    )


    cat(
        "Using demand similarity distance\n"
    )



    demand_cor <-

        cor(

            sales_matrix,

            method="pearson",

            use="pairwise.complete.obs"

        )



    ###########################################################
    # Handle NA correlation
    ###########################################################


    demand_cor[

        is.na(demand_cor)

    ] <- 0



    distance_matrix <-

        1 -

        abs(
            demand_cor
        )



    diag(
        distance_matrix
    ) <- 0



}





###############################################################
# Matrix Labels
###############################################################


rownames(distance_matrix) <-

    selected_stores


colnames(distance_matrix) <-

    selected_stores






###############################################################
# k-nearest Neighbor Network
###############################################################


K_NEIGHBORS <- 3



N <- nrow(distance_matrix)



W_matrix <-

    matrix(

        0,

        nrow=N,

        ncol=N

    )





for(i in seq_len(N)){


    neighbor_order <-

        order(

            distance_matrix[i,]

        )



    neighbor_order <-

        neighbor_order[

            neighbor_order != i

        ]



    neighbors <-

        head(

            neighbor_order,

            K_NEIGHBORS

        )


    W_matrix[i,neighbors] <- 1


}






###############################################################
# Distance Decay Weight
###############################################################


for(i in seq_len(N)){


    for(j in seq_len(N)){


        if(

            W_matrix[i,j] == 1

        ){


            W_matrix[i,j] <-

                1 /

                (

                    distance_matrix[i,j]

                    +

                    1e-8

                )


        }


    }


}







###############################################################
# Row Standardization
###############################################################


row_sum <-

    rowSums(
        W_matrix
    )



for(i in seq_len(N)){


    if(row_sum[i] > 0){


        W_matrix[i,] <-

            W_matrix[i,] /

            row_sum[i]


    }else{


        # isolated node protection

        W_matrix[i,i] <- 0


    }


}






