###############################################################
# Scenario Demand Generator
###############################################################


generate_scenario_demand <- function(

        scenario,

        day

){


    base <-

        sales_matrix[day,]



    if(scenario=="Normal"){


        return(base)

    }



    if(scenario=="High_Volatility"){


        return(

            pmax(

                round(

                    base *

                    rlnorm(

                        N_STORES,

                        0,

                        0.30

                    )

                ),

                0

            )

        )

    }



    if(scenario=="Demand_Shock"){


        shock <-

            ifelse(

                day %% 30 == 0,

                2,

                1

            )


        return(

            base*shock

        )

    }



    base

}
###############################################################
# Robustness Runner
###############################################################


run_robustness_experiment <- function(

        scenario_name,

        method

){


    env <-

        reset_environment()



    Q <-

        create_Q_table()



    rewards <-

        numeric(

            N_DAYS

        )



    for(day in seq_len(N_DAYS)){



        states <-

            integer(N_STORES)



        actions <-

            integer(N_STORES)



        for(i in seq_len(N_STORES)){


            states[i] <-

                environment_state_index(

                    env,

                    i

                )


            actions[i] <-

                epsilon_greedy(

                    Q,

                    states[i],

                    0.05

                )


        }



        env$demand <-

            generate_scenario_demand(

                scenario_name,

                day

            )



        result <-

            environment_step(

                env,

                actions

            )



        env <-

            result$env



        rewards[day] <-

            sum(

                result$reward

            )


    }


    data.frame(

        Scenario=scenario_name,

        Method=method,

        TotalReward=sum(rewards),

        MeanReward=mean(rewards),

        SDReward=sd(rewards)

    )

}
