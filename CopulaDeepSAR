###############################################################
# 9. Copula Simulation Function
###############################################################
#
# Important:
# rCopula() works for parametric copula objects.
# Vine uses RVineSim()
#
###############################################################


simulate_copula_uniform <- function(
        
        copula_model,
        
        n=1
        
){
    
    
    if(
        inherits(
            copula_model,
            "RVineMatrix"
        )
    ){
        
        
        U <- RVineSim(
            
            n,
            
            copula_model
            
        )
        
        
    }else{
        
        
        U <- rCopula(
            
            n,
            
            copula_model
            
        )
        
        
    }
    
    
    as.numeric(U)
    
}


###############################################################
# 10. Copula-Based Demand Generator
###############################################################


simulate_copula_demand <- function(
        
        copula_model,
        
        mu,
        
        sigma
        
){
    
    
    n_store <- length(mu)
    
    
    
    ###########################################################
    # Generate dependent uniforms
    ###########################################################
    
    
    U_sim <- simulate_copula_uniform(
        
        copula_model,
        
        n=1
        
    )
    
    
    
    U_sim <- matrix(
        
        U_sim,
        
        nrow=1
        
    )
    
    
    
    ###########################################################
    # Convert uniforms to Gaussian shocks
    ###########################################################
    
    
    Z <- qnorm(
        
        pmin(
            
            pmax(
                
                U_sim,
                
                1e-8
                
            ),
            
            1-1e-8
            
        )
        
    )
    
    
    
    Z <- as.numeric(Z)
    
    
    
    
    ###########################################################
    # Demand Generation
    ###########################################################
    
    
    demand <- 
        
        
        mu +
        
        sigma * Z
    
    
    
    demand <- pmax(
        
        round(demand),
        
        0
        
    )
    
    
    
    return(
        
        demand
        
    )
    
}




