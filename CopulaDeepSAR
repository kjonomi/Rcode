simulate_independent_demand <- function(
  marginal_means,
  marginal_sds,
  n = 1
){

  demand_sim <- matrix(
    0,
    nrow = n,
    ncol = length(marginal_means)
  )

  for(i in 1:length(marginal_means)){

    demand_sim[, i] <- rnorm(
      n,
      mean = marginal_means[i],
      sd = marginal_sds[i]
    )
  }

  demand_sim <- pmax(
    round(demand_sim),
    0
  )

  return(demand_sim)
}

# ============================================================
# 19) TRAIN NO-COPULA MODEL
# ============================================================

Q_nocop <- matrix(
  0,
  nrow = n_regions,
  ncol = n_actions
)

episode_rewards_nocop <- matrix(
  0,
  nrow = n_episodes,
  ncol = n_regions
)

for(ep in 1:n_episodes){

  s <- states

  eps <- epsilon_start +
    (epsilon_end - epsilon_start) *
    (ep / n_episodes)

  alpha_ep <- alpha *
    (1 / (1 + 0.0005 * ep))

  ep_rewards <- rep(0, n_regions)

  demand_t <- demand_base

  for(t in 1:n_steps){

    demand_forecast <- numeric(n_regions)

    for(i in 1:n_regions){

      demand_forecast[i] <-
        demand_t[i] * demand_phi[i] +
        (1 - demand_phi[i]) *
        demand_base[i]
    }

    independent_demand <- simulate_independent_demand(
      demand_forecast,
      demand_sd,
      n = 1
    )

    realized_demand <- as.numeric(
      independent_demand[1, ]
    )

    actions <- integer(n_regions)

    for(region in 1:n_regions){

      if(runif(1) < eps){

        a <- sample(
          0:(n_actions - 1),
          1
        )

      } else {

        a <- which.max(
          Q_nocop[region, ]
        ) - 1
      }

      actions[region] <- a
    }

    s_next <- next_state_fn(
      inventory = s,
      actions = actions,
      demand = realized_demand
    )

    for(region in 1:n_regions){

      neighbors <- which(
        W[region, ] > 0
      )

      transport_cost <- transport_cost_fn(
        flow = actions[region],
        distance = length(neighbors)
      )

      r <- reward_fn(
        inventory = s_next[region],
        demand = realized_demand[region],
        transport_cost = transport_cost
      )

      ep_rewards[region] <-
        ep_rewards[region] + r

      spatial_term <- lambda_spatial *
        sum(
          W[region, ] *
            Q_nocop[, actions[region] + 1]
        )

      Q_nocop[region, actions[region] + 1] <-
        Q_nocop[region, actions[region] + 1] +
        alpha_ep * (
          r +
            gamma * max(Q_nocop[region, ]) +
            spatial_term -
            Q_nocop[region, actions[region] + 1]
        )
    }

    s <- s_next

    demand_t <- realized_demand
  }

  episode_rewards_nocop[ep, ] <- ep_rewards
}

