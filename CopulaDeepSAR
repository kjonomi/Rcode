    ###########################################################
    
    
    demand_trend <- sapply(
        
        seq_len(N_STORES),
        
        function(i){
            
            
            y <- tail(
                
                sales_matrix[,i],
                
                30
                
            )
            
            
            coef(
                
                lm(
                    
                    y ~ seq_along(y)
                    
                )
                
            )[2]
            
            
        }
        
    )
    
    
    
    
    ###########################################################
    # State Vector
    ###########################################################
    
    
    state <- c(
        
        inventory,
        
        forecast,
        
        demand_sd,
        
        safety_stock,
        
        reorder_point,
        
        neighbor_inventory,
        
        recent_demand,
        
        demand_trend,
        
        rep(0,N_STORES),   # Promotion
        
        rep(0,N_STORES),   # Holiday
        
        rep(0,N_STORES),   # Stockout
        
        inventory/MAX_CAPACITY
        
    )
    
    
    
    matrix(
        
        state,
        
        nrow=1
        
    )
    
}





