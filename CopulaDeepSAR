    0.04 *
      abs(flow) *
      distance
  )
}

# ============================================================
# 12) INVENTORY TRANSITION FUNCTION
# ============================================================

next_state_fn <- function(
  inventory,
  actions,
  demand,
  rho = 0.35
){

  n <- length(inventory)

  spatial_inventory <- as.numeric(
    rho * (W %*% inventory)
  )

  action_effect <- rep(0, n)

  for(i in 1:n){

    action_effect[i] <- switch(
      as.character(actions[i]),

      "0" = 0,

      "1" = round(
        0.20 * demand[i]
      ),

      "2" = -round(
        0.20 * demand[i]
      ),

      0
    )
  }

  noise <- rnorm(
    n,
    0,
    pmax(1, 0.08 * demand)
  )

  next_inventory <- inventory +
    spatial_inventory +
    action_effect -
    demand +
    noise

  next_inventory <- pmax(
    round(next_inventory),
    0
  )

  return(next_inventory)
}

