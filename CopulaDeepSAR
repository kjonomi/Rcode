###############################################################
# 8. ROBUSTNESS EXPERIMENT
###############################################################

run_robustness_experiment <- function(
    scenario_name,
    method,
    replication = 1,
    scenario_settings = NULL
) {

    ###########################################################
    # Get scenario settings
    ###########################################################

    if (
        is.null(
            scenario_settings
        )
    ) {

        scenario_settings <-
            scenarios %>%

            filter(
                Scenario == scenario_name
            )

    }

    if (
        nrow(
            scenario_settings
        ) != 1
    ) {

        stop(
            paste(
                "Scenario not found:",
                scenario_name
            )
        )

    }

    ###########################################################
    # Reset environment
    ###########################################################

    env <-
        reset_environment()

    ###########################################################
    # Apply scenario parameters
    ###########################################################

    env <-
        apply_scenario_parameters(
            env,
            scenario_settings
        )

    ###########################################################
    # Initialize Q table
    ###########################################################

    Q <-
        create_Q_table()

    ###########################################################
    # Storage
    ###########################################################

    rewards <-
        numeric(
            N_DAYS
        )

    fill_rates <-
        numeric(
            N_DAYS
        )

    stockouts <-
        numeric(
            N_DAYS
        )

    ###########################################################
    # Simulation
    ###########################################################

    for (
        day in seq_len(
            N_DAYS
        )
    ) {

        #######################################################
        # State
        #######################################################

        states <-
            integer(
                N_STORES
            )

        #######################################################
        # Actions
        #######################################################

        actions <-
            integer(
                N_STORES
            )

        #######################################################
        # Select actions
        #######################################################

        for (
            i in seq_len(
                N_STORES
            )
        ) {

            states[i] <-
                environment_state_index(
                    env,
                    i
                )

            actions[i] <-
                epsilon_greedy(
                    Q,
                    states[i],
                    0.05
                )
        }

        #######################################################
        # Scenario demand
        #######################################################

        env$demand <-
            generate_scenario_demand(

                scenario =
                    scenario_name,

                day =
                    day,

                demand_multiplier =
                    scenario_settings$DemandMultiplier
            )

        #######################################################
        # Environment step
        #######################################################

        result <-
            environment_step(
                env,
                actions
            )

        env <-
            result$env

        #######################################################
        # Reward
        #######################################################

        rewards[day] <-
            sum(
                result$reward,
                na.rm = TRUE
            )

        #######################################################
        # Fill rate
        #######################################################

        if (
            "fill_rate" %in%
            names(result)
        ) {

            fill_rates[day] <-
                mean(
                    result$fill_rate,
                    na.rm = TRUE
                )

        } else {

            fill_rates[day] <-
                NA_real_

        }

        #######################################################
        # Stockouts
        #######################################################

        if (
            "stockouts" %in%
            names(result)
        ) {

            stockouts[day] <-
                sum(
                    result$stockouts,
                    na.rm = TRUE
                )

        } else {

            stockouts[day] <-
                NA_real_

        }
    }

    ###########################################################
    # Return replication-level results
    ###########################################################

    data.frame(

        Replication =
            replication,

        Scenario =
            scenario_name,

        Method =
            method,

        TotalReward =
            sum(
                rewards,
                na.rm = TRUE
            ),

        MeanReward =
            mean(
                rewards,
                na.rm = TRUE
            ),

        SDReward =
            sd(
                rewards,
                na.rm = TRUE
            ),

        MeanFillRate =
            mean(
                fill_rates,
                na.rm = TRUE
            ),

        TotalStockouts =
            sum(
                stockouts,
                na.rm = TRUE
            ),

        stringsAsFactors = FALSE
    )
}

