reward_fn <- function(
  inventory,
  demand,
  transport_cost = 0
){

  sales <- pmin(
    inventory,
    demand
  )

  revenue <- 15 * sales

  holding_cost <- 0.08 *
    pmax(inventory - demand, 0)

  shortage_cost <- 0.70 *
    pmax(demand - inventory, 0)

  reward <- revenue -
