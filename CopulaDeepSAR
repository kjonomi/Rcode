# ============================================================
# 4) ESTIMATE AR(1) DEMAND MODELS
# ============================================================

demand_phi <- numeric(n_regions)
demand_base <- numeric(n_regions)

for(i in 1:n_regions){

  ts_i <- ts(
    sales_mat[, i],
    frequency = 7
  )

  fit <- tryCatch(
    arima(ts_i, order = c(1,0,0)),
    error = function(e) NULL
  )

  if(!is.null(fit)){

    demand_phi[i] <- coef(fit)["ar1"]

    demand_base[i] <- mean(ts_i)

  } else {

    demand_phi[i] <- 0.5

    demand_base[i] <- mean(ts_i)
  }
}

