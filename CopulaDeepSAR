    # thetaf() directly computes required horizon
    ###########################################################
    
    fit_theta <- thetaf(
        
        train,
        
        h=forecast_horizon
        
    )
    
    
    
    
    ###########################################################
    # Forecasts
    ###########################################################
    
    
    pred_arima <- forecast(
        
        fit_arima,
        
        h=forecast_horizon
        
    )$mean
    
    
    
    pred_ets <- forecast(
        
        fit_ets,
        
        h=forecast_horizon
        
    )$mean
    
    
    
    pred_tbats <- forecast(
        
        fit_tbats,
        
        h=forecast_horizon
        
    )$mean
    
    
    
    pred_theta <- fit_theta$mean
    
    
    
    
    ###########################################################
    # Evaluation
    ###########################################################
    
    
    results <- rbind(
        
        
        cbind(
            
            Model="ARIMA",
            
