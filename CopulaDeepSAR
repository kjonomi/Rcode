demand_sd <- apply(sales_mat,2,sd)

simulate_copula_demand <- function(copula_model, means, sds, n=1){
  U_sim <- rCopula(n, copula_model)
  out <- matrix(0,n,ncol=length(means))
  for(i in 1:length(means)){
    out[,i] <- qnorm(U_sim[,i], mean=means[i], sd=sds[i])
  }
  pmax(round(out),0)
}

# ============================================================
# 6) SPATIAL GRAPH
# ============================================================

corr_mat <- cor(sales_mat)
W <- matrix(0,n_regions,n_regions)
k_neigh <- 3

for(i in 1:n_regions){
  nbrs <- order(corr_mat[i,], decreasing=TRUE)[2:(k_neigh+1)]
  W[i,nbrs] <- 1
}
W <- W / pmax(rowSums(W),1)

# ============================================================
# 7) RL SETUP
# ============================================================

n_actions <- 3
n_episodes <- 300
n_steps <- 25

alpha <- 0.08
gamma <- 0.96
lambda_spatial <- 0.30
consensus_tau <- 0.08

epsilon_start <- 0.35
epsilon_end <- 0.05

Q <- matrix(0,n_regions,n_actions)
states <- round(1.3*demand_base)

reward_fn <- function(inv,demand,tc=0){
  sales <- pmin(inv,demand)
  15*sales - 0.08*pmax(inv-demand,0) - 0.7*pmax(demand-inv,0) - tc
}

next_state_fn <- function(inv,actions,demand){
  n <- length(inv)
  spatial <- as.numeric(0.35*(W%*%inv))
  act <- rep(0,n)
  for(i in 1:n){
    act[i] <- if(actions[i]==1) 0.2*demand[i] else if(actions[i]==2) -0.2*demand[i] else 0
  }
  noise <- rnorm(n,0,pmax(1,0.08*demand))
  pmax(round(inv + spatial + act - demand + noise),0)
}

transport_cost_fn <- function(flow,distance=1) 0.04*abs(flow)*distance

# ============================================================
# 8) COPULA SAR-Q TRAINING
# ============================================================

episode_rewards <- matrix(0,n_episodes,n_regions)

for(ep in 1:n_episodes){

  s <- states
  eps <- epsilon_start + (epsilon_end-epsilon_start)*(ep/n_episodes)
  alpha_ep <- alpha/(1+0.0005*ep)
  ep_r <- rep(0,n_regions)
  demand_t <- demand_base

  for(t in 1:n_steps){

    demand_forecast <- demand_t*demand_phi + (1-demand_phi)*demand_base

    realized <- as.numeric(
      simulate_copula_demand(copula_model,demand_forecast,demand_sd,1)
    )

    actions <- integer(n_regions)

    for(i in 1:n_regions){
      actions[i] <- if(runif(1)<eps) sample(0:2,1) else which.max(Q[i,])-1
    }

    s_next <- next_state_fn(s,actions,realized)

    for(i in 1:n_regions){
      tc <- transport_cost_fn(actions[i], sum(W[i,]>0))
      r <- reward_fn(s_next[i], realized[i], tc)
      ep_r[i] <- ep_r[i] + r

      spatial_term <- lambda_spatial * sum(W[i,]*Q[,actions[i]+1])

      Q[i,actions[i]+1] <- Q[i,actions[i]+1] + alpha_ep*
        (r + gamma*max(Q[i,]) + spatial_term - Q[i,actions[i]+1])
    }

    s <- s_next
    demand_t <- realized
  }

  episode_rewards[ep,] <- ep_r
}

