# ============================================================

action_labels <- c(
  "Maintain",
  "IncreaseShipment",
  "ReduceShipment"
)

results_table <- data.frame(
  Store = stores,
  BestAction = action_labels[
    apply(Q, 1, which.max)
  ],
  MeanReward = round(
    colMeans(episode_rewards),
    2
  ),
  FinalInventory_2Weeks = round(
    forecast_inventory[
      forecast_horizon,
    ],
    2
  )
)

print(results_table)

results_table %>%
  knitr::kable(
    caption = "Copula-Spatial SAR-Q Inventory Results"
  ) %>%
  kableExtra::kable_styling()

# ============================================================
# 16) PLOT: TRAINING REWARDS
# ============================================================

reward_df <- data.frame(
  Episode = 1:n_episodes,
  MeanReward = rowMeans(
    episode_rewards
  )
)

p1 <- ggplot(
  reward_df,
  aes(Episode, MeanReward)
) +
  geom_line(color = "steelblue") +
  geom_smooth(se = TRUE) +
  theme_minimal() +
  labs(
    title = "Copula SAR-Q Training Rewards"
  )

print(p1)

# ============================================================
# 17) PLOT: FORECAST INVENTORY PATHS
# ============================================================

forecast_df <- as.data.frame(
  forecast_inventory
)

colnames(forecast_df) <- stores

forecast_df$Week <- 1:nrow(forecast_df)

forecast_long <- pivot_longer(
  forecast_df,
  -Week,
  names_to = "Store",
  values_to = "Inventory"
)

p2 <- ggplot(
  forecast_long,
  aes(
    Week,
    Inventory,
    color = Store
  )
) +
  geom_line(size = 1) +
  geom_point(size = 2) +
  theme_minimal() +
  labs(
    title = "Forecast Inventory Paths (2 Weeks)",
    x = "Forecast Week",
    y = "Inventory Level"
  )

print(p2)

# ============================================================
# 18) PLOT: COPULA DEPENDENCE MATRIX
# ============================================================

tau_df <- reshape2::melt(
  kendall_tau
)

colnames(tau_df) <- c(
  "Store1",
  "Store2",
  "Tau"
)

p3 <- ggplot(
  tau_df,
  aes(
    Store1,
    Store2,
    fill = Tau
  )
) +
  geom_tile() +
  theme_minimal() +
  labs(
    title = "Kendall Tau Dependence Matrix"
  )

print(p3)

# ============================================================
# 19) PLOT: POLICY PERFORMANCE
# ============================================================

vis_df <- results_table

p4 <- ggplot(
  vis_df,
  aes(
    MeanReward,
    FinalInventory_2Weeks,
    color = BestAction
  )
) +
  geom_point(size = 5) +
  geom_text_repel(
    aes(label = Store)
  ) +
  theme_minimal() +
  labs(
    title = "Reward vs Final Inventory (2 Weeks)"
  )

print(p4)

# ============================================================
# 20) PLOT: SPATIAL ADJACENCY HEATMAP
