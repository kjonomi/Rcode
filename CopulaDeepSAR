    error = function(e) NULL
  )

  if(!is.null(fit)){

    demand_phi[i] <- coef(fit)["ar1"]

    demand_base[i] <- mean(ts_i)

  } else {

    demand_phi[i] <- 0.5

    demand_base[i] <- mean(ts_i)
  }
}

