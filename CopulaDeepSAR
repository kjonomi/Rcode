      copula_demand[1, ]
    )

    # --------------------------------------------------------
    # ACTION SELECTION
    # --------------------------------------------------------

    actions <- integer(n_regions)

    for(region in 1:n_regions){

      if(runif(1) < eps){

        a <- sample(
          0:(n_actions - 1),
          1
        )

      } else {

        a <- which.max(
          Q[region, ]
        ) - 1
      }

      actions[region] <- a

      action_counts[a + 1, region] <-
        action_counts[a + 1, region] + 1
    }

    # --------------------------------------------------------
    # NEXT INVENTORY STATE
    # --------------------------------------------------------

    s_next <- next_state_fn(
      inventory = s,
      actions = actions,
      demand = realized_demand
    )

    # --------------------------------------------------------
    # Q UPDATE
    # --------------------------------------------------------

    for(region in 1:n_regions){

      neighbors <- which(
        W[region, ] > 0
      )

      transport_cost <- transport_cost_fn(
        flow = actions[region],
        distance = length(neighbors)
      )

      r <- reward_fn(
        inventory = s_next[region],
        demand = realized_demand[region],
        transport_cost = transport_cost
      )

      ep_rewards[region] <-
        ep_rewards[region] + r

      spatial_term <- lambda_spatial *
        sum(
          W[region, ] *
            Q[, actions[region] + 1]
        )

      Q[region, actions[region] + 1] <-
        Q[region, actions[region] + 1] +
        alpha_ep * (
          r +
            gamma * max(Q[region, ]) +
            spatial_term -
            Q[region, actions[region] + 1]
        )
    }

    # --------------------------------------------------------
    # CONSENSUS LEARNING
    # --------------------------------------------------------

    Q_new <- Q

    for(region in 1:n_regions){

      if(sum(W[region, ]) > 0){

        neighbor_Q_mean <- colSums(
          matrix(
            W[region, ],
            nrow = n_regions,
            ncol = n_actions,
            byrow = FALSE
          ) * Q
        ) / sum(W[region, ])

      } else {

        neighbor_Q_mean <- rep(
          0,
          n_actions
        )
      }

      Q_new[region, ] <-
        (1 - consensus_tau) *
        Q[region, ] +
        consensus_tau *
        neighbor_Q_mean
    }

    Q <- Q_new

    s <- s_next

    demand_t <- realized_demand
  }

  episode_rewards[ep, ] <- ep_rewards

  cum_reward <- cum_reward + ep_rewards

  if(ep %% 50 == 0){

    cat(
      sprintf(
        "Episode %d/%d | Mean Reward = %.2f\n",
        ep,
        n_episodes,
        mean(ep_rewards)
      )
    )
  }
}

