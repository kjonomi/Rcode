# 14. Environment Initialization
###############################################################


initialize_environment <- function(){
    
    
    list(
        
        inventory=initial_inventory(),
        
        pipeline=initialize_pipeline(),
        
        time=1,
        
        total_reward=0
        
    )
    
}




###############################################################
# 15. Environment Step
###############################################################


environment_step <- function(
        
        env,
        
        action_vector,
        
        copula_model=best_copula
        
){
    
    
    shipment <- round(
        
        env$inventory *
            
            action_vector
        
    )
    
    
    
    demand <- generate_demand(
        
        copula_model
        
    )
    
    
    
    transition <- inventory_step(
        
        env$inventory,
        
        env$pipeline,
        
        shipment,
        
        demand
        
    )
    
    
    
    reward_output <- compute_reward(
        
        demand,
        
        env$inventory,
        
        shipment
        
    )
    
    
    
    next_env <- list(
        
        inventory=transition$inventory,
        
        pipeline=transition$pipeline,
        
        time=env$time+1,
        
        total_reward=
            
            env$total_reward +
            
            sum(
                reward_output$reward
            )
        
    )
    
    
    
    list(
        
        state=create_state(
            
            next_env$inventory
            
        ),
        
        reward=sum(
            
            reward_output$reward
            
        ),
        
        environment=next_env,
        
        demand=demand,
        
        sales=transition$sales,
        
        lost_sales=transition$lost_sales
        
    )
    
}





