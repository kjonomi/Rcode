###############################################################
# PART 4
#
# Base-Stock Policy
#
###############################################################

BASE_SERVICE_LEVEL <-
    0.95


base_stock_policy <- function(
    env
) {

    ###########################################################
    # Safety-stock component
    ###########################################################

    safety_stock <-
        qnorm(
            BASE_SERVICE_LEVEL
        ) *
        demand_sd *
        sqrt(
            LEAD_TIME
        )


    ###########################################################
    # Target inventory
    ###########################################################

    target_inventory <-
        demand_base *
        LEAD_TIME +
        safety_stock


    ###########################################################
    # Order quantity
    ###########################################################

    order_qty <-
        pmax(
            target_inventory -
            env$inventory,
            0
        )


    ###########################################################
    # Convert order quantity to action
    ###########################################################

    action <-
        findInterval(
            order_qty,
            ACTION_SPACE
        )


    ###########################################################
    # Protect action boundaries
    ###########################################################

    action <-
        pmin(
            pmax(
                action,
                1
            ),
            N_ACTIONS
        )


    return(
        action
    )

}


###############################################################
# PART 5
