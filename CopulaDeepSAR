# ============================================================
# 8) COPULA DEMAND SIMULATION
# ============================================================

simulate_copula_demand <- function(
  copula_model,
  marginal_means,
  marginal_sds,
  n = 1
){

  U_sim <- rCopula(
    n,
    copula_model
  )

  demand_sim <- matrix(
    0,
    nrow = n,
    ncol = length(marginal_means)
  )

  for(i in 1:length(marginal_means)){

    demand_sim[, i] <- qnorm(
      U_sim[, i],
      mean = marginal_means[i],
      sd = marginal_sds[i]
    )
  }

  demand_sim <- pmax(
    round(demand_sim),
    0
  )

  return(demand_sim)
}

