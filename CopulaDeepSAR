###############################################################
# Action Selection
###############################################################


epsilon_greedy <- function(

        Q,

        state_id,

        epsilon

){


    q_values <-

        get_Q(

            Q,

            state_id

        )


    if(

        runif(1)<epsilon

    ){

        return(

            sample(

                seq_len(N_ACTIONS),

                1

            )

        )

    }


    best <-

        which(

            q_values==max(q_values)

        )


    sample(

        best,

        1

    )

}
###############################################################
# Spatial Neighbor Value
###############################################################


spatial_value <- function(

        Q,

        env,

        store_id

){


    value <- 0



    neighbors <-

        which(

            W_matrix[store_id,] > 0

        )



    for(j in neighbors){


        state_j <-

            environment_state_index(

                env,

                j

            )


        q_j <-

            get_Q(

                Q,

                state_j

            )



        value <-

            value +

            W_matrix[store_id,j] *

            max(q_j)

    }


    value

}
