###############################################################
# PART 4
#
# Base-Stock Policy
#
###############################################################

BASE_SERVICE_LEVEL <-
    0.95


base_stock_policy <- function(
    env
) {

    ###########################################################
    # Safety-stock component
    ###########################################################

    safety_stock <-
        qnorm(
            BASE_SERVICE_LEVEL
        ) *
        demand_sd *
        sqrt(
            LEAD_TIME
        )


    ###########################################################
    # Target inventory
    ###########################################################

    target_inventory <-
        demand_base *
        LEAD_TIME +
        safety_stock


    ###########################################################
    # Order quantity
    ###########################################################

    order_qty <-
        pmax(
            target_inventory -
            env$inventory,
            0
        )


    ###########################################################
    # Convert order quantity to action
    ###########################################################

    action <-
        findInterval(
            order_qty,
            ACTION_SPACE
        )


    ###########################################################
    # Protect action boundaries
    ###########################################################

    action <-
        pmin(
            pmax(
                action,
                1
            ),
            N_ACTIONS
        )


    return(
        action
    )

}


###############################################################
# PART 5
#
# Environment Output Helper
#
###############################################################

get_result_vector <- function(
    result,
    env,
    variable,
    default = 0
) {

    ###########################################################
    # Prefer variable returned directly by environment_step
    ###########################################################

    if (
        variable %in%
        names(result)
    ) {

        value <-
            result[[variable]]

        if (
            length(value) > 0
        ) {

            return(
                value
            )

        }

    }


    ###########################################################
    # Otherwise use updated environment
    ###########################################################

    if (
        variable %in%
        names(env)
    ) {

        value <-
            env[[variable]]

        if (
            length(value) > 0
        ) {

            return(
                value
            )

        }

    }


    ###########################################################
    # Default
    ###########################################################

    return(
        default
    )

}


###############################################################
# PART 6
#
# Evaluate Policy
#
###############################################################

evaluate_policy <- function(
    policy,
    method_name,
    replication
) {

    ###########################################################
    # Reset environment
    ###########################################################

    env <-
        reset_environment()


    ###########################################################
    # Performance storage
    ###########################################################

    total_reward <-
        0

    total_cost <-
        0

    total_stockout <-
        0

    total_sales <-
        0

    total_demand <-
        0


    ###########################################################
    # Daily simulation
    ###########################################################

    for (
        day in seq_len(
            N_DAYS
        )
    ) {

        #######################################################
        # Select action
        #######################################################

        actions <-
            policy(
                env
            )


        #######################################################
        # Validate actions
        #######################################################

        if (
            length(actions) !=
            N_STORES
        ) {

            stop(
                paste(
                    "Invalid action length for method:",
                    method_name
                )
            )

        }


        #######################################################
        # Environment step
        #######################################################

        result <-
            environment_step(
                env,
                actions
            )


        #######################################################
        # Update environment
        #######################################################

        env <-
            result$env


        #######################################################
        # Reward
        #######################################################

        reward_value <-
            get_result_vector(
                result,
                env,
                "reward"
            )

        total_reward <-
            total_reward +
            sum(
                reward_value,
                na.rm = TRUE
            )


        #######################################################
        # Cost
        #######################################################

        cost_value <-
            get_result_vector(
                result,
                env,
                "cost"
            )

        total_cost <-
            total_cost +
            sum(
                cost_value,
                na.rm = TRUE
            )


        #######################################################
        # Stockouts
        #######################################################

        stockout_value <-
            get_result_vector(
                result,
                env,
                "stockout"
            )

        total_stockout <-
            total_stockout +
            sum(
                stockout_value,
                na.rm = TRUE
            )


        #######################################################
        # Sales
        #######################################################

        sales_value <-
            get_result_vector(
                result,
                env,
                "sales"
            )

        total_sales <-
            total_sales +
            sum(
                sales_value,
                na.rm = TRUE
            )


        #######################################################
        # Demand
        #######################################################

        demand_value <-
            get_result_vector(
                result,
                env,
                "demand"
            )

        total_demand <-
            total_demand +
            sum(
                demand_value,
                na.rm = TRUE
            )

    }


    ###########################################################
    # Fill rate
    ###########################################################

    fill_rate <-
        total_sales /
        pmax(
            total_demand,
            1
        )


    ###########################################################
    # Return replication-level result
    ###########################################################

    data.frame(

        Replication =
            replication,

        Method =
            method_name,

        TotalReward =
            total_reward,

        TotalCost =
            total_cost,

        FillRate =
            fill_rate,

        Stockouts =
            total_stockout,

        TotalSales =
            total_sales,

        TotalDemand =
            total_demand,

        stringsAsFactors =
            FALSE
    )

}


###############################################################
# PART 7
#
# RL Policy Extraction
#
###############################################################

create_RL_policy <- function(
    Q,
    method
) {

    ###########################################################
    # Check Q table
    ###########################################################

    if (
        is.null(Q)
    ) {

        stop(
            paste(
                "Q table is NULL for method:",
                method
            )
        )

    }


    ###########################################################
    # Create deterministic policy
    ###########################################################

    policy_function <-
        function(
            env
        ) {

            actions <-
                integer(
                    N_STORES
                )


            ###################################################
            # Select action for each store
            ###################################################

            for (
                i in seq_len(
                    N_STORES
                )
            ) {

                state <-
                    environment_state_index(
                        env,
                        i
                    )


                q_values <-
                    get_Q(
                        Q,
                        state
                    )


                if (
                    length(q_values) == 0
                ) {

                    stop(
                        paste(
                            "No Q-values found for state:",
                            state
                        )
                    )

                }


                ################################################
                # Greedy action
                ################################################

                actions[i] <-
                    which.max(
                        q_values
                    )

            }


            return(
                actions
            )

        }


    return(
        policy_function
    )

}


