for(name in names(candidate_copulas)){


    cat(
        "\nFitting:",
        name,
        "\n"
    )



    fit <- tryCatch(


        fitCopula(

            candidate_copulas[[name]],

            data=U,

            method="ml"

        ),


        error=function(e){


            cat(
                "ML failed:",
                name,
                "\n"
            )


            NULL


        }

    )



    ###########################################################
    # If fitting succeeds
    ###########################################################

    if(!is.null(fit)){


        ll <- as.numeric(
            logLik(fit)
        )


        k <- length(
            coef(fit)
        )


        n <- nrow(U)



        copula_comparison <- rbind(

            copula_comparison,


            data.frame(

                Model=name,

                LogLik=ll,

                AIC=-2*ll+2*k,

                BIC=-2*ll+log(n)*k

            )

        )



        #######################################################
        # Store actual copula object
        #######################################################

        copula_results[[name]] <-

            fit@copula


    }

