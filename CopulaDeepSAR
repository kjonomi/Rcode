# 6. Action Selection
###############################################################

select_action <- function(
        
        agent,
        
        state,
        
        epsilon=0.1
        
){
    
    
    q_values <- calculate_q_values(
        
        agent,
        
        state
        
    )
    
    
    
    if(runif(1)<epsilon){
        
        
        sample(
            
            seq_len(N_ACTIONS),
            
            1
            
        )
        
        
    }else{
        
        
        which.max(q_values)
        
        
    }
    
}





###############################################################
# 7. Q-Learning Update
###############################################################

update_qlearning <- function(
        
        agent,
        
        state,
        
        action,
        
        reward,
        
        next_state,
        
        alpha,
        
        gamma
        
){
    
    
    q_current <-
        
        sum(
            
            state *
                
                agent$weights[,action]
            
        )
    
    
    
    q_next <- max(
        
        calculate_q_values(
            
            agent,
            
            next_state
            
        )
        
    )
    
    
    
    td_error <-
        
        reward +
        
        gamma*q_next -
        
        q_current
    
    
    
    agent$weights[,action] <-
        
        agent$weights[,action] +
        
        alpha *
        
        td_error *
        
        state
    
    
    agent
    
}





###############################################################
# 8. SAR-Q Update
###############################################################

update_sarq <- function(
        
        agent,
        
        state,
        
        action,
        
        reward,
        
        next_state,
        
        alpha,
        
        gamma
        
){
    
    
    next_q <- calculate_q_values(
        
        agent,
        
        next_state
        
    )
    
    
    
    next_action <- which.max(
        
        next_q
        
    )
    
    
    
    td_error <-
        
        reward +
        
        gamma *
        
        next_q[next_action] -
        
        sum(
            
            state *
                
                agent$weights[,action]
            
        )
    
    
    
    agent$weights[,action] <-
        
        agent$weights[,action] +
        
        alpha *
        
        td_error *
        
        state
    
    
    
    agent
    
}





###############################################################
# 9. LASAR-Q Update
###############################################################

update_lasarq <- function(
        
