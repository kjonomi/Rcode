###############################################################
# Base Stock Policy
###############################################################


BASE_SERVICE_LEVEL <- 0.95



base_stock_policy <- function(

        env

){


    target_inventory <-

        demand_base *

        LEAD_TIME +

        qnorm(

            BASE_SERVICE_LEVEL

        )

        *

        demand_sd *

        sqrt(

            LEAD_TIME

        )



    order_qty <-

        pmax(

            target_inventory -

            env$inventory,

            0

        )



    action <-

        findInterval(

            order_qty,

            ACTION_SPACE

        )



    action <-

        pmin(

            pmax(

                action,

                1

            ),

            N_ACTIONS

        )



    action

}
###############################################################
# Evaluate Policy
###############################################################


evaluate_policy <- function(

        policy,

        method_name,

        replication

){


    env <-

        reset_environment()



    total_reward <- 0

    total_cost <- 0

    total_stockout <- 0

    total_sales <- 0

    total_demand <- 0



    for(day in seq_len(N_DAYS)){



        #######################################################
        # Action
        #######################################################

        actions <-

            policy(env)



        #######################################################
        # Environment step
        #######################################################

        result <-

            environment_step(

                env,

                actions

            )


        env <-

            result$env



        total_reward <-

            total_reward +

            sum(

                result$reward

            )


        total_cost <-

            total_cost +

            sum(

                env$cost

            )


        total_stockout <-

            total_stockout +

            sum(

                env$stockout

            )


        total_sales <-

            total_sales +

            sum(

                env$sales

            )


        total_demand <-

            total_demand +

            sum(

                env$demand

            )


    }



    data.frame(

        Replication=

            replication,

        Method=

            method_name,

        TotalReward=

            total_reward,

        TotalCost=

            total_cost,

        FillRate=

            total_sales /

            pmax(

                total_demand,

                1

            ),

        Stockouts=

            total_stockout

    )

}
###############################################################
# RL Policy Extraction
###############################################################


create_RL_policy <- function(

        Q,

        method

){


    function(env){



        actions <-

            integer(

                N_STORES

            )



        for(i in seq_len(N_STORES)){



            state <-

                environment_state_index(

                    env,

                    i

                )



            q_values <-

                get_Q(

                    Q,

                    state

                )


            actions[i] <-

                which.max(

                    q_values

                )


        }



        actions

    }

}
