###############################################################
# 17. kNN Network Builder
###############################################################


build_knn_network <- function(
        
        similarity,
        
        k=3
        
){
    
    
    n <- nrow(similarity)
    
    
    W <- matrix(
        
        0,
        
        n,
        
        n
        
    )
    
    
    
    for(i in seq_len(n)){
        
        
        neighbors <- order(
            
            similarity[i,],
            
            decreasing=TRUE
            
        )[1:k]
        
        
        
        W[i,neighbors] <-
            
            similarity[i,neighbors]
        
        
    }
    
    
    
    
    row_sum <- rowSums(W)
    
    
    W <- sweep(
        
        W,
        
        1,
        
        row_sum,
        
        "/"
        
    )
    
    
    W[is.na(W)] <- 0
    
    
    return(W)
    
}




