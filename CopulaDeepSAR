###############################################################
# 5. Train Ablation Model
###############################################################


train_ablation_agent <- function(

    model_name,

    episodes=500

){


    config <-


        ablation_models %>%


        filter(

            Model==model_name

        )



    use_copula <- config$Copula


    use_spatial <- config$Spatial



    agent <-


        initialize_agent(

            "SARQ"

        )



    reward_history <- numeric(episodes)



    epsilon <- 0.3



    for(ep in seq_len(episodes)){



        env <-


            initialize_environment()



        total_reward <- 0



        for(step in 1:50){



            state <-


                scale_state_ablation <-


                scale_state(


                    create_state_ablation(

                        env$inventory,

                        use_spatial

                    )[1,]

                )



            action <-


                select_action(

                    agent,

                    state,

                    epsilon

                )



            if(use_copula){


                result <-


                    environment_step(

                        env,

                        rep(

                            actions[action],

                            N_STORES

                        )

                    )


            }else{


                demand <-


                    generate_demand_ablation(

                        FALSE

                    )



                result <-


                    environment_step(

                        env,

                        rep(

                            actions[action],

                            N_STORES

                        )

                    )


            }




            next_state <-


                scale_state(

                    create_state_ablation(

                        result$environment$inventory,

                        use_spatial

                    )[1,]

                )



            agent <-


                update_sarq(

                    agent,

                    state,

                    action,

                    result$reward,

                    next_state,

                    0.01,

                    0.95

                )



            env <-


                result$environment



            total_reward <-


                total_reward +

                result$reward



        }



        reward_history[ep] <-


            total_reward



        epsilon <-


            max(

                0.01,

                epsilon*0.995

            )


    }



    list(

        agent=agent,

        RewardHistory=reward_history,

        MeanReward=mean(reward_history)

    )

}




