###############################################################
# Single Episode Trainer
###############################################################


run_episode <- function(

        method,

        Q,

        episode

){


    ###########################################################
    # Reset Environment
    ###########################################################

    env <-

        reset_environment()



    total_reward <-

        rep(

            0,

            N_STORES

        )



    epsilon <-

        max(

            EPSILON_END,

            EPSILON_START *

            EPSILON_DECAY^(episode-1)

        )



    done <- FALSE



    ###########################################################
    # Daily Simulation
    ###########################################################

    while(!done){



        #######################################################
        # Current states
        #######################################################

        states <-

            integer(

                N_STORES

            )


        actions <-

            integer(

                N_STORES

            )



        for(i in seq_len(N_STORES)){



            states[i] <-

                environment_state_index(

                    env,

                    i

                )



            actions[i] <-

                epsilon_greedy(

                    Q,

                    states[i],

                    epsilon

                )

        }




        #######################################################
        # Environment transition
        #######################################################

        transition <-

            environment_step(

                env,

                actions

            )


        new_env <-

            transition$env



        rewards <-

            transition$reward



        done <-

            transition$done



        #######################################################
        # Next state update
        #######################################################

        next_states <-

            integer(

                N_STORES

            )



        for(i in seq_len(N_STORES)){



            next_states[i] <-

                environment_state_index(

                    new_env,

                    i

                )



            Q <-

                RL_update(

                    method,

                    Q,

                    new_env,

                    i,

                    states[i],

                    actions[i],

                    rewards[i],

                    next_states[i]

                )

        }



        total_reward <-

            total_reward +

            rewards



        env <-

            new_env


    }


    list(

        Q = Q,

        reward = total_reward,

        KPI = network_KPI(env)

    )

}
###############################################################
# Train One Algorithm
###############################################################


train_algorithm <- function(

        method,

        seed

){


    set.seed(seed)



    Q <-

        create_Q_table()



    reward_history <-

        vector(

            "numeric",

            EPISODES

        )


    KPI_history <-

        list()



    for(ep in seq_len(EPISODES)){



        result <-

            run_episode(

                method,

                Q,

                ep

            )



        Q <-

            result$Q



        reward_history[ep] <-

            sum(

                result$reward

            )



        KPI_history[[ep]] <-

            result$KPI



        if(ep %% 50 == 0){


            cat(

                method,

                "Episode",

                ep,

                "\n"

            )

        }

    }



    list(

        Q = Q,

        reward_history = reward_history,

        KPI_history = KPI_history

    )

}
