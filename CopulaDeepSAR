simulate_independent_demand <- function(
  marginal_means,
  marginal_sds,
  n = 1
){

  demand_sim <- matrix(
    0,
    nrow = n,
    ncol = length(marginal_means)
  )

  for(i in 1:length(marginal_means)){

    demand_sim[, i] <- rnorm(
      n,
      mean = marginal_means[i],
      sd = marginal_sds[i]
    )
  }

  demand_sim <- pmax(
    round(demand_sim),
    0
  )

  return(demand_sim)
}

