# ============================================================
# 8) COPULA DEMAND SIMULATION
# ============================================================

simulate_copula_demand <- function(
  copula_model,
  marginal_means,
  marginal_sds,
  n = 1
){

  U_sim <- rCopula(
    n,
    copula_model
  )

  demand_sim <- matrix(
    0,
    nrow = n,
    ncol = length(marginal_means)
  )

  for(i in 1:length(marginal_means)){

    demand_sim[, i] <- qnorm(
      U_sim[, i],
      mean = marginal_means[i],
      sd = marginal_sds[i]
    )
  }

  demand_sim <- pmax(
    round(demand_sim),
    0
  )

  return(demand_sim)
}

# ============================================================
# 9) SAR-Q INITIALIZATION
# ============================================================

n_actions <- 3

# 0 = Maintain
# 1 = Increase Shipment
# 2 = Reduce Shipment

n_episodes <- 300
n_steps <- 25

alpha <- 0.08
gamma <- 0.96

lambda_spatial <- 0.30
consensus_tau <- 0.08

epsilon_start <- 0.35
epsilon_end <- 0.05

Q <- matrix(
  0,
  nrow = n_regions,
  ncol = n_actions
)

rownames(Q) <- stores

states <- round(
  1.3 * demand_base
)

# ============================================================
# 10) REWARD FUNCTION
# ============================================================

reward_fn <- function(
  inventory,
  demand,
  transport_cost = 0
){

  sales <- pmin(
    inventory,
    demand
  )

  revenue <- 15 * sales

  holding_cost <- 0.08 *
    pmax(inventory - demand, 0)

  shortage_cost <- 0.70 *
    pmax(demand - inventory, 0)

  reward <- revenue -
    holding_cost -
    shortage_cost -
    transport_cost

  return(reward)
}

# ============================================================
# 11) TRANSPORT COST FUNCTION
# ============================================================

transport_cost_fn <- function(
  flow,
  distance = 1
){

  return(
    0.04 *
      abs(flow) *
      distance
  )
}

# ============================================================
# 12) INVENTORY TRANSITION FUNCTION
# ============================================================

next_state_fn <- function(
  inventory,
  actions,
  demand,
  rho = 0.35
){

  n <- length(inventory)

  spatial_inventory <- as.numeric(
    rho * (W %*% inventory)
  )

  action_effect <- rep(0, n)

  for(i in 1:n){

    action_effect[i] <- switch(
      as.character(actions[i]),

      "0" = 0,

      "1" = round(
        0.20 * demand[i]
      ),

      "2" = -round(
        0.20 * demand[i]
      ),

      0
    )
  }

  noise <- rnorm(
    n,
    0,
    pmax(1, 0.08 * demand)
  )

  next_inventory <- inventory +
    spatial_inventory +
    action_effect -
    demand +
    noise

  next_inventory <- pmax(
    round(next_inventory),
    0
  )

  return(next_inventory)
}

# ============================================================
# 13) COPULA-SPATIAL SAR-Q TRAINING
# ============================================================

demand_sd <- apply(
  sales_mat,
  2,
  sd
)

episode_rewards <- matrix(
  0,
  nrow = n_episodes,
  ncol = n_regions
)

cum_reward <- rep(0, n_regions)

action_counts <- matrix(
  0,
  nrow = n_actions,
  ncol = n_regions
)

for(ep in 1:n_episodes){

  s <- states

  eps <- epsilon_start +
    (epsilon_end - epsilon_start) *
    (ep / n_episodes)

  alpha_ep <- alpha *
    (1 / (1 + 0.0005 * ep))

  ep_rewards <- rep(0, n_regions)

  demand_t <- demand_base

  for(t in 1:n_steps){

    # --------------------------------------------------------
    # DEMAND FORECAST
    # --------------------------------------------------------

    demand_forecast <- numeric(n_regions)

    for(i in 1:n_regions){

      demand_forecast[i] <-
        demand_t[i] * demand_phi[i] +
        (1 - demand_phi[i]) *
        demand_base[i]
    }

    # --------------------------------------------------------
    # COPULA DEPENDENT DEMAND
    # --------------------------------------------------------

    copula_demand <- simulate_copula_demand(
      copula_model = copula_model,
      marginal_means = demand_forecast,
      marginal_sds = demand_sd,
      n = 1
    )

    realized_demand <- as.numeric(
      copula_demand[1, ]
    )

    # --------------------------------------------------------
    # ACTION SELECTION
    # --------------------------------------------------------

    actions <- integer(n_regions)

    for(region in 1:n_regions){

      if(runif(1) < eps){

        a <- sample(
          0:(n_actions - 1),
          1
        )

      } else {

        a <- which.max(
          Q[region, ]
        ) - 1
      }

      actions[region] <- a

      action_counts[a + 1, region] <-
        action_counts[a + 1, region] + 1
    }

    # --------------------------------------------------------
    # NEXT INVENTORY STATE
    # --------------------------------------------------------

    s_next <- next_state_fn(
      inventory = s,
      actions = actions,
      demand = realized_demand
    )

    # --------------------------------------------------------
    # Q UPDATE
    # --------------------------------------------------------

    for(region in 1:n_regions){

      neighbors <- which(
        W[region, ] > 0
      )

      transport_cost <- transport_cost_fn(
        flow = actions[region],
        distance = length(neighbors)
      )

      r <- reward_fn(
        inventory = s_next[region],
        demand = realized_demand[region],
        transport_cost = transport_cost
      )

      ep_rewards[region] <-
        ep_rewards[region] + r

      spatial_term <- lambda_spatial *
        sum(
          W[region, ] *
            Q[, actions[region] + 1]
        )

      Q[region, actions[region] + 1] <-
        Q[region, actions[region] + 1] +
        alpha_ep * (
          r +
            gamma * max(Q[region, ]) +
            spatial_term -
            Q[region, actions[region] + 1]
        )
    }

    # --------------------------------------------------------
    # CONSENSUS LEARNING
    # --------------------------------------------------------

    Q_new <- Q

    for(region in 1:n_regions){

      if(sum(W[region, ]) > 0){

        neighbor_Q_mean <- colSums(
          matrix(
            W[region, ],
            nrow = n_regions,
            ncol = n_actions,
            byrow = FALSE
          ) * Q
        ) / sum(W[region, ])

      } else {

        neighbor_Q_mean <- rep(
          0,
          n_actions
        )
      }

      Q_new[region, ] <-
        (1 - consensus_tau) *
        Q[region, ] +
        consensus_tau *
        neighbor_Q_mean
    }

    Q <- Q_new

    s <- s_next

    demand_t <- realized_demand
  }

  episode_rewards[ep, ] <- ep_rewards

  cum_reward <- cum_reward + ep_rewards

  if(ep %% 50 == 0){

    cat(
      sprintf(
        "Episode %d/%d | Mean Reward = %.2f\n",
        ep,
        n_episodes,
        mean(ep_rewards)
      )
    )
  }
}

# ============================================================
# 14) POLICY FORECASTING (2 WEEKS)
# ============================================================

forecast_horizon <- 2

s_current <- states

forecast_inventory <- matrix(
  0,
  nrow = forecast_horizon,
  ncol = n_regions
)

forecast_actions <- matrix(
  0,
  nrow = forecast_horizon,
  ncol = n_regions
)

demand_current <- demand_base

for(t in 1:forecast_horizon){

  actions_sel <- apply(
    Q,
    1,
    which.max
  ) - 1

  demand_pred <- numeric(n_regions)

  for(i in 1:n_regions){

    demand_pred[i] <-
      demand_current[i] * demand_phi[i] +
      (1 - demand_phi[i]) *
      demand_base[i]
  }

  copula_future <- simulate_copula_demand(
    copula_model,
    demand_pred,
    demand_sd,
    n = 1
  )

  future_demand <- as.numeric(
    copula_future[1, ]
  )

  s_next <- next_state_fn(
    inventory = s_current,
    actions = actions_sel,
    demand = future_demand
  )

  forecast_inventory[t, ] <- s_next

  forecast_actions[t, ] <- actions_sel

  s_current <- s_next

  demand_current <- future_demand
}

