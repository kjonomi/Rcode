###############################################################
# k-nearest Neighbor Network
###############################################################


K_NEIGHBORS <- 3



N <- nrow(distance_matrix)



W_matrix <-

    matrix(

        0,

        nrow=N,

        ncol=N

    )





for(i in seq_len(N)){


    neighbor_order <-

        order(

            distance_matrix[i,]

        )



    neighbor_order <-

        neighbor_order[

            neighbor_order != i

        ]



    neighbors <-

        head(

            neighbor_order,

            K_NEIGHBORS

        )


    W_matrix[i,neighbors] <- 1


}






###############################################################
# Distance Decay Weight
###############################################################


for(i in seq_len(N)){


    for(j in seq_len(N)){


        if(

            W_matrix[i,j] == 1

        ){


            W_matrix[i,j] <-

                1 /

                (

                    distance_matrix[i,j]

                    +

                    1e-8

                )


        }


    }


}







###############################################################
# Row Standardization
###############################################################


row_sum <-

    rowSums(
        W_matrix
    )



for(i in seq_len(N)){


    if(row_sum[i] > 0){


        W_matrix[i,] <-

            W_matrix[i,] /

            row_sum[i]


    }else{


        # isolated node protection

        W_matrix[i,i] <- 0


    }


