###############################################################
# PART 10
#
# Spatial Network
#
###############################################################

if (
    !is.null(
        W_matrix
    )
) {

    ###########################################################
    # Convert to numeric matrix
    ###########################################################

    W_matrix <-
        as.matrix(
            W_matrix
        )


    storage.mode(
        W_matrix
    ) <-
        "numeric"


    ###########################################################
    # Remove diagonal
    ###########################################################

    diag(
        W_matrix
    ) <-
        0


    ###########################################################
    # Symmetrize
    ###########################################################

    W_network <-
        (
            W_matrix +
            t(W_matrix)
        ) / 2


    ###########################################################
    # Replace missing values
    ###########################################################

    W_network[
        !is.finite(
            W_network
        )
    ] <-
        0


    ###########################################################
    # Create graph
    ###########################################################

    network_graph <-
        igraph::graph_from_adjacency_matrix(

            W_network,

            mode =
                "undirected",

            weighted =
                TRUE,

            diag =
                FALSE

        )


    ###########################################################
    # Store labels
    ###########################################################

    if (

        !is.null(
            selected_stores
        ) &&

        length(
            selected_stores
        ) ==
        igraph::vcount(
            network_graph
        )

    ) {

        V(
            network_graph
        )$label <-
            as.character(
                selected_stores
            )

    } else {

        V(
            network_graph
        )$label <-
            as.character(
                seq_len(
                    igraph::vcount(
                        network_graph
                    )
                )
            )

    }


    ###########################################################
    # Edge width
    ###########################################################

    edge_weights <-
        E(
            network_graph
        )$weight


    if (
        length(edge_weights) > 0
    ) {

        edge_width <-
            1 +
            4 *
            pmax(
                0,
                abs(
                    edge_weights
                )
            )

    } else {

        edge_width <-
            numeric(0)

    }


    ###########################################################
    # Network plot
    ###########################################################

    png(

        "results/Figure5_SpatialNetwork.png",

        width = 1000,

        height = 800,

        res = 120

    )


    plot(

        network_graph,

        vertex.label =
            V(network_graph)$label,

        vertex.size =
            28,

        vertex.color =
            "lightgray",

        vertex.frame.color =
            "black",

        edge.width =
            edge_width,

        edge.arrow.size =
            0,

        main =
            "Spatial Store Dependence Network"

    )


    dev.off()

}


