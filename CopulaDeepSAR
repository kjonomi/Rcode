forecast_metrics <- function(obs,pred){

    
    obs <- as.numeric(obs)
    
    pred <- as.numeric(pred)
    
    
    data.frame(
        
        RMSE =
            sqrt(
                mean(
                    (obs-pred)^2
                )
            ),
        
        
        MAE =
            mean(
                abs(obs-pred)
            ),
        
        
        MAPE =
            mean(
                abs(obs-pred) /
                    pmax(obs,1)
            )*100,
        
        
        WAPE =
            sum(abs(obs-pred)) /
            pmax(sum(obs),1)
        
    )
    
}




