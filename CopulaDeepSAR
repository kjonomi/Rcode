    ###########################################################
    # Time Series Object
    ###########################################################
    
    y <- ts(
        
        sales_matrix[,i],
        
        frequency=7
        
    )
    
    
    
    ###########################################################
    # Train / Test Split
    ###########################################################
    
    train <- ts(
        
        y[1:train_length],
        
        frequency=7
        
    )
    
    
    
    test <- ts(
        
        y[(train_length+1):length(y)],
        
        frequency=7
        
    )
    
    
    
    
    ###########################################################
    # Models
    ###########################################################
    
    fit_arima <- auto.arima(
        
        train
        
    )
    
    
    fit_ets <- ets(
        
        train
        
    )
    
    
    fit_tbats <- tbats(
        
        train
        
    )
    
    
    
    ###########################################################
    # Theta
    #
    # IMPORTANT:
    # thetaf() directly computes required horizon
    ###########################################################
    
    fit_theta <- thetaf(
        
        train,
        
        h=forecast_horizon
        
    )
    
    
    
    
    ###########################################################
    # Forecasts
    ###########################################################
    
    
    pred_arima <- forecast(
        
        fit_arima,
        
        h=forecast_horizon
        
    )$mean
    
    
    
    pred_ets <- forecast(
        
        fit_ets,
        
        h=forecast_horizon
        
    )$mean
    
    
    
    pred_tbats <- forecast(
        
        fit_tbats,
        
        h=forecast_horizon
        
    )$mean
    
    
    
    pred_theta <- fit_theta$mean
    
    
    
    
    ###########################################################
    # Evaluation
    ###########################################################
    
    
    results <- rbind(
        
        
        cbind(
            
            Model="ARIMA",
            
            forecast_metrics(
                test,
                pred_arima
            )
            
        ),
        
        
        cbind(
            
            Model="ETS",
            
            forecast_metrics(
                test,
                pred_ets
            )
            
        ),
        
        
        cbind(
            
            Model="TBATS",
            
            forecast_metrics(
                test,
                pred_tbats
            )
            
        ),
        
        
        cbind(
            
            Model="Theta",
            
            forecast_metrics(
                test,
                pred_theta
            )
            
        )
        
        
    )
    
    
    
    
    results$Store <- selected_stores[i]
    
    
    
    
    forecast_accuracy <- rbind(
        
        forecast_accuracy,
        
        results
        
    )
    
    
    
    
    ###########################################################
    # Save Models
    ###########################################################
    
    
    forecast_models[[selected_stores[i]]] <- list(
        
        ARIMA=fit_arima,
        
        ETS=fit_ets,
        
        TBATS=fit_tbats,
        
        Theta=fit_theta
        
    )
    
    
    
    
    ###########################################################
    # Demand Parameters for RL Environment
    ###########################################################
    
    
    demand_base[i] <- mean(
        
        train
        
    )
    
    
    
    demand_sd[i] <- sd(
        
        train
        
    )
    
    
}



