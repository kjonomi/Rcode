###############################################################
# 2. CALCULATE 95% CONFIDENCE INTERVALS
###############################################################

# MeanReward is assumed to be the mean across simulation
# replications and SDReward is the corresponding SD.
#
# Therefore:
#
# Standard Error = SD / sqrt(N)
#
# 95% CI = Mean +/- 1.96 * SE

learning_curve <- learning_curve %>%
    mutate(
        NRep = N_REPLICATIONS,

        SEReward =
            SDReward / sqrt(NRep),

        Lower95 =
            MeanReward -
            qnorm(1 - (1 - CONF_LEVEL) / 2) *
            SEReward,

        Upper95 =
            MeanReward +
            qnorm(1 - (1 - CONF_LEVEL) / 2) *
            SEReward
    )

