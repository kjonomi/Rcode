###############################################################
# Forecast Accuracy Function
###############################################################

forecast_metrics <- function(
    obs,
    pred
) {

    obs <- as.numeric(
        obs
    )

    pred <- as.numeric(
        pred
    )

    pred <- pmax(
        pred,
        0
    )

    data.frame(

        RMSE =
            sqrt(
                mean(
                    (
                        obs -
                        pred
                    )^2,
                    na.rm = TRUE
                )
            ),

        MAE =
            mean(
                abs(
                    obs -
                    pred
                ),
                na.rm = TRUE
            ),

        MAPE =
            mean(

                abs(
                    obs -
                    pred
                ) /

                    pmax(
                        abs(obs),
                        1
                    ),

                na.rm = TRUE

            ) * 100,

        WAPE =
            sum(
                abs(
                    obs -
                    pred
                ),
                na.rm = TRUE
            ) /

            pmax(
                sum(
                    abs(obs),
                    na.rm = TRUE
                ),
                1
            )

    )

}


###############################################################
# Forecast Each Store
###############################################################

for (
    i in seq_len(
        N_STORES
    )
) {

    cat(
        "\nForecasting Store:",
        selected_stores[i],
        "\n"
    )


    ###########################################################
    # Time Series Construction
    ###########################################################

    y <- ts(

        sales_matrix[, i],

        frequency = 7

    )


    ###########################################################
    # Train/Test Split
    ###########################################################

    train <- ts(

        y[
            1:train_length
        ],

        frequency = 7

    )


    test <- ts(

        y[
            (train_length + 1):
                length(y)
        ],

        frequency = 7

    )


    ###########################################################
    # Forecast Models
    ###########################################################

    fit_arima <-
        tryCatch(

            auto.arima(
                train
            ),

            error =
                function(e) {

                    cat(
                        "ARIMA failed for Store ",
                        selected_stores[i],
                        ": ",
                        conditionMessage(e),
                        "\n",
                        sep = ""
                    )

                    NULL

                }

        )


    fit_ets <-
        tryCatch(

            ets(
                train
            ),

            error =
                function(e) {

                    cat(
                        "ETS failed for Store ",
                        selected_stores[i],
                        ": ",
                        conditionMessage(e),
                        "\n",
                        sep = ""
                    )

                    NULL

                }

        )


    fit_tbats <-
        tryCatch(

            tbats(
                train
            ),

            error =
                function(e) {

                    cat(
                        "TBATS failed for Store ",
                        selected_stores[i],
                        ": ",
                        conditionMessage(e),
                        "\n",
                        sep = ""
                    )

                    NULL

                }

        )


    fit_theta <-
        tryCatch(

            thetaf(
                train,
                h = forecast_horizon
            ),

            error =
                function(e) {

                    cat(
                        "Theta failed for Store ",
                        selected_stores[i],
                        ": ",
                        conditionMessage(e),
                        "\n",
                        sep = ""
                    )

                    NULL

                }

        )


    ###########################################################
    # Forecast Generation
    ###########################################################

    pred_arima <-
        if (!is.null(fit_arima)) {

            as.numeric(
                forecast(
                    fit_arima,
                    h = forecast_horizon
                )$mean
            )

        } else {

            rep(
                mean(train),
                forecast_horizon
            )

        }


    pred_ets <-
        if (!is.null(fit_ets)) {

            as.numeric(
                forecast(
                    fit_ets,
                    h = forecast_horizon
                )$mean
            )

        } else {

            rep(
                mean(train),
                forecast_horizon
            )

        }


    pred_tbats <-
        if (!is.null(fit_tbats)) {

            as.numeric(
                forecast(
                    fit_tbats,
                    h = forecast_horizon
                )$mean
            )

        } else {

            rep(
                mean(train),
                forecast_horizon
            )

        }


    pred_theta <-
        if (!is.null(fit_theta)) {

            as.numeric(
                fit_theta$mean
            )

        } else {

            rep(
                mean(train),
                forecast_horizon
            )

        }


    ###########################################################
    # Remove Negative Demand
    ###########################################################

    pred_arima <-
        pmax(
            pred_arima,
            0
        )

    pred_ets <-
        pmax(
            pred_ets,
            0
        )

    pred_tbats <-
        pmax(
            pred_tbats,
            0
        )

    pred_theta <-
        pmax(
            pred_theta,
            0
        )


    ###########################################################
    # Forecast Evaluation
    ###########################################################

    store_results <- rbind(

        cbind(
            Model = "ARIMA",
            forecast_metrics(
                test,
                pred_arima
            )
        ),

        cbind(
            Model = "ETS",
            forecast_metrics(
                test,
                pred_ets
            )
        ),

        cbind(
            Model = "TBATS",
            forecast_metrics(
                test,
                pred_tbats
            )
        ),

        cbind(
            Model = "Theta",
            forecast_metrics(
                test,
                pred_theta
            )
        )

    )


    store_results$Store <-
        selected_stores[i]


    forecast_accuracy <-
        rbind(
            forecast_accuracy,
            store_results
        )


###########################################################
# Save Models
###########################################################

forecast_models[[selected_stores[i]]] <-

    list(

        ARIMA = fit_arima,

        ETS = fit_ets,

        TBATS = fit_tbats,

        Theta = fit_theta

    )

    ###########################################################
    # Demand Parameters for SAR-Q
    ###########################################################

    demand_base[i] <-
        mean(
            train,
            na.rm = TRUE
        )


    demand_sd[i] <-
        max(

            sd(
                train,
                na.rm = TRUE
            ),

            MIN_DEMAND_SD

        )


    ###########################################################
    # ARIMA Residuals
    #
    # Input for Copula Dependence Modeling
    ###########################################################

    if (
        !is.null(
            fit_arima
        )
    ) {

        residuals_i <-
            as.numeric(
                residuals(
                    fit_arima
                )
            )

        residual_length <-
            min(
                length(residuals_i),
                train_length
            )

        demand_residuals[
            seq_len(
                residual_length
            ),
            i
        ] <-
            residuals_i[
                seq_len(
                    residual_length
                )
            ]

    }

}


