###############################################################

construct_store_state <- function(

        env,

        store_id

){


    day <-

        min(

            env$day,

            N_DAYS

        )



    ###########################################################
    # Current demand
    ###########################################################

    current_demand <-

        if(day <= N_DAYS){

            sales_matrix[day,store_id]

        }else{

            0

        }



    ###########################################################
    # Network demand
    ###########################################################

    spatial_demand <-

        spatial_demand_feature(

            env$demand

        )[store_id]




    ###########################################################
    # State vector
    ###########################################################

    state <-

        c(

            Inventory =

                env$inventory[store_id]

                /

                MAX_INVENTORY,


            Demand =

                current_demand,


            Forecast =

                ForecastFeature[store_id],


            Volatility =

                VolatilityFeature[store_id],


            SpatialDemand =

                spatial_demand,


            CopulaDependence =

                CopulaFeature[store_id]

        )



    state

}
###############################################################
# State Discretization
###############################################################

discretize_state <- function(

        state_vector

){


    bins <-

        vapply(

            state_vector,

            function(x){


                findInterval(

                    x,

                    seq(

                        -3,

                        3,

                        length.out =
                            STATE_BINS+1

                    ),

                    all.inside=TRUE

                )


            },

            integer(1)

        )



    bins

}
