# Copula Dependence Strength
###############################################################


tau_values <-

    kendall_tau_matrix[

        lower.tri(
            kendall_tau_matrix
        )

    ]



mean_tau <-

    mean(
        tau_values
    )





###############################################################
# Clayton Parameter
###############################################################


clayton_theta <-

    ifelse(

        mean_tau > 0,

        2 *

        mean_tau /

        (1-mean_tau),

        0.1

    )



clayton_theta <-

    max(

        clayton_theta,

        0.1

    )





