###############################################################
# Create Initial Environment
###############################################################

create_environment <- function(){


    env <- list(


        #######################################################
        # Time
        #######################################################

        day = 1,



        #######################################################
        # Inventory level for all stores
        #######################################################

        inventory = rep(

            INITIAL_INVENTORY,

            N_STORES

        ),



        #######################################################
        # Outstanding orders
        #
        # Rows: Stores
        # Columns: Lead time periods
        #######################################################

        pipeline = matrix(

            0,

            nrow=N_STORES,

            ncol=MAX_LEAD_TIME

        ),



        #######################################################
        # Performance tracking
        #######################################################

        reward = rep(

            0,

            N_STORES

        ),



        cost = rep(

            0,

            N_STORES

        ),



        demand = rep(

            0,

            N_STORES

        ),



        sales = rep(

            0,

            N_STORES

        ),



        stockout = rep(

            0,

            N_STORES

        ),



        orders = rep(

            0,

            N_STORES

        )


    )


    return(env)

}
###############################################################
# Reset Episode
###############################################################

reset_environment <- function(){


    create_environment()


}
###############################################################
# Receive Orders
###############################################################

receive_shipments <- function(env){


    arrivals <-

        env$pipeline[,1]



    env$inventory <-

        env$inventory +

        arrivals



    if(MAX_LEAD_TIME > 1){


        env$pipeline[,1:(MAX_LEAD_TIME-1)] <-

            env$pipeline[,2:MAX_LEAD_TIME]

    }



    env$pipeline[,MAX_LEAD_TIME] <-

        0



    env

}
###############################################################
# Place Store Orders
###############################################################

place_orders <- function(

        env,

        actions

){


    order_qty <-

        ACTION_SPACE[actions]



    env$pipeline[,MAX_LEAD_TIME] <-

        env$pipeline[,MAX_LEAD_TIME] +

        order_qty



    env$orders <-

        order_qty



    env

}
###############################################################
# Network Demand Generator
###############################################################

generate_network_demand <- function(day){


    if(day > N_DAYS){


        return(

            rep(

                0,

                N_STORES

            )

        )

    }



    as.numeric(

        sales_matrix[day,]

    )

}
###############################################################
# Inventory Balance
###############################################################

update_inventory <- function(

        env,

        demand

){


    sales <- pmin(

        env$inventory,

        demand

    )



    shortage <-

        demand -

        sales



    env$inventory <-

        env$inventory -

        sales



    env$inventory <-

        env$inventory -

        shortage



    env$sales <-

        sales



    env$demand <-

        demand



    env$stockout <-

        env$stockout +

        as.numeric(

            shortage > 0

        )


    env

}
###############################################################
# Cost Calculation
###############################################################

calculate_reward <- function(env){



    holding <-

        HOLDING_COST *

        pmax(

            env$inventory,

            0

        )



    shortage <-

        SHORTAGE_COST *

        pmax(

            -env$inventory,

            0

        )



    ordering <-

        ORDERING_COST *

        env$orders



    purchasing <-

        PURCHASE_COST *

        env$orders



    total_cost <-

        holding +

        shortage +

        ordering +

        purchasing



    reward <-

        -total_cost



    env$cost <-

        env$cost +

        total_cost



    env$reward <-

        env$reward +

        reward



    reward

}
###############################################################
# Environment Transition
###############################################################

environment_step <- function(

        env,

        actions

){


    ###########################################################
    # Receive previous orders
    ###########################################################

    env <-

        receive_shipments(env)



    ###########################################################
    # New orders
    ###########################################################

    env <-

        place_orders(

            env,

            actions

        )



    ###########################################################
    # Demand realization
    ###########################################################

    demand <-

        generate_network_demand(

            env$day

        )



    ###########################################################
    # Inventory update
    ###########################################################

    env <-

        update_inventory(

            env,

            demand

        )



    ###########################################################
    # Reward
    ###########################################################

    reward <-

        calculate_reward(

            env

        )



    ###########################################################
    # Advance time
    ###########################################################

    env$day <-

        env$day + 1



    done <-

        env$day > N_DAYS



    list(

        env = env,

        reward = reward,

        done = done,

        demand = demand

    )

}
###############################################################
# Network Performance Summary
###############################################################

network_KPI <- function(env){


    fill_rate <-

        sum(env$sales) /

        pmax(

            sum(env$demand),

            1

        )



    data.frame(

        TotalReward = sum(env$reward),

        TotalCost = sum(env$cost),

        FillRate = fill_rate,

        TotalStockouts = sum(env$stockout),

        MeanInventory = mean(env$inventory)

    )

}
