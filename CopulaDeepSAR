generate_scenario_demand <- function(
    scenario
){

    if(scenario=="Normal"){

        sd_factor <- 1

    }else if(scenario=="HighVolatility"){

        sd_factor <- 2

    }else if(scenario=="ExtremeVolatility"){

        sd_factor <- 3

    }else if(scenario=="DemandShock"){

        shock <- runif(1,1.5,2.5)

        demand <- demand_base*shock +
            rnorm(
                N_STORES,
                0,
                demand_sd
            )

        return(
            pmax(
                round(demand),
                0
            )
        )

    }else{

        stop("Unknown scenario")

    }


    demand <- demand_base +
        rnorm(
            N_STORES,
            0,
            demand_sd*sd_factor
        )


    pmax(
        round(demand),
        0
    )

}




