benchmark_test <- function(

        metric,

        m1,

        m2

){


    x <-

        benchmark_results %>%

        filter(

            Method==m1

        ) %>%

        pull(

            metric

        )



    y <-

        benchmark_results %>%

        filter(

            Method==m2

        ) %>%

        pull(

            metric

        )



    wilcox <-

        wilcox.test(

            x,

            y

        )



    effect <-

        cliff.delta(

            x,

            y

        )


    data.frame(

        Model1=m1,

        Model2=m2,

        Metric=metric,

        PValue=wilcox$p.value,

        CliffDelta=

            effect$estimate

    )

}
