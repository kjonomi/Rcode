        demand <- demand_base*shock +
            rnorm(
                N_STORES,
                0,
                demand_sd
            )

        return(
            pmax(
                round(demand),
                0
            )
        )

    }else{

        stop("Unknown scenario")

    }


    demand <- demand_base +
        rnorm(
            N_STORES,
            0,
            demand_sd*sd_factor
        )


    pmax(
        round(demand),
        0
    )

}




