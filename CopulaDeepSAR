###############################################################
# 15. Environment Transition
###############################################################

environment_step <- function(
    environment,
    shipment,
    copula = environment$copula
){

    ###########################################################
    # Generate Demand
    ###########################################################

    demand <- generate_demand(copula)

    ###########################################################
    # Inventory Transition
    ###########################################################

    transition <- inventory_step(

        inventory = environment$inventory,

        pipeline = environment$pipeline,

        shipment = shipment,

        demand = demand

    )

    ###########################################################
    # Reward
    ###########################################################

    reward_result <- compute_reward(

        demand = demand,

        inventory = environment$inventory,

        shipment = shipment

    )

    ###########################################################
    # Update Environment
    ###########################################################

    environment$inventory <- transition$inventory

    environment$pipeline <- transition$pipeline

    environment$day <- environment$day + 1

    ###########################################################
    # Return
    ###########################################################

    list(

        environment = environment,

        demand = demand,

        sales = transition$sales,

        lost_sales = transition$lost_sales,

        reward = sum(reward_result$reward)

    )

}



###############################################################
# 15. Environment Step
###############################################################


environment_step <- function(
        
        env,
        
        action_vector,
        
        copula_model=best_copula
        
){
    
    
    shipment <- round(
        
        env$inventory *
            
            action_vector
        
    )
    
    
    
    demand <- generate_demand(
        
        copula_model
        
    )
    
    
    
    transition <- inventory_step(
        
        env$inventory,
        
        env$pipeline,
        
        shipment,
        
        demand
        
    )
    
    
    
    reward_output <- compute_reward(
        
        demand,
        
        env$inventory,
        
        shipment
        
    )
    
    
    
    next_env <- list(
        
        inventory=transition$inventory,
        
        pipeline=transition$pipeline,
        
        time=env$time+1,
        
        total_reward=
            
            env$total_reward +
            
            sum(
                reward_output$reward
            )
        
    )
    
    
    
    list(
        
        state=create_state(
            
            next_env$inventory
            
        ),
        
        reward=sum(
            
            reward_output$reward
            
        ),
        
        environment=next_env,
        
        demand=demand,
        
        sales=transition$sales,
        
        lost_sales=transition$lost_sales
        
    )
    
}





