###############################################################
# Kendall Tau Matrix
###############################################################


cat(
"Computing Kendall dependence matrix...\n"
)



kendall_tau_matrix <-

    cor(

        pseudo_obs,

        method="kendall"

    )





###############################################################
# Diagonal Correction
###############################################################


diag(
    kendall_tau_matrix
) <- 1





###############################################################
# Positive Definite Adjustment
###############################################################


eigen_values <-

    eigen(

        kendall_tau_matrix,

        symmetric=TRUE

    )$values



cat(

"Minimum eigenvalue:",

min(eigen_values),

"\n"

)



if(
    min(eigen_values) <= 0
){


    library(Matrix)


    kendall_tau_matrix <-

        as.matrix(

            nearPD(

                kendall_tau_matrix

            )$mat

        )


}







###############################################################
# Gaussian Copula Correlation
#
# rho = sin(pi*tau/2)
###############################################################


gaussian_dependence_matrix <-

    sin(

        pi *

        kendall_tau_matrix /

        2

    )



diag(
    gaussian_dependence_matrix
) <- 1






###############################################################
# Copula Dependence Strength
###############################################################


tau_values <-

    kendall_tau_matrix[

        lower.tri(
            kendall_tau_matrix
        )

    ]



mean_tau <-

    mean(
        tau_values
    )





###############################################################
# Clayton Parameter
###############################################################


clayton_theta <-

    ifelse(

        mean_tau > 0,

        2 *

        mean_tau /

        (1-mean_tau),

        0.1

    )



clayton_theta <-

    max(

        clayton_theta,

        0.1

    )





###############################################################
# Gumbel Parameter
###############################################################


gumbel_theta <-

    1 /

    max(

        1-mean_tau,

        0.01

    )



gumbel_theta <-

    max(

        gumbel_theta,

        1.01

    )







