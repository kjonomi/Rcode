# 6. SCENARIO DEMAND GENERATOR
###############################################################

generate_scenario_demand <- function(
    scenario,
    day,
    demand_multiplier = 1
) {

    base <-
        as.numeric(
            sales_matrix[day, ]
        )

    ###########################################################
    # Normal
    ###########################################################

    if (
        scenario == "Normal"
    ) {

        return(
            pmax(
                round(
                    base *
                    demand_multiplier
                ),
                0
            )
        )
    }

    ###########################################################
    # High volatility
    ###########################################################

    if (
        scenario == "High_Volatility"
    ) {

        volatility_factor <-
            rlnorm(
                N_STORES,
                meanlog = 0,
                sdlog = 0.30
            )

        return(
            pmax(
                round(
                    base *
                    volatility_factor *
                    demand_multiplier
                ),
                0
            )
        )
    }

    ###########################################################
    # Demand shock
    ###########################################################

    if (
        scenario == "Demand_Shock"
    ) {

        shock <-
            ifelse(
                day %% 30 == 0,
                2,
                1
            )

        return(
            pmax(
                round(
                    base *
                    shock *
                    demand_multiplier
                ),
                0
            )
        )
    }

    ###########################################################
    # Long lead time
    ###########################################################

    if (
        scenario == "Long_Lead_Time"
    ) {

        return(
            pmax(
                round(
                    base *
                    demand_multiplier
                ),
                0
            )
        )
    }

    ###########################################################
    # Low service level
    ###########################################################

    if (
        scenario == "Low_Service_Level"
    ) {

        return(
            pmax(
                round(
                    base *
                    demand_multiplier
                ),
                0
            )
        )
    }

    ###########################################################
    # High service level
    ###########################################################

    if (
        scenario == "High_Service_Level"
    ) {

        return(
            pmax(
                round(
                    base *
                    demand_multiplier
                ),
                0
            )
        )
    }

    ###########################################################
    # Default
    ###########################################################

    return(
        pmax(
            round(
                base *
                demand_multiplier
            ),
            0
        )
    )
}

