N_ACTIONS <- length(actions)




###############################################################
# 3. State Scaling
###############################################################

scale_state <- function(state){
    
    
    state <- as.numeric(state)
    
    
    state[is.na(state)] <- 0
    
    
    
    if(length(state) != N_FEATURES){
        
        
        stop(
            paste(
                "State length mismatch:",
                length(state),
                "Expected:",
                N_FEATURES
            )
        )
        
    }
    
    
    
    sd_value <- sd(state)
    
    
    if(
        is.na(sd_value) ||
        sd_value==0
    ){
        
        return(
            rep(
                0,
                length(state)
            )
        )
        
    }
    
    
    (state-mean(state)) /
        
        (sd_value+1e-8)
    
}




###############################################################
# 4. Agent Initialization
###############################################################

initialize_agent <- function(
        
        algorithm="LASARQ"
        
){
    
    
    list(
        
        Algorithm=algorithm,
        
        
        weights=
            
            matrix(
                
                0,
                
                nrow=N_FEATURES,
                
                ncol=N_ACTIONS
                
            )
        
    )
    
}




###############################################################
# 5. Q Value Calculation
###############################################################

calculate_q_values <- function(
        
        agent,
        
        state
        
){
    
    
    state <- as.numeric(state)
    
    
    as.numeric(
        
        t(state) %*%
            
            agent$weights
        
    )
    
}




###############################################################
# 6. Action Selection
###############################################################

select_action <- function(
        
        agent,
        
        state,
        
        epsilon=0.1
        
){
    
    
    q_values <- calculate_q_values(
        
        agent,
        
        state
        
    )
    
    
    
    if(runif(1)<epsilon){
        
        
        sample(
            
            seq_len(N_ACTIONS),
            
            1
            
        )
        
        
    }else{
        
        
        which.max(q_values)
        
        
    }
    
}





###############################################################
# 7. Q-Learning Update
###############################################################

update_qlearning <- function(
        
        agent,
        
        state,
        
        action,
        
        reward,
        
        next_state,
        
        alpha,
        
        gamma
        
){
    
    
    q_current <-
        
        sum(
            
            state *
                
                agent$weights[,action]
            
        )
    
    
    
    q_next <- max(
        
        calculate_q_values(
            
            agent,
            
            next_state
            
        )
        
    )
    
    
    
    td_error <-
        
        reward +
        
        gamma*q_next -
        
        q_current
    
    
    
    agent$weights[,action] <-
        
        agent$weights[,action] +
        
        alpha *
        
        td_error *
        
        state
    
    
    agent
    
}





###############################################################
# 8. SAR-Q Update
###############################################################

update_sarq <- function(
        
        agent,
        
        state,
        
        action,
        
        reward,
        
        next_state,
        
        alpha,
        
        gamma
        
){
    
    
    next_q <- calculate_q_values(
        
        agent,
        
        next_state
        
    )
    
    
    
    next_action <- which.max(
        
        next_q
        
    )
    
    
    
    td_error <-
        
        reward +
        
        gamma *
        
        next_q[next_action] -
        
        sum(
            
            state *
                
                agent$weights[,action]
            
        )
    
    
    
    agent$weights[,action] <-
        
        agent$weights[,action] +
        
        alpha *
        
        td_error *
        
        state
    
    
    
    agent
    
}





###############################################################
# 9. LASAR-Q Update
###############################################################

update_lasarq <- function(
        
        agent,
        
        state,
        
        action,
        
        reward,
        
        next_state,
        
        alpha,
        
        gamma
        
){
    
    
    q_current <-
        
        sum(
            
            state *
                
                agent$weights[,action]
            
        )
    
    
    
    next_q <- calculate_q_values(
        
        agent,
        
        next_state
        
    )
    
    
    
    next_action <- which.max(
        
        next_q
        
    )
    
    
    
    td_error <-
        
        reward +
        
        gamma *
        
        next_q[next_action] -
        
        q_current
    
    
    
    agent$weights[,action] <-
        
        agent$weights[,action] +
        
        alpha *
        
        td_error *
        
        state
    
    
    
    agent
    
}





###############################################################
# 10. Double SAR-Q Update
###############################################################

update_double_sarq <- function(
        
        agent,
        
        state,
        
        action,
        
        reward,
        
        next_state,
        
        alpha,
        
        gamma
        
){
    
    
    if(is.null(agent$weights2)){
        
        
        agent$weights2 <- agent$weights
        
    }
    
    
    
    if(runif(1)<0.5){
        
        
        next_action <- which.max(
            
            calculate_q_values(
                
                agent,
                
                next_state
                
            )
            
        )
        
        
        
        target <-
            
            reward +
            
            gamma *
            
            sum(
                
                next_state *
                    
                    agent$weights2[,next_action]
                
            )
        
        
        current <-
            
            sum(
                
                state *
                    
                    agent$weights[,action]
                
            )
        
        
        td_error <- target-current
        
        
        
        agent$weights[,action] <-
            
            agent$weights[,action] +
            
            alpha *
            
            td_error *
            
            state
        
        
    }else{
        
        
        next_action <- which.max(
            
            calculate_q_values(
                
                list(
                    
                    weights=agent$weights2
                    
                ),
                
                next_state
                
            )
            
        )
        
        
        target <-
            
            reward +
            
            gamma *
            
            sum(
                
                next_state *
                    
                    agent$weights[,next_action]
                
            )
        
        
        current <-
            
            sum(
                
                state *
                    
                    agent$weights2[,action]
                
            )
        
        
        td_error <- target-current
        
        
        
        agent$weights2[,action] <-
            
            agent$weights2[,action] +
            
            alpha *
            
            td_error *
            
            state
        
    }
    
    
    
    agent
    
}




###############################################################
# 11. Update Dispatcher
###############################################################

update_agent <- function(
        
        agent,
        
        algorithm,
        
        state,
        
        action,
        
        reward,
        
        next_state,
        
        alpha=0.01,
        
        gamma=0.95
        
){
    
    
    switch(
        
        algorithm,
        
        
        QLearning =
            update_qlearning(
                agent,
                state,
                action,
                reward,
                next_state,
                alpha,
                gamma
            ),
        
        
        SARQ =
            update_sarq(
                agent,
                state,
                action,
                reward,
                next_state,
                alpha,
                gamma
            ),
        
        
        LASARQ =
            update_lasarq(
                agent,
                state,
                action,
                reward,
                next_state,
                alpha,
                gamma
            ),
        
        
        DoubleSARQ =
            update_double_sarq(
                agent,
                state,
                action,
                reward,
                next_state,
                alpha,
                gamma
            )
        
    )
    
}

###############################################################
# 12. Training Engine
###############################################################

train_linear_agent <- function(
    
    algorithm,
    
    copula_model = "Gaussian",
    
    episodes = 1000,
    
    alpha = 0.01,
    
    gamma = 0.95,
    
    epsilon = 0.30
    
){
    
    agent <- initialize_agent(
        algorithm
    )
    
    
    reward_history <- numeric(
        episodes
    )
    
    
    
    for(ep in seq_len(episodes)){
        
        
        #######################################################
        # Initialize environment
        # Current initialize_environment()
        # does not use copula argument
        #######################################################
        
        env <- initialize_environment()
        
        
        total_reward <- 0
        
        
        
        for(step in 1:50){
            
            
            state <- scale_state(
                
                create_state(
                    env$inventory
                )
                
            )
            
            
            
            action <- select_action(
                
                agent,
                
                state,
                
                epsilon
                
            )
            
            
            
            ###################################################
            # Environment transition
            # Current environment_step()
            # does not use copula argument
            ###################################################
            
            result <- environment_step(
                
                env,
                
                rep(
                    actions[action],
                    N_STORES
                )
                
            )
            
            
            
            next_state <- scale_state(
                
                result$state
                
            )
            
            
            
            agent <- update_agent(
                
                agent,
                
                algorithm,
                
                state,
                
                action,
                
                result$reward,
                
                next_state,
                
                alpha,
                
                gamma
                
            )
            
            
            
            env <- result$environment
            
            
            
            total_reward <- total_reward +
                
                result$reward
            
        }
        
        
        
        reward_history[ep] <- total_reward
        
        
        
        epsilon <- max(
            
            0.01,
            
            epsilon * 0.995
            
        )
        
        
    }
    
    
    
    list(
        
        agent = agent,
        
        RewardHistory = reward_history,
        
        MeanReward = mean(reward_history),
        
        Copula = copula_model
        
    )
    
}



