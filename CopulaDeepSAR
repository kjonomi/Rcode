        method="kendall"

    )





###############################################################
# Diagonal Correction
###############################################################


diag(
    kendall_tau_matrix
) <- 1





###############################################################
# Positive Definite Adjustment
###############################################################


eigen_values <-

    eigen(

        kendall_tau_matrix,

        symmetric=TRUE

    )$values



cat(

"Minimum eigenvalue:",

min(eigen_values),

"\n"

)



if(
    min(eigen_values) <= 0
){


    library(Matrix)


    kendall_tau_matrix <-

        as.matrix(

            nearPD(

                kendall_tau_matrix

            )$mat

        )


}







###############################################################
# Gaussian Copula Correlation
#
# rho = sin(pi*tau/2)
###############################################################


gaussian_dependence_matrix <-

    sin(

        pi *

        kendall_tau_matrix /

        2

    )



diag(
    gaussian_dependence_matrix
) <- 1






