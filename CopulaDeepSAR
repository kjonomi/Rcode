# 10. Copula Demand Generator
###############################################################

simulate_copula_demand <- function(

    copula_model,

    mu,

    sigma

){


    ###########################################################
    # Generate Uniform Dependence
    ###########################################################

    U_sim <-

        simulate_copula_uniform(

            copula_model,

            n=1

        )




    ###########################################################
    # Convert Uniform to Normal Demand Shock
    ###########################################################

    Z <-

        qnorm(

            pmin(

                pmax(

                    U_sim,

                    1e-8

                ),

                1-1e-8

            )

        )




    ###########################################################
    # Demand
    ###########################################################

    demand <-

        mu +

        sigma * Z



    demand <-

        round(demand)



    demand <-

        pmax(

            demand,

            0

        )



    as.numeric(
        demand
    )


}





