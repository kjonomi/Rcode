bootstrap_difference <- function(
    data,
    indices
) {

    d <-
        data$Difference[
            indices
        ]

    mean(
        d,
        na.rm = TRUE
    )
}

###############################################################
# 34. BOOTSTRAP COMPARISON FUNCTION
###############################################################

bootstrap_model_difference <- function(
    metric,
    model1,
    model2,
    R = BOOT_R
) {

    x <-
        metric %>%

        filter(
            Method == model1
        ) %>%

        select(
            Replication,
            value
        ) %>%

        arrange(
            Replication
        )

    y <-
        metric %>%

        filter(
            Method == model2
        ) %>%

        select(
            Replication,
            value
        ) %>%

        arrange(
            Replication
        )

    ###########################################################
    # Verify pairing
    ###########################################################

    if (
        !identical(
            x$Replication,
            y$Replication
        )
    ) {

        stop(
            paste0(
                "Replication IDs do not match between ",
                model1,
                " and ",
                model2,
                "."
            )
        )

    }

    ###########################################################
    # Difference dataset
    ###########################################################

    difference_data <-
        data.frame(

            Replication =
                x$Replication,

            Difference =
                x$value -
                y$value

        )

    ###########################################################
    # Bootstrap
    ###########################################################

    boot_result <-
        boot(
            data =
                difference_data,

            statistic =
                bootstrap_difference,

            R = R
        )

    ###########################################################
    # Percentile confidence interval
    ###########################################################

    boot_ci <-
        boot.ci(
            boot_result,
            type = "perc"
        )

    ###########################################################
    # Return summary
    ###########################################################

    data.frame(

        Model1 =
            model1,

        Model2 =
            model2,

        N =
            nrow(
                difference_data
            ),

        ObservedMeanDifference =
            mean(
                difference_data$Difference,
                na.rm = TRUE
            ),

        BootstrapMeanDifference =
            mean(
                boot_result$t,
                na.rm = TRUE
            ),

        CI_Lower =
            boot_ci$percent[4],

        CI_Upper =
            boot_ci$percent[5]

    )
}

