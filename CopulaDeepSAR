###############################################################
# 13. Inventory Transition
###############################################################


inventory_step <- function(
        
        inventory,
        
        pipeline,
        
        shipment,
        
        demand
        
){
    
    
    arriving <- pipeline[,1]
    
    
    inventory <- inventory + arriving
    
    
    
    if(LEAD_TIME > 1){
        
        pipeline <-
            
            cbind(
                
                pipeline[,-1,drop=FALSE],
                
                rep(0,N_STORES)
                
            )
        
    }
    
    
    
    pipeline[,LEAD_TIME] <- shipment
    
    
    
    inventory <- pmin(
        
        inventory,
        
        MAX_CAPACITY
        
    )
    
    
    
    sales <- pmin(
        
        inventory,
        
        demand
        
    )
    
    
    
    lost_sales <- pmax(
        
        demand-sales,
        
        0
        
    )
    
    
    
    inventory <- inventory-sales
    
    
    
    list(
        
        inventory=inventory,
        
        pipeline=pipeline,
        
        sales=sales,
        
        lost_sales=lost_sales
        
    )
    
}


