###############################################################
# Q Table Functions
###############################################################


create_Q_table <- function(){

    new.env(

        hash=TRUE,

        parent=emptyenv()

    )

}



initialize_Q_state <- function(

        Q,

        state_id

){


    key <-

        as.character(state_id)



    if(

        !exists(

            key,

            envir=Q,

            inherits=FALSE

        )

    ){

        assign(

            key,

            rep(

                0,

                N_ACTIONS

            ),

            envir=Q

        )

    }

}
###############################################################
# Q Access
###############################################################


get_Q <- function(

        Q,

        state_id

){

    initialize_Q_state(

        Q,

        state_id

    )


    get(

        as.character(state_id),

        envir=Q

    )

}



set_Q <- function(

        Q,

        state_id,

        value

){


    assign(

        as.character(state_id),

        value,

        envir=Q

    )

}
###############################################################
# Action Selection
###############################################################


epsilon_greedy <- function(

        Q,

        state_id,

        epsilon

){


    q_values <-

        get_Q(

            Q,

            state_id

        )


    if(

        runif(1)<epsilon

    ){

        return(

            sample(

                seq_len(N_ACTIONS),

                1

            )

        )

    }


    best <-

        which(

            q_values==max(q_values)

        )


    sample(

        best,

        1

    )

}
###############################################################
# Spatial Neighbor Value
###############################################################


spatial_value <- function(

        Q,

        env,

        store_id

){


    value <- 0



    neighbors <-

        which(

            W_matrix[store_id,] > 0

        )



    for(j in neighbors){


        state_j <-

            environment_state_index(

                env,

                j

            )


        q_j <-

            get_Q(

                Q,

                state_j

            )



        value <-

            value +

            W_matrix[store_id,j] *

            max(q_j)

    }


    value

}
###############################################################
# Adaptive Spatial Parameter
###############################################################


adaptive_lambda <- function(

        store_id

){


    dependence <-

        CopulaFeature[store_id]



    lambda <-

        LAMBDA_SPATIAL *

        (

            1 +

            LAMBDA_COPULA *

            dependence

        )



    min(

        max(

            lambda,

            0

        ),

        1

    )

}
###############################################################
# Q-Learning Update
###############################################################


update_Q_learning <- function(

        Q,

        state,

        action,

        reward,

        next_state

){


    q <-

        get_Q(

            Q,

            state

        )



    q_next <-

        get_Q(

            Q,

            next_state

        )



    target <-

        reward +

        GAMMA *

        max(q_next)



    q[action] <-

        q[action] +

        ALPHA *

        (

            target -

            q[action]

        )



    set_Q(

        Q,

        state,

        q

    )



    Q

}
###############################################################
# SAR-Q Update
###############################################################


update_SARQ <- function(

        Q,

        env,

        store_id,

        state,

        action,

        reward,

        next_state

){


    q <-

        get_Q(

            Q,

            state

        )


    q_next <-

        get_Q(

            Q,

            next_state

        )



    own_value <-

        max(q_next)



    neighbor_value <-

        spatial_value(

            Q,

            env,

            store_id

        )



    target <-

        reward +

        GAMMA *

        (

            (1-LAMBDA_SPATIAL)

            *

            own_value

            +

            LAMBDA_SPATIAL

            *

            neighbor_value

        )



    q[action] <-

        q[action]

        +

        ALPHA *

        (

            target-q[action]

        )



    set_Q(

        Q,

        state,

        q

    )


    Q

}
###############################################################
# LASAR-Q Update
###############################################################


update_LASARQ <- function(

        Q,

        env,

        store_id,

        state,

        action,

        reward,

        next_state

){


    q <-

        get_Q(

            Q,

            state

        )



    q_next <-

        get_Q(

            Q,

            next_state

        )



    own_value <-

        max(q_next)



    neighbor_value <-

        spatial_value(

            Q,

            env,

            store_id

        )



    lambda_i <-

        adaptive_lambda(

            store_id

        )



    target <-

        reward +

        GAMMA *

        (

            (1-lambda_i)

            *

            own_value

            +

            lambda_i

            *

            neighbor_value

        )



    q[action] <-

        q[action]

        +

        ALPHA *

        (

            target-q[action]

        )



    set_Q(

        Q,

        state,

        q

    )


    Q

}
###############################################################
# Algorithm Selector
###############################################################


RL_update <- function(

        method,

        Q,

        env,

        store_id,

        state,

        action,

        reward,

        next_state

){


    if(method=="Q-Learning"){


        return(

            update_Q_learning(

                Q,

                state,

                action,

                reward,

                next_state

            )

        )

    }



    if(method=="SAR-Q"){


        return(

            update_SARQ(

                Q,

                env,

                store_id,

                state,

                action,

                reward,

                next_state

            )

        )

    }



    if(method=="LASAR-Q"){


        return(

            update_LASARQ(

                Q,

                env,

                store_id,

                state,

                action,

                reward,

                next_state

            )

        )

    }

}
