evaluate_scenario <- function(

    agent,

    scenario,

    lead_time=2,

    service_level=.95,

    copula=TRUE,

    episodes=100

){



    assign(

        "LEAD_TIME",

        lead_time,

        envir=.GlobalEnv

    )



    assign(

        "SERVICE_LEVEL",

        service_level,

        envir=.GlobalEnv

    )



    rewards <- numeric(episodes)



    for(ep in seq_len(episodes)){


        env <-


            initialize_environment()



        total <- 0



        for(step in 1:50){



            state <-


                scale_state(

                    create_state(

                        env$inventory

                    )[1,]

                )



            action <-


                select_action(

                    agent,

                    state,

                    0

                )



            result <-


                environment_step_robust(

                    env,

                    rep(

                        actions[action],

                        N_STORES

                    ),

                    scenario,

                    copula

                )



            env <-


                result$environment



            total <-


                total +

                result$reward


        }



        rewards[ep] <- total

    }



    data.frame(

        Scenario=scenario,

        LeadTime=lead_time,

        ServiceLevel=service_level,

        Copula=copula,

        MeanReward=mean(rewards),

        SD=sd(rewards)

