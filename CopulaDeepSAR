###############################################################
# 9. Copula Simulation Function
###############################################################

simulate_copula_uniform <- function(

    copula_model,

    n=1

){


    ###########################################################
    # Validation
    ###########################################################

    if(is.null(copula_model)){


        stop(
            "simulate_copula_uniform(): Copula model is NULL"
        )


    }



    ###########################################################
    # Vine Copula
    ###########################################################

    if(

        inherits(
            copula_model,
            "RVineMatrix"
        )

    ){


        out <-

            RVineSim(

                n,

                copula_model

            )



    }else{


        #######################################################
        # Parametric Copula
        #######################################################

        out <-

            rCopula(

                n,

                copula_model

            )


    }



    return(

        as.matrix(out)

    )


}





###############################################################
# 10. Copula Demand Generator
###############################################################

simulate_copula_demand <- function(

    copula_model,

    mu,

    sigma

){


    ###########################################################
    # Generate Uniform Dependence
    ###########################################################

    U_sim <-

        simulate_copula_uniform(

            copula_model,

            n=1

        )




    ###########################################################
    # Convert Uniform to Normal Demand Shock
    ###########################################################

    Z <-

        qnorm(

            pmin(

                pmax(

                    U_sim,

                    1e-8

                ),

                1-1e-8

            )

        )




    ###########################################################
    # Demand
    ###########################################################

    demand <-

        mu +

        sigma * Z



    demand <-

        round(demand)



    demand <-

        pmax(

            demand,

            0

        )



    as.numeric(
        demand
    )


}





