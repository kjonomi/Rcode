    ###########################################################
    # Demand trend
    ###########################################################
    
    
    demand_trend <- sapply(
        
        seq_len(N_STORES),
        
        function(i){
            
            
            y <- tail(
                
                sales_matrix[,i],
                
                30
                
            )
            
            
            coef(
                
                lm(
                    
                    y ~ seq_along(y)
                    
                )
                
            )[2]
            
            
        }
        
    )
    
    
    
    
    ###########################################################
    # State Vector
    ###########################################################
    
    
    state <- c(
        
        inventory,
        
        forecast,
        
        demand_sd,
        
        safety_stock,
        
