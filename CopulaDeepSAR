generate_copula_feature <- function(
    copula_name
) {

    ###########################################################
    # Gaussian
    ###########################################################

    if (
        copula_name == "Gaussian"
    ) {

        return(
            safe_scale(
                rowMeans(
                    copula_matrix,
                    na.rm = TRUE
                )
            )
        )
    }

    ###########################################################
    # Clayton
    ###########################################################

    if (
        copula_name == "Clayton"
    ) {

        return(
            safe_scale(
                rowMeans(
                    copula_matrix^2,
                    na.rm = TRUE
                )
            )
        )
    }

    ###########################################################
    # Gumbel
    ###########################################################

    if (
        copula_name == "Gumbel"
    ) {

        return(
            safe_scale(
                rowMeans(
                    -log(
                        pmax(
                            copula_matrix,
                            1e-8
                        )
                    ),
                    na.rm = TRUE
                )
            )
        )
    }

    stop(
        paste(
            "Unknown copula:",
            copula_name
        )
    )
