    )



    demand_cor <-

        cor(

            sales_matrix,

            method="pearson",

            use="pairwise.complete.obs"

        )



    ###########################################################
    # Handle NA correlation
    ###########################################################


    demand_cor[

        is.na(demand_cor)

    ] <- 0



    distance_matrix <-

        1 -

        abs(
            demand_cor
        )



    diag(
        distance_matrix
    ) <- 0



