# 13) COPULA-SPATIAL SAR-Q TRAINING
# ============================================================

demand_sd <- apply(
  sales_mat,
  2,
  sd
)

episode_rewards <- matrix(
  0,
  nrow = n_episodes,
  ncol = n_regions
