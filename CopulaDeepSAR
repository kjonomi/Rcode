# ============================================================
# 10) REWARD FUNCTION
# ============================================================

reward_fn <- function(
  inventory,
  demand,
  transport_cost = 0
){

  sales <- pmin(
    inventory,
    demand
  )

  revenue <- 15 * sales

  holding_cost <- 0.08 *
    pmax(inventory - demand, 0)

  shortage_cost <- 0.70 *
    pmax(demand - inventory, 0)

  reward <- revenue -
    holding_cost -
    shortage_cost -
    transport_cost

  return(reward)
}

# ============================================================
# 11) TRANSPORT COST FUNCTION
# ============================================================

transport_cost_fn <- function(
  flow,
  distance = 1
){

  return(
    0.04 *
      abs(flow) *
      distance
  )
}

# ============================================================
# 12) INVENTORY TRANSITION FUNCTION
# ============================================================

next_state_fn <- function(
  inventory,
  actions,
  demand,
  rho = 0.35
){

  n <- length(inventory)

  spatial_inventory <- as.numeric(
    rho * (W %*% inventory)
  )

  action_effect <- rep(0, n)

  for(i in 1:n){

    action_effect[i] <- switch(
      as.character(actions[i]),

      "0" = 0,

      "1" = round(
        0.20 * demand[i]
      ),

      "2" = -round(
        0.20 * demand[i]
      ),

      0
    )
  }

  noise <- rnorm(
    n,
    0,
    pmax(1, 0.08 * demand)
  )

  next_inventory <- inventory +
    spatial_inventory +
    action_effect -
    demand +
    noise

  next_inventory <- pmax(
    round(next_inventory),
    0
  )

  return(next_inventory)
}

