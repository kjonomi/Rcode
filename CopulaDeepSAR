###############################################################
# 9. Copula Simulation Function (UPDATED)
###############################################################

simulate_copula_uniform <- function(
    
    copula_model,
    
    n=1
    
){
    
    
    ###########################################################
    # Vine Copula
    ###########################################################
    
    if(
        inherits(
            copula_model,
            "RVineMatrix"
        )
    ){
        
        
        out <-
            
            RVineSim(
                N=n,
                RVM=copula_model
            )
        
        
    }
    
    
    ###########################################################
    # Standard Copula
    ###########################################################
    
    else{
        
        
        if(is.null(copula_model)){
            
            
            stop(
                "Copula model is NULL"
            )
            
            
        }
        
        
        out <-
            
            rCopula(
                n,
                copula_model
            )
        
        
    }
    
    
    
    
    
    matrix(
        
        out,
        
        nrow=n,
        
        ncol=DIM
        
    )
    
    
}





###############################################################
# 10. Copula Demand Generator (UPDATED)
###############################################################

simulate_copula_demand <- function(
    
    copula_model,
    
    mu,
    
    sigma
    
){
    
    
    U_sim <-
        
        simulate_copula_uniform(
            
            copula_model,
            
            n=1
            
        )
    
    
    
    
    U_sim <-
        
        pmin(
            
            pmax(
                
                U_sim,
                
                1e-8
                
            ),
            
            1-1e-8
            
        )
    
    
    
    
    Z <-
        
        qnorm(
            
            U_sim
            
        )
    
    
    
    
    demand <-
        
        mu +
        
        sigma*Z
    
    
    
    pmax(
        
        round(
            
            demand
            
        ),
        
        0
        
    )
    
    
}






