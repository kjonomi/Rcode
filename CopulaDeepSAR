evaluate_agent <- function(
    
    agent,
    
    episodes = 200
    
){
    
    
    reward_history <- numeric(
        episodes
    )
    
    
    
    for(ep in seq_len(episodes)){
        
        
        env <- initialize_environment()
        
        
        total_reward <- 0
        
        
        
        for(step in 1:50){
            
            
            state <- scale_state(
                
                create_state(
                    env$inventory
                )
                
            )
            
            
            
            action <- select_action(
                
                agent,
                
                state,
                
                epsilon = 0
                
            )
            
            
            
            result <- environment_step(
                
                env,
                
                rep(
                    actions[action],
                    N_STORES
                )
                
            )
            
            
            
            env <- result$environment
            
            
            
            total_reward <-
                
                total_reward +
                
                result$reward
            
            
        }
        
        
        reward_history[ep] <-
            
            total_reward
        
        
    }
    
    
    
    list(
        
        RewardHistory =
            reward_history,
        
        MeanReward =
            mean(reward_history),
        
        SDReward =
            sd(reward_history)
        
    )
    
}





