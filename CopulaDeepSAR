flatten_column <- function(x) {

    if (is.list(x)) {

        x <-
            unlist(
                x,
                recursive = TRUE,
                use.names = FALSE
            )

    }

    return(x)

}


normalize_dataframe <- function(df) {

    if ("Method" %in% names(df)) {

        df$Method <-
            as.character(
                flatten_column(
                    df$Method
                )
            )

    }

    return(df)

}


safe_read_csv <- function(
    filename,
    required = TRUE
) {

    path <-
        file.path(
            RESULT_DIR,
            filename
        )

    if (!file.exists(path)) {

        if (required) {

            stop(
                paste(
                    "Required result file not found:",
                    path
                )
            )

        } else {

            warning(
                paste(
                    "Optional result file not found:",
                    path
                )
            )

            return(NULL)

        }

    }

    df <-
        read.csv(
            path,
            stringsAsFactors = FALSE
        )

    return(
        normalize_dataframe(df)
    )

}


