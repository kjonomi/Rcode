        history[[t]] <- data.frame(

            Day=t,

            Store=seq_len(N_STORES),

            Inventory=env$inventory,

            Demand=result$demand,

            Sales=result$sales,

            LostSales=result$lost_sales,

            Order=order_quantity,

            Reward=result$reward

        )



        env <- result$environment

    }



    bind_rows(history)

}



