###############################################################
# 28. STATISTICAL COMPARISON FUNCTION
###############################################################

compare_models <- function(
    metric,
    model1,
    model2
) {

    x <-
        metric %>%

        filter(
            Method == model1
        ) %>%

        select(
            Replication,
            value
        ) %>%

        arrange(
            Replication
        )

    y <-
        metric %>%

        filter(
            Method == model2
        ) %>%

        select(
            Replication,
            value
        ) %>%

        arrange(
            Replication
        )

    ###########################################################
    # Check replication IDs
    ###########################################################

    if (
        !identical(
            x$Replication,
            y$Replication
        )
    ) {

        stop(
            paste0(
                "Replication IDs do not match between ",
                model1,
                " and ",
                model2,
                "."
            )
        )

    }

    ###########################################################
    # Paired differences
    ###########################################################

    differences <-
        x$value -
        y$value

    ###########################################################
    # Wilcoxon signed-rank test
    ###########################################################

    wilcox <-
        wilcox.test(
            x$value,
            y$value,
            paired = TRUE,
            exact = FALSE,
            conf.int = TRUE
        )

    ###########################################################
    # Cliff's delta
    ###########################################################

    effect <-
        effsize::cliff.delta(
            x$value,
            y$value,
            paired = TRUE
        )

    ###########################################################
    # Mean difference
    ###########################################################

    mean_difference <-
        mean(
            differences,
            na.rm = TRUE
        )

    median_difference <-
        median(
            differences,
            na.rm = TRUE
        )

    ###########################################################
    # Return results
    ###########################################################

    data.frame(

        Model1 =
            model1,

        Model2 =
            model2,

        N =
            length(
                differences
            ),

        MeanDifference =
            mean_difference,

        MedianDifference =
            median_difference,

        W =
            as.numeric(
                wilcox$statistic
            ),

        PValue =
            wilcox$p.value,

        CliffDelta =
            as.numeric(
                effect$estimate
            ),

        stringsAsFactors = FALSE
    )
}

