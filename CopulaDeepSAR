    ShortageCost=1.0,
    
    TransferCost=0.05
    
)




###############################################################
# 11. Reward Function
###############################################################


compute_reward <- function(
        
        demand,
        
        inventory,
        
        shipment,
        
        transfer=0
        
){
    
    
    available <- inventory + shipment
    
    
    sales <- pmin(
        
        available,
        
        demand
        
    )
    
    
    
    ending_inventory <- pmax(
        
        available-demand,
        
        0
        
    )
    
    
    
    shortage <- pmax(
        
        demand-available,
        
        0
        
    )
    
    
    
    reward <-
        
        reward_parameters$Revenue *
        
        sales -
        
        reward_parameters$HoldingCost *
        
        ending_inventory -
        
        reward_parameters$ShortageCost *
        
        shortage -
        
        reward_parameters$TransferCost *
        
        transfer
    
    
    
    list(
        
        reward=reward,
        
        sales=sales,
        
        ending_inventory=ending_inventory,
        
        shortage=shortage
        
    )
    
}




