###############################################################
# Forecast Accuracy Function
###############################################################


forecast_metrics <- function(
    
    obs,
    pred
    
){


    obs <- as.numeric(obs)

    pred <- as.numeric(pred)



    pred <- pmax(
        pred,
        0
    )



    data.frame(

        RMSE =
            sqrt(
                mean(
                    (obs-pred)^2
                )
            ),


        MAE =
            mean(
                abs(obs-pred)
            ),


        MAPE =
            mean(

                abs(obs-pred) /

                    pmax(obs,1)

            ) * 100,


        WAPE =
            sum(
                abs(obs-pred)
            ) /

            pmax(
                sum(obs),
                1
            )

    )

}





###############################################################
# Forecast Each Store
###############################################################


for(i in seq_len(N_STORES)){



    cat(

        "\nForecasting Store:",

        selected_stores[i],

        "\n"

    )



    ###########################################################
    # Time Series Construction
    ###########################################################


    y <- ts(

        sales_matrix[,i],

        frequency=7

    )




    ###########################################################
    # Train/Test Split
    ###########################################################


    train <- ts(

        y[1:train_length],

        frequency=7

    )



    test <- ts(

        y[(train_length+1):length(y)],

        frequency=7

    )





    ###########################################################
    # Forecast Models
    ###########################################################


    fit_arima <- auto.arima(

        train

    )



    fit_ets <- ets(

        train

    )



    fit_tbats <- tryCatch(

        tbats(train),

        error=function(e){

            NULL

        }

    )



    fit_theta <- thetaf(

        train,

        h=forecast_horizon

    )





    ###########################################################
    # Forecast Generation
    ###########################################################


    pred_arima <-

        forecast(

            fit_arima,

            h=forecast_horizon

        )$mean



    pred_ets <-

        forecast(

            fit_ets,

            h=forecast_horizon

        )$mean




    pred_tbats <-

        if(!is.null(fit_tbats)){


            forecast(

                fit_tbats,

                h=forecast_horizon

            )$mean


        }else{


            rep(

                mean(train),

                forecast_horizon

            )


        }




    pred_theta <-

        fit_theta$mean





    ###########################################################
    # Remove Negative Demand
    ###########################################################


    pred_arima <- pmax(
        pred_arima,
        0
    )


    pred_ets <- pmax(
        pred_ets,
        0
    )


    pred_tbats <- pmax(
        pred_tbats,
        0
    )


    pred_theta <- pmax(
        pred_theta,
        0
    )






    ###########################################################
    # Forecast Evaluation
    ###########################################################


    store_results <- rbind(


        cbind(

            Model="ARIMA",

            forecast_metrics(
                test,
                pred_arima
            )

        ),



        cbind(

            Model="ETS",

            forecast_metrics(
                test,
                pred_ets
            )

        ),




        cbind(

            Model="TBATS",

            forecast_metrics(
                test,
                pred_tbats
            )

        ),




        cbind(

            Model="Theta",

            forecast_metrics(
                test,
                pred_theta
            )

        )



    )



    store_results$Store <-
        selected_stores[i]



    forecast_accuracy <-

        rbind(

            forecast_accuracy,

            store_results

        )





    ###########################################################
    # Save Models
    ###########################################################


    forecast_models[[selected_stores[i]]] <-

        list(

            ARIMA=fit_arima,

            ETS=fit_ets,

            TBATS=fit_tbats,

            Theta=fit_theta

        )





    ###########################################################
    # Demand Parameters for SAR-Q
    ###########################################################


    demand_base[i] <-

        mean(train)



    demand_sd[i] <-

        max(

            sd(train),

            MIN_DEMAND_SD

        )





    ###########################################################
    # ARIMA Residuals
    # Input for Copula Modeling
    ###########################################################


    residuals_i <-

        residuals(
            fit_arima
        )



    demand_residuals[

        seq_along(residuals_i),

        i

    ] <-

        residuals_i



}


