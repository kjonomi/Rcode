  s_next <- next_state_fn(
    inventory = s_current,
    actions = actions_sel,
    demand = future_demand
  )

  forecast_inventory[t, ] <- s_next

  forecast_actions[t, ] <- actions_sel

  s_current <- s_next

  demand_current <- future_demand
}

