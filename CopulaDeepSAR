###############################################################
# Statistical Comparison
###############################################################


compare_models <- function(

        metric,

        model1,

        model2

){


    x <-

        metric %>%

        filter(

            Method==model1

        ) %>%

        arrange(

            Replication

        ) %>%

        pull(value)



    y <-

        metric %>%

        filter(

            Method==model2

        ) %>%

        arrange(

            Replication

        ) %>%

        pull(value)



    wilcox <-

        wilcox.test(

            x,

            y,

            paired=TRUE

        )



    effect <-

        effsize::cliff.delta(

            x,

            y,

            paired=TRUE

        )



    data.frame(

        Model1=model1,

        Model2=model2,

        PValue=wilcox$p.value,

        CliffDelta=effect$estimate

    )

}
