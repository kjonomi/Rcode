        max(q_next)



    q[action] <-

        q[action] +

        ALPHA *

        (

            target -

            q[action]

        )



    set_Q(

        Q,

        state,

        q

    )



    Q

}
###############################################################
# SAR-Q Update
###############################################################


update_SARQ <- function(

        Q,

        env,

        store_id,

        state,

        action,

        reward,

        next_state

){


    q <-

        get_Q(

            Q,

            state

        )


    q_next <-

        get_Q(

            Q,

            next_state

        )



    own_value <-

        max(q_next)



    neighbor_value <-

        spatial_value(

            Q,

            env,

            store_id

        )



    target <-

        reward +

        GAMMA *

        (

            (1-LAMBDA_SPATIAL)

            *

            own_value

            +

            LAMBDA_SPATIAL

            *

            neighbor_value

        )



    q[action] <-

        q[action]

        +

        ALPHA *

        (

            target-q[action]

        )



    set_Q(

        Q,

        state,

        q

    )


    Q

}
###############################################################
# LASAR-Q Update
###############################################################


update_LASARQ <- function(

        Q,

        env,

        store_id,

        state,

        action,

        reward,

        next_state

){


    q <-

        get_Q(

            Q,

            state

        )



    q_next <-

        get_Q(

            Q,

            next_state

        )



    own_value <-

        max(q_next)



    neighbor_value <-

        spatial_value(

            Q,

            env,

            store_id

        )



    lambda_i <-

        adaptive_lambda(

            store_id

        )



    target <-

        reward +

        GAMMA *

        (

            (1-lambda_i)

            *

            own_value

            +

            lambda_i

            *

            neighbor_value

        )



    q[action] <-

        q[action]

        +

        ALPHA *

        (

            target-q[action]

        )



    set_Q(

        Q,

        state,

        q

    )


    Q

}
###############################################################
# Algorithm Selector
###############################################################


RL_update <- function(

        method,

        Q,

        env,

        store_id,

        state,

        action,

        reward,

        next_state

){


    if(method=="Q-Learning"){


        return(

            update_Q_learning(

                Q,

                state,

                action,

                reward,

                next_state

            )

        )

    }



    if(method=="SAR-Q"){


        return(

            update_SARQ(

                Q,

                env,

                store_id,

                state,

                action,

                reward,

                next_state

            )

        )

    }



    if(method=="LASAR-Q"){


        return(

            update_LASARQ(

                Q,

                env,

                store_id,

                state,

                action,

                reward,

                next_state

            )

        )

    }

}
