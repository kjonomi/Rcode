# 2. Confidence Interval Function
###############################################################

mean_ci <- function(x){

    n <- length(x)

    m <- mean(x)

    se <- sd(x)/sqrt(n)

    lower <- 
        m - qt(0.975,n-1)*se

    upper <-
        m + qt(0.975,n-1)*se


    data.frame(
        
        Mean = m,
        
        Lower = lower,
        
        Upper = upper
        
    )

}



