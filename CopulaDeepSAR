###############################################################
# 3. Demand Scenario Generator
###############################################################


generate_scenario_demand <- function(

    scenario

){


    if(scenario=="Normal"){


        sd_factor <- 1


    }else if(scenario=="HighVolatility"){


        sd_factor <- 2


    }else if(scenario=="ExtremeVolatility"){


        sd_factor <- 3


    }else if(scenario=="DemandShock"){


        shock <- runif(

            1,

            1.5,

            2.5

        )


        return(

            pmax(

                round(

                    demand_base *

                    shock +

                    rnorm(

                        N_STORES,

                        0,

                        demand_sd

                    )

                ),

                0

            )

        )


    }


    demand <-


        demand_base +

        rnorm(

            N_STORES,

            0,

            demand_sd*sd_factor

        )


    pmax(

        round(demand),

        0

    )


}




###############################################################
# 4. Robust Environment Step
###############################################################


environment_step_robust <- function(

    env,

    action_vector,

    scenario="Normal",

    use_copula=TRUE

){



    shipment <-


        round(

            env$inventory *

            action_vector

        )



    if(use_copula){


        demand <-


            generate_demand()



    }else{


        demand <-


            generate_scenario_demand(

                scenario

            )

    }




    transition <-


        inventory_step(

            env$inventory,

            env$pipeline,

            shipment,

            demand

        )




    reward_output <-


        compute_reward(

            demand,

            env$inventory,

            shipment

        )



    next_env <- list(


        inventory=

            transition$inventory,


        pipeline=

            transition$pipeline,


        time=

            env$time+1,


        total_reward=

            env$total_reward+

            sum(

                reward_output$reward

            )

    )



    list(

        reward=

            sum(

                reward_output$reward

            ),

        environment=

            next_env

    )

}



