###############################################################

benchmark_test <- function(

    metric,

    m1,

    m2

) {

    ###########################################################
    # Extract data
    ###########################################################

    x <-
        benchmark_results %>%

        filter(
            Method == m1
        ) %>%

        select(
            Replication,
            value = all_of(metric)
        )


    y <-
        benchmark_results %>%

        filter(
            Method == m2
        ) %>%

        select(
            Replication,
            value = all_of(metric)
        )


    ###########################################################
    # Match replications
    ###########################################################

    paired_data <-
        inner_join(

            x,

            y,

            by =
                "Replication",

            suffix =
                c(
                    "_1",
                    "_2"
                )
        )


    ###########################################################
    # Check sample size
    ###########################################################

    if (
        nrow(
            paired_data
        ) < 2
    ) {

        return(
            data.frame(

                Model1 =
                    m1,

                Model2 =
                    m2,

                Metric =
                    metric,

                N =
                    nrow(
                        paired_data
                    ),

                PValue =
                    NA_real_,

                CliffDelta =
                    NA_real_

            )
        )

    }


    ###########################################################
    # Paired vectors
    ###########################################################

    x_value <-
        paired_data$value_1

    y_value <-
        paired_data$value_2


    ###########################################################
    # Paired Wilcoxon test
    ###########################################################

    wilcox <-
        wilcox.test(

            x_value,

            y_value,

            paired =
                TRUE,

            exact =
                FALSE
        )


    ###########################################################
    # Paired Cliff's delta
    ###########################################################

    effect <-
        effsize::cliff.delta(

            x_value,

            y_value,

            paired =
                TRUE
        )


    ###########################################################
    # Return
    ###########################################################

    data.frame(

        Model1 =
            m1,

        Model2 =
            m2,

        Metric =
            metric,

        N =
            nrow(
                paired_data
            ),

        PValue =
            wilcox$p.value,

        CliffDelta =
            as.numeric(
                effect$estimate
            ),

        stringsAsFactors =
            FALSE
    )

}


