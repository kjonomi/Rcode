# ============================================================
# 23) CLIFF'S DELTA
# ============================================================

cliff_delta <- function(x, y){

  comp <- outer(
    x,
    y,
    FUN = "-"
  )

  delta <- (
    sum(comp > 0) -
      sum(comp < 0)
  ) / (length(x) * length(y))

  return(delta)
}

delta_value <- cliff_delta(
  rowMeans(episode_rewards),
  rowMeans(episode_rewards_nocop)
)

cat(
  "Cliff Delta:",
  round(delta_value, 4),
  "\n"
)

