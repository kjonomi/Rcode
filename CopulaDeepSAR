    HoldingCost=0.10,
    
    ShortageCost=1.0,
    
    TransferCost=0.05
    
)




###############################################################
# 11. Reward Function
###############################################################


compute_reward <- function(
        
        demand,
        
        inventory,
        
        shipment,
        
        transfer=0
        
){
    
    
    available <- inventory + shipment
    
    
    sales <- pmin(
        
        available,
        
        demand
        
    )
    
    
    
    ending_inventory <- pmax(
        
        available-demand,
        
        0
        
    )
    
    
    
    shortage <- pmax(
        
        demand-available,
        
        0
        
    )
    
    
    
    reward <-
        
        reward_parameters$Revenue *
        
        sales -
        
        reward_parameters$HoldingCost *
        
        ending_inventory -
        
        reward_parameters$ShortageCost *
        
        shortage -
        
        reward_parameters$TransferCost *
        
        transfer
    
    
    
    list(
        
        reward=reward,
        
        sales=sales,
        
        ending_inventory=ending_inventory,
        
        shortage=shortage
        
    )
    
}




###############################################################
# 12. Pipeline Initialization
###############################################################


initialize_pipeline <- function(){
    
    
    matrix(
        
        0,
        
        nrow=N_STORES,
        
        ncol=LEAD_TIME
        
    )
    
}




###############################################################
# 13. Inventory Transition
###############################################################


inventory_step <- function(
        
        inventory,
        
        pipeline,
        
        shipment,
        
        demand
        
){
    
    
    arriving <- pipeline[,1]
    
    
    inventory <- inventory + arriving
    
    
    
    if(LEAD_TIME > 1){
        
        pipeline <-
            
            cbind(
                
                pipeline[,-1,drop=FALSE],
                
                rep(0,N_STORES)
                
            )
        
    }
    
    
    
    pipeline[,LEAD_TIME] <- shipment
    
    
    
    inventory <- pmin(
        
        inventory,
        
        MAX_CAPACITY
        
    )
    
    
    
    sales <- pmin(
        
        inventory,
        
        demand
        
    )
    
    
    
    lost_sales <- pmax(
        
        demand-sales,
        
        0
        
    )
    
    
    
    inventory <- inventory-sales
    
    
    
    list(
        
        inventory=inventory,
        
        pipeline=pipeline,
        
        sales=sales,
        
        lost_sales=lost_sales
        
    )
    
}


