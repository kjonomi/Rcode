###############################################################
# Safe percentage calculation
###############################################################

safe_percent_change <- function(
    old_value,
    new_value
) {

    if (
        length(old_value) != 1 ||
        length(new_value) != 1 ||
        is.na(old_value) ||
        is.na(new_value) ||
        !is.finite(old_value) ||
        !is.finite(new_value) ||
        abs(old_value) < .Machine$double.eps
    ) {

        return(
            NA_real_
        )

    }

    return(
        100 *
        (
            old_value -
            new_value
        ) /
        old_value
    )

}


###############################################################
# Safe reward improvement
###############################################################

safe_reward_improvement <- function(
    baseline,
    new_value
) {

    if (
        length(baseline) != 1 ||
        length(new_value) != 1 ||
        is.na(baseline) ||
        is.na(new_value) ||
        !is.finite(baseline) ||
        !is.finite(new_value) ||
        abs(baseline) < .Machine$double.eps
    ) {

        return(
            NA_real_
        )

    }

    return(
        100 *
        (
            new_value -
            baseline
        ) /
        abs(baseline)
    )

}


###############################################################
# Pareto efficiency function
###############################################################

is_pareto_efficient <- function(
    cost,
    fill_rate
) {

    n <-
        length(cost)

    efficient <-
        rep(
            FALSE,
            n
        )

    valid <-
        is.finite(cost) &
        is.finite(fill_rate)

    if (!any(valid)) {

        return(
            efficient
        )

    }

    valid_indices <-
        which(valid)

    for (i in valid_indices) {

        dominated <-
            FALSE

        for (j in valid_indices) {

            if (i == j) {
                next
            }

            if (
                cost[j] <= cost[i] &&
                fill_rate[j] >= fill_rate[i] &&
                (
                    cost[j] < cost[i] ||
                    fill_rate[j] > fill_rate[i]
                )
            ) {

                dominated <-
                    TRUE

                break

            }

        }

        efficient[i] <-
            !dominated

    }

    return(
        efficient
    )

}


