###############################################################
# 5. TensorFlow Safe Functions
###############################################################


tf_clip <- function(
        x,
        lower=1e-7,
        upper=1-1e-7
){

    tf$clip_by_value(
        x,
        clip_value_min=lower,
        clip_value_max=upper
    )

}



safe_log <- function(x){

    tf$math$log(
        tf_clip(x)
    )

}





###############################################################
# 6. Gaussian Copula Penalty
###############################################################


gaussian_copula_penalty <- function(
        y_pred
){


    u1 <-
        tf_clip(
            y_pred[,1]
        )


    u2 <-
        tf_clip(
            y_pred[,2]
        )



    z1 <-
        tf$math$log(
            u1/(1-u1)
        )


    z2 <-
        tf$math$log(
            u2/(1-u2)
        )



    rho <- 0.8



    penalty <-

        (
            z1^2 -
            2*rho*z1*z2 +
            z2^2

        ) /

        (
            2*(1-rho^2)
        )



    tf$reduce_mean(
        penalty
    )

}






###############################################################
# 7. Clayton Copula Penalty
###############################################################


clayton_copula_penalty <- function(
        y_pred
){


    theta <- 3



    u1 <-
        tf_clip(
            y_pred[,1]
        )


    u2 <-
        tf_clip(
            y_pred[,2]
        )



    term <-

        u1^(-theta) +

        u2^(-theta) -

        1




    penalty <-

        -(
            log(theta+1)

            -

            (theta+1)
            *
            tf$math$log(u1*u2)

            -

            (2+1/theta)
            *
            tf$math$log(term)

        )



    tf$reduce_mean(
        penalty
    )

}






###############################################################
# 8. Gumbel Copula Penalty
###############################################################


gumbel_copula_penalty <- function(
        y_pred
){


    theta <- 4



    u1 <-
        tf_clip(
            y_pred[,1]
        )


    u2 <-
        tf_clip(
            y_pred[,2]
        )



    a <-

        (-safe_log(u1))^theta



    b <-

        (-safe_log(u2))^theta




    A <-

        (a+b)^(1/theta)



    tf$reduce_mean(
        A
    )

}






###############################################################
# 9. Copula Loss Function
###############################################################


create_copula_loss <- function(
        copula_type
){


    function(
            y_true,
            y_pred
    ){


        #######################################################
        # Binary Cross Entropy
        #######################################################


        bce <-

            tf$keras$losses$
            binary_crossentropy(
                y_true,
                y_pred
            )



        #######################################################
        # Copula Dependence
        #######################################################


        penalty <-

            switch(

                copula_type,


                "Gaussian" =

                    gaussian_copula_penalty(
                        y_pred
                    ),



                "Clayton" =

                    clayton_copula_penalty(
                        y_pred
                    ),



                "Gumbel" =

                    gumbel_copula_penalty(
                        y_pred
                    )

            )




        loss <-

            tf$reduce_mean(
                bce
            )

            +

            lambda_copula *
            penalty



        loss


    }

}






###############################################################
# 10. CNN-LSTM Architecture
###############################################################


create_cnn_lstm_model <- function(
        copula_type
){



    tf$keras$backend$clear_session()



    input_layer <-

        keras_input(

            shape=c(
                p,
                1
            ),

            name="covariate_sequence"

        )




    x <-

        input_layer %>%

        layer_conv_1d(

            filters=32,

            kernel_size=3,

            padding="same",

            activation="relu"

        ) %>%


        layer_batch_normalization() %>%


        layer_dropout(
            rate=0.25
        )






    x <-

        x %>%

        layer_lstm(

            units=64,

            return_sequences=FALSE

        )





    x <-

        x %>%

        layer_dense(

            units=32,

            activation="relu"

        ) %>%


        layer_dropout(
            rate=0.25
        )





    output_layer <-

        x %>%

        layer_dense(

            units=2,

            activation="sigmoid",

            name="cause_probability"

        )





    model <-

        keras_model(

            inputs=input_layer,

            outputs=output_layer

        )






    model %>%

        compile(

            optimizer=

                optimizer_adam(

                    learning_rate=0.001

                ),



            loss=

                create_copula_loss(
                    copula_type
                ),



            metrics=

                list(
                    "accuracy"
                )

        )



    return(model)


}






###############################################################
# 11. Training Function
###############################################################


train_model <- function(

        model,

        X_train_array,

        Y_train,

        model_name

){



    cat(
        "\nTraining:",
        model_name,
        "\n"
    )



    early_stop <-

        callback_early_stopping(

            monitor="val_loss",

            patience=10,

            restore_best_weights=TRUE

        )



    reduce_lr <-

        callback_reduce_lr_on_plateau(

            monitor="val_loss",

            factor=0.5,

            patience=5,

            min_lr=1e-6

        )





    history <-

        model %>%

        fit(

            x=X_train_array,

            y=Y_train,


            validation_split=0.20,


            epochs=epochs,


            batch_size=batch_size,


            callbacks=list(

                early_stop,

                reduce_lr

            ),


            verbose=0

        )



    return(history)

}





