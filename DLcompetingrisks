bootstrap_all_models <- function(

    model_list,

    df_test,

    B = 50

){

    ############################################################
    ## Cause 1
    ############################################################

    boot_c1 <-

        lapply(

            model_list,

            function(m)

                boot(

                    data=df_test,

                    statistic=function(d,i)

                        cindex_cause_boot_fn(

                            d,

                            i,

                            m,

                            cause=1

                        ),

                    R=B

                )

        )

    ############################################################
    ## Cause 2
    ############################################################

    boot_c2 <-

        lapply(

            model_list,

            function(m)

                boot(

                    data=df_test,

                    statistic=function(d,i)

                        cindex_cause_boot_fn(

                            d,

                            i,

                            m,

                            cause=2

                        ),

                    R=B

                )

        )

    ############################################################
    ## Summary table
    ############################################################

    data.frame(

        Model=names(model_list),

        C_index_Cause1=

            sapply(

                boot_c1,

                function(x)

                    mean(

                        x$t,

                        na.rm=TRUE

                    )

            ),

        Lower1=

            sapply(

                boot_c1,

                function(x)

                    ci_safe(x)[1]

            ),

        Upper1=

            sapply(

                boot_c1,

                function(x)

                    ci_safe(x)[2]

            ),

        C_index_Cause2=

            sapply(

                boot_c2,

                function(x)

                    mean(

                        x$t,

                        na.rm=TRUE

                    )

            ),

        Lower2=

            sapply(

                boot_c2,

                function(x)

                    ci_safe(x)[1]

            ),

        Upper2=

            sapply(

                boot_c2,

                function(x)

                    ci_safe(x)[2]

            )

    )

}

