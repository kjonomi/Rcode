extract_CIF <- function(

    cif_data,

    time_point,

    cause="Death"

){


    tmp <- cif_data %>%

        filter(

            Time >= time_point

        ) %>%

        slice(1)



    if(cause=="Death"){

        return(tmp$CIF_Death)

    }else{

        return(tmp$CIF_Recurrence)

    }

