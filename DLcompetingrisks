###############################################################
# 67. Brier Score Function
###############################################################


brier_score <- function(

    observed,

    predicted

){


    mean(

        (

            observed -

            predicted

        )^2,

        na.rm=TRUE

    )

}



###############################################################
# 68. Create Binary Event Indicators
###############################################################


# Death by time


death_indicator <- function(

    t

){


    as.numeric(

        time_test <= t &

        event_test == 2

    )


}



# Recurrence by time


recurrence_indicator <- function(

    t

){


    as.numeric(

        time_test <= t &

        event_test == 1

    )


}



###############################################################
# 69. Brier Score Evaluation
###############################################################


compute_brier_table <- function(

    cif_model,

    model_name

){


    result <- data.frame()



    for(t in eval_times){


        pred_death <-


            extract_CIF(

                cif_model,

                t,

                "Death"

            )



        pred_recur <-


            extract_CIF(

                cif_model,

                t,

                "Recurrence"

            )



        result <- rbind(

            result,

            data.frame(

                Model=model_name,


                Time=t,


                Death_Brier=

                    brier_score(

                        death_indicator(t),

                        pred_death

                    ),



                Recurrence_Brier=

                    brier_score(

                        recurrence_indicator(t),

                        pred_recur

                    )

            )

        )


    }



    result

}



