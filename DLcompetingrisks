# 26. CIF Function
# ===============================================================


compute_CIF <- function(

    risk,

    times,

    model_name

){


    h1 <-

        pmin(

            risk$Recurrence*0.05,

            0.95

        )


    h2 <-

        pmin(

            risk$Death*0.05,

            0.95

        )



    n <-

        nrow(risk)



    cif1 <-

        matrix(

            0,

            n,

            length(times)

        )


    cif2 <-

        matrix(

            0,

            n,

            length(times)

        )


    surv <-

        matrix(

            1,

            n,

            length(times)

        )



    for(t in seq_along(times)){


        if(t==1){

            s_prev <-

                rep(1,n)

        }else{

            s_prev <-

                surv[,t-1]

        }



        cif1[,t] <-

            if(t==1){

                s_prev*h1

            }else{

                cif1[,t-1]+s_prev*h1

            }



        cif2[,t] <-

            if(t==1){

                s_prev*h2

            }else{

                cif2[,t-1]+s_prev*h2

            }



        surv[,t] <-

            pmax(

                1-cif1[,t]-cif2[,t],

                0

            )


    }



    data.frame(

        Time=times,

        CIF_Recurrence=

            colMeans(cif1),


        CIF_Death=

            colMeans(cif2),


        Survival=

            colMeans(surv),


        Model=model_name

    )

}

