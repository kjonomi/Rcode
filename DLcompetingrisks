# 13. Simulation Loop
# ===============================================================


set.seed(123)



cindex_results_list <- list()


cif_results_list <- list()





for(sim in 1:n_sim){


    ############################################################
    # Clear TensorFlow graph
    ############################################################


    k_clear_session()



    cat(

        "Simulation:",

        sim,

        "\n"

    )




    ############################################################
    # Generate data
    ############################################################


    df <-

        generate_data(n)





    ############################################################
    # Train/Test split
    ############################################################


    idx_train <-

        sample(

            seq_len(n),

            floor(0.8*n)

        )



    df_train <-

        df[idx_train,]



    df_test <-

        df[-idx_train,]




    stopifnot(

        all(

            covariates %in%

                names(df_test)

        )

    )




    ############################################################
    # CNN-LSTM input
    ############################################################


    X_train <-

        array(

            as.matrix(

                df_train[,covariates,drop=FALSE]

            ),

            dim=c(

                nrow(df_train),

                1,

                length(covariates)

            )

        )




    ############################################################
    # Labels
    ############################################################


    y_train <-

        as.matrix(

            cbind(

                df_train$event==0,

                df_train$event==1,

                df_train$event==2

            )

        )



    storage.mode(y_train) <- "numeric"





    ############################################################
    # Build models
    ############################################################


    model_gauss <-

        create_model(

            copula_gaussian_loss

        )


    model_clayton <-

        create_model(

            copula_clayton_loss

        )


    model_gumbel <-

        create_model(

            copula_gumbel_loss

        )





    ############################################################
    # Train models
    ############################################################


    model_gauss %>%

        fit(

            X_train,

            y_train,

            epochs=epochs,

            batch_size=batch_size,

            verbose=0

        )



    model_clayton %>%

        fit(

            X_train,

            y_train,

            epochs=epochs,

            batch_size=batch_size,

            verbose=0

        )



    model_gumbel %>%

        fit(

            X_train,

            y_train,

            epochs=epochs,

            batch_size=batch_size,

            verbose=0

        )





    ############################################################
    # Store models
    ############################################################


    model_list <-

        list(

            Gaussian=model_gauss,

            Clayton=model_clayton,

            Gumbel=model_gumbel

        )





    ############################################################
    # Bootstrap C-index
    ############################################################


    cindex_results_list[[sim]] <-

        bootstrap_all_models(

            model_list,

            df_test,

            B=B_boot

        ) %>%

        mutate(

            Simulation=sim

        )





    ############################################################
    # CIF estimation
    ############################################################


    cif_results_list[[sim]] <-

        rbind(

            compute_cif_realistic(

                model_gauss,

                df_test,

                times_eval,

                "Gaussian"

            ),



            compute_cif_realistic(

                model_clayton,

                df_test,

                times_eval,

                "Clayton"

            ),



            compute_cif_realistic(

                model_gumbel,

                df_test,

                times_eval,

                "Gumbel"

            )

        )




    cat(

        "Completed simulation:",

        sim,

        "\n\n"

    )


}

