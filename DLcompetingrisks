# ================================================================
# 5. Bootstrap Cause-specific C-index
# ================================================================

cindex_cause_boot_fn <- function(
    data,
    indices,
    model,
    cause = 1
){

    ############################################################
    ## Bootstrap sample
    ############################################################

    d <- data[indices, ]

    if(sum(d$event==cause) < 2)
        return(NA)

    ############################################################
    ## Predictor matrix
    ############################################################

    Xd <- array(

        as.matrix(d[,covariates]),

        dim = c(
            nrow(d),
            1,
            length(covariates)
        )

    )

    ############################################################
    ## Neural-network prediction
    ############################################################

    pred <- predict(
        model,
        Xd,
        verbose=0
    )

    ############################################################
    ## Cause-specific risk score
    ############################################################

    if(cause==1){

        score <- pred[,2]

    }else{

        score <- pred[,3]

    }

    ############################################################
    ## Concordance Index
    ############################################################

    cindex <-

        rcorr.cens(

            score,

            Surv(

                d$time,

                ifelse(
                    d$event==cause,
                    1,
                    0
                )

            )

        )["C Index"]

    as.numeric(cindex)

}

# ================================================================
# Bootstrap Confidence Interval
# ================================================================

ci_safe <- function(b){

    if(

        all(is.na(b$t))

        ||

        sd(b$t,na.rm=TRUE)==0

    ){

        return(c(NA,NA))

    }

    out <-

        tryCatch(

            boot.ci(
                b,
                type="perc"
            )$percent[4:5],

            error=function(e)
                c(NA,NA)

        )

    out

}

