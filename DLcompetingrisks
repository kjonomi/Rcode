# 3. Global Simulation Parameters
###############################################################


set.seed(1234)



n <- 3000


p <- 30


n_sim <- 100



train_fraction <- 0.70



epochs <- 100


batch_size <- 64



lambda_copula <- 0.30




###############################################################
# 4. Nonlinear High Correlation Weibull Competing Risk Data
###############################################################


generate_data <- function(
        n,
        p
){



###############################################################
# Correlated Covariates
###############################################################


rho <- 0.90



Sigma <-

    matrix(
        rho,
        nrow=p,
        ncol=p
    )



diag(Sigma) <- 1




X <-

    MASS::mvrnorm(

        n=n,

        mu=rep(0,p),

        Sigma=Sigma

    )



colnames(X) <-

    paste0(
        "X",
        1:p
    )




###############################################################
# Cause 1 Nonlinear Risk
# Variables X1-X15
###############################################################


eta1 <-

    0.60*X[,1] +

    0.40*X[,2]^2 -

    0.50*sin(X[,3]) +

    0.35*X[,4]*X[,5] +

    0.30*exp(-X[,6]^2) +

    0.25*X[,7]*X[,8] -

    0.35*log(abs(X[,9])+1) +

    0.30*cos(X[,10]) +

    0.20*X[,11]^3 +

    0.25*X[,12]*X[,13] +

    0.25*(X[,14]>0) +

    0.30*X[,15]




###############################################################
# Cause 2 Nonlinear Risk
# Variables X16-X30
###############################################################


eta2 <-

    -0.55*X[,16] +

    0.45*X[,17]^2 +

    0.40*cos(X[,18]) +

    0.35*X[,19]*X[,20] -

    0.30*exp(-X[,21]^2) +

    0.25*X[,22]*X[,23] +

    0.35*sin(X[,24]) +

    0.30*X[,25]^3 -

    0.25*log(abs(X[,26])+1) +

    0.25*X[,27]*X[,28] +

    0.20*(X[,29]>0) +

    0.30*X[,30]




###############################################################
# Stabilize Predictors
###############################################################


eta1 <-

    pmax(
        pmin(
            eta1,
            4
        ),
        -4
    )



eta2 <-

    pmax(
        pmin(
            eta2,
            4
        ),
        -4
    )





###############################################################
# Weibull Baseline Hazards
###############################################################


shape1 <- 2.8

scale1 <- 0.03



shape2 <- 1.8

scale2 <- 0.05




###############################################################
# Generate Event Times
###############################################################


U1 <- runif(n)

U2 <- runif(n)



T1 <-

(
-log(U1) /

(
scale1 *
exp(eta1)
)

)^(1/shape1)




T2 <-

(
-log(U2) /

(
scale2 *
exp(eta2)
)

)^(1/shape2)




###############################################################
# Weibull Censoring
###############################################################


Uc <- runif(n)



C <-

(
-log(Uc)/0.02

)^(1/1.2)




###############################################################
# Observed Time
###############################################################


time <-

    pmin(
        T1,
        T2,
        C
    )




###############################################################
# Event Indicator
###############################################################


status <-

    rep(
        0,
        n
    )



status[
    T1<T2 &
    T1<C
] <- 1



status[
    T2<T1 &
    T2<C
] <- 2





data.frame(

    time=time,

    status=status,

    X

)


}

###############################################################
# END PART 1
