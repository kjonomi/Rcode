# ===============================================================
# 32. Bootstrap C-index
# ===============================================================


bootstrap_cindex <- function(

    model,

    model_name,

    B=500

){


    ############################################################
    # Cause 1
    ############################################################


    boot_c1 <-

        boot(

            data=test_eval,

            statistic=function(d,i){

                cause_cindex(

                    d,

                    i,

                    model,

                    cause=1

                )

            },

            R=B

        )



    ############################################################
    # Cause 2
    ############################################################


    boot_c2 <-

        boot(

            data=test_eval,

            statistic=function(d,i){

                cause_cindex(

                    d,

                    i,

                    model,

                    cause=2

                )

            },

            R=B

        )




    ############################################################
    # Confidence interval
    ############################################################


    ci1 <-

        boot.ci(

            boot_c1,

            type="perc"

        )


    ci2 <-

        boot.ci(

            boot_c2,

            type="perc"

        )



    data.frame(

        Model=model_name,


        Cause1_Cindex=

            mean(

                boot_c1$t,

                na.rm=TRUE

            ),


        Cause1_Lower=

            ci1$percent[4],


        Cause1_Upper=

            ci1$percent[5],



        Cause2_Cindex=

            mean(

                boot_c2$t,

                na.rm=TRUE

            ),


        Cause2_Lower=

            ci2$percent[4],


        Cause2_Upper=

            ci2$percent[5]

    )


}

