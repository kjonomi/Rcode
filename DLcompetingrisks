###############################################################
# Time-dependent AUC Function (Robust Version)
###############################################################

compute_timeROC <-

function(

    risk,

    model_name,

    time_test,

    event_test

){


###############################################################
# Select valid evaluation times
###############################################################

valid_times <-

    eval_times[

        eval_times > min(time_test) &

        eval_times < max(time_test)

    ]



if(length(valid_times) < 3){

    valid_times <-

        quantile(

            time_test,

            probs=c(

                0.25,

                0.50,

                0.75

            )

        )

}



###############################################################
# TimeROC
###############################################################

roc <-

tryCatch(

timeROC(

    T = time_test,

    delta = event_test,

    marker = risk,

    cause = 1,

    weighting="marginal",

    times = valid_times,

    iid=FALSE

),

error=function(e){

    return(NULL)

}

)



###############################################################
# Error handling
###############################################################

if(is.null(roc) ||

   length(roc$AUC)<3){


    return(

        data.frame(

            Model=model_name,

            AUC_10=NA,

            AUC_20=NA,

            AUC_30=NA

        )

    )

}



###############################################################
# Return first three AUCs
###############################################################

data.frame(

    Model=model_name,

    AUC_10=roc$AUC[1],

    AUC_20=roc$AUC[2],

    AUC_30=roc$AUC[3]

)


}


###############################################################
# 5.2 Convert Risk Score to CIF
###############################################################

risk_to_cif <-

function(

    risk,

    times

){


    risk <-

        pmin(

            pmax(

                risk,

                1e-6

            ),

            1-1e-6

        )



    cif <-

        outer(

            risk,

            times,

            function(r,t)

                1-exp(

                    -r*t/max(times)

                )

        )



    cif

}



###############################################################
# 5.3 Integrated Brier Score
###############################################################

compute_IBS <-

function(

    cif_prediction,

    model_name,

    time_test,

    event_test

){



    ###############################################################
    # Survival probability
    ###############################################################

    pred_survival <-

        1 -

        cif_prediction



    ###############################################################
    # Calculate Brier at each time
    ###############################################################

    brier_values <- c()



    for(j in seq_along(eval_times)){


        t <- eval_times[j]


        observed <-

            ifelse(

                time_test <= t &
                event_test == 1,

                1,

                0

            )


        brier_values[j] <-

            mean(

                (

                    observed -

                    cif_prediction[,j]

                )^2

            )


    }



    data.frame(

        Model = model_name,

        IBS = mean(

            brier_values

        )

    )

}



