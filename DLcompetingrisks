extract_auc <- function(obj){
    
    
    if(is.null(obj)){
        
        return(
            rep(
                NA,
                3
            )
        )
        
    }
    
    
    if(!is.null(obj$AUC)){
        
        return(obj$AUC)
        
    }
    
    
    if(!is.null(obj$AUC_1)){
        
        return(obj$AUC_1)
        
    }
    
    
    return(
        rep(
            NA,
            3
        )
    )
    
}



