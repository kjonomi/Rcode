                "Recurrence"

            )



        result <- rbind(

            result,

            data.frame(

                Model=model_name,


                Time=t,


                Death_Brier=

                    brier_score(

                        death_indicator(t),

                        pred_death

                    ),



                Recurrence_Brier=

                    brier_score(

                        recurrence_indicator(t),

                        pred_recur

                    )

            )

        )


    }



    result

}



