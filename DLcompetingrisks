    0.8*X[,1] +

    0.6*X[,2]^2 -

    0.7*sin(X[,3]) +

    0.5*X[,4]*X[,5] +

    0.4*exp(-X[,6]^2) +

    0.5*X[,7]*X[,8] -

    0.4*log(abs(X[,9])+1) +

    0.5*cos(X[,10]) +

