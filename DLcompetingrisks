###############################################################
# 55. CNN-LSTM CIF Prediction Function
###############################################################


predict_CIF_CNN <- function(

    risk,

    time_grid,

    model_name

){


    n <- nrow(risk)


    #############################################
    # Cause-specific hazards
    #############################################


    h1 <- risk$Recurrence

    h2 <- risk$Death



    #############################################
    # Calibration factor
    # Converts NN probabilities to hazards
    #############################################


    h1 <- pmin(

        h1 * 0.05,

        0.95

    )


    h2 <- pmin(

        h2 * 0.05,

        0.95

    )



    #############################################
    # Storage
    #############################################


    cif1 <- matrix(

        0,

        n,

        length(time_grid)

    )


    cif2 <- matrix(

        0,

        n,

        length(time_grid)

    )


    surv <- matrix(

        1,

        n,

        length(time_grid)

    )



    #############################################
    # Recursive CIF
    #############################################


    for(t in seq_along(time_grid)){


        if(t==1){

            S_prev <- rep(

                1,

                n

            )

        }else{


            S_prev <- surv[,t-1]


        }



        cif1[,t] <-


            if(t==1){


                S_prev*h1


            }else{


                cif1[,t-1]+S_prev*h1


            }



        cif2[,t] <-


            if(t==1){


                S_prev*h2


            }else{


                cif2[,t-1]+S_prev*h2


            }



        surv[,t] <-


            pmax(

                1 -

                    cif1[,t] -

                    cif2[,t],

                0

            )


    }



    data.frame(

        Time=time_grid,


        CIF_Recurrence=

            colMeans(cif1),


        CIF_Death=

            colMeans(cif2),


        Survival=

            colMeans(surv),


        Model=model_name


    )

}



###############################################################
# 56. RSF CIF Prediction Function
###############################################################


predict_CIF_RSF <- function(

    rsf_pred,

    model_name

){


    #############################################
    # RSF already estimates cumulative incidence
    #############################################


    cif <- rsf_pred$cif



    #############################################
    # RSF time points
    #############################################


    rsf_time <- rsf_pred$time.interest



    #############################################
    # Mean CIF over subjects
    #############################################


    data.frame(

        Time = rsf_time,


        CIF_Recurrence =

            colMeans(

                cif[, ,1],

                na.rm=TRUE

            ),


        CIF_Death =

            colMeans(

                cif[, ,2],

                na.rm=TRUE

            ),


        Survival =

            1 -

            colMeans(

                cif[, ,1],

                na.rm=TRUE

            ) -

            colMeans(

                cif[, ,2],

                na.rm=TRUE

            ),


        Model=model_name

    )


}



