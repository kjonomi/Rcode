###############################################################
# 33. Cause-specific C-index Function
###############################################################


cause_cindex <- function(
    
    time,
    
    event,
    
    risk,
    
    cause
    
){


    ###########################################################
    # Check event availability
    ###########################################################


    if(sum(event==cause)<5){

        return(NA)

    }



    ###########################################################
    # Binary cause event
    ###########################################################


    status_binary <-

        ifelse(

            event==cause,

            1,

            0

        )



    ###########################################################
    # Concordance
    ###########################################################


    result <-

        rcorr.cens(

            risk,

            Surv(

                time,

                status_binary

            )

        )


    as.numeric(

        result["C Index"]

    )

}





