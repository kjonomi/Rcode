        verbose=0

    )


pred_clayton <-

    predict(

        model_clayton,

        X_test_array,

        verbose=0

    )


pred_gumbel <-

    predict(

        model_gumbel,

        X_test_array,

        verbose=0

    )





###############################################################
# Random Survival Forest
###############################################################


rsf_data <-

    data.frame(

        time=train_data$time,

        status=train_data$status,

        train_data[,feature_names]

    )



rsf_model <-

    rfsrc(

        Surv(
            time,
            status
        )~

            .,

        data=rsf_data,

        ntree=500,

        nodesize=15,

        splitrule="logrankCR",

        importance=TRUE

    )





rsf_prediction <-

    predict(

        rsf_model,

        newdata=

            test_data[,feature_names]

    )






###############################################################
# RSF Risk Extraction
###############################################################


rsf_cif <-

    rsf_prediction$cif



rsf_time_index <-

    dim(rsf_cif)[2]



rsf_cause1 <-

    rsf_cif[,

           rsf_time_index,

           1]



rsf_cause2 <-

    rsf_cif[,

           rsf_time_index,

           2]








###############################################################
# Collect Risk Predictions
###############################################################


risk_list <- list(


RSF_Cause1 =
    rsf_cause1,


RSF_Cause2 =
    rsf_cause2,



Gaussian_Cause1 =
    pred_gaussian[,1],


Gaussian_Cause2 =
    pred_gaussian[,2],



Clayton_Cause1 =
    pred_clayton[,1],


Clayton_Cause2 =
    pred_clayton[,2],



Gumbel_Cause1 =
    pred_gumbel[,1],


Gumbel_Cause2 =
    pred_gumbel[,2]


)






###############################################################
