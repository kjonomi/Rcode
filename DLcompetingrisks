# ===============================================================
# 12. TensorFlow Utility
# ===============================================================


to_uniform_tf <- function(x){


    u <-

        tf$math$sigmoid(

            tf$cast(

                x,

                tf$float32

            )

        )


    tf$clip_by_value(

        u,

        1e-6,

        1-1e-6

    )

}

# ===============================================================
# 13. Binary Cross Entropy
# ===============================================================


bce_loss <- function(
    y_true,
    y_pred
){


    tf$reduce_mean(

        tf$keras$losses$

            binary_crossentropy(

                y_true,

                y_pred

            )

    )

}

# ===============================================================
# 14. Gaussian Copula Loss
# ===============================================================


copula_gaussian_loss <- function(
    y_true,
    y_pred
){


    bce <-

        bce_loss(
            y_true,
            y_pred
        )


    ############################################################
    # Extract competing risks
    ############################################################


    u <-

        to_uniform_tf(

            y_pred[,2:3]

        )



    ############################################################
    # Gaussian copula parameter
    ############################################################


    rho <-

        tf$constant(

            0.5,

            dtype=tf$float32

        )



    ############################################################
    # Normal transformation
    ############################################################


    z <-

        tf$sqrt(2.0) *

        tf$math$erfinv(

            2*u-1

        )



    z1 <- z[,1]

    z2 <- z[,2]



    detR <-

        1-rho^2



    quad <-

        (

            z1^2+

            z2^2-

            2*rho*z1*z2

        )/detR



    log_density <-

        -0.5*quad -

        0.5*

        tf$math$log(detR)



    penalty <-

        -tf$reduce_mean(

            log_density

        )



    lambda <-

        tf$constant(

            0.1,

            dtype=tf$float32

        )



    return(

        bce+

        lambda*penalty

    )

}

# ===============================================================
# 15. Clayton Copula Loss
# ===============================================================


copula_clayton_loss <- function(
    y_true,
    y_pred
){


    bce <-

        bce_loss(

            y_true,

            y_pred

        )



    u <-

        to_uniform_tf(

            y_pred[,2:3]

        )



    theta <-

        tf$constant(

            1.5,

            dtype=tf$float32

        )



    S <-

        tf$reduce_sum(

            u^(-theta),

            axis=1L

        )



    log_c <-

        tf$math$log(1+theta)

        -

        (theta+1)*

        tf$reduce_sum(

            tf$math$log(u),

            axis=1L

        )

        -

        (2+1/theta)*

        tf$math$log(

            S-1+1e-6

        )



    penalty <-

        -tf$reduce_mean(

            log_c

        )



    lambda <-

        tf$constant(

            0.1,

            dtype=tf$float32

        )



    bce+

        lambda*penalty

}

# ===============================================================
# 16. Gumbel Copula Loss
# ===============================================================


copula_gumbel_loss <- function(
    y_true,
    y_pred
){


    bce <-

        bce_loss(

            y_true,

            y_pred

        )



    u <-

        to_uniform_tf(

            y_pred[,2:3]

        )



    theta <-

        tf$constant(

            2.0,

            dtype=tf$float32

        )



    log_u <-

        -tf$math$log(u)



    phi <-

        log_u^theta



    S <-

        tf$reduce_sum(

            phi,

            axis=1L

        )



    log_C <-

        -S^(1/theta)



    log_c <-

        log_C+

        (1/theta-1)*

        tf$math$log(

            S+1e-6

        )



    penalty <-

        -tf$reduce_mean(

            log_c

        )



    lambda <-

        tf$constant(

            0.1,

            dtype=tf$float32

        )



    bce+

        lambda*penalty

}

# ===============================================================
# 17. CNN-LSTM Builder
# ===============================================================


create_copula_cnn_lstm <- function(
    
    loss_function,
    
    n_features=length(features)

){


    input <-

        layer_input(

            shape=c(

                1,

                n_features

            ),

            name="Clinical_Input"

        )



    x <-

        input %>%

        layer_conv_1d(

            filters=32,

            kernel_size=1,

            activation="relu",

            padding="same"

        ) %>%


        layer_batch_normalization() %>%


        layer_dropout(

            rate=0.2

        )



    x <-

        x %>%

        layer_lstm(

            units=32,

            dropout=0.1,

            recurrent_dropout=0.1

        )



    x <-

        x %>%

        layer_dense(

            units=32,

            activation="relu"

        )



    x <-

        x %>%

        layer_dropout(

            rate=0.2

        )



    output <-

        x %>%

        layer_dense(

            units=3,

            activation="sigmoid",

            name="Risk_Output"

        )



    model <-

        keras_model(

            input,

            output

        )


model$compile(
    optimizer = keras$optimizers$Adam(
        learning_rate = 0.001
    ),
    loss = loss_function,
    metrics = list("accuracy")
)




    return(model)

}

