# ================================================================
# TensorFlow utility
# ================================================================

to_uniform_tf <- function(x){

  u <- tf$math$sigmoid(
        tf$cast(x, tf$float32)
      )

  tf$clip_by_value(
      u,
      1e-6,
      1-1e-6
  )

}

# ================================================================
# Synthetic competing-risk data
# ================================================================

generate_data <- function(n){

    X <- matrix(
        rnorm(n*p),
        nrow=n,
        ncol=p
    )

    colnames(X) <- covariates

    df <- data.frame(

        id=1:n,

        X

    )

    ############################################################
    ## Linear predictors
    ############################################################

    lp1 <-
        2*df$x1 -
        df$x2 +
        1.5*df$x3

    lp2 <-
       -df$x1 +
        2*df$x2 -
        df$x4

    ############################################################
    ## Cause-specific event times
    ############################################################

    df$time1 <-
        -log(runif(n))/
        (baseline_hazard*exp(lp1))

    df$time2 <-
        -log(runif(n))/
        (baseline_hazard*exp(lp2))

    ############################################################
    ## Independent censoring
    ############################################################

    censor_time <-
        rexp(n,0.01)

    true_time <-
        pmin(df$time1,
             df$time2)

    true_event <-
        ifelse(
            df$time1<df$time2,
            1,
            2
        )

    df$time <-
        pmin(
            true_time,
            censor_time
        )

    df$event <-
        ifelse(
            censor_time<true_time,
            0,
            true_event
        )

    df

}

# ================================================================
# Binary Cross-Entropy
# ================================================================

bce_loss <- function(y_true, y_pred){

    tf$reduce_mean(

        tf$keras$losses$binary_crossentropy(
            y_true,
            y_pred
        )

    )

}

# ================================================================
# Gaussian Copula Loss
# ================================================================

copula_gaussian_loss <- function(y_true, y_pred){

    ############################################################
    ## Prediction loss
    ############################################################

    bce <- bce_loss(y_true, y_pred)

    ############################################################
    ## Cause-specific outputs only
    ############################################################

    u <- to_uniform_tf(

        y_pred[,2:3]

    )

    rho <- tf$constant(
        0.50,
        dtype=tf$float32
    )

    z <- tf$sqrt(2.0) *
        tf$math$erfinv(
            2*u-1
        )

    z1 <- z[,1]
    z2 <- z[,2]

    detR <- 1-rho^2

    quad <-

        (z1^2+
         z2^2-
         2*rho*z1*z2)/detR

    copula_penalty <-

        -tf$reduce_mean(

            -0.5*quad-
            0.5*tf$math$log(detR)

        )

    lambda <- tf$constant(
        0.10,
        dtype=tf$float32
    )

    bce + lambda*copula_penalty

}

# ================================================================
# Clayton Copula Loss
# ================================================================

copula_clayton_loss <- function(y_true,y_pred){

    bce <- bce_loss(
        y_true,
        y_pred
    )

    u <- to_uniform_tf(

        y_pred[,2:3]

    )

    theta <- tf$constant(
        1.50,
        dtype=tf$float32
    )

    S <-

        tf$reduce_sum(

            u^(-theta),

            axis=1L

        )

    log_c <-

        tf$math$log(1+theta)

        -

        (theta+1)*

        tf$reduce_sum(

            tf$math$log(u),

            axis=1L

        )

        -

        (2+1/theta)*

        tf$math$log(

            S-1+1e-6

        )

    copula_penalty <-

        -tf$reduce_mean(log_c)

    lambda <- tf$constant(
        0.10,
        dtype=tf$float32
    )

    bce +

        lambda*

        copula_penalty

}

# ================================================================
# Gumbel Copula Loss
# ================================================================

copula_gumbel_loss <- function(y_true,y_pred){

    bce <- bce_loss(
        y_true,
        y_pred
    )

    u <- to_uniform_tf(

        y_pred[,2:3]

    )

    theta <- tf$constant(
        2.0,
        dtype=tf$float32
    )

    log_u <-

        -tf$math$log(u)

    phi <-

        log_u^theta

    S <-

        tf$reduce_sum(

            phi,

            axis=1L

        )

    log_C <-

        -S^(1/theta)

    log_c <-

        log_C +

        (1/theta-1)*

        tf$math$log(

            S+1e-6

        ) +

        tf$reduce_sum(

            (theta-1)*

            tf$math$log(

                log_u+1e-6

            )

            -

            tf$math$log(

                u+1e-6

            ),

            axis=1L

        ) +

        tf$math$log(

            1+

            (theta-1)*

            S^(-1/theta)

        )

    copula_penalty <-

        -tf$reduce_mean(log_c)

    lambda <- tf$constant(
        0.10,
        dtype=tf$float32
    )

    bce +

        lambda*

        copula_penalty

}

# ================================================================
# 3. CNN-LSTM Model Builder
# ================================================================

create_model <- function(
    loss_fn,
    n_features = length(covariates),
    n_outputs = 3
){

    ############################################################
    ## Input Layer
    ############################################################

    inputs <- layer_input(

        shape = c(1, n_features),

        name = "Input"

    )

    ############################################################
    ## CNN Feature Extraction
    ############################################################

    x <- inputs %>%

        layer_conv_1d(

            filters = 32,

            kernel_size = 1,

            activation = "relu",

            padding = "same",

            name = "Conv1"

        ) %>%

        layer_batch_normalization(

            name = "BN1"

        ) %>%

        layer_dropout(

            rate = 0.20,

            name = "Dropout1"

        )

    ############################################################
    ## LSTM Layer
    ############################################################

    x <- x %>%

        layer_lstm(

            units = 32,

            activation = "tanh",

            recurrent_dropout = 0.10,

            name = "LSTM"

        )

    ############################################################
    ## Dense Layers
    ############################################################

    x <- x %>%

        layer_dense(

            units = 32,

            activation = "relu",

            name = "Dense1"

        ) %>%

        layer_dropout(

            rate = 0.20,

            name = "Dropout2"

        )

    ############################################################
    ## Output Layer
    ############################################################

    outputs <- x %>%

        layer_dense(

            units = n_outputs,

            activation = "sigmoid",

            name = "Output"

        )

    ############################################################
    ## Build Model
    ############################################################

    model <- keras_model(

        inputs = inputs,

        outputs = outputs

    )

    ############################################################
    ## Compile
    ############################################################

    model %>% compile(

        optimizer = optimizer_adam(

            learning_rate = learning_rate

        ),

        loss = loss_fn,

        metrics = list("accuracy")

    )

    return(model)

}

# ================================================================
# 4. Compute Cause-Specific Cumulative Incidence Functions (CIF)
# ================================================================

compute_cif_realistic <- function(
    model,
    df,
    times,
    model_name,
    time_step = 1
){

    ############################################################
    ## Prediction
    ############################################################

    Xd <- array(

        as.matrix(df[, covariates]),

        dim = c(
            nrow(df),
            1,
            length(covariates)
        )

    )

    preds <- predict(
        model,
        Xd,
        verbose = 0
    )

    ############################################################
    ## Cause-specific hazards
    ############################################################

    h1 <- pmin(
        pmax(preds[,2],0),
        1
    )

    h2 <- pmin(
        pmax(preds[,3],0),
        1
    )

    ############################################################
    ## Storage
    ############################################################

    n_subjects <- nrow(df)

    n_times <- length(times)

    cif1 <- matrix(
        0,
        n_subjects,
        n_times
    )

    cif2 <- matrix(
        0,
        n_subjects,
        n_times
    )

    surv <- matrix(
        1,
        n_subjects,
        n_times
    )

    ############################################################
    ## Recursive CIF calculation
    ############################################################

    for(t in seq_len(n_times)){

        if(t==1){

            surv_prev <- rep(
                1,
                n_subjects
            )

        }else{

            surv_prev <- surv[,t-1]

        }

        cif1[,t] <-

            if(t==1){

                surv_prev*h1*time_step

            }else{

                cif1[,t-1] +

                surv_prev*h1*time_step

            }

        cif2[,t] <-

            if(t==1){

                surv_prev*h2*time_step

            }else{

                cif2[,t-1] +

                surv_prev*h2*time_step

            }

        surv[,t] <-

            pmax(

                1-

                cif1[,t]-

                cif2[,t],

                0

            )

    }

    ############################################################
    ## Average CIF
    ############################################################

    data.frame(

        Time = times,

        CIF1 = colMeans(cif1),

        CIF2 = colMeans(cif2),

        Survival = colMeans(surv),

        Model = model_name

    )

}

