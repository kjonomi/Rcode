# ===============================================================
# 2. TensorFlow Utility
# ===============================================================


to_uniform_tf <- function(x){

    u <- tf$math$sigmoid(
        tf$cast(
            x,
            tf$float32
        )
    )

    tf$clip_by_value(
        u,
        1e-6,
        1-1e-6
    )

}



# ===============================================================
# 3. Generate Competing Risk Data
# ===============================================================


generate_data <- function(n){


    X <- matrix(

        rnorm(
            n*p
        ),

        nrow=n,

        ncol=p

    )


    colnames(X) <- covariates


    df <- data.frame(

        id=1:n,

        X

    )


    # Cause 1 hazard

    lp1 <-

        2*df$x1 -

        df$x2 +

        1.5*df$x3



    # Cause 2 hazard

    lp2 <-

        -df$x1 +

        2*df$x2 -

        df$x4



############################################################
# Nonlinear predictors
############################################################

lp1 <-

    1.5*sin(df$x1) +

    0.8*(df$x2)^2 -

    1.2*log(abs(df$x3)+1) +

    0.6*df$x4*df$x5


lp2 <-

    -1.2*cos(df$x1) +

    0.5*(df$x2)^3 -

    0.8*sqrt(abs(df$x3)+1) +

    0.7*df$x4*df$x5

############################################################
# Weibull parameters
############################################################

shape1 <- 1.5

shape2 <- 2.0

lambda1 <- 0.01

lambda2 <- 0.015

############################################################
# Uniform variables
############################################################

u1 <- runif(n)

u2 <- runif(n)

############################################################
# Nonlinear Weibull event times
############################################################

df$time1 <-

    (-log(u1) /

        (lambda1*exp(lp1)))^(1/shape1)


df$time2 <-

    (-log(u2) /

        (lambda2*exp(lp2)))^(1/shape2)


    # Censoring

    censor_time <-

        rexp(
            n,
            0.01
        )



    true_time <-

        pmin(
            df$time1,
            df$time2
        )



    true_event <-

        ifelse(

            df$time1 < df$time2,

            1,

            2

        )



    df$time <-

        pmin(
            true_time,
            censor_time
        )



    df$event <-

        ifelse(

            censor_time < true_time,

            0,

            true_event

        )


    return(df)

}





# ===============================================================
# 4. Binary Cross Entropy
# ===============================================================


bce_loss <- function(
    y_true,
    y_pred
){


    tf$reduce_mean(

        tf$keras$losses$

            binary_crossentropy(

                y_true,

                y_pred

            )

    )

}






# ===============================================================
# 5. Gaussian Copula Loss
# ===============================================================


copula_gaussian_loss <- function(
    y_true,
    y_pred
){


    bce <- bce_loss(
        y_true,
        y_pred
    )



    u <- to_uniform_tf(

        y_pred[,2:3]

    )


    rho <- tf$constant(
        0.5,
        dtype=tf$float32
    )



    z <-

        tf$sqrt(2.0) *

        tf$math$erfinv(

            2*u-1

        )



    z1 <- z[,1]

    z2 <- z[,2]



    detR <- 1-rho^2



    quad <-

        (z1^2+

             z2^2-

             2*rho*z1*z2)/detR



    penalty <-

        -tf$reduce_mean(

            -0.5*quad -

                0.5*
                tf$math$log(detR)

        )



    lambda <- tf$constant(
        0.1,
        dtype=tf$float32
    )


    bce +

        lambda*penalty

}






# ===============================================================
# 6. Clayton Copula Loss
# ===============================================================


copula_clayton_loss <- function(
    y_true,
    y_pred
){


    bce <- bce_loss(
        y_true,
        y_pred
    )


    u <- to_uniform_tf(

        y_pred[,2:3]

    )


    theta <- tf$constant(
        1.5,
        dtype=tf$float32
    )



    S <-

        tf$reduce_sum(

            u^(-theta),

            axis=1L

        )



    log_c <-

        tf$math$log(1+theta)

        -

        (theta+1)*

        tf$reduce_sum(

            tf$math$log(u),

            axis=1L

        )

        -

        (2+1/theta)*

        tf$math$log(

            S-1+1e-6

        )



    penalty <-

        -tf$reduce_mean(log_c)



    lambda <- tf$constant(
        0.1,
        dtype=tf$float32
    )


    bce +

        lambda*penalty

}






# ===============================================================
# 7. Gumbel Copula Loss
# ===============================================================


copula_gumbel_loss <- function(
    y_true,
    y_pred
){

    bce <- bce_loss(
        y_true,
        y_pred
    )


    u <- to_uniform_tf(

        y_pred[,2:3]

    )


    theta <- tf$constant(
        2.0,
        dtype=tf$float32
    )


    log_u <-

        -tf$math$log(u)



    phi <-

        log_u^theta



    S <-

        tf$reduce_sum(

            phi,

            axis=1L

        )



    log_C <-

        -S^(1/theta)



    log_c <-

        log_C +

        (1/theta-1)*

        tf$math$log(

            S+1e-6

        )



    penalty <-

        -tf$reduce_mean(log_c)



    lambda <- tf$constant(
        0.1,
        dtype=tf$float32
    )


    bce +

        lambda*penalty

}

# ===============================================================
# 8. CNN-LSTM Model Builder
# ===============================================================


create_model <- function(
    loss_fn,
    n_features=length(covariates),
    n_outputs=3
){


    inputs <-

        layer_input(

            shape=c(
                1,
                n_features
            ),

            name="Input"

        )



    x <- inputs %>%

        layer_conv_1d(

            filters=32,

            kernel_size=1,

            activation="relu",

            padding="same",

            name="CNN"

        ) %>%

        layer_batch_normalization() %>%

        layer_dropout(
            rate=0.2
        )



    x <- x %>%

        layer_lstm(

            units=32,

            dropout=0.1,

            recurrent_dropout=0.1,

            name="LSTM"

        )



    x <- x %>%

        layer_dense(

            units=32,

            activation="relu"

        ) %>%

        layer_dropout(

            rate=0.2

        )



    outputs <-

        x %>%

        layer_dense(

            units=n_outputs,

            activation="sigmoid",

            name="Risk_Output"

        )



    model <-

        keras_model(

            inputs=inputs,

            outputs=outputs

        )



    model %>%

        compile(

            optimizer=
                optimizer_adam(

                    learning_rate=
                        learning_rate

                ),

            loss=loss_fn,

            metrics=list(
                "accuracy"
            )

        )



    return(model)

}





# ===============================================================
# 9. Compute CIF Function
# ===============================================================


compute_cif_realistic <- function(

    model,

    df,

    times,

    model_name,

    time_step=1

){


    Xd <-

        array(

            as.matrix(

                df[,covariates,drop=FALSE]

            ),

            dim=c(

                nrow(df),

                1,

                length(covariates)

            )

        )



    preds <-

        predict(

            model,

            Xd,

            verbose=0

        )



    # Cause-specific hazards

    h1 <-

        pmin(

            preds[,2]*0.05,

            0.95

        )



    h2 <-

        pmin(

            preds[,3]*0.05,

            0.95

        )



    n_subjects <-

        nrow(df)


    n_times <-

        length(times)



    cif1 <-

        matrix(

            0,

            n_subjects,

            n_times

        )



    cif2 <-

        matrix(

            0,

            n_subjects,

            n_times

        )



    survival_prob <-

        matrix(

            1,

            n_subjects,

            n_times

        )




    for(t in seq_len(n_times)){


        if(t==1){

            s_prev <-

                rep(
                    1,
                    n_subjects
                )

        }else{

            s_prev <-

                survival_prob[,t-1]

        }



        cif1[,t] <-

            if(t==1){

                s_prev*h1*time_step

            }else{

                cif1[,t-1] +

                    s_prev*h1*time_step

            }



        cif2[,t] <-

            if(t==1){

                s_prev*h2*time_step

            }else{

                cif2[,t-1] +

                    s_prev*h2*time_step

            }



        survival_prob[,t] <-

            pmax(

                1-

                    cif1[,t]-

                    cif2[,t],

                0

            )

    }




    data.frame(

        Time=times,

        CIF1=colMeans(cif1),

        CIF2=colMeans(cif2),

        Survival=colMeans(survival_prob),

        Model=model_name

    )

}





# ===============================================================
# 10. Bootstrap Cause-specific C-index
# ===============================================================


cindex_cause_boot_fn <- function(

    data,

    indices,

    model,

    cause=1

){


    d <-

        data[indices,]



    if(

        sum(d$event==cause)<2

    ){

        return(NA)

    }



    Xd <-

        array(

            as.matrix(

                d[,covariates,drop=FALSE]

            ),

            dim=c(

                nrow(d),

                1,

                length(covariates)

            )

        )



    pred <-

        predict(

            model,

            Xd,

            verbose=0

        )



    if(cause==1){

        score <- pred[,2]

    }else{

        score <- pred[,3]

    }



    result <-

        rcorr.cens(

            score,

            Surv(

                d$time,

                ifelse(

                    d$event==cause,

                    1,

                    0

                )

            )

        )



    as.numeric(

        result["C Index"]

    )

}





# ===============================================================
# 11. Bootstrap Confidence Interval
# ===============================================================


ci_safe <- function(b){


    if(

        all(is.na(b$t))

        ||

        sd(
            b$t,
            na.rm=TRUE
        )==0

    ){

        return(
            c(NA,NA)
        )

    }



    tryCatch(

        boot.ci(

            b,

            type="perc"

        )$percent[4:5],

        error=function(e)

            c(NA,NA)

    )

}

# ===============================================================
# 12. Bootstrap All Models
# ===============================================================


bootstrap_all_models <- function(

    model_list,

    df_test,

    B=50

){


    ############################################################
    # Cause 1
    ############################################################

    boot_c1 <-

        lapply(

            model_list,

            function(m){


                boot(

                    data=df_test,


                    statistic=function(d,i){


                        cindex_cause_boot_fn(

                            d,

                            i,

                            m,

                            cause=1

                        )


                    },


                    R=B

                )


            }

        )



    ############################################################
    # Cause 2
    ############################################################


    boot_c2 <-

        lapply(

            model_list,

            function(m){


                boot(

                    data=df_test,


                    statistic=function(d,i){


                        cindex_cause_boot_fn(

                            d,

                            i,

                            m,

                            cause=2

                        )


                    },


                    R=B

                )


            }

        )





    ############################################################
    # Summary
    ############################################################


    data.frame(

        Model=names(model_list),


        C_index_Cause1=

            sapply(

                boot_c1,

                function(x)

                    mean(

                        x$t,

                        na.rm=TRUE

                    )

            ),


        CI_lower_Cause1=

            sapply(

                boot_c1,

                function(x)

                    ci_safe(x)[1]

            ),


        CI_upper_Cause1=

            sapply(

                boot_c1,

                function(x)

                    ci_safe(x)[2]

            ),



        C_index_Cause2=

            sapply(

                boot_c2,

                function(x)

                    mean(

                        x$t,

                        na.rm=TRUE

                    )

            ),


        CI_lower_Cause2=

            sapply(

                boot_c2,

                function(x)

                    ci_safe(x)[1]

            ),


        CI_upper_Cause2=

            sapply(

                boot_c2,

                function(x)

                    ci_safe(x)[2]

            )


    )

}






