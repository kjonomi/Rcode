###############################################################
# 12. Transform to Uniform
###############################################################


to_uniform_tf <- function(x){

    u <-

        tf$math$sigmoid(

            x

        )


    tf$clip_by_value(

        u,

        1e-6,

        1-1e-6

    )

}



###############################################################
# 13. Binary Cross Entropy
###############################################################


bce_loss <- function(
    y_true,
    y_pred
){


    tf$reduce_mean(

        tf$keras$losses$

            binary_crossentropy(

                y_true,

                y_pred

            )

    )

}



###############################################################
# 14. Gaussian Copula Loss
###############################################################


copula_gaussian_loss <- function(
    y_true,
    y_pred
){


    bce <-

        bce_loss(

            y_true,

            y_pred

        )


    # recurrence + death

    u <-

        to_uniform_tf(

            y_pred[,2:3]

        )



    z <-

        tf$sqrt(2.0) *

        tf$math$erfinv(

            2*u-1

        )



    z1 <- z[,1]

    z2 <- z[,2]



    rho <- 0.5



    detR <-

        1-rho^2



    quad <-

        (

            z1^2+

            z2^2-

            2*rho*z1*z2

        )/

        detR



    log_density <-

        -0.5*quad -

        0.5*

        tf$math$log(detR)



    penalty <-

        -tf$reduce_mean(

            log_density

        )



    lambda <- 0.25



    bce +

        lambda*penalty

}





###############################################################
# 15. Clayton Copula Loss
###############################################################


copula_clayton_loss <- function(
    y_true,
    y_pred
){


    bce <-

        bce_loss(

            y_true,

            y_pred

        )


    u <-

        to_uniform_tf(

            y_pred[,2:3]

        )



    theta <- 1.5



    S <-

        tf$reduce_sum(

            u^(-theta),

            axis=1L

        )



    log_c <-

        tf$math$log(

            1+theta

        )

        -

        (theta+1)*

        tf$reduce_sum(

            tf$math$log(u),

            axis=1L

        )

        -

        (2+1/theta)*

        tf$math$log(

            S-1+1e-6

        )



    penalty <-

        -tf$reduce_mean(

            log_c

        )



    bce +

        0.25*penalty

}




###############################################################
# 16. Gumbel Copula Loss
###############################################################


copula_gumbel_loss <- function(
    y_true,
    y_pred
){


    bce <-

        bce_loss(

            y_true,

            y_pred

        )



    u <-

        to_uniform_tf(

            y_pred[,2:3]

        )



    theta <- 2.0



    logu <-

        -tf$math$log(u)



    phi <-

        logu^theta



    S <-

        tf$reduce_sum(

            phi,

            axis=1L

        )



    log_c <-

        -S^(1/theta)



    penalty <-

        -tf$reduce_mean(

            log_c

        )



    bce +

        0.25*penalty

}





###############################################################
# 17. CNN-LSTM Builder
###############################################################


create_copula_cnn_lstm <- function(
    
    loss_function,
    
    n_features
    
){


    input <-

        keras_input(

            shape=c(

                1,

                n_features

            ),

            name="Clinical_Input"

        )



    x <-

        input %>%

        layer_conv_1d(

            filters=32,

            kernel_size=1,

            padding="same",

            activation="relu"

        ) %>%


        layer_batch_normalization() %>%


        layer_dropout(

            rate=0.2

        )



    x <-

        x %>%

        layer_lstm(

            units=32,

            dropout=0.1,

            recurrent_dropout=0.1

        )



    x <-

        x %>%

        layer_dense(

            units=32,

            activation="relu"

        )



    x <-

        x %>%

        layer_dropout(

            rate=0.2

        )



    output <-

        x %>%

        layer_dense(

            units=3,

            activation="sigmoid",

            name="Risk_Output"

        )



    model <-

        keras_model(

            inputs=input,

            outputs=output

        )



    model %>% compile(

        optimizer=

            optimizer_adam(

                learning_rate=0.001

            ),

        loss=

            loss_function,

        metrics=

            list(

                "accuracy"

            )

    )


    return(model)

}





