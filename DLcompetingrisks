        cif1[,t] <-

            if(t==1){

                s_prev*h1*time_step

            }else{

                cif1[,t-1] +

                    s_prev*h1*time_step

            }



        cif2[,t] <-

            if(t==1){

                s_prev*h2*time_step

            }else{

                cif2[,t-1] +

                    s_prev*h2*time_step

            }



        survival_prob[,t] <-

            pmax(

                1-

                    cif1[,t]-

                    cif2[,t],

                0

            )

    }




    data.frame(

        Time=times,

        CIF1=colMeans(cif1),

        CIF2=colMeans(cif2),

        Survival=colMeans(survival_prob),

        Model=model_name

    )

}





# ===============================================================
# 10. Bootstrap Cause-specific C-index
# ===============================================================


cindex_cause_boot_fn <- function(

    data,

    indices,

    model,

    cause=1

){


    d <-

        data[indices,]



    if(

        sum(d$event==cause)<2

    ){

        return(NA)

    }



    Xd <-

        array(

            as.matrix(

                d[,covariates,drop=FALSE]

            ),

            dim=c(

                nrow(d),

                1,

                length(covariates)

            )

        )



    pred <-

        predict(

            model,

            Xd,

            verbose=0

        )



    if(cause==1){

        score <- pred[,2]

    }else{

        score <- pred[,3]

    }



    result <-

        rcorr.cens(

            score,

            Surv(

                d$time,

                ifelse(

                    d$event==cause,

                    1,

                    0

                )

            )

        )



    as.numeric(

        result["C Index"]

    )

}





# ===============================================================
# 11. Bootstrap Confidence Interval
# ===============================================================


ci_safe <- function(b){


    if(

        all(is.na(b$t))

        ||

        sd(
            b$t,
            na.rm=TRUE
        )==0

    ){

        return(
            c(NA,NA)
        )

    }



    tryCatch(

        boot.ci(

            b,

            type="perc"

        )$percent[4:5],

        error=function(e)

            c(NA,NA)

    )

}

# ===============================================================
# 12. Bootstrap All Models
# ===============================================================


bootstrap_all_models <- function(

    model_list,

    df_test,

    B=50

){


    ############################################################
    # Cause 1
    ############################################################

    boot_c1 <-

        lapply(

            model_list,

            function(m){


                boot(

                    data=df_test,


                    statistic=function(d,i){


                        cindex_cause_boot_fn(

                            d,

                            i,

                            m,

                            cause=1

                        )


                    },


                    R=B

                )


            }

        )



    ############################################################
    # Cause 2
    ############################################################


    boot_c2 <-

        lapply(

            model_list,

            function(m){


                boot(

                    data=df_test,


                    statistic=function(d,i){


                        cindex_cause_boot_fn(

                            d,

                            i,

                            m,

                            cause=2

                        )


                    },


                    R=B

                )


            }

        )





    ############################################################
    # Summary
    ############################################################


    data.frame(

        Model=names(model_list),


        C_index_Cause1=

            sapply(

                boot_c1,

                function(x)

                    mean(

                        x$t,

                        na.rm=TRUE

                    )

            ),


        CI_lower_Cause1=

            sapply(

                boot_c1,

                function(x)

                    ci_safe(x)[1]

            ),


        CI_upper_Cause1=

            sapply(

                boot_c1,

                function(x)

                    ci_safe(x)[2]

            ),



        C_index_Cause2=

            sapply(

                boot_c2,

                function(x)

                    mean(

                        x$t,

                        na.rm=TRUE

                    )

            ),


        CI_lower_Cause2=

            sapply(

                boot_c2,

                function(x)

                    ci_safe(x)[1]

            ),


        CI_upper_Cause2=

            sapply(

                boot_c2,

                function(x)

                    ci_safe(x)[2]

            )


    )

}






