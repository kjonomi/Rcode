###############################################################
# 5.2 Convert Risk Score to CIF
###############################################################

risk_to_cif <-

function(

    risk,

    times

){


    risk <-

        pmin(

            pmax(

                risk,

                1e-6

            ),

            1-1e-6

        )



    cif <-

        outer(

            risk,

            times,

            function(r,t)

                1-exp(

                    -r*t/max(times)

                )

        )



    cif

}



