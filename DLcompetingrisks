###############################################################
# 67. Brier Score Function
###############################################################


brier_score <- function(

    observed,

    predicted

){


    mean(

        (

            observed -

            predicted

        )^2,

        na.rm=TRUE

    )

}



###############################################################
# 68. Create Binary Event Indicators
###############################################################


# Death by time


