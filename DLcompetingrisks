###############################################################
# 29. CIF Prediction Function
###############################################################


predict_CIF <- function(
    
    risk,
    
    times
    
){


    n <-

        nrow(risk)



    cif_recur <-

        matrix(

            0,

            nrow=n,

            ncol=length(times)

        )


    cif_death <-

        matrix(

            0,

            nrow=n,

            ncol=length(times)

        )


    for(i in 1:n){


        h1 <-

            risk$Recurrence[i]



        h2 <-

            risk$Death[i]



        total <-

            h1+h2+1e-6



        cif_recur[i,] <-

            (h1/total)*

            (1-exp(-times/mean(time_test)))



        cif_death[i,] <-

            (h2/total)*

            (1-exp(-times/mean(time_test)))


    }



    data.frame(

        Time=times,


        CIF_Recurrence=

            colMeans(cif_recur),


        CIF_Death=

            colMeans(cif_death)

    )

}




