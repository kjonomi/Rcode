to_uniform_tf <- function(x){

    u <- tf$math$sigmoid(
        tf$cast(
            x,
            tf$float32
        )
    )

    tf$clip_by_value(
        u,
        1e-6,
        1-1e-6
    )

}


# ===============================================================
# 3. Generate High-Correlation Competing Risk Data
# ===============================================================

generate_data <- function(n){

    ############################################################
    # AR(1) covariance matrix
    ############################################################

    rho <- 0.90

    Sigma <- outer(

        1:p,

        1:p,

        function(i,j) rho^abs(i-j)

    )

    ############################################################
    # Multivariate normal predictors
    ############################################################

    X <- MASS::mvrnorm(

        n = n,

        mu = rep(0,p),

        Sigma = Sigma

    )

    colnames(X) <- covariates

    df <- data.frame(

        id = 1:n,

        X

    )

    ############################################################
    # Nonlinear predictors
    ############################################################

############################################################
# Cause 1 Linear Predictor (30 variables)
############################################################

lp1 <-

    1.5*sin(df$x1) +

    0.8*(df$x2)^2 -

    1.2*log(abs(df$x3)+1) +

    0.6*df$x4*df$x5 +

    0.7*cos(df$x6) -

    0.5*(df$x7)^2 +

    0.8*df$x8*df$x9 +

    0.4*exp(df$x10/3) -

    0.6*sqrt(abs(df$x11)+1) +

    0.5*df$x12 +

    0.8*sin(df$x13*df$x14) -

    0.7*log(abs(df$x15)+1) +

    0.5*(df$x16)^2 -

    0.6*df$x17*df$x18 +

    0.7*cos(df$x19) +

    0.5*df$x20 -

    0.8*exp(-abs(df$x21)) +

    0.6*df$x22*df$x23 -

    0.5*(df$x24)^2 +

    0.7*sin(df$x25) +

    0.4*df$x26 +

    0.6*log(abs(df$x27)+1) -

    0.5*df$x28*df$x29 +

    0.8*df$x30


############################################################
# Cause 2 Linear Predictor (30 variables)
############################################################

lp2 <-

    3*sin(df$x1) +

    2*(df$x2)^2 -

    2*log(abs(df$x3)+1) +

    1.5*df$x4*df$x5 +

    1.2*cos(df$x6) -

    1.0*(df$x7)^2 +

    1.1*df$x8*df$x9 +

    0.8*exp(df$x10/3) -

    1.0*sqrt(abs(df$x11)+1) +

    0.9*df$x12 +

    1.2*sin(df$x13*df$x14) -

    1.1*log(abs(df$x15)+1) +

    0.8*(df$x16)^2 -

    0.9*df$x17*df$x18 +

    1.0*cos(df$x19) +

    0.7*df$x20 -

    1.1*exp(-abs(df$x21)) +

    0.9*df$x22*df$x23 -

    0.8*(df$x24)^2 +

    1.0*sin(df$x25) +

    0.7*df$x26 +

    0.9*log(abs(df$x27)+1) -

    0.8*df$x28*df$x29 +

    1.2*df$x30


    ############################################################
    # Weibull parameters
    ############################################################

    shape1 <- 2.5

    shape2 <- 3.0

    lambda1 <- 0.01

    lambda2 <- 0.015

    ############################################################
    # Weibull event times
    ############################################################

    u1 <- runif(n)

    u2 <- runif(n)

    df$time1 <-

        (-log(u1) /

            (lambda1*exp(lp1)))^(1/shape1)

    df$time2 <-

        (-log(u2) /

            (lambda2*exp(lp2)))^(1/shape2)

    ############################################################
    # Independent censoring
    ############################################################

    censor_time <- rexp(

        n,

        rate = 0.01

    )

    true_time <- pmin(

        df$time1,

        df$time2

    )

    true_event <- ifelse(

        df$time1 < df$time2,

        1,

        2

    )

    df$time <- pmin(

        true_time,

        censor_time

    )

    df$event <- ifelse(

        censor_time < true_time,

        0,

        true_event

    )

    return(df)

}




# ===============================================================
# 4. Binary Cross Entropy
# ===============================================================


bce_loss <- function(
    y_true,
    y_pred
){


    tf$reduce_mean(

        tf$keras$losses$

            binary_crossentropy(

                y_true,

                y_pred

            )

    )

}






# ===============================================================
# 5. Gaussian Copula Loss
# ===============================================================


copula_gaussian_loss <- function(
    y_true,
    y_pred
){


    bce <- bce_loss(
        y_true,
        y_pred
    )



    u <- to_uniform_tf(

        y_pred[,2:3]

    )


    rho <- tf$constant(
        0.5,
        dtype=tf$float32
    )



    z <-

        tf$sqrt(2.0) *

        tf$math$erfinv(

            2*u-1

        )



    z1 <- z[,1]

    z2 <- z[,2]



    detR <- 1-rho^2



    quad <-

        (z1^2+

             z2^2-

             2*rho*z1*z2)/detR



    penalty <-

        -tf$reduce_mean(

            -0.5*quad -

                0.5*
                tf$math$log(detR)

        )



    lambda <- tf$constant(
        0.1,
        dtype=tf$float32
    )


    bce +

        lambda*penalty

}






# ===============================================================
# 6. Clayton Copula Loss
# ===============================================================


copula_clayton_loss <- function(
    y_true,
    y_pred
){


    bce <- bce_loss(
        y_true,
        y_pred
    )


    u <- to_uniform_tf(

        y_pred[,2:3]

    )


    theta <- tf$constant(
        1.5,
        dtype=tf$float32
    )



    S <-

        tf$reduce_sum(

            u^(-theta),

            axis=1L

        )



    log_c <-

        tf$math$log(1+theta)

        -

        (theta+1)*

        tf$reduce_sum(

            tf$math$log(u),

            axis=1L

        )

        -

        (2+1/theta)*

        tf$math$log(

            S-1+1e-6

        )



    penalty <-

        -tf$reduce_mean(log_c)



    lambda <- tf$constant(
        0.1,
        dtype=tf$float32
    )


    bce +

        lambda*penalty

}






# ===============================================================
# 7. Gumbel Copula Loss
# ===============================================================


copula_gumbel_loss <- function(
    y_true,
    y_pred
){

    bce <- bce_loss(
        y_true,
        y_pred
    )


    u <- to_uniform_tf(

        y_pred[,2:3]

    )


    theta <- tf$constant(
        2.0,
        dtype=tf$float32
    )


    log_u <-

        -tf$math$log(u)



    phi <-

        log_u^theta



    S <-

        tf$reduce_sum(

            phi,

            axis=1L

        )



    log_C <-

        -S^(1/theta)



    log_c <-

        log_C +

        (1/theta-1)*

        tf$math$log(

            S+1e-6

        )



    penalty <-

        -tf$reduce_mean(log_c)



    lambda <- tf$constant(
        0.1,
        dtype=tf$float32
    )


    bce +

        lambda*penalty

}

# ===============================================================
# 8. CNN-LSTM Model Builder
# ===============================================================


create_model <- function(
    loss_fn,
    n_features=length(covariates),
    n_outputs=3
){


    inputs <-

        layer_input(

            shape=c(
                1,
                n_features
            ),

            name="Input"

        )



    x <- inputs %>%

        layer_conv_1d(

            filters=32,

            kernel_size=1,

            activation="relu",

            padding="same",

            name="CNN"

        ) %>%

        layer_batch_normalization() %>%

        layer_dropout(
            rate=0.2
        )



    x <- x %>%

        layer_lstm(

            units=32,

            dropout=0.1,

            recurrent_dropout=0.1,

            name="LSTM"

        )



    x <- x %>%

        layer_dense(

            units=32,

            activation="relu"

        ) %>%

        layer_dropout(

            rate=0.2

        )



    outputs <-

        x %>%

        layer_dense(

            units=n_outputs,

            activation="sigmoid",

            name="Risk_Output"

        )



    model <-

        keras_model(

            inputs=inputs,

            outputs=outputs

        )



    model %>%

        compile(

            optimizer=
                optimizer_adam(

                    learning_rate=
                        learning_rate

                ),

            loss=loss_fn,

            metrics=list(
                "accuracy"
            )

        )



    return(model)

}





