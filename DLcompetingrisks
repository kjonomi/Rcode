###############################################################
# 12. Cause-specific C-index
###############################################################


cause_cindex <- function(
        time,
        status,
        risk,
        cause
){


    event <-

        ifelse(
            status==cause,
            1,
            0
        )



    result <-

        concordance.index(

            x=risk,

            surv.time=time,

            surv.event=event,

            method="noether"

        )



    result$c.index

}






###############################################################
# 13. Time-dependent AUC
###############################################################


compute_auc_cause <- function(

        risk,

        cause,

        test_data

){



    delta <-

        ifelse(
            test_data$status==cause,
            1,
            0
        )



    eval_times <-

        quantile(

            test_data$time,

            probs=c(
                0.25,
                0.50,
                0.75
            )

        )



    roc <-

        timeROC(

            T=test_data$time,

            delta=delta,

            marker=risk,

            cause=1,

            weighting="marginal",

            times=eval_times

        )



    mean(
        roc$AUC
    )

}






###############################################################
# 14. Brier Score
###############################################################


compute_brier_cause <- function(

        risk,

        cause,

        test_data

){



    observed <-

        ifelse(

            test_data$status==cause,

            1,

            0

        )



    mean(

        (observed-risk)^2

    )


}






