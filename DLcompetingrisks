# ===============================================================
# 30. Cause-specific C-index
# ===============================================================


cause_cindex <- function(

    data,

    indices,

    model,

    cause=1

){


    d <-

        data[indices,]



    ############################################################
    # Event number check
    ############################################################


    if(sum(d$event==cause)<5){

        return(NA)

    }



    ############################################################
    # Create CNN input
    ############################################################


    Xd <-

        array(

            as.matrix(

                d[,features]

            ),

            dim=c(

                nrow(d),

                1,

                length(features)

            )

        )



    ############################################################
    # Prediction
    ############################################################


    pred <-

        predict(

            model,

            Xd,

            verbose=0

        )



    ############################################################
    # Cause-specific risk score
    ############################################################


    if(cause==1){

        score <-

            pred[,2]

    }else{


        score <-

            pred[,3]

    }



    ############################################################
    # C-index
    ############################################################


    result <-

        rcorr.cens(

            score,

            Surv(

                d$time,

                d$event==cause

            )

        )


    as.numeric(

        result["C Index"]

    )

}

