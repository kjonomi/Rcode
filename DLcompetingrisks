###############################################################
# 41. Safe timeROC Function
###############################################################


compute_timeROC <- function(
    
    time,
    
    event,
    
    marker,
    
    cause=2
    
){
    
    
    roc <- tryCatch(
        
        {
            
            timeROC(
                
                T=time,
                
                delta=event,
                
                marker=marker,
                
                cause=cause,
                
                weighting="marginal",
                
                iid=TRUE,
                
                times=c(
                    1000,
                    2000,
                    3000
                )
                
            )
            
        },
        
        error=function(e){
            
            message(
                "timeROC failed: ",
                e$message
            )
            
            return(NULL)
            
        }
        
    )
    
    
    return(roc)
    
}



