###############################################################
# 3. Global Simulation Parameters
###############################################################


set.seed(12345)

tf$random$set_seed(12345L)



n <- 3000


p <- 30


n_sim <- 150



train_fraction <- 0.70



epochs <- 100


batch_size <- 64



lambda_copula <- 0.5




###############################################################
# Data Generator
###############################################################


generate_data <- function(
        n,
        p
){


###############################################################
# Correlated Covariates
###############################################################


rho_x <- 0.8


Sigma <- matrix(
    rho_x,
    p,
    p
)


diag(Sigma) <- 1



X <- MASS::mvrnorm(
    n,
    rep(0,p),
    Sigma
)


colnames(X) <- paste0(
    "X",
    1:p
)



###############################################################
# Cause 1 Nonlinear Risk
###############################################################


eta1 <-

    0.8*X[,1] +

    0.6*X[,2]^2 -

    0.7*sin(X[,3]) +

    0.5*X[,4]*X[,5] +

    0.4*exp(-X[,6]^2) +

    0.5*X[,7]*X[,8] -

    0.4*log(abs(X[,9])+1) +

    0.5*cos(X[,10]) +

    0.3*X[,11]^3 +

    0.4*X[,12]*X[,13] +

    0.4*(X[,14]>0) +

    0.5*X[,15]




###############################################################
# Cause 2
###############################################################


eta2 <-

    -0.7*X[,16] +

    0.6*X[,17]^2 +

    0.5*cos(X[,18]) +

    0.5*X[,19]*X[,20] -

    0.4*exp(-X[,21]^2) +

    0.4*X[,22]*X[,23] +

    0.5*sin(X[,24]) +

    0.4*X[,25]^3 -

    0.4*log(abs(X[,26])+1) +

    0.4*X[,27]*X[,28] +

    0.4*(X[,29]>0) +

    0.5*X[,30]




eta1 <- pmax(pmin(eta1,5),-5)

eta2 <- pmax(pmin(eta2,5),-5)



###############################################################
# DEPENDENT EVENT TIMES
# Gaussian Copula
###############################################################


rho_event <- 0.8


Sigma_event <- matrix(
    c(
        1,rho_event,
        rho_event,1
    ),
    2,
    2
)



Z <- MASS::mvrnorm(
    n,
    c(0,0),
    Sigma_event
)


U1 <- pnorm(Z[,1])

U2 <- pnorm(Z[,2])





###############################################################
# Weibull Baseline Hazards
###############################################################

shape1 <- 2.5
shape2 <- 1.8


scale1 <- 0.5
scale2 <- 0.3


###############################################################
# Generate Event Times
###############################################################


U1 <- runif(n)

U2 <- runif(n)



T1 <-

(
-log(U1) /

(
scale1 *
exp(eta1)
)

)^(1/shape1)




T2 <-

(
-log(U2) /

(
scale2 *
exp(eta2)
)

)^(1/shape2)




###############################################################
# Weibull Censoring
###############################################################


