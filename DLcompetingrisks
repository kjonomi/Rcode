###############################################################
# 12. Cause-specific C-index
###############################################################


cause_cindex <- function(
        time,
        status,
        risk,
        cause
){


    event <-

        ifelse(
            status==cause,
            1,
            0
        )



    result <-

        concordance.index(

            x=risk,

            surv.time=time,

            surv.event=event,

            method="noether"

        )



    result$c.index

}






###############################################################
# 13. Time-dependent AUC
###############################################################


compute_auc_cause <- function(

        risk,

        cause,

        test_data

){



    delta <-

        ifelse(
            test_data$status==cause,
            1,
            0
        )



    eval_times <-

        quantile(

            test_data$time,

            probs=c(
                0.25,
                0.50,
                0.75
            )

        )



    roc <-

        timeROC(

            T=test_data$time,

            delta=delta,

            marker=risk,

            cause=1,

            weighting="marginal",

            times=eval_times

        )



    mean(
        roc$AUC
    )

}






###############################################################
# 14. Brier Score
###############################################################


compute_brier_cause <- function(

        risk,

        cause,

        test_data

){



    observed <-

        ifelse(

            test_data$status==cause,

            1,

            0

        )



    mean(

        (observed-risk)^2

    )


}






###############################################################
# 15. Run One Simulation
###############################################################


run_one_simulation <- function(

        sim_id

){



cat(
    "\n====================================\n"
)

cat(
    "Simulation:",
    sim_id,
    "\n"
)

cat(
    "====================================\n"
)





###############################################################
# Generate Data
###############################################################


sim_data <-

    generate_data(

        n,

        p

    )





###############################################################
# Train/Test Split
###############################################################


train_index <-

    sample(

        1:nrow(sim_data),

        size=

            floor(
                train_fraction*
                nrow(sim_data)
            )

    )



train_data <-

    sim_data[
        train_index,
    ]



test_data <-

    sim_data[
        -train_index,
    ]





###############################################################
# Extract Features
###############################################################


feature_names <-

    paste0(
        "X",
        1:p
    )



X_train <-

    as.matrix(

        train_data[,

        feature_names]

    )



X_test <-

    as.matrix(

        test_data[,

        feature_names]

    )






###############################################################
# Standardization
###############################################################


mu <-

    apply(
        X_train,
        2,
        mean
    )


sigma <-

    apply(
        X_train,
        2,
        sd
    )


sigma[sigma==0] <- 1



X_train <-

    scale(

        X_train,

        center=mu,

        scale=sigma

    )



X_test <-

    scale(

        X_test,

        center=mu,

        scale=sigma

    )







###############################################################
# CNN-LSTM Input Array
###############################################################


X_train_array <-

    array(

        X_train,

        dim=c(

            nrow(X_train),

            p,

            1

        )

    )



X_test_array <-

    array(

        X_test,

        dim=c(

            nrow(X_test),

            p,

            1

        )

    )






###############################################################
# Binary Competing Risk Labels
###############################################################


Y_train <-

    cbind(

        train_data$status==1,

        train_data$status==2

    )*1





###############################################################
# Build CNN-LSTM Models
###############################################################


model_gaussian <-

    create_cnn_lstm_model(
        "Gaussian"
    )


model_clayton <-

    create_cnn_lstm_model(
        "Clayton"
    )


model_gumbel <-

    create_cnn_lstm_model(
        "Gumbel"
    )






###############################################################
# Train Models
###############################################################


history_gaussian <-

    train_model(

        model_gaussian,

        X_train_array,

        Y_train,

        "Gaussian"

    )



history_clayton <-

    train_model(

        model_clayton,

        X_train_array,

        Y_train,

        "Clayton"

    )



history_gumbel <-

    train_model(

        model_gumbel,

        X_train_array,

        Y_train,

        "Gumbel"

    )






###############################################################
# Predictions
###############################################################


pred_gaussian <-

    predict(

        model_gaussian,

        X_test_array,

        verbose=0

    )


pred_clayton <-

    predict(

        model_clayton,

        X_test_array,

        verbose=0

    )


pred_gumbel <-

    predict(

        model_gumbel,

        X_test_array,

        verbose=0

    )





###############################################################
# Random Survival Forest
###############################################################


rsf_data <-

    data.frame(

        time=train_data$time,

        status=train_data$status,

        train_data[,feature_names]

    )



rsf_model <-

    rfsrc(

        Surv(
            time,
            status
        )~

            .,

        data=rsf_data,

        ntree=500,

        nodesize=15,

        splitrule="logrankCR",

        importance=TRUE

    )





rsf_prediction <-

    predict(

        rsf_model,

        newdata=

            test_data[,feature_names]

    )






###############################################################
# RSF Risk Extraction
###############################################################


rsf_cif <-

    rsf_prediction$cif



rsf_time_index <-

    dim(rsf_cif)[2]



rsf_cause1 <-

    rsf_cif[,

           rsf_time_index,

           1]



rsf_cause2 <-

    rsf_cif[,

           rsf_time_index,

           2]








###############################################################
# Collect Risk Predictions
###############################################################


risk_list <- list(


RSF_Cause1 =
    rsf_cause1,


RSF_Cause2 =
    rsf_cause2,



Gaussian_Cause1 =
    pred_gaussian[,1],


Gaussian_Cause2 =
    pred_gaussian[,2],



Clayton_Cause1 =
    pred_clayton[,1],


Clayton_Cause2 =
    pred_clayton[,2],



Gumbel_Cause1 =
    pred_gumbel[,1],


Gumbel_Cause2 =
    pred_gumbel[,2]


)






###############################################################
# Evaluation
###############################################################


result <- data.frame()



for(model_name in names(risk_list)){


    cause <-

        ifelse(

            grepl(
                "Cause1",
                model_name
            ),

            1,

            2

        )



    cindex <-

        cause_cindex(

            test_data$time,

            test_data$status,

            risk_list[[model_name]],

            cause

        )



    auc <-

        compute_auc_cause(

            risk_list[[model_name]],

            cause,

            test_data

        )



    ibs <-

        compute_brier_cause(

            risk_list[[model_name]],

            cause,

            test_data

        )




    result <-

        rbind(

            result,

            data.frame(

                Simulation=sim_id,

                Model=

                    gsub(
                        "_Cause[12]",
                        "",
                        model_name
                    ),


                Cause=cause,


                Cindex=cindex,


                AUC=auc,


                IBS=ibs


            )

        )


}




return(result)


}



###############################################################
# END PART 3
###############################################################

###############################################################
# PART 4
# 100 Monte Carlo Simulation Loop
###############################################################



###############################################################
# 16. Run Simulations
###############################################################


set.seed(2026)



simulation_results <- list()



start_time <- Sys.time()



for(sim in 1:n_sim){



    result_sim <-

        run_one_simulation(

            sim

        )



    simulation_results[[sim]] <-

        result_sim



}




end_time <- Sys.time()



cat("\n====================================\n")

cat("100 Simulations Completed\n")

cat("Runtime:\n")

print(
    end_time-start_time
)

cat("====================================\n")






###############################################################
# 17. Combine All Results
###############################################################


all_results <-

    do.call(

        rbind,

        simulation_results

    )



print(
    head(all_results)
)



cat("\nNumber of Results:\n")

print(
    nrow(all_results)
)





###############################################################
# 18. Save Individual Simulation Results
###############################################################


write.csv(

    all_results,

    "Copula_CNN_LSTM_100_Simulation_All_Results.csv",

    row.names=FALSE

)






###############################################################
# 19. Summary Statistics
###############################################################


summary_results <-

    all_results %>%

    group_by(

        Model,

        Cause

    ) %>%

    summarise(


        Mean_Cindex =

            mean(
                Cindex,
                na.rm=TRUE
            ),



        SD_Cindex =

            sd(
                Cindex,
                na.rm=TRUE
            ),



        Mean_AUC =

            mean(
                AUC,
                na.rm=TRUE
            ),



        SD_AUC =

            sd(
                AUC,
                na.rm=TRUE
            ),



        Mean_IBS =

            mean(
                IBS,
                na.rm=TRUE
            ),



        SD_IBS =

            sd(
                IBS,
                na.rm=TRUE
            ),



        .groups="drop"

    )







###############################################################
# 20. Display Final Table
###############################################################


cat("\n====================================\n")

cat("100 Simulation Summary\n")

cat("====================================\n")


print(

    summary_results

)







###############################################################
# 21. Save Summary Table
###############################################################


write.csv(

    summary_results,

    "Copula_CNN_LSTM_100_Simulation_Summary.csv",

    row.names=FALSE

)







###############################################################
# 22. Publication Format Table
###############################################################

publication_table <-

summary_results %>%

dplyr::mutate(

    Cindex =
        sprintf(
            "%.3f (%.3f)",
            Mean_Cindex,
            SD_Cindex
        ),

