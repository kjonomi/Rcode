    0.4*X[,12]*X[,13] +

    0.4*(X[,14]>0) +

    0.5*X[,15]




###############################################################
# Cause 2
###############################################################


eta2 <-

    -0.7*X[,16] +

    0.6*X[,17]^2 +

    0.5*cos(X[,18]) +

    0.5*X[,19]*X[,20] -

    0.4*exp(-X[,21]^2) +

    0.4*X[,22]*X[,23] +

    0.5*sin(X[,24]) +

    0.4*X[,25]^3 -

