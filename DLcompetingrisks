# 5. Evaluation Functions
###############################################################


cause_cindex <-

function(

time,

status,

risk,

cause

){


event <-

ifelse(

status==cause,

1,

0

)


concordance.index(

x=risk,

surv.time=time,

surv.event=event,

method="noether"

)$c.index


}





compute_auc <-

function(

risk,

cause

){


delta <-

ifelse(

status_test==cause,

1,

0

)



times <-

quantile(

time_test,

probs=c(

0.25,

0.50,

0.75

)

)



roc <-

timeROC(

T=time_test,

delta=delta,

marker=risk,

cause=1,

weighting="marginal",

times=times

)



mean(roc$AUC)

}






compute_ibs <-

function(

risk,

cause

){


event <-

ifelse(

status_test==cause,

1,

0

)


mean(

(event-risk)^2

)


}





