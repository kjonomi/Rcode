    0.5*X[,30]




eta1 <- pmax(pmin(eta1,5),-5)

eta2 <- pmax(pmin(eta2,5),-5)



###############################################################
# DEPENDENT EVENT TIMES
# Gaussian Copula
###############################################################


rho_event <- 0.8


Sigma_event <- matrix(
    c(
        1,rho_event,
        rho_event,1
    ),
    2,
    2
)



Z <- MASS::mvrnorm(
    n,
    c(0,0),
    Sigma_event
)


U1 <- pnorm(Z[,1])

U2 <- pnorm(Z[,2])





###############################################################
# Weibull Baseline Hazards
###############################################################

shape1 <- 2.5
shape2 <- 1.8


scale1 <- 0.5
scale2 <- 0.3


###############################################################
# Generate Event Times
###############################################################


U1 <- runif(n)

U2 <- runif(n)



T1 <-

(
-log(U1) /

(
scale1 *
exp(eta1)
)

)^(1/shape1)




T2 <-

(
-log(U2) /

(
scale2 *
exp(eta2)
)

)^(1/shape2)




###############################################################
# Weibull Censoring
###############################################################


Uc <- runif(n)



C <-

(
-log(Uc)/0.02

)^(1/1.2)




###############################################################
# Observed Time
###############################################################


time <-

    pmin(
        T1,
        T2,
        C
    )




###############################################################
# Event Indicator
###############################################################


status <-

    rep(
        0,
        n
    )



status[
    T1<T2 &
    T1<C
] <- 1



status[
    T2<T1 &
    T2<C
] <- 2





data.frame(

    time=time,

    status=status,

    X

)


}

