###############################################################


train_index <-

    sample(

        1:nrow(sim_data),

        size=

            floor(
                train_fraction*
                nrow(sim_data)
            )

    )



train_data <-

    sim_data[
        train_index,
    ]



test_data <-

    sim_data[
        -train_index,
    ]





###############################################################
# Extract Features
###############################################################


feature_names <-

    paste0(
        "X",
        1:p
    )



X_train <-

    as.matrix(

        train_data[,

        feature_names]

    )



X_test <-

    as.matrix(

        test_data[,

        feature_names]

    )






###############################################################
# Standardization
###############################################################


mu <-

    apply(
        X_train,
        2,
        mean
    )


sigma <-

    apply(
        X_train,
        2,
        sd
    )


sigma[sigma==0] <- 1



X_train <-

    scale(

        X_train,

        center=mu,

        scale=sigma

    )



X_test <-

    scale(

        X_test,

        center=mu,

        scale=sigma

    )







###############################################################
# CNN-LSTM Input Array
###############################################################


X_train_array <-

    array(

        X_train,

        dim=c(

            nrow(X_train),

            p,

            1

        )

    )



X_test_array <-

    array(

        X_test,

        dim=c(

            nrow(X_test),

            p,

            1

        )

    )






###############################################################
# Binary Competing Risk Labels
###############################################################


Y_train <-

    cbind(

        train_data$status==1,

        train_data$status==2

    )*1





###############################################################
# Build CNN-LSTM Models
###############################################################


model_gaussian <-

    create_cnn_lstm_model(
        "Gaussian"
    )


model_clayton <-

    create_cnn_lstm_model(
        "Clayton"
    )


model_gumbel <-

    create_cnn_lstm_model(
        "Gumbel"
    )






###############################################################
# Train Models
###############################################################


history_gaussian <-

    train_model(

        model_gaussian,

        X_train_array,

        Y_train,

        "Gaussian"

    )



history_clayton <-

    train_model(

        model_clayton,

        X_train_array,

        Y_train,

        "Clayton"

    )



history_gumbel <-

    train_model(

        model_gumbel,

        X_train_array,

        Y_train,

        "Gumbel"

    )






###############################################################
# Predictions
###############################################################


pred_gaussian <-

    predict(

        model_gaussian,

        X_test_array,

        verbose=0

    )


pred_clayton <-

    predict(

        model_clayton,

        X_test_array,

        verbose=0

    )


pred_gumbel <-

    predict(

        model_gumbel,

        X_test_array,

        verbose=0

    )





###############################################################
# Random Survival Forest
###############################################################


rsf_data <-

    data.frame(

        time=train_data$time,

        status=train_data$status,

        train_data[,feature_names]

    )



rsf_model <-

    rfsrc(

        Surv(
            time,
            status
        )~

            .,

        data=rsf_data,

        ntree=500,

        nodesize=15,

        splitrule="logrankCR",

        importance=TRUE

    )





rsf_prediction <-

    predict(

        rsf_model,

        newdata=

            test_data[,feature_names]

    )






###############################################################
# RSF Risk Extraction
###############################################################


rsf_cif <-

    rsf_prediction$cif



rsf_time_index <-

    dim(rsf_cif)[2]



rsf_cause1 <-

    rsf_cif[,

           rsf_time_index,

           1]



rsf_cause2 <-

    rsf_cif[,

           rsf_time_index,

           2]








###############################################################
# Collect Risk Predictions
###############################################################


risk_list <- list(


RSF_Cause1 =
    rsf_cause1,


RSF_Cause2 =
    rsf_cause2,



Gaussian_Cause1 =
    pred_gaussian[,1],


Gaussian_Cause2 =
    pred_gaussian[,2],



Clayton_Cause1 =
    pred_clayton[,1],


Clayton_Cause2 =
    pred_clayton[,2],



Gumbel_Cause1 =
    pred_gumbel[,1],


Gumbel_Cause2 =
    pred_gumbel[,2]


)






###############################################################
# Evaluation
###############################################################


result <- data.frame()



for(model_name in names(risk_list)){


    cause <-

        ifelse(

            grepl(
                "Cause1",
                model_name
            ),

            1,

            2

        )



    cindex <-

        cause_cindex(

            test_data$time,

            test_data$status,

            risk_list[[model_name]],

            cause

        )



    auc <-

        compute_auc_cause(

            risk_list[[model_name]],

            cause,

            test_data

        )



    ibs <-

        compute_brier_cause(

            risk_list[[model_name]],

            cause,

            test_data

        )




    result <-

        rbind(

            result,

            data.frame(

                Simulation=sim_id,

                Model=

                    gsub(
                        "_Cause[12]",
                        "",
                        model_name
                    ),


                Cause=cause,


                Cindex=cindex,


                AUC=auc,


                IBS=ibs


            )

        )


}




return(result)


}



