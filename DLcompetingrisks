###############################################################
# 35. Bootstrap Function
###############################################################


bootstrap_cindex <- function(
    
    time,
    
    event,
    
    risk,
    
    cause=2,
    
    B=500
    
){


    boot_fun <- function(data,index){


        d <-

            data[index,]


        value <-

            cause_cindex(

                d$time,

                d$event,

                d$risk,

                cause

            )


        return(value)

    }



    boot_data <-

        data.frame(

            time=time,

            event=event,

            risk=risk

        )



    result <-

        boot(

            data=boot_data,

            statistic=boot_fun,

            R=B

        )



    values <-

        result$t[

            !is.na(result$t)

        ]



    if(length(values)<10){


        return(

            c(

                Mean=NA,

                Lower=NA,

                Upper=NA

            )

        )

    }



    ci <-

        quantile(

            values,

            c(

                0.025,

                0.975

            )

        )


    c(

        Mean=mean(values),

        Lower=ci[1],

        Upper=ci[2]

    )

}





