        )



    auc <-

        compute_auc_cause(

            risk_list[[model_name]],

            cause,

            test_data

        )



    ibs <-

        compute_brier_cause(

            risk_list[[model_name]],

            cause,

            test_data

        )




    result <-

        rbind(

            result,

            data.frame(

                Simulation=sim_id,

                Model=

                    gsub(
                        "_Cause[12]",
                        "",
                        model_name
                    ),


                Cause=cause,


                Cindex=cindex,


                AUC=auc,


                IBS=ibs


            )

        )


}




return(result)


}



