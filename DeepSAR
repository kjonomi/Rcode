states <- round(1.2 * demand_base)

# Spatial adjacency matrix
dist_mat <- as.matrix(dist(t(sales_mat)))
W <- matrix(0, n_regions, n_regions)
k_neigh <- pmin(3, n_regions - 1)
for(i in 1:n_regions){
  nbrs <- order(dist_mat[i, ])[2:(k_neigh+1)]
