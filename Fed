############################################################
# 1️⃣ LOAD FRED MACRO DATA
############################################################
 # https://fred.stlouisfed.org/series/DGS10
 # https://fred.stlouisfed.org/series/DTB3
 # 2021-04-22 to 2026-04-22

dgs10 <- fread("DGS10.csv")
dtb3  <- fread("DTB3.csv")

dgs10 <- dgs10[, .(observation_date, DGS10 = as.numeric(DGS10))]
dtb3  <- dtb3[, .(observation_date, DTB3  = as.numeric(DTB3))]

data <- merge(dgs10, dtb3, by="observation_date")
data$DATE <- as.Date(data$observation_date)
data <- na.omit(data)

############################################################
# 2️⃣ FEATURE ENGINEERING
############################################################
feat <- data.frame(
  dgs10 = data$DGS10,
  dtb3  = data$DTB3,
  dgs10_ret = c(NA, diff(data$DGS10)),
  dtb3_ret  = c(NA, diff(data$DTB3)),
  spread = data$DGS10 - data$DTB3,
  vol_dgs10 = runSD(data$DGS10, 10)
)

feat <- na.omit(feat)

############################################################
# 3️⃣ SEQUENCE DATA
############################################################
T_steps <- 5
n <- nrow(feat) - T_steps

X_long <- array(0, dim=c(n, T_steps, ncol(feat)))
Y_matrix <- matrix(0, nrow=n, ncol=3)

for(i in 1:n){
  X_long[i,,] <- as.matrix(feat[i:(i+T_steps-1), ])

  dy <- feat$dgs10_ret[i+T_steps]

  Y_matrix[i,] <- c(
    0,
    dy,
    -dy
  )
}

############################################################
# 4️⃣ REPLAY BUFFER
############################################################
ReplayBuffer <- R6Class(
  "ReplayBuffer",
  public = list(
    capacity = NULL,
    buffer = NULL,
    position = 1,

    initialize = function(capacity){
      self$capacity <- capacity
      self$buffer <- vector("list", capacity)
    },

    push = function(state, action, reward){
      self$buffer[[self$position]] <- list(
        state=state, action=action, reward=reward
      )
      self$position <- ifelse(self$position == self$capacity, 1, self$position + 1)
    },

    sample_indices = function(batch_size, weights=NULL){
      filled <- which(!sapply(self$buffer, is.null))
      if(length(filled) < batch_size) return(NULL)

      if(is.null(weights)){
        return(sample(filled, batch_size))
      } else {
        w <- weights[filled]
        return(sample(filled, batch_size, prob=w/sum(w)))
      }
    }
  )
)

############################################################
# 5️⃣ MODEL
############################################################
build_model <- function(input_shape){
  model <- keras_model_sequential() %>%
    layer_conv_1d(filters=32, kernel_size=2, activation="relu",
                  input_shape=input_shape) %>%
    layer_lstm(32) %>%
    layer_dense(64, activation="relu") %>%
    layer_dense(3)

  model %>% compile(
    optimizer = optimizer_adam(0.001),
    loss = "mse"
  )
  model
}

############################################################
# 6️⃣ TRAIN DQN (3 METHODS)
############################################################
train_dqn <- function(X, Y,
                      episodes=30,
                      batch_size=32,
                      method="uniform",
                      alpha_entropy=0.5,
                      beta_per=0.6) {

  input_dims <- dim(X)[2:3]
  model <- build_model(input_dims)
  buffer <- ReplayBuffer$new(2000)

  epsilon <- 1.0
  rewards_hist <- c()

  for(ep in 1:episodes){

    ep_rewards <- c()

    # collect experience
    for(i in 1:dim(X)[1]){

      state <- X[i,,]

      if(runif(1) < epsilon){
        action <- sample(0:2,1)
      } else {
        q_vals <- predict(model, array(state, dim=c(1,input_dims)), verbose=0)
        action <- which.max(q_vals) - 1
      }

      reward <- Y[i, action+1]
      ep_rewards <- c(ep_rewards, reward)

      buffer$push(state, action, reward)
    }

    rewards_hist <- c(rewards_hist, mean(ep_rewards))

    filled_idx <- which(!sapply(buffer$buffer, is.null))
    if(length(filled_idx) < batch_size) next

    all_s <- array(0, dim=c(length(filled_idx), input_dims))
    for(k in seq_along(filled_idx)){
      all_s[k,,] <- buffer$buffer[[filled_idx[k]]]$state
    }

    q_all <- predict(model, all_s, verbose=0)

    weights <- rep(1, length(filled_idx))

    ########################################################
    # ENTROPY SAMPLING
    ########################################################
    if(method == "entropy"){
      prob <- t(apply(q_all,1,function(x) exp(x)/sum(exp(x))))
      entropy <- -rowSums(prob * log(prob + 1e-8))
      qvar <- apply(q_all,1,var)
      weights <- alpha_entropy * entropy + (1-alpha_entropy)*qvar
    }

    ########################################################
    # PER SAMPLING
    ########################################################
    if(method == "per"){
      rewards <- sapply(filled_idx, function(i) buffer$buffer[[i]]$reward)
      actions <- sapply(filled_idx, function(i) buffer$buffer[[i]]$action)

      pred <- q_all[cbind(1:nrow(q_all), actions+1)]
      td <- abs(rewards - pred)
      weights <- (td + 1e-5)^beta_per
    }

    idx <- buffer$sample_indices(batch_size, weights)
    samples <- buffer$buffer[idx]

    batch_s <- array(0, dim=c(batch_size, input_dims))
    batch_y <- matrix(0, nrow=batch_size, ncol=3)

    for(j in 1:batch_size){
      batch_s[j,,] <- samples[[j]]$state

      q <- predict(model,
                   array(samples[[j]]$state, dim=c(1,input_dims)),
                   verbose=0)

      q[1, samples[[j]]$action+1] <- samples[[j]]$reward
      batch_y[j,] <- q
    }

    model %>% fit(batch_s, batch_y, epochs=1, verbose=0)

    epsilon <- max(0.1, epsilon * 0.95)
  }

  list(model=model, rewards=rewards_hist)
}

############################################################
# 7️⃣ EVALUATION
############################################################
evaluate_model <- function(model, X, Y){
  q <- predict(model, X, verbose=0)
  a <- apply(q,1,which.max)
  mean(Y[cbind(1:nrow(Y), a)])
}

############################################################
# 8️⃣ TRAIN / TEST SPLIT
############################################################
split <- floor(0.7 * n)

X_train <- X_long[1:split,,]
Y_train <- Y_matrix[1:split,]

X_test  <- X_long[(split+1):n,,]
Y_test  <- Y_matrix[(split+1):n,]

############################################################
# 9️⃣ TRAIN 3 MODELS
############################################################
model_uniform <- train_dqn(X_train, Y_train, method="uniform")
model_entropy <- train_dqn(X_train, Y_train, method="entropy", alpha_entropy=0.5)
model_per     <- train_dqn(X_train, Y_train, method="per", beta_per=0.6)

############################################################
# 🔟 TEST PERFORMANCE
############################################################
perf_uniform <- evaluate_model(model_uniform$model, X_test, Y_test)
perf_entropy <- evaluate_model(model_entropy$model, X_test, Y_test)
perf_per     <- evaluate_model(model_per$model, X_test, Y_test)

results <- data.frame(
  Model = c("Uniform", "Entropy", "PER"),
  TestReward = c(perf_uniform, perf_entropy, perf_per)
)

print(results)

############################################################
# 📊 BAR PLOT
############################################################
ggplot(results, aes(Model, TestReward, fill=Model)) +
  geom_bar(stat="identity") +
  theme_minimal() +
  labs(title="DQN Model Comparison (FRED Rates Trading)",
       y="Average Test Reward")

############################################################
# 📈 LEARNING CURVES
############################################################
df <- data.frame(
  Episode = 1:length(model_uniform$rewards),
  Uniform = model_uniform$rewards,
  Entropy = model_entropy$rewards,
  PER = model_per$rewards
)

df_long <- df %>%
  pivot_longer(-Episode, names_to="Model", values_to="Reward")

ggplot(df_long, aes(Episode, Reward, color=Model)) +
  geom_line(size=1) +
  theme_minimal() +
  labs(title="Learning Curves Comparison")

############################################################
# 📊 SUMMARY TABLE
############################################################
library(dplyr)

summary_table <- df_long %>%
  group_by(Model) %>%
  summarise(
    Mean_Reward   = mean(Reward, na.rm = TRUE),
    SD_Reward     = sd(Reward, na.rm = TRUE),
    Final_Reward  = last(Reward),
    Early_Reward  = mean(Reward[Episode <= 10], na.rm = TRUE),
    Late_Reward   = mean(Reward[Episode > max(Episode) - 10], na.rm = TRUE),
    Improvement   = Late_Reward - Early_Reward
  )

print(summary_table)
