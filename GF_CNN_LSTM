make_sequences_multi <- function(
    imgs,
    L_in = 5
) {

  T <- dim(imgs)[1]

  nlat <- dim(imgs)[2]

  nlon <- dim(imgs)[3]

  nout <- dim(imgs)[4]


  nSamples <- T - L_in


  X <- array(
    0,
    dim = c(
      nSamples,
      L_in,
      nlat,
      nlon,
      nout
    )
  )


  Y <- array(
    0,
    dim = c(
      nSamples,
      nlat,
      nlon,
      nout
    )
  )


  for(i in seq_len(nSamples)) {

    X[i,,,,] <-
      imgs[
        i:(i + L_in - 1),
        ,,
        ,
        ,
        drop = FALSE
      ]


    Y[i,,,] <-
      imgs[
        i + L_in,
        ,,
        ,
        drop = FALSE
      ][1,,,]
  }


  list(
    X = X,
    Y = Y
  )
}


