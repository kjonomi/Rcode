# 2) Spatial detrending: polynomial
###############################################################

detrend_spatial_poly <- function(Y_vec, coords3) {

    x <- coords3[, 1]
    y <- coords3[, 2]
    z <- coords3[, 3]

    B <- cbind(
        1,
        x,
        y,
        z,
        x^2,
        x*y,
        x*z,
        y^2,
        y*z,
        z^2
    )

    residuals(
        lm(Y_vec ~ B - 1)
    )
}


detrend_all_times_poly <- function(Xmat, coords3) {

    N  <- nrow(Xmat)
    Tt <- ncol(Xmat)

    resid <- matrix(
        0,
        nrow = N,
        ncol = Tt
    )

    for (t in 1:Tt) {

        resid[, t] <-
            detrend_spatial_poly(
                Xmat[, t],
                coords3
            )
    }

    resid
}
###############################################################
# 2) Spatial detrending: spherical harmonics
###############################################################

assoc_legendre_seq <- function(L, m, x) {

    x <- as.numeric(x)
    nx <- length(x)

    P <- matrix(
        0,
        nrow = nx,
        ncol = (L - m + 1)
    )

    if (m == 0) {

        P[, 1] <- 1

    } else {

        dfac <- 2^m * gamma(m + 0.5) / sqrt(pi)

        P[, 1] <-
            (-1)^m *
            dfac *
            (1 - x^2)^(m / 2)
    }

    if (L == m)
        return(P[, 1, drop = FALSE])

    if ((m + 1) <= L)
        P[, 2] <- x * (2*m + 1) * P[, 1]

    if ((m + 2) <= L) {

        for (l in (m + 2):L) {

            idx  <- l - m + 1
            idx1 <- idx - 1
            idx2 <- idx - 2

            P[, idx] <-
                (
                    (2*l - 1) * x * P[, idx1] -
                    (l + m - 1) * P[, idx2]
                ) / (l - m)
        }
    }

    P
}


norm_const <- function(l, m) {

    sqrt(
        ((2*l + 1) / (4*pi)) *
        exp(
            lgamma(l - m + 1) -
            lgamma(l + m + 1)
        )
    )
}


sph_harm_basis <- function(coords3, L = 3) {

    x <- coords3[, 1]
    y <- coords3[, 2]
    z <- coords3[, 3]

    costheta <- z
    phi <- atan2(y, x)

    cols <- list()
    colnames <- character(0)

    for (l in 0:L) {

        for (m in 0:l) {

            Pseq <- assoc_legendre_seq(
                l,
                m,
                costheta
            )

            P_lm <-
                as.numeric(
                    Pseq[, ncol(Pseq)]
                )

            Nlm <- norm_const(l, m)

            if (m == 0) {

                col <- Nlm * P_lm

                cols[[length(cols) + 1]] <- col

                colnames <-
                    c(
                        colnames,
                        paste0("Y_l", l, "_m0")
                    )

            } else {

                factor <-
                    sqrt(2) *
                    Nlm *
                    P_lm

                cols[[length(cols) + 1]] <-
                    factor * cos(m * phi)

                colnames <-
                    c(
                        colnames,
                        paste0(
                            "Y_l", l,
                            "_m", m,
                            "_c"
                        )
                    )

                cols[[length(cols) + 1]] <-
                    factor * sin(m * phi)

                colnames <-
                    c(
                        colnames,
                        paste0(
                            "Y_l", l,
                            "_m", m,
                            "_s"
                        )
                    )
            }
        }
    }

    B <- do.call(cbind, cols)

    colnames(B) <- colnames

    B
}


detrend_spatial_sph <- function(
    Y_vec,
    coords3,
    L = 3,
    intercept = TRUE,
    tol = 1e-8
) {

    B <- sph_harm_basis(
        coords3,
        L = L
    )

    if (intercept)
        B <- cbind(1, B)

    qrB <- qr(
        B,
        tol = tol
    )

    coef <- qr.coef(
        qrB,
        Y_vec
    )

    resid <-
        Y_vec -
        B %*% coef

    as.numeric(resid)
}


detrend_all_times_sph <- function(
    Xmat,
    coords3,
    L = 3
) {

    N  <- nrow(Xmat)
    Tt <- ncol(Xmat)

    resid <-
        matrix(
            0,
            nrow = N,
            ncol = Tt
        )

    for (t in 1:Tt) {

        resid[, t] <-
            detrend_spatial_sph(
                Xmat[, t],
                coords3,
                L = L
            )
    }

    resid
}
###############################################################
# 7) Full example: compare polynomial vs spherical harmonics
###############################################################
run_example_compare_methods <- function(nlon=84,nlat=42,Tt=30,L_in=5,nout=3,seed=1){
  set.seed(seed)
  grid <- sphere_grid(nlon,nlat)
  coords3 <- grid$coords3
  
  # Simulate spatio-temporal
  X <- simulate_spatio_temporal(coords3, T=Tt, seed=seed)
  
  ## Method 1: Polynomial detrending
  R_poly <- detrend_all_times_poly(X, coords3)
  Y_poly <- simulate_copula_outcomes(R_poly)
  Y_poly <- detrend_temporal_poly_safe(Y_poly, degree=2)
  Y_poly <- normalize_array_per_output(Y_poly)
  imgs_poly <- make_image_tensor_multi(Y_poly, nlon, nlat)
  seqs_poly <- make_sequences_multi(imgs_poly,L_in=L_in)
  
  # Flatten Y for NLL
  nSamples <- dim(seqs_poly$X)[1]
  Y_flat_poly <- array(0, dim=c(nSamples,nlon*nlat,nout))
  for(i in 1:nSamples) for(k in 1:nout) Y_flat_poly[i,,k] <- as.numeric(seqs_poly$Y[i,,,k])
  
  model_poly <- build_cnn_lstm_multi(nlat,nlon,nout,L_in=L_in)
  model_poly %>% compile(optimizer=optimizer_adam(1e-3), loss=nll_gaussian_multi())
  history_poly <- model_poly %>% fit(seqs_poly$X,Y_flat_poly,epochs=5,batch_size=4,validation_split=0.2,verbose=2)
  
  ## Method 2: Spherical harmonics detrending
  R_sph <- detrend_all_times_sph(X, coords3, L=3)
  Y_sph <- simulate_copula_outcomes(R_sph)
  Y_sph <- detrend_temporal_poly_safe(Y_sph, degree=2)
  Y_sph <- normalize_array_per_output(Y_sph)
  imgs_sph <- make_image_tensor_multi(Y_sph, nlon, nlat)
  seqs_sph <- make_sequences_multi(imgs_sph,L_in=L_in)
  
  Y_flat_sph <- array(0, dim=c(nSamples,nlon*nlat,nout))
  for(i in 1:nSamples) for(k in 1:nout) Y_flat_sph[i,,k] <- as.numeric(seqs_sph$Y[i,,,k])
  
  model_sph <- build_cnn_lstm_multi(nlat,nlon,nout,L_in=L_in)
  model_sph %>% compile(optimizer=optimizer_adam(1e-3), loss=nll_gaussian_multi())
  history_sph <- model_sph %>% fit(seqs_sph$X,Y_flat_sph,epochs=5,batch_size=4,validation_split=0.2,verbose=2)
  
  # Compute RMSE
  rmse_poly <- compute_rmse_multi_safe(model_poly, seqs_poly$X, seqs_poly$Y, nout)
  rmse_sph <- compute_rmse_multi_safe(model_sph, seqs_sph$X, seqs_sph$Y, nout)
  
  list(rmse_poly=rmse_poly, rmse_sph=rmse_sph,
       model_poly=model_poly, model_sph=model_sph,
       seqs_poly=seqs_poly, seqs_sph=seqs_sph)
}

