# Temporal polynomial detrending
detrend_temporal_poly <- function(Y_array, degree=2) {
  N <- dim(Y_array)[1]; T <- dim(Y_array)[2]; nout <- dim(Y_array)[3]
  Y_resid <- array(0, dim=c(N,T,nout))
  for(i in 1:N) {
    for(k in 1:nout) {
      y <- Y_array[i,,k]
      B <- poly(1:T, degree=degree, raw=TRUE)
      fit <- lm(y ~ B - 1)
      Y_resid[i,,k] <- residuals(fit)
    }
  }
  Y_resid
}

# Normalize per output
normalize_array_per_output <- function(Y_array) {
  nout <- dim(Y_array)[3]
  for(k in 1:nout) {
    Y_array[,,k] <- (Y_array[,,k] - mean(Y_array[,,k])) / sd(Y_array[,,k])
  }
  Y_array
}

###############################################################
# 3) Multi-output copula simulation
###############################################################
simulate_copula_outcomes <- function(X, R_dep = matrix(c(1,0.5,0.3,0.5,1,0.4,0.3,0.4,1),3,3), seed=123) {
  set.seed(seed)
  N <- nrow(X); T <- ncol(X); nout <- nrow(R_dep)
  Y_array <- array(0, dim=c(N,T,nout))
  L_R <- chol(R_dep)
  for(t in 1:T) {
    Z_indep <- matrix(rnorm(N*nout), nrow=N, ncol=nout)
    Z_dep <- Z_indep %*% L_R
    for(k in 1:nout) Y_array[,t,k] <- X[,t] + Z_dep[,k]
  }
  Y_array
}

###############################################################
# 4) CNN-LSTM preparation functions
###############################################################
make_image_tensor_multi <- function(Y_array, nlon, nlat) {
  N <- dim(Y_array)[1]; T <- dim(Y_array)[2]; nout <- dim(Y_array)[3]
  imgs <- array(0, dim=c(T, nlat, nlon, nout))
  for(t in 1:T) for(k in 1:nout) imgs[t,,,k] <- matrix(Y_array[,t,k], nrow=nlat, ncol=nlon, byrow=FALSE)
  imgs
}

make_sequences_multi <- function(imgs, L_in=5) {
  T <- dim(imgs)[1]; nlat <- dim(imgs)[2]; nlon <- dim(imgs)[3]; nout <- dim(imgs)[4]
  nSamples <- T - L_in
  X <- array(0, dim=c(nSamples, L_in, nlat, nlon, nout))
  Y <- array(0, dim=c(nSamples, nlat, nlon, nout))
  for(i in 1:nSamples) {
    X[i,,,,] <- imgs[i:(i+L_in-1),,,, drop=FALSE]
    Y[i,,,] <- imgs[i + L_in,,,, drop=FALSE][1,,,]
  }
  list(X=X, Y=Y)
}

build_cnn_lstm_multi <- function(nlat,nlon,nout,L_in=5) {
  input <- layer_input(shape=c(L_in,nlat,nlon,nout))
  td <- input %>%
    time_distributed(layer_conv_2d(filters=16,kernel_size=c(3,3),padding="same",activation="relu")) %>%
    time_distributed(layer_max_pooling_2d(pool_size=c(2,2))) %>%
    time_distributed(layer_conv_2d(filters=32,kernel_size=c(3,3),padding="same",activation="relu")) %>%
    time_distributed(layer_max_pooling_2d(pool_size=c(2,2))) %>%
    time_distributed(layer_flatten())
  lstm <- td %>% layer_lstm(units=128,return_sequences=FALSE)
  total_pixels <- nlat*nlon
  dense_out <- lstm %>% layer_dense(units=total_pixels*nout*2)
  out <- layer_reshape(dense_out, target_shape=c(total_pixels,nout,2))
  keras_model(inputs=input, outputs=out)
}

nll_gaussian_multi <- function() {
  function(y_true, y_pred) {
    pred_mean <- y_pred[,, ,1]
    pred_logsd <- y_pred[,, ,2]
    sd <- k_exp(pred_logsd)+1e-6
    nll <- 0.5*k_log(2*pi) + k_log(sd) + 0.5*k_square((y_true-pred_mean)/sd)
    k_mean(nll)
  }
}

###############################################################
# 5) Run full example
###############################################################
run_example_multi_joint_fixed <- function(nlon=84, nlat=42, T=30, L_in=5, seed=1) {
  set.seed(seed)
  gr <- sphere_grid(nlon=nlon, nlat=nlat)
  coords3 <- gr$coords3
  
  
  # 1) Simulate spatio-temporal
  X <- simulate_spatio_temporal(coords3, T=T)
  
  # 2) Spatial detrend
  R <- detrend_all_times(X, coords3)
  
  # 3) Multi-output copula outcomes
  Y_array <- simulate_copula_outcomes(R)
  
  # 4) Temporal detrend
  Y_array <- detrend_temporal_poly(Y_array, degree=2)
  
  # 5) Normalize per output
  Y_array <- normalize_array_per_output(Y_array)
  
  # 6) CNN-LSTM input
  imgs <- make_image_tensor_multi(Y_array, nlon, nlat)
  seqs <- make_sequences_multi(imgs,L_in=L_in)
  Xseq <- seqs$X; Yseq <- seqs$Y
  
  nSamples <- dim(Xseq)[1]; nout <- dim(Y_array)[3]; total_pixels <- nlat*nlon
  Y_flat <- array(0, dim=c(nSamples,total_pixels,nout))
  for(i in 1:nSamples) for(k in 1:nout) Y_flat[i,,k] <- as.numeric(Yseq[i,,,k])
  
  # 7) Build and train model
  model <- build_cnn_lstm_multi(nlat,nlon,nout,L_in=L_in)
  model %>% compile(optimizer=optimizer_adam(1e-3), loss=nll_gaussian_multi())
  history <- model %>% fit(Xseq,Y_flat,epochs=5,batch_size=4,validation_split=0.2,verbose=2)
  
  list(model=model, history=history, Y_array=Y_array, Xseq=Xseq, Yseq=Yseq, gr=gr)
}

summarize_and_plot_cnn_lstm_large <- function(model, Xseq, Yseq, gr, nout,
                                              batch_size=8, num_samples_plot=3,
                                              save_plots=FALSE, random_seed=NULL) {
  
  library(reshape2)
  library(ggplot2)
  library(viridis)
  
  nlat <- gr$nlat
  nlon <- gr$nlon
  nSamples <- dim(Xseq)[1]
  total_pixels <- nlat * nlon
  
  # Set seed if given
  if(!is.null(random_seed)) set.seed(random_seed)
  
  # ---------------------------
  # 1) Predict using CNN-LSTM
  # ---------------------------
  Y_pred_array <- model %>% predict(Xseq, batch_size=batch_size)
  # Assuming shape: [nSamples, total_pixels, nout, 2] -> mean + logSD
  
  # Vectorized mean predictions
  Y_pred <- array(Y_pred_array[,,,1], dim=c(nSamples, total_pixels, nout))
  dim(Y_pred) <- c(nSamples, nlat, nlon, nout)  # reshape to grid
  
  # ---------------------------
  # 2) Summary Table: Mean & SD
  # ---------------------------
  summary_table <- data.frame(
    Output = 1:nout,
    True_Mean = sapply(1:nout, function(k) mean(Yseq[,,,k])),
    Pred_Mean = sapply(1:nout, function(k) mean(Y_pred[,,,k])),
    True_SD   = sapply(1:nout, function(k) sd(Yseq[,,,k])),
    Pred_SD   = sapply(1:nout, function(k) sd(Y_pred[,,,k]))
  )
  
  print("Summary Table (Mean & SD per Output):")
  print(summary_table)
  
  # ---------------------------
  # 3) Metrics Table: RMSE & NLL
  # ---------------------------
  metrics_table <- data.frame(
    Output = 1:nout,
    RMSE = numeric(nout),
    Avg_NLL = numeric(nout)
  )
  
  for(k in 1:nout) {
    true_vals <- as.vector(Yseq[,,,k])
    pred_vals <- as.vector(Y_pred[,,,k])
    
    rmse <- sqrt(mean((pred_vals - true_vals)^2))
    
    sd_vals <- exp(as.vector(Y_pred_array[,,k,2])) + 1e-6
    nll <- mean(0.5*log(2*pi) + log(sd_vals) + 0.5*((true_vals - pred_vals)/sd_vals)^2)
    
    metrics_table[k, c("RMSE","Avg_NLL")] <- c(rmse, nll)
  }
  
  print("Per-output RMSE and Average NLL:")
  print(metrics_table)
  
  # ---------------------------
  # 4) Time Series Plots
  # ---------------------------
  for(s in 1:num_samples_plot) {
    lat_idx <- sample(1:nlat,1)
    lon_idx <- sample(1:nlon,1)
    
    df_ts <- data.frame(Time = 1:nSamples)
    for(k in 1:nout) {
      df_ts[[paste0("True_Y",k)]] <- Yseq[1:nSamples,lat_idx,lon_idx,k]
      df_ts[[paste0("Pred_Y",k)]] <- Y_pred[1:nSamples,lat_idx,lon_idx,k]
    }
    
    df_long <- melt(df_ts, id.vars="Time")
    
    p <- ggplot(df_long, aes(x=Time, y=value, color=variable)) +
      geom_line() +
      ggtitle(paste("Time Series at lat =", lat_idx, "lon =", lon_idx)) +
      ylab("Value") +
      theme_minimal()
    
    print(p)
  }
  
  # ---------------------------
  # 5) Heatmaps: True, Predicted & Residual
  # ---------------------------
  for(t_idx in c(1, round(nSamples/2), nSamples)) {
    for(k in 1:nout) {
      
      # True
      df_true <- melt(Yseq[t_idx,,,k])
      names(df_true) <- c("Lat","Lon","Value")
      p_true <- ggplot(df_true, aes(x=Lon, y=Lat, fill=Value)) +
        geom_tile() + scale_fill_viridis_c() +
        ggtitle(paste("True Y", k, "at time", t_idx)) +
        theme_minimal()
      
      # Predicted
      df_pred <- melt(Y_pred[t_idx,,,k])
      names(df_pred) <- c("Lat","Lon","Value")
      p_pred <- ggplot(df_pred, aes(x=Lon, y=Lat, fill=Value)) +
        geom_tile() + scale_fill_viridis_c() +
        ggtitle(paste("Predicted Y", k, "at time", t_idx)) +
        theme_minimal()
      
      # Residual
      df_resid <- df_true
      df_resid$Value <- df_true$Value - df_pred$Value
      p_resid <- ggplot(df_resid, aes(x=Lon, y=Lat, fill=Value)) +
        geom_tile() + scale_fill_viridis_c(option="magma") +
        ggtitle(paste("Residual Y", k, "at time", t_idx)) +
        theme_minimal()
      
      print(p_true); print(p_pred); print(p_resid)
      
      if(save_plots) {
        ggsave(paste0("Heatmap_TrueY",k,"_t",t_idx,".png"), p_true, width=5, height=4)
        ggsave(paste0("Heatmap_PredY",k,"_t",t_idx,".png"), p_pred, width=5, height=4)
        ggsave(paste0("Heatmap_ResidY",k,"_t",t_idx,".png"), p_resid, width=5, height=4)
      }
    }
  }
  
  list(summary_table = summary_table,
       metrics_table = metrics_table,
       Y_pred = Y_pred)
}

