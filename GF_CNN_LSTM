build_cnn_lstm_multi <- function(
    nlat,
    nlon,
    nout,
    L_in = 5
) {

  input <- layer_input(
    shape = c(
      L_in,
      nlat,
      nlon,
      nout
    )
  )


  td <- input %>%

    time_distributed(
      layer_conv_2d(
        filters = 16,
        kernel_size = c(3,1),
        padding = "same",
        activation = "relu"
      )
    ) %>%

    # Pool only longitude dimension.
    # Do NOT pool the five-city dimension.
    time_distributed(
      layer_max_pooling_2d(
        pool_size = c(1,1)
      )
    ) %>%

    time_distributed(
      layer_conv_2d(
        filters = 32,
        kernel_size = c(3,1),
        padding = "same",
        activation = "relu"
      )
    ) %>%

    time_distributed(
      layer_flatten()
    )


  lstm <- td %>%

    layer_lstm(
      units = 128,
      return_sequences = FALSE
    )


  dense_out <- lstm %>%

    layer_dense(
      units = nlat * nlon * nout * 2
    )


  out <- dense_out %>%

    layer_reshape(
      target_shape =
        c(
          nlat * nlon,
          nout,
          2
        )
    )


  keras_model(
    inputs = input,
    outputs = out
  )
}


###############################################################
# 17) Gaussian negative log-likelihood
###############################################################

nll_gaussian_multi <- function() {

  function(
      y_true,
      y_pred
  ) {

    pred_mean <-
      y_pred[,,,1]


    pred_logsd <-
      y_pred[,,,2]


    sd <- k_exp(
      pred_logsd
    ) + 1e-6


    nll <-
      0.5 * k_log(2 * pi) +
      k_log(sd) +
      0.5 *
      k_square(
        (y_true - pred_mean) / sd
      )


    k_mean(nll)
  }
}


