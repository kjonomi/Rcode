# 6) Extract nearest TerraClimate grid cell for each city
###############################################################

extract_city_variable <- function(
    variable,
    locations,
    tc_files
) {

  result_list <- list()

  counter <- 1


  for(y in start_year:end_year) {

    file_path <-
      tc_files[[variable]][[as.character(y)]]


    r <- terra::rast(
      file_path
    )


    # Convert city coordinates to spatial points
    city_points <- terra::vect(
      locations,
      geom = c("lon", "lat"),
      crs = "EPSG:4326"
    )


    # Extract nearest grid cell
    values <- terra::extract(
      r,
      city_points,
      method = "near"
    )


    # Remove ID column
    values <- values[, -1, drop = FALSE]


    # Convert to matrix
    values <- as.matrix(values)


    result_list[[counter]] <- values

    counter <- counter + 1


    rm(r)

    gc()
  }


  # Combine all years
  result <- do.call(
    rbind,
    result_list
  )


  result
}


