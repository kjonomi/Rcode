###############################################################################
# 37) MAIN REAL-DATA COMPARISON
###############################################################################

run_real_data_comparison <- function(

    PM10_standardized,

    coords,

    graph,

    nlon = 10,

    nlat = 7,

    L_in = 14,

    epochs = 30,

    batch_size = 8

) {

  N <- nrow(
    PM10_standardized
  )

  Tt <- ncol(
    PM10_standardized
  )


  ###########################################################################
  # Original station-time field
  ###########################################################################

  original_field <-

    PM10_standardized


  ###########################################################################
  # Target image
  #
  # SAME TARGET FOR ALL THREE MODELS
  ###########################################################################

  target_image <-

    make_real_image_tensor(

      original_field,

      coords,

      nlon,

      nlat

    )


  target_array <-

    target_image$images


  ###########################################################################
  # MODEL 1
  ###########################################################################

  cat("\n")
  cat("============================================================\n")
  cat("MODEL 1: CNN-LSTM WITHOUT GRAPH\n")
  cat("============================================================\n")


  input_no_graph <-

    target_image


  data_no_graph <-

    prepare_model_data_with_target(

      X_array =
        input_no_graph$images,

      target_array =
        target_array,

      L_in =
        L_in,

      train_idx =
        train_idx,

      validation_idx =
        validation_idx,

      test_idx =
        test_idx

    )


  cat(
    "X_train dimensions: ",
    paste(
      dim(data_no_graph$X_train),
      collapse = " x "
    ),
    "\n"
  )

  cat(
    "Y_train dimensions: ",
    paste(
      dim(data_no_graph$Y_train),
      collapse = " x "
    ),
    "\n"
  )


  train_no_graph <-

    train_model(

      data_no_graph$X_train,

      data_no_graph$Y_train,

      data_no_graph$X_validation,

      data_no_graph$Y_validation,

      nlat,

      nlon,

      L_in,

      epochs,

      batch_size

    )


  metrics_no_graph <-

    calculate_metrics(

      train_no_graph$model,

      data_no_graph$X_test,

      data_no_graph$Y_test,

      nout = 1

    )


  ###########################################################################
  # MODEL 2
  ###########################################################################

  cat("\n")
  cat("============================================================\n")
  cat("MODEL 2: GRAPH-FREQUENCY CNN-LSTM\n")
  cat("============================================================\n")


  ###########################################################################
  # Graph Fourier transform INPUT
  ###########################################################################

  X_graph_frequency <-

    graph_fourier_transform(

      original_field,

      graph$U

    )


  ###########################################################################
  # Normalize graph input using TRAINING data only
  ###########################################################################

  graph_freq_norm <-

    normalize_using_training(

      X_graph_frequency,

      train_idx

    )


  X_graph_frequency <-
    graph_freq_norm$X


  ###########################################################################
  # Convert graph-frequency representation to image
  ###########################################################################

  graph_frequency_image <-

    make_real_image_tensor(

      X_graph_frequency,

      coords,

      nlon,

      nlat

    )


  ###########################################################################
  # Prepare sequences
  #
  # Target remains ORIGINAL PM10.
  ###########################################################################

  data_graph <-

    prepare_model_data_with_target(

      X_array =
        graph_frequency_image$images,

      target_array =
        target_array,

      L_in =
        L_in,

      train_idx =
        train_idx,

      validation_idx =
        validation_idx,

      test_idx =
        test_idx

    )


  cat(
    "X_train dimensions: ",
    paste(
      dim(data_graph$X_train),
      collapse = " x "
    ),
    "\n"
  )

  cat(
    "Y_train dimensions: ",
    paste(
      dim(data_graph$Y_train),
      collapse = " x "
    ),
    "\n"
  )


  train_graph <-

    train_model(

      data_graph$X_train,

      data_graph$Y_train,

      data_graph$X_validation,

      data_graph$Y_validation,

      nlat,

      nlon,

      L_in,

      epochs,

      batch_size

    )


  metrics_graph <-

    calculate_metrics(

      train_graph$model,

      data_graph$X_test,

      data_graph$Y_test,

      nout = 1

    )


  ###########################################################################
  # MODEL 3
  ###########################################################################

  cat("\n")
  cat("============================================================\n")
  cat("MODEL 3: GRAPH-CONVOLUTION CNN-LSTM\n")
  cat("============================================================\n")


  ###########################################################################
  # Graph convolution INPUT
  ###########################################################################

  X_graph_conv <-

    graph_convolution_preprocess(

      original_field,

      graph$A_norm,

      alpha = 0.80

    )


  ###########################################################################
  # Normalize using training data only
  ###########################################################################

  graph_conv_norm <-

    normalize_using_training(

      X_graph_conv,

      train_idx

    )


  X_graph_conv <-
    graph_conv_norm$X


  ###########################################################################
  # Convert to image
  ###########################################################################

  graph_conv_image <-

    make_real_image_tensor(

      X_graph_conv,

      coords,

      nlon,

      nlat

    )


  ###########################################################################
  # Prepare sequences
  #
  # Target remains ORIGINAL PM10.
  ###########################################################################

  data_graph_conv <-

    prepare_model_data_with_target(

      X_array =
        graph_conv_image$images,

      target_array =
        target_array,

      L_in =
        L_in,

      train_idx =
        train_idx,

      validation_idx =
        validation_idx,

      test_idx =
        test_idx

    )


  cat(
    "X_train dimensions: ",
    paste(
      dim(data_graph_conv$X_train),
      collapse = " x "
    ),
    "\n"
  )

  cat(
    "Y_train dimensions: ",
    paste(
      dim(data_graph_conv$Y_train),
      collapse = " x "
    ),
    "\n"
  )


  train_graph_conv <-

    train_model(

      data_graph_conv$X_train,

      data_graph_conv$Y_train,

      data_graph_conv$X_validation,

      data_graph_conv$Y_validation,

      nlat,

      nlon,

      L_in,

      epochs,

      batch_size

    )


  metrics_graph_conv <-

    calculate_metrics(

      train_graph_conv$model,

      data_graph_conv$X_test,

      data_graph_conv$Y_test,

      nout = 1

    )


  ###########################################################################
  # OVERALL RESULTS
  ###########################################################################

  overall_table <- data.frame(

    Model = c(

      "CNN-LSTM without graph",

      "Graph-frequency CNN-LSTM",

      "Graph-convolution CNN-LSTM"

    ),

    RMSE = c(

      metrics_no_graph$overall_rmse,

      metrics_graph$overall_rmse,

      metrics_graph_conv$overall_rmse

    ),

    MAE = c(

      metrics_no_graph$overall_mae,

      metrics_graph$overall_mae,

      metrics_graph_conv$overall_mae

    ),

    Mean_NLL = c(

      metrics_no_graph$overall_nll,

      metrics_graph$overall_nll,

      metrics_graph_conv$overall_nll

    )

  )


  ###########################################################################
  # IMPROVEMENT RELATIVE TO BASELINE
  ###########################################################################

  baseline_rmse <-
    metrics_no_graph$overall_rmse

  baseline_mae <-
    metrics_no_graph$overall_mae

  baseline_nll <-
    metrics_no_graph$overall_nll


  comparison_models <- c(

    "Graph-frequency CNN-LSTM",

    "Graph-convolution CNN-LSTM"

  )


  comparison_rmse <- c(

    metrics_graph$overall_rmse,

    metrics_graph_conv$overall_rmse

  )


  comparison_mae <- c(

    metrics_graph$overall_mae,

    metrics_graph_conv$overall_mae

  )


  comparison_nll <- c(

    metrics_graph$overall_nll,

    metrics_graph_conv$overall_nll

  )


  improvement_table <- data.frame(

    Model =
      comparison_models,

    RMSE_Improvement =

      100 *

      (
        baseline_rmse -
          comparison_rmse
      ) /

      baseline_rmse,

    MAE_Improvement =

      100 *

      (
        baseline_mae -
          comparison_mae
      ) /

      baseline_mae,

    NLL_Improvement =

      100 *

      (
        baseline_nll -
          comparison_nll
      ) /

      abs(
        baseline_nll
      )

  )


  ###########################################################################
  # RETURN
  ###########################################################################

  list(

    overall_table =
      overall_table,

    improvement_table =
      improvement_table,


    model_no_graph =
      train_no_graph$model,

    model_graph_frequency =
      train_graph$model,

    model_graph_conv =
      train_graph_conv$model,


    history_no_graph =
      train_no_graph$history,

    history_graph_frequency =
      train_graph$history,

    history_graph_conv =
      train_graph_conv$history,


    metrics_no_graph =
      metrics_no_graph,

    metrics_graph_frequency =
      metrics_graph,

    metrics_graph_conv =
      metrics_graph_conv,


    data_no_graph =
      data_no_graph,

    data_graph =
      data_graph,

    data_graph_conv =
      data_graph_conv,


    X_graph_frequency =
      X_graph_frequency,

    X_graph_conv =
      X_graph_conv,


    graph =
      graph,

    target_image =
      target_image

  )

}


