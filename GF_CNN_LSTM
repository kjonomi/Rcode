#   time x nlat x nlon x 1
#
# Every grid-cell value comes from a REAL monitoring station.
###############################################################################

make_real_image_tensor <- function(

    X,

    coords,

    nlon = 10,

    nlat = 7

) {

  Tt <- ncol(X)

  lon_seq <- seq(

    min(coords[, "lon"]),

    max(coords[, "lon"]),

    length.out = nlon

  )

  lat_seq <- seq(

    min(coords[, "lat"]),

    max(coords[, "lat"]),

    length.out = nlat

  )


  grid <- expand.grid(

    lon = lon_seq,

    lat = lat_seq

  )


  nearest_station <- integer(
    nrow(grid)
  )


  for (g in seq_len(nrow(grid))) {

    d <-

      (
        coords[, "lon"] -
          grid$lon[g]
      )^2 +

      (
        coords[, "lat"] -
          grid$lat[g]
      )^2

    nearest_station[g] <-
      which.min(d)

  }


  imgs <- array(

    0,

    dim = c(

      Tt,

      nlat,

      nlon,

      1

    )

  )


  for (tt in seq_len(Tt)) {

    values <- X[
      ,
      tt
    ]

    z <- values[
      nearest_station
    ]

    imgs[
      tt,
      ,
      ,
      1
    ] <-

      matrix(

        z,

        nrow = nlat,

        ncol = nlon,

        byrow = FALSE

      )

  }


  list(

    images = imgs,

    grid = grid,

    nearest_station =
      nearest_station

  )

}


###############################################################################
# 26) SEQUENCE CONSTRUCTION
#
# Input:
#
#   time x latitude x longitude x channel
#
# Output:
#
#   X = samples x L_in x latitude x longitude x channel
#   Y = samples x latitude x longitude x channel
###############################################################################

make_sequences_single <- function(

    imgs,

    L_in = 14

) {

  dims <- dim(imgs)

  Tt <- dims[1]

  nlat <- dims[2]

  nlon <- dims[3]

  nch <- dims[4]

  if (Tt <= L_in) {

    stop(
      "Number of time points must be larger than L_in."
    )

  }


  nSamples <- Tt - L_in


  X <- array(

    0,

    dim = c(

      nSamples,

      L_in,

      nlat,

      nlon,

      nch

    )

  )


  Y <- array(

    0,

    dim = c(

      nSamples,

      nlat,

      nlon,

      nch

    )

  )


  for (i in seq_len(nSamples)) {

    input_times <-
      i:(i + L_in - 1)

    target_time <-
      i + L_in


    X[
      i,
      ,
      ,
      ,
      1
    ] <-

      imgs[
        input_times,
        ,
        ,
        1
      ]


    Y[
      i,
      ,
      ,
      1
    ] <-

      imgs[
        target_time,
        ,
        ,
        1
      ]

  }


  list(

    X = X,

    Y = Y

  )

}


###############################################################################
# 27) FLATTEN RESPONSE
###############################################################################

flatten_response_single <- function(
    Y
) {

  dims <- dim(Y)

  nSamples <- dims[1]

  nlat <- dims[2]

  nlon <- dims[3]

  nch <- dims[4]

  if (nch != 1) {

    stop(
      "This function expects one output channel."
    )

  }


  Y_flat <- array(

    0,

    dim = c(

      nSamples,

      nlat * nlon,

      1

    )

  )


  for (i in seq_len(nSamples)) {

    Y_flat[
      i,
      ,
      1
    ] <-

      as.numeric(

        Y[
          i,
          ,
          ,
          1
        ]

      )

  }


  Y_flat

}


###############################################################################
# 28) GRAPH FOURIER TRANSFORM
#
# Transform each time point across stations:
#
#   x_t -> U' x_t
###############################################################################

graph_fourier_transform <- function(

    X,

    U

) {

  N <- nrow(X)

  Tt <- ncol(X)

  X_graph <- matrix(

    0,

    N,

    Tt

  )


  for (tt in seq_len(Tt)) {

    X_graph[
      ,
      tt
    ] <-

      as.numeric(

        t(U) %*%

          X[
            ,
            tt
          ]

      )

  }


  X_graph

}


###############################################################################
# 29) GRAPH CONVOLUTION
#
# x_t -> (1-alpha)x_t + alpha A_norm x_t
###############################################################################

graph_convolution_preprocess <- function(

    X,

    A_norm,

    alpha = 0.80

) {

  N <- nrow(X)

  Tt <- ncol(X)

  X_gc <- matrix(

    0,

    N,

    Tt

  )


  for (tt in seq_len(Tt)) {

    local_component <-
      X[
        ,
        tt
      ]

    graph_component <-

      as.numeric(

        A_norm %*%
          local_component

      )


    X_gc[
      ,
      tt
    ] <-

      (
        1 - alpha
      ) *
      local_component +

      alpha *
      graph_component

  }


  X_gc

}


###############################################################################
# 30) TRAINING-BASED NORMALIZATION OF GRAPH REPRESENTATIONS
#
# This is done separately for graph-transformed INPUTS only.
###############################################################################

normalize_using_training <- function(

    X,

    train_idx

) {

  train_values <-
    X[
      ,
      train_idx,
      drop = FALSE
    ]

  mu <- mean(
    train_values,
    na.rm = TRUE
  )

  s <- sd(
    as.numeric(train_values),
    na.rm = TRUE
  )

  if (
    !is.finite(s) ||
    s < 1e-8
  ) {

    s <- 1

  }


  list(

    X =
      (
        X - mu
      ) / s,

    mean = mu,

    sd = s

  )

}


###############################################################################
# 31) CNN-LSTM MODEL
#
# IMPORTANT:
#
# The model outputs:
#
#   samples x pixels x 2
#
# where:
#
#   channel 1 = predictive mean
#   channel 2 = predictive log-SD
#
# This avoids the Keras 3 singleton-dimension problem.
###############################################################################

build_cnn_lstm_real <- function(

    nlat,

    nlon,

    L_in = 14

) {

  total_pixels <-
    nlat * nlon


  input <- layer_input(

    shape = c(

      L_in,

      nlat,

      nlon,

      1

    )

  )


  x <- input %>%

    time_distributed(

      layer_conv_2d(

        filters = 16,

        kernel_size = c(
          3,
          3
        ),

        padding = "same",

        activation = "relu"

      )

    ) %>%

    time_distributed(

      layer_max_pooling_2d(

        pool_size = c(
          2,
          2
        ),

        padding = "same"

      )

    ) %>%

    time_distributed(

      layer_conv_2d(

        filters = 32,

        kernel_size = c(
          3,
          3
        ),

        padding = "same",

        activation = "relu"

      )

    ) %>%

    time_distributed(

      layer_max_pooling_2d(

        pool_size = c(
          2,
          2
        ),

        padding = "same"

      )

    ) %>%

    time_distributed(

      layer_flatten()

    )


  x <- x %>%

    layer_lstm(

      units = 128,

      return_sequences = FALSE

    )


  x <- x %>%

    layer_dense(

      units =
        total_pixels * 2

    )


  output <- x %>%

    layer_reshape(

      target_shape = c(

        total_pixels,

        2

      )

    )


  model <- keras_model(

    inputs = input,

    outputs = output

  )


  model

}


###############################################################################
# 32) GAUSSIAN NLL
#
# y_true:
#
#   samples x pixels x 1
#
# y_pred:
#
#   samples x pixels x 2
###############################################################################

nll_gaussian_single <- function(

    eps = 1e-5

) {

  function(

      y_true,

      y_pred

  ) {

    pred_mean <-

      y_pred[,
             ,
             1]

    pred_logsd <-

      y_pred[,
             ,
             2]


    true_value <-

      y_true[,
             ,
             1]


    pred_logsd <-

      tf$clip_by_value(

        pred_logsd,

        -5,

        5

      )


    sd_pred <-

      tf$math$exp(
        pred_logsd
      ) +

      eps


    nll <-

      0.5 * log(2 * pi) +

      tf$math$log(
        sd_pred
      ) +

      0.5 *

      tf$square(

        (
          true_value -
            pred_mean
        ) /

          sd_pred

      )


    tf$reduce_mean(
      nll
    )

  }

}


###############################################################################
# 33) TRAIN MODEL
###############################################################################

train_model <- function(

    X_train,

    Y_train,

    X_validation,

    Y_validation,

    nlat,

    nlon,

    L_in,

    epochs = 30,

    batch_size = 8,

    learning_rate = 5e-4

) {

  model <-

    build_cnn_lstm_real(

      nlat,

      nlon,

      L_in

    )


  model %>%

    compile(

      optimizer =

        optimizer_adam(

          learning_rate =
            learning_rate

        ),

      loss =
        nll_gaussian_single()

    )


  callbacks <- list(

    callback_reduce_lr_on_plateau(

      monitor =
        "val_loss",

      factor =
        0.5,

      patience =
        4,

      min_lr =
        1e-5

    ),

    callback_early_stopping(

      monitor =
        "val_loss",

      patience =
        8,

      restore_best_weights =
        TRUE

    )

  )


  history <-

    model %>%

    fit(

      X_train,

      Y_train,

      validation_data =
        list(

          X_validation,

          Y_validation

        ),

      epochs =
        epochs,

      batch_size =
        batch_size,

      shuffle =
        FALSE,

      callbacks =
        callbacks,

      verbose =
        2

    )


  list(

    model =
      model,

    history =
      history

  )

}


###############################################################################
# 34) ROBUST PREDICTION METRICS
#
# Keras 3 prediction:
#
#   samples x pixels x 2
#
# This function explicitly reconstructs dimensions.
###############################################################################

calculate_metrics <- function(

    model,

    X,

    Y,

    nout = 1

) {

  pred <- model %>%

    predict(

      X,

      verbose = 0

    )


  pred <- as.array(pred)


  cat("\nPrediction dimensions:\n")

  print(
    dim(pred)
  )


  cat(
    "Prediction length:",
    length(pred),
    "\n"
  )


  ###########################################################################
  # Number of samples
  ###########################################################################

  nSamples <- dim(X)[1]


  ###########################################################################
  # Number of spatial pixels
  ###########################################################################

  if (
    length(dim(Y)) == 3
  ) {

    nPixels <- dim(Y)[2]

  } else {

    stop(
      "Y must have dimensions samples x pixels x 1."
    )

  }


  ###########################################################################
  # Force prediction dimensions
  ###########################################################################

  expected_length <-

    nSamples *
    nPixels *
    2


  if (
    length(pred) !=
    expected_length
  ) {

    stop(

      "\nPrediction size mismatch.\n",

      "Expected: ",

      expected_length,

      " values.\n",

      "Received: ",

      length(pred),

      " values.\n",

      "Prediction dimensions: ",

      paste(
        dim(pred),
        collapse = " x "
      ),

      "\n"

    )

  }


  pred <- array(

    pred,

    dim = c(

      nSamples,

      nPixels,

      2

    )

  )


  ###########################################################################
  # Force Y dimensions
  ###########################################################################

  Y <- array(

    Y,

    dim = c(

      nSamples,

      nPixels,

      1

    )

  )


  ###########################################################################
  # Predictive mean
  ###########################################################################

  pred_mean <-

    pred[,
         ,
         1]


  ###########################################################################
  # Predictive log-SD
  ###########################################################################

  pred_logsd <-

    pred[,
         ,
         2]


  pred_logsd <-

    pmax(

      -5,

      pmin(

        5,

        pred_logsd

      )

    )


  sd_pred <-

    exp(
      pred_logsd
    ) +

    1e-6


  ###########################################################################
  # Metrics
  ###########################################################################

  rmse <- numeric(
    nout
  )

  mae <- numeric(
    nout
  )

  nll <- numeric(
    nout
  )


  ###########################################################################
  # One output
  ###########################################################################

  true_k <-

    Y[
      ,
      ,
      1
    ]

  mu_k <-
    pred_mean

  sd_k <-
    sd_pred


  rmse[1] <-

    sqrt(

      mean(

        (
          true_k -
            mu_k
        )^2,

        na.rm = TRUE

      )

    )


  mae[1] <-

    mean(

      abs(

        true_k -
          mu_k

      ),

      na.rm = TRUE

    )


  nll[1] <-

    mean(

      0.5 * log(2 * pi) +

      log(sd_k) +

      0.5 *

      (

        (
          true_k -
            mu_k
        ) /

          sd_k

      )^2,

      na.rm = TRUE

    )


  ###########################################################################
  # Overall
  ###########################################################################

  overall_rmse <-

    sqrt(

      mean(

        (
          Y[, , 1] -
            pred_mean
        )^2,

        na.rm = TRUE

      )

    )


  overall_mae <-

    mean(

      abs(

        Y[, , 1] -
          pred_mean

      ),

      na.rm = TRUE

    )


  overall_nll <-

    mean(

      0.5 * log(2 * pi) +

      log(sd_pred) +

      0.5 *

      (

        (
          Y[, , 1] -
            pred_mean
        ) /

          sd_pred

      )^2,

      na.rm = TRUE

    )


  list(

    prediction =
      pred,

    prediction_mean =
      pred_mean,

    prediction_sd =
      sd_pred,

    rmse =
      rmse,

    mae =
      mae,

    nll =
      nll,

    overall_rmse =
      overall_rmse,

    overall_mae =
      overall_mae,

    overall_nll =
      overall_nll

  )

}


###############################################################################
# 35) PREPARE MODEL DATA
###############################################################################

prepare_model_data <- function(

    X_array,

    Y_array,

    L_in,

    train_idx,

    validation_idx,

    test_idx

) {

  ###########################################################################
  # Construct sequences
  ###########################################################################

  seq_data <-

    make_sequences_single(

      X_array,

      L_in

    )


  X <- seq_data$X

  Y <- seq_data$Y


  ###########################################################################
  # Flatten Y
  ###########################################################################

  Y_flat <-

    flatten_response_single(
      Y
    )


  ###########################################################################
  # Target time
  ###########################################################################

  target_times <-

    seq(

      L_in + 1,

      dim(X_array)[1]

    )


  ###########################################################################
  # Rows
  ###########################################################################

  train_rows <-

    which(

      target_times %in%
        train_idx

    )


  validation_rows <-

    which(

      target_times %in%
        validation_idx

    )


  test_rows <-

    which(

      target_times %in%
        test_idx

    )


  ###########################################################################
  # Return
  ###########################################################################

  list(

    X_train =

      X[

        train_rows,

        ,

        ,

        ,

        ,

        drop = FALSE

      ],


    Y_train =

      Y_flat[

        train_rows,

        ,

        ,

        drop = FALSE

      ],


    X_validation =

      X[

        validation_rows,

        ,

        ,

        ,

        ,

        drop = FALSE

      ],


    Y_validation =

      Y_flat[

        validation_rows,

        ,

        ,

        drop = FALSE

      ],


    X_test =

      X[

        test_rows,

        ,

        ,

        ,

        ,

        drop = FALSE

      ],


    Y_test =

      Y_flat[

        test_rows,

        ,

        ,

        drop = FALSE

      ]

  )

}


###############################################################################
