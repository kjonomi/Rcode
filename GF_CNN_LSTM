# Convert Y_array (N x T x nout) to (T x nlat x nlon x nout) tensor
make_image_tensor_multi <- function(Y_array, nlon, nlat){
  N <- dim(Y_array)[1]  # number of spatial locations
  Tt <- dim(Y_array)[2] # number of time points
  nout <- dim(Y_array)[3] # number of outputs
  imgs <- array(0, dim=c(Tt, nlat, nlon, nout))
  
  for(t in 1:Tt){
    for(k in 1:nout){
      imgs[t,,,k] <- matrix(Y_array[,t,k], nrow=nlat, ncol=nlon, byrow=FALSE)
    }
  }
  imgs
}

# Create input-output sequences for L_in time steps
make_sequences_multi <- function(imgs, L_in=5){
  Tt <- dim(imgs)[1]; nlat <- dim(imgs)[2]; nlon <- dim(imgs)[3]; nout <- dim(imgs)[4]
  nSamples <- Tt - L_in
  X <- array(0, dim=c(nSamples, L_in, nlat, nlon, nout))
  Y <- array(0, dim=c(nSamples, nlat, nlon, nout))
  
  for(i in 1:nSamples){
    X[i,,,,] <- imgs[i:(i+L_in-1),,,, drop=FALSE]
    Y[i,,,] <- imgs[i+L_in,,,, drop=FALSE][1,,,]
  }
  
  list(X=X, Y=Y)
}

# Build CNN-LSTM model for multi-output grid
build_cnn_lstm_multi <- function(nlat, nlon, nout, L_in=5){
  input <- layer_input(shape=c(L_in, nlat, nlon, nout))
  
  td <- input %>%
    time_distributed(layer_conv_2d(filters=16, kernel_size=c(3,3), padding="same", activation="relu")) %>%
    time_distributed(layer_max_pooling_2d(pool_size=c(2,2))) %>%
    time_distributed(layer_conv_2d(filters=32, kernel_size=c(3,3), padding="same", activation="relu")) %>%
    time_distributed(layer_max_pooling_2d(pool_size=c(2,2))) %>%
    time_distributed(layer_flatten())
  
  lstm <- td %>% layer_lstm(units=128, return_sequences=FALSE)
  
  total_pixels <- nlat * nlon
  dense_out <- lstm %>% layer_dense(units=total_pixels * nout * 2)  # mean + log(sd) per pixel/output
  out <- layer_reshape(dense_out, target_shape=c(total_pixels, nout, 2))
  
  keras_model(inputs=input, outputs=out)
}

# Negative log-likelihood loss for Gaussian outputs
###############################################################
# Gaussian negative log-likelihood loss
# Keras 3 compatible
###############################################################

nll_gaussian_multi <- function(eps = 1e-5) {

    function(y_true, y_pred) {

        pred_mean  <- y_pred[,,,1]
        pred_logsd <- y_pred[,,,2]

        # Stable standard deviation
        sd <- tf$math$exp(
            tf$clip_by_value(
                pred_logsd,
                -10,
                10
            )
        ) + eps

        # Gaussian negative log-likelihood
        nll <-
            0.5 * log(2 * pi) +
            tf$math$log(sd) +
            0.5 *
            tf$square(
                (y_true - pred_mean) / sd
            )

        tf$reduce_mean(nll)
    }
}

###############################################################
# 6) RMSE computation (safe)
###############################################################
compute_rmse_multi_safe <- function(model, Xseq, Yseq, nout){
  preds <- predict(model,Xseq)
  pred_mean <- preds[,, ,1]
  
  nSamples <- dim(Xseq)[1]; nlat <- dim(Yseq)[2]; nlon <- dim(Yseq)[3]
  Y_flat <- array(0, dim=c(nSamples, nlat*nlon, nout))
  for(i in 1:nSamples) for(k in 1:nout) Y_flat[i,,k] <- as.numeric(Yseq[i,,,k])
  
  rmse_vec <- numeric(nout)
  for(k in 1:nout) rmse_vec[k] <- sqrt(mean((Y_flat[,,k]-pred_mean[,,k])^2))
  names(rmse_vec) <- paste0("Output_",1:nout)
  overall_rmse <- sqrt(mean((Y_flat-pred_mean)^2))
  list(per_output_rmse=rmse_vec, overall_rmse=overall_rmse)
}
