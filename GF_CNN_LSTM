###############################################################
# GRAPH-FREQUENCY CNN-LSTM VS CNN-LSTM WITHOUT GRAPH
# Fair spatial-domain comparison
###############################################################

###############################################################
# 0) Required libraries
###############################################################

library(keras3)
library(tensorflow, lib.loc = "/opt/R/4.4.0/lib/R/library")
library(pracma)
library(reshape2)
library(ggplot2)
library(dplyr)
library(tidyr)

###############################################################
# 1) Reproducibility
###############################################################

set.seed(42)

###############################################################
# 2) Spherical grid
###############################################################

deg2rad <- function(deg) {
  deg * pi / 180
}

sphere_grid <- function(nlon = 84, nlat = 42) {

  lon <- seq(
    -180,
    180 - 360 / nlon,
    length.out = nlon
  )

  lat <- seq(
    -90 + 180 / (2 * nlat),
    90 - 180 / (2 * nlat),
    length.out = nlat
  )

  grid <- expand.grid(
    lon = lon,
    lat = lat
  )

  x <- cos(deg2rad(grid$lat)) *
       cos(deg2rad(grid$lon))

  y <- cos(deg2rad(grid$lat)) *
       sin(deg2rad(grid$lon))

  z <- sin(deg2rad(grid$lat))

  coords3 <- cbind(x, y, z)

  list(
    grid = grid,
    coords3 = coords3,
    nlon = nlon,
    nlat = nlat
  )
}

###############################################################
# 3) Angular distance
###############################################################

angular_dist <- function(u, v) {

  if (is.vector(u)) {
    u <- matrix(u, nrow = 1)
  }

  res <- u %*% t(v)

  res <- pmax(
    -1,
    pmin(1, res)
  )

  acos(res)
}

pairwise_ang_dist_mat <- function(coords3) {

  N <- nrow(coords3)

  M <- matrix(
    0,
    nrow = N,
    ncol = N
  )

  for (i in seq_len(N)) {

    M[i, ] <-
      angular_dist(
        coords3[i, ],
        coords3
      )
  }

  M
}

###############################################################
# 4) Spatially varying covariance
###############################################################

make_sigma_spatial <- function(
    coords3,
    alpha0 = 1,
    alpha1 = 0.5,
    alpha2 = 0.2) {

  x <- coords3[, 1]
  y <- coords3[, 2]
  z <- coords3[, 3]

  sigma <-
    alpha0 +
    alpha1 * z +
    alpha2 * (x^2 - y^2)

  pmax(
    0.05,
    sigma
  )
}

iscf_cov_matrix <- function(
    coords3,
    phi = 0.4,
    alpha0 = 1,
    alpha1 = 0.5,
    alpha2 = 0.2,
    nugget = 1e-6) {

  sigma <- make_sigma_spatial(
    coords3,
    alpha0,
    alpha1,
    alpha2
  )

  ang <- pairwise_ang_dist_mat(
    coords3
  )

  K <-
    outer(
      sigma,
      sigma,
      "*"
    ) *
    exp(
      -(ang / phi)^2
    )

  diag(K) <-
    diag(K) + nugget

  K
}

###############################################################
# 5) Spatio-temporal simulation
###############################################################

simulate_spatio_temporal <- function(
    coords3,
    T = 30,
    seed = 1) {

  set.seed(seed)

  N <- nrow(coords3)

  CovW <- iscf_cov_matrix(
    coords3
  )

  L <- chol(CovW)

  W <- matrix(
    rnorm(N * T),
    nrow = N,
    ncol = T
  )

  W <- L %*% W

  X <- matrix(
    0,
    nrow = N,
    ncol = T
  )

  X[, 1] <- W[, 1]

  if (T > 1) {

    for (t in 2:T) {

      X[, t] <-
        X[, t - 1] +
        W[, t]
    }
  }

  X
}

###############################################################
# 6) Spatial polynomial detrending
###############################################################

detrend_spatial_poly <- function(
    Y_vec,
    coords3) {

  x <- coords3[, 1]
  y <- coords3[, 2]
  z <- coords3[, 3]

  B <- cbind(
    1,
    x,
    y,
    z,
    x^2,
    x * y,
    x * z,
    y^2,
    y * z,
    z^2
  )

  fit <- lm(
    Y_vec ~ B - 1
  )

  residuals(fit)
}

detrend_all_times_poly <- function(
    Xmat,
    coords3) {

  N <- nrow(Xmat)
  Tt <- ncol(Xmat)

  resid <- matrix(
    0,
    nrow = N,
    ncol = Tt
  )

  for (t in seq_len(Tt)) {

    resid[, t] <-
      detrend_spatial_poly(
        Xmat[, t],
        coords3
      )
  }

  resid
}

###############################################################
# 7) Temporal polynomial detrending
###############################################################

detrend_temporal_poly_safe <- function(
    Y_array,
    degree = 2) {

  N <- dim(Y_array)[1]
  Tt <- dim(Y_array)[2]
  nout <- dim(Y_array)[3]

  Y_resid <- array(
    0,
    dim = c(N, Tt, nout)
  )

  B <- poly(
    seq_len(Tt),
    degree = degree,
    raw = TRUE
  )

  for (i in seq_len(N)) {

    for (k in seq_len(nout)) {

      y <- Y_array[i, , k]

      if (
        any(is.na(y)) ||
        sd(y, na.rm = TRUE) < 1e-8
      ) {

        Y_resid[i, , k] <- 0

        next
      }

      fit <- lm(
        y ~ B - 1
      )

      Y_resid[i, , k] <-
        residuals(fit)
    }
  }

  Y_resid
}

###############################################################
# 8) Normalization
###############################################################

normalize_array_per_output <- function(
    Y_array) {

  nout <- dim(Y_array)[3]

  for (k in seq_len(nout)) {

    mu <- mean(
      Y_array[, , k]
    )

    s <- sd(
      Y_array[, , k]
    )

    if (
      !is.finite(s) ||
      s < 1e-8
    ) {

      s <- 1
    }

    Y_array[, , k] <-
      (Y_array[, , k] - mu) / s
  }

  Y_array
}

###############################################################
# 9) Multivariate copula outcome simulation
###############################################################

simulate_copula_outcomes <- function(
    X,
    R_dep = matrix(
      c(
        1, 0.5, 0.3,
        0.5, 1, 0.4,
        0.3, 0.4, 1
      ),
      3,
      3
    ),
    seed = 123) {

  set.seed(seed)

  N <- nrow(X)
  Tt <- ncol(X)
  nout <- nrow(R_dep)

  Y_array <- array(
    0,
    dim = c(N, Tt, nout)
  )

  L_R <- chol(R_dep)

  for (t in seq_len(Tt)) {

    Z <- matrix(
      rnorm(N * nout),
      nrow = N,
      ncol = nout
    )

    Z_dep <-
      Z %*% L_R

    for (k in seq_len(nout)) {

      Y_array[, t, k] <-
        X[, t] +
        Z_dep[, k]
    }
  }

  Y_array
}

###############################################################
# 10) Geographic graph construction
###############################################################

build_geographic_graph <- function(
    coords3) {

  N <- nrow(coords3)

  D_geo <-
    pairwise_ang_dist_mat(
      coords3
    )

  positive_distances <-
    D_geo[D_geo > 0]

  sigma <-
    median(
      positive_distances
    )

  W <-
    exp(
      -(D_geo^2) /
      (2 * sigma^2)
    )

  diag(W) <- 0

  W <-
    (W + t(W)) / 2

  degree <-
    rowSums(W)

  degree[
    degree < 1e-10
  ] <- 1e-10

  D_inv_sqrt <-
    diag(
      1 / sqrt(degree)
    )

  L <-
    diag(N) -
    D_inv_sqrt %*%
    W %*%
    D_inv_sqrt

  L <-
    (L + t(L)) / 2

  eig <-
    eigen(
      L,
      symmetric = TRUE
    )

  list(
    W = W,
    L = L,
    eigenvalues = eig$values,
    U = eig$vectors,
    sigma = sigma
  )
}

###############################################################
# 11) Graph Fourier transform
###############################################################

graph_fourier_transform <- function(
    Y_array,
    U) {

  N <- dim(Y_array)[1]
  Tt <- dim(Y_array)[2]
  nout <- dim(Y_array)[3]

  Y_graph <- array(
    0,
    dim = c(N, Tt, nout)
  )

  for (t in seq_len(Tt)) {

    for (k in seq_len(nout)) {

      Y_graph[, t, k] <-
        as.numeric(
          t(U) %*%
          Y_array[, t, k]
        )
    }
  }

  Y_graph
}

###############################################################
# 12) Inverse graph Fourier transform
###############################################################

inverse_graph_fourier_transform <- function(
    Y_graph,
    U) {

  N <- dim(Y_graph)[1]
  Tt <- dim(Y_graph)[2]
  nout <- dim(Y_graph)[3]

  Y_spatial <- array(
    0,
    dim = c(N, Tt, nout)
  )

  for (t in seq_len(Tt)) {

    for (k in seq_len(nout)) {

      Y_spatial[, t, k] <-
        as.numeric(
          U %*%
          Y_graph[, t, k]
        )
    }
  }

  Y_spatial
}

###############################################################
# 13) Convert spatial array to image tensor
###############################################################

make_image_tensor_multi <- function(
    Y_array,
    nlon,
    nlat) {

  Tt <- dim(Y_array)[2]
  nout <- dim(Y_array)[3]

  imgs <- array(
    0,
    dim = c(
      Tt,
      nlat,
      nlon,
      nout
    )
  )

  for (t in seq_len(Tt)) {

    for (k in seq_len(nout)) {

      imgs[t, , , k] <-
        matrix(
          Y_array[, t, k],
          nrow = nlat,
          ncol = nlon,
          byrow = FALSE
        )
    }
  }

  imgs
}

###############################################################
# 14) Create CNN-LSTM sequences
###############################################################

make_sequences_multi <- function(
    imgs,
    L_in = 5) {

  Tt <- dim(imgs)[1]
  nlat <- dim(imgs)[2]
  nlon <- dim(imgs)[3]
  nout <- dim(imgs)[4]

  nSamples <-
    Tt - L_in

  X <- array(
    0,
    dim = c(
      nSamples,
      L_in,
      nlat,
      nlon,
      nout
    )
  )

  Y <- array(
    0,
    dim = c(
      nSamples,
      nlat,
      nlon,
      nout
    )
  )

  for (i in seq_len(nSamples)) {

    X[i, , , , ] <-
      imgs[
        i:(i + L_in - 1),
        , ,
        ,
        drop = FALSE
      ]

    Y[i, , , ] <-
      imgs[
        i + L_in,
        , ,
        ,
        drop = FALSE
      ][1, , , ]
  }

  list(
    X = X,
    Y = Y
  )
}

###############################################################
# 15) Flatten spatial response
###############################################################

flatten_response <- function(
    Yseq) {

  nSamples <- dim(Yseq)[1]
  nlat <- dim(Yseq)[2]
  nlon <- dim(Yseq)[3]
  nout <- dim(Yseq)[4]

  total_pixels <-
    nlat * nlon

  Y_flat <- array(
    0,
    dim = c(
      nSamples,
      total_pixels,
      nout
    )
  )

  for (i in seq_len(nSamples)) {

    for (k in seq_len(nout)) {

      Y_flat[i, , k] <-
        as.numeric(
          Yseq[i, , , k]
        )
    }
  }

  Y_flat
}

###############################################################
# 16) CNN-LSTM architecture
###############################################################

build_cnn_lstm_multi <- function(
    nlat,
    nlon,
    nout,
    L_in = 5) {

  input <-
    layer_input(
      shape = c(
        L_in,
        nlat,
        nlon,
        nout
      )
    )

  td <-
    input %>%

    time_distributed(
      layer_conv_2d(
        filters = 16,
        kernel_size = c(3, 3),
        padding = "same",
        activation = "relu"
      )
    ) %>%

    time_distributed(
      layer_max_pooling_2d(
        pool_size = c(2, 2)
      )
    ) %>%

    time_distributed(
      layer_conv_2d(
        filters = 32,
        kernel_size = c(3, 3),
        padding = "same",
        activation = "relu"
      )
    ) %>%

    time_distributed(
      layer_max_pooling_2d(
        pool_size = c(2, 2)
      )
    ) %>%

    time_distributed(
      layer_flatten()
    )

  lstm <-
    td %>%
    layer_lstm(
      units = 128,
      return_sequences = FALSE
    )

  total_pixels <-
    nlat * nlon

  dense_out <-
    lstm %>%
    layer_dense(
      units =
        total_pixels *
        nout *
        2
    )

  out <-
    dense_out %>%
    layer_reshape(
      target_shape =
        c(
          total_pixels,
          nout,
          2
        )
    )

  keras_model(
    inputs = input,
    outputs = out
  )
}

###############################################################
# 17) Gaussian negative log-likelihood
###############################################################

nll_gaussian_multi <- function(
    eps = 1e-5) {

  function(
      y_true,
      y_pred) {

    pred_mean <-
      y_pred[, , , 1]

    pred_logsd <-
      y_pred[, , , 2]

    pred_logsd <-
      tf$clip_by_value(
        pred_logsd,
        -10,
        10
      )

    sd <-
      tf$math$exp(
        pred_logsd
      ) +
      eps

    nll <-
      0.5 * log(2 * pi) +
      tf$math$log(sd) +
      0.5 *
      tf$square(
        (y_true - pred_mean) / sd
      )

    tf$reduce_mean(
      nll
    )
  }
}

###############################################################
# 18) Convert model prediction to spatial array
###############################################################

prediction_to_array <- function(
    pred,
    nlat,
    nlon,
    nout) {

  nSamples <-
    dim(pred)[1]

  pred_mean <-
    pred[, , , 1]

  out <-
    array(
      0,
      dim = c(
        nSamples,
        nlat,
        nlon,
        nout
      )
    )

  for (i in seq_len(nSamples)) {

    for (k in seq_len(nout)) {

      out[i, , , k] <-
        matrix(
          pred_mean[i, , k],
          nrow = nlat,
          ncol = nlon,
          byrow = FALSE
        )
    }
  }

  out
}

###############################################################
# 19) Inverse graph transformation of predictions
###############################################################

inverse_prediction_graph <- function(
    pred,
    U,
    nlat,
    nlon,
    nout) {

  nSamples <-
    dim(pred)[1]

  N <-
    nlat * nlon

  pred_spatial <-
    array(
      0,
      dim = c(
        nSamples,
        N,
        nout
      )
    )

  pred_mean <-
    pred[, , , 1]

  for (i in seq_len(nSamples)) {

    for (k in seq_len(nout)) {

      pred_spatial[i, , k] <-
        as.numeric(
          U %*%
          pred_mean[i, , k]
        )
    }
  }

  pred_spatial
}

###############################################################
# 20) Fair comparison metrics
###############################################################

calculate_metrics <- function(
    Y_true,
    pred_mean,
    pred_logsd,
    model_name) {

  nout <-
    dim(Y_true)[3]

  rmse <-
    numeric(nout)

  mae <-
    numeric(nout)

  nll <-
    numeric(nout)

  for (k in seq_len(nout)) {

    true_k <-
      as.vector(
        Y_true[, , k]
      )

    pred_k <-
      as.vector(
        pred_mean[, , k]
      )

    logsd_k <-
      as.vector(
        pred_logsd[, , k]
      )

    sd_k <-
      exp(
        pmin(
          pmax(
            logsd_k,
            -10
          ),
          10
        )
      ) +
      1e-6

    rmse[k] <-
      sqrt(
        mean(
          (true_k - pred_k)^2
        )
      )

    mae[k] <-
      mean(
        abs(
          true_k - pred_k
        )
      )

    nll[k] <-
      mean(
        0.5 * log(2 * pi) +
        log(sd_k) +
        0.5 *
        ((true_k - pred_k) /
           sd_k)^2
      )
  }

  data.frame(
    Model = model_name,
    Output = seq_len(nout),
    RMSE = rmse,
    MAE = mae,
    NLL = nll
  )
}

###############################################################
# 21) MAIN TWO-MODEL EXPERIMENT
###############################################################

run_example_compare_graph <- function(
    nlon = 84,
    nlat = 42,
    Tt = 30,
    L_in = 5,
    nout = 3,
    seed = 42,
    epochs = 5,
    batch_size = 4) {

  #############################################################
  # Reproducibility
  #############################################################

  set.seed(seed)

  #############################################################
  # Generate spherical grid
  #############################################################

  gr <-
    sphere_grid(
      nlon,
      nlat
    )

  coords3 <-
    gr$coords3

  #############################################################
  # Simulate common spatio-temporal process
  #############################################################

  X <-
    simulate_spatio_temporal(
      coords3,
      T = Tt,
      seed = seed
    )

  #############################################################
  # Common spatial detrending
  #############################################################

  R <-
    detrend_all_times_poly(
      X,
      coords3
    )

  #############################################################
  # Common multivariate climate outcomes
  #############################################################

  Y_array <-
    simulate_copula_outcomes(
      R,
      seed = seed + 100
    )

  #############################################################
  # Common temporal detrending
  #############################################################

  Y_array <-
    detrend_temporal_poly_safe(
      Y_array,
      degree = 2
    )

  #############################################################
  # Common normalization
  #############################################################

  Y_array <-
    normalize_array_per_output(
      Y_array
    )

  #############################################################
  # Spatial image representation
  #############################################################

  imgs_spatial <-
    make_image_tensor_multi(
      Y_array,
      nlon,
      nlat
    )

  #############################################################
  # ==========================================================
  # MODEL 1: CNN-LSTM WITHOUT GRAPH
  # ==========================================================
  #############################################################

  cat(
    "\n============================================\n"
  )

  cat(
    "MODEL 1: CNN-LSTM WITHOUT GRAPH\n"
  )

  cat(
    "============================================\n"
  )

  seqs_nograph <-
    make_sequences_multi(
      imgs_spatial,
      L_in
    )

  X_nograph <-
    seqs_nograph$X

  Y_nograph <-
    seqs_nograph$Y

  Y_flat_nograph <-
    flatten_response(
      Y_nograph
    )

  model_nograph <-
    build_cnn_lstm_multi(
      nlat,
      nlon,
      nout,
      L_in
    )

  model_nograph %>%
    compile(
      optimizer =
        optimizer_adam(
          learning_rate = 0.001
        ),
      loss =
        nll_gaussian_multi()
    )

  history_nograph <-
    model_nograph %>%
    fit(
      X_nograph,
      Y_flat_nograph,
      epochs = epochs,
      batch_size = batch_size,
      validation_split = 0.20,
      shuffle = FALSE,
      verbose = 2
    )

  #############################################################
  # Predictions: no graph
  #############################################################

  pred_nograph <-
    model_nograph %>%
    predict(
      X_nograph
    )

  pred_mean_nograph <-
    pred_nograph[, , , 1]

  pred_logsd_nograph <-
    pred_nograph[, , , 2]

  #############################################################
  # ==========================================================
  # MODEL 2: GRAPH-FREQUENCY CNN-LSTM
  # ==========================================================
  #############################################################

  cat(
    "\n============================================\n"
  )

  cat(
    "MODEL 2: GRAPH-FREQUENCY CNN-LSTM\n"
  )

  cat(
    "============================================\n"
  )

  #############################################################
  # Construct geographic graph
  #############################################################

  graph <-
    build_geographic_graph(
      coords3
    )

  #############################################################
  # Graph Fourier transform
  #############################################################

  Y_graph <-
    graph_fourier_transform(
      Y_array,
      graph$U
    )

  #############################################################
  # Graph-frequency image representation
  #############################################################

  imgs_graph <-
    make_image_tensor_multi(
      Y_graph,
      nlon,
      nlat
    )

  #############################################################
  # Graph sequences
  #############################################################

  seqs_graph <-
    make_sequences_multi(
      imgs_graph,
      L_in
    )

  X_graph <-
    seqs_graph$X

  Y_graph_seq <-
    seqs_graph$Y

  Y_flat_graph <-
    flatten_response(
      Y_graph_seq
    )

  #############################################################
  # Build graph-frequency CNN-LSTM
  #############################################################

  model_graph <-
    build_cnn_lstm_multi(
      nlat,
      nlon,
      nout,
      L_in
    )

  model_graph %>%
    compile(
      optimizer =
        optimizer_adam(
          learning_rate = 0.001
        ),
      loss =
        nll_gaussian_multi()
    )

  history_graph <-
    model_graph %>%
    fit(
      X_graph,
      Y_flat_graph,
      epochs = epochs,
      batch_size = batch_size,
      validation_split = 0.20,
      shuffle = FALSE,
      verbose = 2
    )

  #############################################################
  # Graph-domain prediction
  #############################################################

  pred_graph <-
    model_graph %>%
    predict(
      X_graph
    )

  #############################################################
  # Inverse graph transform
  #
  # This is the critical correction:
  # graph predictions are converted back to spatial domain
  # before comparing them with the original spatial targets.
  #############################################################

  pred_graph_spatial <-
    inverse_prediction_graph(
      pred_graph,
      graph$U,
      nlat,
      nlon,
      nout
    )

  #############################################################
  # Original spatial-domain target
  #############################################################

  Y_true_spatial <-
    array(
      0,
      dim = c(
        dim(Y_nograph)[1],
        nlat * nlon,
        nout
      )
    )

  for (i in seq_len(dim(Y_nograph)[1])) {

    for (k in seq_len(nout)) {

      Y_true_spatial[i, , k] <-
        as.numeric(
          Y_nograph[i, , , k]
        )
    }
  }

  #############################################################
  # Spatial predictions from no-graph model
  #############################################################

  pred_nograph_spatial <-
    pred_mean_nograph

  #############################################################
  # Calculate fair spatial-domain metrics
  #############################################################

  metrics_nograph <-
    calculate_metrics(
      Y_true_spatial,
      pred_nograph_spatial,
      pred_logsd_nograph,
      "CNN-LSTM without graph"
    )

  #############################################################
  # Graph model uncertainty
  #
  # The predicted uncertainty is initially in graph space.
  # For the primary RMSE/MAE comparison, spatial mean prediction
  # is sufficient. NLL is reported in graph space separately.
  #############################################################

  pred_logsd_graph <-
    pred_graph[, , , 2]

  #############################################################
  # Spatial-domain graph metrics
  #
  # Use transformed spatial mean prediction.
  #############################################################

  metrics_graph_spatial <-
    data.frame(
      Model =
        "Graph-frequency CNN-LSTM",

      Output =
        seq_len(nout),

      RMSE =
        numeric(nout),

      MAE =
        numeric(nout),

      NLL =
        NA_real_
    )

  for (k in seq_len(nout)) {

    true_k <-
      as.vector(
        Y_true_spatial[, , k]
      )

    pred_k <-
      as.vector(
        pred_graph_spatial[, , k]
      )

    metrics_graph_spatial$RMSE[k] <-
      sqrt(
        mean(
          (true_k - pred_k)^2
        )
      )

    metrics_graph_spatial$MAE[k] <-
      mean(
        abs(
          true_k - pred_k
        )
      )
  }

  #############################################################
  # Combine RMSE/MAE comparison
  #############################################################

  comparison_table <-
    rbind(
      metrics_nograph,
      metrics_graph_spatial
    )

  #############################################################
  # Overall RMSE and MAE
  #############################################################

  overall_rmse_nograph <-
    sqrt(
      mean(
        (
          Y_true_spatial -
          pred_nograph_spatial
        )^2
      )
    )

  overall_rmse_graph <-
    sqrt(
      mean(
        (
          Y_true_spatial -
          pred_graph_spatial
        )^2
      )
    )

  overall_mae_nograph <-
    mean(
      abs(
        Y_true_spatial -
        pred_nograph_spatial
      )
    )

  overall_mae_graph <-
    mean(
      abs(
        Y_true_spatial -
        pred_graph_spatial
      )
    )

  #############################################################
  # Percentage improvements
  #############################################################

  improvement_table <-
    data.frame(

      Metric = c(
        "RMSE",
        "MAE"
      ),

      CNN_LSTM_without_graph = c(
        overall_rmse_nograph,
        overall_mae_nograph
      ),

      Graph_frequency_CNN_LSTM = c(
        overall_rmse_graph,
        overall_mae_graph
      ),

      Improvement_Percent = c(

        100 *
        (
          overall_rmse_nograph -
          overall_rmse_graph
        ) /
        overall_rmse_nograph,

        100 *
        (
          overall_mae_nograph -
          overall_mae_graph
        ) /
        overall_mae_nograph
      )
    )

  #############################################################
  # Per-output comparison
  #############################################################

  per_output_comparison <-
    data.frame(

      Output =
        seq_len(nout),

      RMSE_NoGraph =
        metrics_nograph$RMSE,

      RMSE_Graph =
        metrics_graph_spatial$RMSE,

      MAE_NoGraph =
        metrics_nograph$MAE,

      MAE_Graph =
        metrics_graph_spatial$MAE
    ) %>%

    mutate(

      RMSE_Improvement =
        100 *
        (
          RMSE_NoGraph -
          RMSE_Graph
        ) /
        RMSE_NoGraph,

      MAE_Improvement =
        100 *
        (
          MAE_NoGraph -
          MAE_Graph
        ) /
        MAE_NoGraph
    )

  #############################################################
  # Return results
  #############################################################

  list(

    comparison_table =
      comparison_table,

    per_output_comparison =
      per_output_comparison,

    improvement_table =
      improvement_table,

    overall_rmse_nograph =
      overall_rmse_nograph,

