###############################################################
# 31.8 Evaluation function
###############################################################

evaluate_model <- function(
    Y_true,
    pred
){

    results <- data.frame(
        Variable = variable_names,
        RMSE = NA_real_,
        MAE = NA_real_,
        Avg_NLL = NA_real_
    )

    for(k in 1:n_var){

        true_vals <-
            as.vector(
                Y_true[,,,k]
            )

        pred_vals <-
            as.vector(
                pred$mean[,,,k]
            )

        sd_vals <-
            exp(
                as.vector(
                    pred$logsd[,,,k]
                )
            ) + 1e-6


        results$RMSE[k] <-
            sqrt(
                mean(
                    (true_vals - pred_vals)^2,
                    na.rm = TRUE
                )
            )


        results$MAE[k] <-
            mean(
                abs(
                    true_vals - pred_vals
                ),
                na.rm = TRUE
            )


        results$Avg_NLL[k] <-
            mean(
                0.5 * log(2*pi) +
                log(sd_vals) +
                0.5 *
                (
                    (true_vals - pred_vals) /
                    sd_vals
                )^2,
                na.rm = TRUE
            )
    }

    results
}


