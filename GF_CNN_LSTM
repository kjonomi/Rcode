detrend_temporal_poly <- function(
    Y_array,
    degree = 2
) {

  N <- dim(Y_array)[2]

  T <- dim(Y_array)[1]

  nout <- dim(Y_array)[4]


  Y_resid <- array(
    NA_real_,
    dim = dim(Y_array)
  )


  for(i in seq_len(N)) {

    for(k in seq_len(nout)) {

      y <- Y_array[, i, 1, k]


      time_index <- seq_len(T)


      B <- poly(
        time_index,
        degree = degree,
        raw = TRUE
      )


      fit <- lm(
        y ~ B - 1
      )


      Y_resid[, i, 1, k] <-
        residuals(fit)
    }
  }


  Y_resid
}


