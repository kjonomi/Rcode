      pred_raw,
      dim = c(
        nSamples,
        total_pixels,
        nout,
        2
      )
    )


  } else if(
    length(dim(pred_raw)) == 3
  ) {

    if(
      dim(pred_raw)[2] ==
      total_pixels &&
      dim(pred_raw)[3] ==
