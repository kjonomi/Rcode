        "Unexpected prediction dimensions."
      )
    }
  }


  pred_mean <-
    pred_raw[,,,1]


  pred_logsd <-
    pred_raw[,,,2]


  mean_arr <- array(
    pred_mean,
    dim = c(
      nSamples,
      nlat,
      nlon,
      nout
    )
  )


  logsd_arr <- array(
    pred_logsd,
    dim = c(
      nSamples,
      nlat,
      nlon,
      nout
    )
  )


  list(
    mean = mean_arr,
    logsd = logsd_arr
  )
