###############################################################
# Geographic weight matrix
###############################################################

make_geographic_weight_matrix <- function(

    latitudes,

    longitudes,

    sigma = NULL,

    self_weight = 0

) {


  stopifnot(
    length(latitudes) ==
      length(longitudes)
  )


  n <- length(
    latitudes
  )


  lat <- latitudes *
    pi / 180


  lon <- longitudes *
    pi / 180


  earth_radius <- 6371


  Wdist <- matrix(
    0,
    n,
    n
  )


  for(i in 1:n) {

    for(j in 1:n) {

      cos_d <-

        sin(lat[i]) *
        sin(lat[j]) +

        cos(lat[i]) *
        cos(lat[j]) *
        cos(
          lon[i] - lon[j]
        )


      cos_d <-
        max(
          -1,
          min(
            1,
            cos_d
          )
        )


      Wdist[i,j] <-
        earth_radius *
        acos(cos_d)
    }
  }


  if(is.null(sigma)) {

    positive_dist <-
      Wdist[
        Wdist > 0
      ]


    if(
      length(
        positive_dist
      ) == 0
    ) {

      sigma <- 1

    } else {

      sigma <-
        median(
          positive_dist
        )
    }
  }


  W <-
    exp(
      -(Wdist^2) /
        (2 * sigma^2)
    )


  diag(W) <-
    self_weight


  W[
    !is.finite(W)
  ] <- 0


  W
}


###############################################################
# Correlation weight matrix
###############################################################

make_correlation_weight_matrix <- function(

    X,

    threshold = 0,

    absolute = TRUE

) {


  C <- cor(
    t(X),
    use = "pairwise.complete.obs"
  )


  if(absolute) {

    W <- abs(C)

  } else {

    W <- C
  }


  diag(W) <- 0


  if(threshold > 0) {

    W[
      W < threshold
    ] <- 0
  }


  W[
    !is.finite(W)
  ] <- 0


  W
}


###############################################################
# Hybrid graph
###############################################################

make_hybrid_weight_matrix <- function(

    W_geo,

    W_corr = NULL,

    alpha_geo = 1,

    alpha_corr = 0

) {


  if(
    is.null(W_corr)
  ) {

    return(W_geo)
  }


  W <-

    alpha_geo * W_geo +

    alpha_corr * W_corr


  diag(W) <- 0


  W[
    !is.finite(W)
  ] <- 0


  W
}


###############################################################
# Graph Laplacian
###############################################################

make_graph_laplacian <- function(

    W,

    normalized = TRUE

) {


  W <- as.matrix(W)


  W <-
    (W + t(W)) / 2


  diag(W) <- 0


  degree <-
    rowSums(W)


  D <-
    diag(degree)


  if(normalized) {


    degree_inv_sqrt <-
      rep(
        0,
        length(degree)
      )


    positive <-
      degree > 1e-12


    degree_inv_sqrt[
      positive
    ] <-

      1 /
      sqrt(
        degree[
          positive
        ]
      )


    D_inv_sqrt <-
      diag(
        degree_inv_sqrt
      )


    L <-

      diag(
        nrow(W)
      ) -

      D_inv_sqrt %*%
      W %*%
      D_inv_sqrt


  } else {


    L <-
      D - W
  }


  L <-
    (L + t(L)) / 2


  L
}


###############################################################
# Graph Fourier basis
###############################################################

graph_fourier_basis <- function(
    L
) {


  eig <-
    eigen(
      L,
      symmetric = TRUE
    )


  ord <-
    order(
      eig$values
    )


  eigenvalues <-
    eig$values[
      ord
    ]


  U <-
    eig$vectors[
      ,
      ord,
      drop = FALSE
    ]


  eigenvalues[
    eigenvalues < 0 &
      eigenvalues > -1e-10
  ] <- 0


  list(

    eigenvalues =
      eigenvalues,

    U =
      U
  )
}


###############################################################
# Graph Fourier transform
###############################################################

graph_fourier_transform <- function(

    X,

    U

) {


  d <- dim(X)


  if(
    length(d) == 2
  ) {

    return(
      t(U) %*% X
    )
  }


  if(
    length(d) == 3
  ) {


    N <- d[1]

    T <- d[2]

    P <- d[3]


    Xtilde <-
      array(
        0,
        dim = c(
          N,
          T,
          P
        )
      )


    for(p in 1:P) {

      Xtilde[,,p] <-

        t(U) %*%
        X[,,p]
    }


    return(
      Xtilde
    )
  }


  stop(
    "X must be either N x T or N x T x P."
  )
}


###############################################################
# Inverse graph Fourier transform
###############################################################

inverse_graph_fourier_transform <- function(

    Xtilde,

    U

) {


  d <- dim(
    Xtilde
  )


  if(
    length(d) == 2
  ) {

    return(
      U %*% Xtilde
    )
  }


  if(
    length(d) == 3
  ) {


    N <- d[1]

    T <- d[2]

    P <- d[3]


    X <-
      array(
        0,
        dim = c(
          N,
          T,
          P
        )
      )


    for(p in 1:P) {

      X[,,p] <-

        U %*%
        Xtilde[,,p]
    }


    return(
      X
    )
  }


  stop(
    "Xtilde must be either N x T or N x T x P."
  )
}


###############################################################
# Graph-frequency filter
###############################################################

graph_frequency_filter <- function(

    Xtilde,

    eigenvalues,

    cutoff = NULL

) {


  d <- dim(
    Xtilde
  )


  if(
    is.null(cutoff)
  ) {

    cutoff <-
      length(
        eigenvalues
      )
  }


  cutoff <-
    min(
      cutoff,
      length(
        eigenvalues
      )
    )


  if(
    length(d) == 2
  ) {


    Xfiltered <-
      Xtilde


    if(
      cutoff < d[1]
    ) {

      Xfiltered[
        (cutoff + 1):d[1],
        ,
        drop = FALSE
      ] <- 0
    }


    return(
      Xfiltered
    )
  }


  if(
    length(d) == 3
  ) {


    Xfiltered <-
      Xtilde


    if(
      cutoff < d[1]
    ) {

      Xfiltered[
        (cutoff + 1):d[1],
        ,
        ,
        drop = FALSE
      ] <- 0
    }


    return(
      Xfiltered
    )
  }


  stop(
    "Unsupported dimension."
  )
}


###############################################################
# Graph-frequency energy
###############################################################

graph_frequency_energy <- function(
    Xtilde
) {


  d <- dim(
    Xtilde
  )


  if(
    length(d) == 2
  ) {

    energy <-
      rowSums(
        Xtilde^2
      )


  } else if(
    length(d) == 3
  ) {


    energy <-
      numeric(
        d[1]
      )


    for(k in 1:d[1]) {

      energy[k] <-
        sum(
          Xtilde[k,,]^2
        )
    }


  } else {

    stop(
      "Unsupported dimension."
    )
  }


  total <-
    sum(energy)


  relative_energy <-

    if(
      total > 0
    ) {

      energy / total

    } else {

      energy
    }


  data.frame(

    Frequency =
      seq_along(
        energy
      ),

    Eigenvalue = NA_real_,

    Energy =
      energy,

    RelativeEnergy =
      relative_energy
  )
}


###############################################################
# Complete graph-frequency preprocessing
###############################################################

prepare_graph_frequency_data <- function(

    X,

    latitudes,

    longitudes,

    W_corr = NULL,

    alpha_geo = 1,

    alpha_corr = 0,

    normalized_laplacian = TRUE

) {


  W_geo <-

    make_geographic_weight_matrix(

      latitudes =
        latitudes,

      longitudes =
        longitudes
    )


  W <-

    make_hybrid_weight_matrix(

      W_geo =
        W_geo,

      W_corr =
        W_corr,

      alpha_geo =
        alpha_geo,

      alpha_corr =
        alpha_corr
    )


  L <-

    make_graph_laplacian(

      W = W,

      normalized =
        normalized_laplacian
    )


  gf <-

    graph_fourier_basis(
      L
    )


  Xtilde <-

    graph_fourier_transform(

      X = X,

      U = gf$U
    )


  energy <-

    graph_frequency_energy(
      Xtilde
    )


  energy$Eigenvalue <-
    gf$eigenvalues


  list(

    W_geo =
      W_geo,

    W =
      W,

    L =
      L,

    U =
      gf$U,

    eigenvalues =
      gf$eigenvalues,

    X_original =
      X,

    X_graph_frequency =
      Xtilde,

    frequency_energy =
      energy
  )
}


