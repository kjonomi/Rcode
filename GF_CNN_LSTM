download_terraclimate_file <- function(
    variable,
    year,
    data_dir
) {

  file_name <- paste0(
    "TerraClimate_",
    variable,
    "_",
    year,
    ".nc"
  )

  local_file <- file.path(
    data_dir,
    file_name
  )

  remote_file <- paste0(
    base_url,
    "/",
    file_name
  )


  if(file.exists(local_file)) {

    cat(
      "Already exists:",
      file_name,
      "\n"
    )

    return(local_file)
  }


  cat(
    "Downloading:",
    file_name,
    "\n"
  )


  tryCatch({

    download.file(
      url = remote_file,
      destfile = local_file,
      mode = "wb",
      method = "libcurl",
      quiet = FALSE
    )

  }, error = function(e) {

    if(file.exists(local_file)) {
      file.remove(local_file)
    }

    stop(
      paste0(
        "\nTerraClimate download failed:\n",
        remote_file,
        "\n\nError: ",
        conditionMessage(e)
      )
    )
  })


  if(!file.exists(local_file)) {

    stop(
      paste(
        "File was not downloaded:",
        file_name
      )
    )
  }


  file_size <- file.info(
    local_file
  )$size


  if(is.na(file_size) || file_size < 100000) {

    file.remove(local_file)

    stop(
      paste(
        "Downloaded TerraClimate file appears invalid:",
        file_name
      )
    )
  }


  cat(
    "Successfully downloaded:",
    file_name,
    "\n"
  )


  local_file
}


