predict_and_reshape <- function(
    model,
    Xseq,
    nlat,
    nlon,
    nout,
    batch_size = 8
) {

  pred_raw <- model %>%

    predict(
      Xseq,
      batch_size = batch_size
    )


  pred_raw <- as.array(
    pred_raw
  )


  nSamples <- dim(Xseq)[1]

  total_pixels <- nlat * nlon


  if(length(dim(pred_raw)) == 2) {

    pred_raw <- array(
      pred_raw,
      dim = c(
        nSamples,
        total_pixels,
        nout,
        2
      )
    )


  } else if(
    length(dim(pred_raw)) == 3
  ) {

    if(
      dim(pred_raw)[2] ==
      total_pixels &&
      dim(pred_raw)[3] ==
      nout * 2
    ) {

      pred_raw <- array(
        pred_raw,
        dim = c(
          nSamples,
          total_pixels,
          nout,
          2
        )
      )

    } else {

      stop(
        "Unexpected prediction dimensions."
      )
    }
  }


  pred_mean <-
    pred_raw[,,,1]


  pred_logsd <-
    pred_raw[,,,2]


  mean_arr <- array(
    pred_mean,
    dim = c(
      nSamples,
      nlat,
      nlon,
      nout
    )
  )


  logsd_arr <- array(
    pred_logsd,
    dim = c(
      nSamples,
      nlat,
      nlon,
      nout
    )
  )


  list(
    mean = mean_arr,
    logsd = logsd_arr
  )
}


