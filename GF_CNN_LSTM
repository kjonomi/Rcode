fill_missing_temporal <- function(
    X
) {

  Xout <- X

  for (i in seq_len(nrow(X))) {

    y <- X[i, ]

    good <- which(
      is.finite(y)
    )

    if (length(good) >= 2) {

      Xout[i, ] <- approx(

        x = good,

        y = y[good],

        xout = seq_along(y),

        method = "linear",

        rule = 2

      )$y

    }

  }

  Xout

}


