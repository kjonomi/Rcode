###############################################################
# 1) Grid and spatial simulation
###############################################################
deg2rad <- function(deg) deg * pi / 180
sphere_grid <- function(nlon = 84, nlat = 42) {
  lon <- seq(-180, 180 - 360/nlon, length.out = nlon)
  lat <- seq(-90 + 180/(nlat*2), 90 - 180/(nlat*2), length.out = nlat)
  grid <- expand.grid(lon=lon, lat=lat)
  x <- cos(deg2rad(grid$lat)) * cos(deg2rad(grid$lon))
  y <- cos(deg2rad(grid$lat)) * sin(deg2rad(grid$lon))
  z <- sin(deg2rad(grid$lat))
  coords3 <- cbind(x,y,z)
  list(grid=grid, coords3=coords3, nlon=nlon, nlat=nlat)
}

angular_dist <- function(u,v) {
  if(is.vector(u)) u <- matrix(u, nrow=1)
  res <- u %*% t(v)
  pmax(0, pmin(pi, acos(pmin(1, pmax(-1, res)))))
}

pairwise_ang_dist_mat <- function(coords3) {
  N <- nrow(coords3); M <- matrix(0,N,N)
  for(i in 1:N) M[i,] <- angular_dist(coords3[i,], coords3)
  M
}

make_sigma_spatial <- function(coords3, alpha0=1, alpha1=0.5, alpha2=0.2) {
  x <- coords3[,1]; y <- coords3[,2]; z <- coords3[,3]
  sigma <- alpha0 + alpha1*z + alpha2*(x^2 - y^2)
  pmax(0.05, sigma)
}

iscf_cov_matrix <- function(coords3, phi=0.4, alpha0=1, alpha1=0.5, alpha2=0.2, nugget=1e-6) {
  sigma <- make_sigma_spatial(coords3, alpha0, alpha1, alpha2)
  ang <- pairwise_ang_dist_mat(coords3)
  K <- outer(sigma,sigma,"*") * exp(-(ang/phi)^2)
  diag(K) <- diag(K) + nugget
  K
}

simulate_spatio_temporal <- function(coords3, T=30, seed=1) {
  set.seed(seed); N <- nrow(coords3)
  CovW <- iscf_cov_matrix(coords3)
  L <- chol(CovW)
  W <- matrix(rnorm(N*T), nrow=N, ncol=T)
  W <- L %*% W
  X <- matrix(0, N, T); X[,1] <- W[,1]
  if(T>1) for(t in 2:T) X[,t] <- X[,t-1] + W[,t]
  X
}

###############################################################
# 3) Temporal detrending + normalization (safe)
###############################################################
detrend_temporal_poly_safe <- function(Y_array, degree=2) {
  N <- dim(Y_array)[1]; Tt <- dim(Y_array)[2]; nout <- dim(Y_array)[3]
  Y_resid <- array(0, dim=c(N,Tt,nout))
  for(i in 1:N){
    for(k in 1:nout){
      y <- Y_array[i,,k]
      if(any(is.na(y)) || sd(y, na.rm=TRUE) < 1e-8){
        Y_resid[i,,k] <- 0; next
      }
      B <- poly(1:Tt, degree=degree, raw=TRUE)
      Y_resid[i,,k] <- residuals(lm(y ~ B -1))
    }
  }
  Y_resid
}

normalize_array_per_output <- function(Y_array) {
  nout <- dim(Y_array)[3]
  for(k in 1:nout){
    sd_k <- sd(Y_array[,,k])
    if(sd_k < 1e-8) Y_array[,,k] <- Y_array[,,k] + rnorm(length(Y_array[,,k]),0,1e-3)
    Y_array[,,k] <- (Y_array[,,k]-mean(Y_array[,,k]))/sd(Y_array[,,k])
  }
  Y_array
}
###############################################################
# 4) Copula outcome simulation
###############################################################
simulate_copula_outcomes <- function(X, R_dep=matrix(c(1,0.5,0.3,0.5,1,0.4,0.3,0.4,1),3,3), seed=123){
  set.seed(seed); N <- nrow(X); Tt <- ncol(X); nout <- nrow(R_dep)
  Y_array <- array(0, dim=c(N,Tt,nout))
  L_R <- chol(R_dep)
  for(t in 1:Tt){
    Z <- matrix(rnorm(N*nout), nrow=N, ncol=nout)
    Z_dep <- Z %*% L_R
    for(k in 1:nout) Y_array[,t,k] <- X[,t] + Z_dep[,k]
  }
  Y_array
}
