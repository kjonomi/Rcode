# 27. PAIRED STATISTICAL TESTS
#
# All inferential comparisons are conducted at the Monte Carlo replication
# level. Each prioritized method is compared with Uniform MLP using the same
# replication-specific simulated data and data partition.
# ==============================================================================

paired_test <- function(
    df,
    method_name,
    metric = "policy_value"
) {

  # ---------------------------------------------------------------------------
  # Extract the method being compared
  # ---------------------------------------------------------------------------

  method_df <-
    df %>%
    dplyr::filter(
      model == "MLP",
      replay == method_name
    )

  # ---------------------------------------------------------------------------
  # Construct paired comparison
  # ---------------------------------------------------------------------------

  if (metric == "policy_value") {

    comparison <-
      method_df %>%
      dplyr::select(
        replication,
        value = policy_value
      ) %>%
      dplyr::inner_join(
        uniform_mlp %>%
          dplyr::select(
            replication,
            uniform_value = uniform_policy_value
          ),
        by = "replication"
      )

  } else if (metric == "regret") {

    comparison <-
      method_df %>%
      dplyr::select(
        replication,
        value = regret
      ) %>%
      dplyr::inner_join(
        uniform_mlp %>%
          dplyr::select(
            replication,
            uniform_value = uniform_regret
          ),
        by = "replication"
      )

  } else {

    stop(
      "Unknown metric: ",
      metric,
      ". Use 'policy_value' or 'regret'."
    )
  }

  # ---------------------------------------------------------------------------
  # Paired differences
  #
  # Positive difference is favorable for policy value.
  # Negative difference is favorable for regret.
  # ---------------------------------------------------------------------------

  difference <-
    comparison$value -
    comparison$uniform_value

  difference <-
    difference[
      is.finite(difference)
    ]

  # ---------------------------------------------------------------------------
  # Insufficient observations
  # ---------------------------------------------------------------------------

  if (length(difference) < 2) {

    return(
      tibble::tibble(
        method = method_name,
        metric = metric,
        n = length(difference),
        mean_difference = NA_real_,
        sd_difference = NA_real_,
        paired_t_p = NA_real_,
        wilcoxon_p = NA_real_
      )
    )
  }

  # ---------------------------------------------------------------------------
  # Paired t-test
  #
  # Since the paired comparison has already been reduced to differences,
  # a one-sample t-test of the differences is equivalent to a paired t-test.
  # ---------------------------------------------------------------------------

  t_result <-
    stats::t.test(
      difference,
      mu = 0
    )

  # ---------------------------------------------------------------------------
  # Wilcoxon signed-rank test
  # ---------------------------------------------------------------------------

  w_result <-
    suppressWarnings(
      stats::wilcox.test(
        difference,
        mu = 0,
        exact = FALSE
      )
    )

  # ---------------------------------------------------------------------------
  # Return results
  # ---------------------------------------------------------------------------

  tibble::tibble(
    method = method_name,
    metric = metric,
    n = length(difference),

    mean_difference =
      mean(
        difference,
        na.rm = TRUE
      ),

    sd_difference =
      stats::sd(
        difference,
        na.rm = TRUE
      ),

    paired_t_p =
      t_result$p.value,

    wilcoxon_p =
      w_result$p.value
  )
}


