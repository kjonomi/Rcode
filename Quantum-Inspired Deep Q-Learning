    Y2 =
      data$Y2[idx],

    A =
      data$A[idx],

    Y =
      data$Y[idx]
  )
}


# ==============================================================================
# 18. FIT AND EVALUATE
# ==============================================================================

fit_and_evaluate <- function(
    train_data,
    eval_data,
    model_type,
    replay_method,
    alpha,
    seed) {

  fitted <-
    train_contextual_bandit(
      X = train_data$X,
      Y0 = train_data$Y0,
      Y1 = train_data$Y1,
      Y2 = train_data$Y2,
      model_type = model_type,
      replay_method = replay_method,
      alpha = alpha,
      seed = seed
    )


  evaluation <-
    evaluate_policy(
      model = fitted$model,
      X = eval_data$X,
      Y0 = eval_data$Y0,
      Y1 = eval_data$Y1,
      Y2 = eval_data$Y2
    )


  list(
    fitted = fitted,
    evaluation = evaluation
  )
}


# ==============================================================================
# 19. VALIDATION-BASED ALPHA SELECTION
# ==============================================================================

select_alpha_validation <- function(
    train_data,
    valid_data,
    model_type = "MLP",
    replay_method = "Quantum-Uncertainty",
    alpha_grid = ALPHA_GRID,
    seed = 1) {

  validation_results <-
    vector(
      "list",
      length(alpha_grid)
    )


  for (
    j in seq_along(alpha_grid)
  ) {

    alpha_j <-
      alpha_grid[j]

    cat(
      sprintf(
        "    Validation alpha %.2f\n",
        alpha_j
      )
    )


    # Same seed for all alpha values.
    # This reduces unnecessary stochastic differences in the comparison.
    fit_j <-
      fit_and_evaluate(
        train_data = train_data,
        eval_data = valid_data,
        model_type = model_type,
        replay_method = replay_method,
        alpha = alpha_j,
        seed = seed
      )


    validation_results[[j]] <-
      tibble(
        alpha = alpha_j,

        validation_value =
          fit_j$evaluation$policy_value,

        validation_regret =
          fit_j$evaluation$regret
      )
  }


  validation_table <-
    bind_rows(
      validation_results
    )


  best_row <-
    validation_table %>%
    arrange(
      desc(validation_value),
      validation_regret
    ) %>%
    slice(1)


  list(
    selected_alpha =
      best_row$alpha,

    validation_table =
      validation_table
  )
}


