      regret =
        fit_per$evaluation$regret,

      action_rate_0 =
        fit_per$evaluation$action_rate_0,

      action_rate_1 =
        fit_per$evaluation$action_rate_1,

      action_rate_2 =
        fit_per$evaluation$action_rate_2
    )


  # ===========================================================================
  # 20.7 Quantum-Uncertainty CNN-LSTM
  # ===========================================================================

  cat(
    "\n  [7] Quantum-Uncertainty CNN-LSTM\n"
  )

  fit_quantum_cnn <-
    fit_and_evaluate(
