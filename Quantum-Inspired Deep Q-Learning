safe_minmax <- function(x) {

  x <- as.numeric(x)

  if (length(x) == 0) {
    return(numeric(0))
  }

  finite_x <- x[is.finite(x)]

  if (length(finite_x) == 0) {
    return(rep(0, length(x)))
  }

  replacement <- median(
    finite_x
  )

  x[!is.finite(x)] <- replacement

  xmin <- min(x)

  xmax <- max(x)

  if (
    !is.finite(xmin) ||
    !is.finite(xmax) ||
    abs(xmax - xmin) < 1e-12
  ) {

    return(
      rep(
        0,
        length(x)
      )
    )
  }

  (x - xmin) / (xmax - xmin)
}


normalize_probabilities <- function(
    scores,
    prob_floor = PROB_FLOOR) {

  scores <- as.numeric(scores)

  scores[
    !is.finite(scores)
  ] <- 0

  scores <- pmax(
    scores,
    0
  )

  if (
    length(scores) == 0
  ) {

    return(
      numeric(0)
    )
  }

  if (
    sum(scores) <= 0
  ) {

    scores <- rep(
      1,
      length(scores)
    )
  }

  probabilities <- scores /
    sum(scores)

  probabilities <- pmax(
    probabilities,
    prob_floor
  )

  probabilities <- probabilities /
    sum(probabilities)

  probabilities
}


sample_actions_epsilon_greedy <- function(
    q_values,
    epsilon,
    n_actions = N_ACTIONS) {

  n <- nrow(
    q_values
  )

  actions <- integer(
    n
  )

  for (i in seq_len(n)) {

    if (
      runif(1) < epsilon
    ) {

      actions[i] <- sample(
        0:(n_actions - 1),
        size = 1
      )

    } else {

      actions[i] <-
        which.max(
          q_values[i, ]
        ) - 1
    }
  }

  actions
}


get_action_rewards <- function(
    Y0,
    Y1,
    Y2,
    actions) {

  rewards <- numeric(
    length(actions)
  )

  rewards[
    actions == 0
  ] <- Y0[
    actions == 0
  ]

  rewards[
    actions == 1
  ] <- Y1[
    actions == 1
  ]

  rewards[
    actions == 2
  ] <- Y2[
    actions == 2
  ]

  rewards
}


# ==============================================================================
# 5. GENERATE SEMISYNTHETIC BOSTON DATA
# ==============================================================================

generate_boston_data <- function(
    n = N,
    T_steps = T_STEPS,
    seed = NULL) {

  if (!is.null(seed)) {
    set.seed(seed)
  }


  # ---------------------------------------------------------------------------
  # Boston Housing data
  # ---------------------------------------------------------------------------

  boston <- MASS::Boston

  p <- ncol(
    boston
  )

  idx <- sample(
    seq_len(
      nrow(boston)
    ),
    size = n,
    replace = TRUE
  )

  X_base <- as.matrix(
    boston[idx, ]
  )


  # ---------------------------------------------------------------------------
  # Repeated noisy measurements
  #
  # These are artificial repeated measurements rather than genuine
  # longitudinal observations.
  # ---------------------------------------------------------------------------

  X <- array(
    NA_real_,
    dim = c(
      n,
      T_steps,
      p
    )
  )


  for (t in seq_len(T_steps)) {

    noise <- matrix(
      rnorm(
        n * p,
        mean = 0,
        sd = 0.01
      ),
      nrow = n,
      ncol = p
    )

    X[, t, ] <-
      X_base + noise
  }


  # ---------------------------------------------------------------------------
  # Standardize each variable at each time point
  # ---------------------------------------------------------------------------

  for (t in seq_len(T_steps)) {

    for (j in seq_len(p)) {

      x <- X[, t, j]

      s <- sd(x)

      if (
        !is.finite(s) ||
        s < 1e-12
      ) {

        X[, t, j] <- 0

      } else {

        X[, t, j] <-
          (
            x - mean(x)
          ) / s
      }
    }
  }


  # ---------------------------------------------------------------------------
  # Average repeated measurements
  # ---------------------------------------------------------------------------

  X_avg <- apply(
    X,
    c(1, 3),
    mean
  )

  X_avg <- matrix(
    X_avg,
    nrow = n,
    ncol = p
  )

  colnames(X_avg) <-
    colnames(
      MASS::Boston
    )


  # ---------------------------------------------------------------------------
  # Key covariates
  # ---------------------------------------------------------------------------

  rm_avg <-
    X_avg[, "rm"]

  ptratio_avg <-
    X_avg[, "ptratio"]


  # ---------------------------------------------------------------------------
  # Baseline outcome
  # ---------------------------------------------------------------------------

  base_outcome <-
    3 *
    sin(
      rowMeans(
        X_avg[, 1:3, drop = FALSE]
      )
    ) +
    rnorm(
      n,
      mean = 0,
      sd = 0.5
    )


  # ---------------------------------------------------------------------------
  # Heterogeneous treatment effects
  # ---------------------------------------------------------------------------

  tau0 <- rep(
    0,
    n
  )

  tau1 <-
    1.5 +
    2.0 * ptratio_avg -
    rm_avg

  tau2 <-
    -2.0 +
    3.5 * rm_avg -
    0.5 * ptratio_avg


  # ---------------------------------------------------------------------------
  # Potential outcomes
  # ---------------------------------------------------------------------------

  Y0 <-
    base_outcome +
    tau0

  Y1 <-
    base_outcome +
    tau1

  Y2 <-
    base_outcome +
    tau2


  # ---------------------------------------------------------------------------
  # Treatment assignment mechanism
  # ---------------------------------------------------------------------------

  logits <- cbind(
    0.5 * X_avg[, "rm"],
    -0.25 * X_avg[, "lstat"],
    0.25 * X_avg[, "ptratio"]
  )

  logits <-
    logits -
    apply(
      logits,
      1,
      max
    )

  assignment_prob <-
    exp(logits)

  assignment_prob <-
    assignment_prob /
    rowSums(
      assignment_prob
    )


  # ---------------------------------------------------------------------------
  # Observed treatment
  # ---------------------------------------------------------------------------

  A <- integer(
    n
  )

  for (i in seq_len(n)) {

    A[i] <- sample(
      0:2,
      size = 1,
      prob = assignment_prob[i, ]
    )
  }


  # ---------------------------------------------------------------------------
  # Observed outcome
  # ---------------------------------------------------------------------------

  Y <- get_action_rewards(
    Y0 = Y0,
    Y1 = Y1,
    Y2 = Y2,
    actions = A
  )


  # ---------------------------------------------------------------------------
  # Return
  # ---------------------------------------------------------------------------

  list(
    X = X,
    X_avg = X_avg,
    A = A,
    Y = Y,
    Y0 = Y0,
    Y1 = Y1,
    Y2 = Y2,
    tau0 = tau0,
    tau1 = tau1,
    tau2 = tau2,
    assignment_prob = assignment_prob,
    feature_names = colnames(X_avg)
  )
}


# ==============================================================================
# 6. TRAIN / VALIDATION / TEST SPLIT
# ==============================================================================

make_data_split <- function(
    n,
    train_prop = TRAIN_PROP,
    valid_prop = VALID_PROP,
    seed = NULL) {

  if (!is.null(seed)) {
    set.seed(seed)
  }

  if (
    train_prop <= 0 ||
    valid_prop <= 0 ||
    train_prop + valid_prop >= 1
  ) {

    stop(
      "Invalid train/validation proportions."
    )
  }

  idx <- sample(
    seq_len(n)
  )

  n_train <- floor(
    train_prop * n
  )

  n_valid <- floor(
    valid_prop * n
  )

  train_idx <-
    idx[
      seq_len(n_train)
    ]

  valid_idx <-
    idx[
      (n_train + 1):
      (n_train + n_valid)
    ]

  test_idx <-
    idx[
      (n_train + n_valid + 1):
      n
    ]

  list(
    train = train_idx,
    valid = valid_idx,
    test = test_idx
  )
}


# ==============================================================================
# 7. REPLAY BUFFER
# ==============================================================================

ReplayBuffer <- R6::R6Class(

  "ReplayBuffer",

  public = list(

    capacity = NULL,

    states = NULL,

    actions = NULL,

    rewards = NULL,

    size = NULL,


    initialize = function(
        capacity) {

      self$capacity <-
        capacity

      self$states <-
        vector(
          "list",
          capacity
        )

      self$actions <-
        numeric(
          capacity
        )

      self$rewards <-
        numeric(
          capacity
        )

      self$size <- 0
    },


    add = function(
        state,
        action,
        reward) {

      if (
        self$size <
        self$capacity
      ) {

        self$size <-
          self$size + 1

        position <-
          self$size

      } else {

        # FIFO replacement is easier to interpret than random replacement.
        # Shift the oldest experience out.
        self$states <-
          c(
            self$states[-1],
            list(state)
          )

        self$actions <-
          c(
            self$actions[-1],
            action
          )

        self$rewards <-
          c(
            self$rewards[-1],
            reward
          )

        return(
          invisible(NULL)
        )
      }

      self$states[[position]] <-
        state

      self$actions[position] <-
        action

      self$rewards[position] <-
        reward
    },


    get_all = function() {

      if (
        self$size == 0
      ) {

        return(NULL)
      }

      list(
        states =
          self$states[
            seq_len(self$size)
          ],

        actions =
          self$actions[
            seq_len(self$size)
          ],

        rewards =
          self$rewards[
            seq_len(self$size)
          ]
      )
    }
  )
)


# ==============================================================================
# 8. MLP
#
# IMPORTANT:
# Functional API is used to avoid the Keras shape/batch_shape error.
# ==============================================================================

build_mlp <- function(
    input_shape,
    n_actions = N_ACTIONS) {

  inputs <-
    keras3::layer_input(
      shape = input_shape,
      name = "state_input"
    )

  outputs <-
    inputs %>%
    keras3::layer_flatten() %>%
    keras3::layer_dense(
      units = 128,
      activation = "relu"
    ) %>%
    keras3::layer_dropout(
      rate = 0.20
    ) %>%
    keras3::layer_dense(
      units = 64,
      activation = "relu"
    ) %>%
    keras3::layer_dense(
      units = n_actions,
      activation = "linear"
    )

  model <-
    keras3::keras_model(
      inputs = inputs,
      outputs = outputs
    )

  model %>%
    keras3::compile(
      optimizer =
        keras3::optimizer_adam(
          learning_rate =
            LEARNING_RATE
        ),
      loss = "mse"
    )

  model
}


# ==============================================================================
# 9. CNN-LSTM
# ==============================================================================

build_cnn_lstm <- function(
    input_shape,
    n_actions = N_ACTIONS) {

  inputs <-
    keras3::layer_input(
      shape = input_shape,
      name = "sequence_input"
    )

  outputs <-
    inputs %>%
    keras3::layer_conv_1d(
      filters = 32,
      kernel_size = 3,
      activation = "relu",
      padding = "same"
    ) %>%
    keras3::layer_lstm(
      units = 32
    ) %>%
    keras3::layer_dense(
      units = 32,
      activation = "relu"
    ) %>%
    keras3::layer_dense(
      units = n_actions,
      activation = "linear"
    )

  model <-
    keras3::keras_model(
      inputs = inputs,
      outputs = outputs
    )

  model %>%
    keras3::compile(
      optimizer =
        keras3::optimizer_adam(
          learning_rate =
            LEARNING_RATE
        ),
      loss = "mse"
    )

  model
}


# ==============================================================================
# 10. CRITICAL DIMENSION FUNCTION
#
# Individual replay states have dimension:
#
#       T_STEPS x P
#
# A batch has dimension:
#
#       N_BATCH x T_STEPS x P
#
# The previous code incorrectly assumed that an individual state retained
# three dimensions. R drops the first dimension when X[i, , ] is used.
# ==============================================================================

states_to_array <- function(
    states) {

  if (
    length(states) == 0
  ) {

    return(NULL)
  }


  # ---------------------------------------------------------------------------
  # Individual state
  # ---------------------------------------------------------------------------

  first_state <-
    states[[1]]

  if (
    is.null(
      dim(first_state)
    )
  ) {

    stop(
      "Replay-buffer states must be matrices."
    )
  }


  state_dim <-
    dim(first_state)


  if (
    length(state_dim) != 2
  ) {

    stop(
      paste(
        "Each state must have exactly two dimensions.",
        "Found:",
        paste(
          state_dim,
          collapse = " x "
        )
      )
    )
  }


  T_steps <-
    state_dim[1]

  p <-
    state_dim[2]

  n <-
    length(states)


  # ---------------------------------------------------------------------------
  # Create batch array
  # ---------------------------------------------------------------------------

  X_array <-
    array(
      NA_real_,
      dim = c(
        n,
        T_steps,
        p
      )
    )


  # ---------------------------------------------------------------------------
  # Insert individual states
  # ---------------------------------------------------------------------------

  for (
    i in seq_len(n)
  ) {

    current_state <-
      states[[i]]

    current_dim <-
      dim(current_state)

    if (
      length(current_dim) != 2 ||
      current_dim[1] != T_steps ||
      current_dim[2] != p
    ) {

      stop(
        paste(
          "Inconsistent replay-buffer state dimensions.",
          "Expected:",
          T_steps,
          "x",
          p,
          "Found:",
          paste(
            current_dim,
            collapse = " x "
          )
        )
      )
    }

    X_array[i, , ] <-
      current_state
  }


  X_array
}


# ==============================================================================
# 11. PREDICT Q-VALUES
# ==============================================================================

predict_q_values <- function(
    model,
    X) {

  q <- predict(
    model,
    X,
    verbose = 0
  )

  q <- as.matrix(
    q
  )

  if (
    ncol(q) != N_ACTIONS
  ) {

    stop(
      paste(
        "Unexpected number of Q-values.",
        "Expected:",
        N_ACTIONS,
        "Found:",
        ncol(q)
      )
    )
  }

  q
}


# ==============================================================================
# 12. UNCERTAINTY CALCULATION
#
# U_i = w_H H_i + w_Q QVar_i
#
# Alpha is NOT used here.
#
# Priority is applied later:
#
#       score_i(alpha) = 1 + alpha U_i
#
# ==============================================================================

calculate_uncertainty <- function(
    model,
    states) {

  if (
    length(states) == 0
  ) {

    return(
      list(
        entropy = numeric(0),
        q_variance = numeric(0),
        entropy_norm = numeric(0),
        qvar_norm = numeric(0),
        uncertainty = numeric(0)
      )
    )
  }


  # ---------------------------------------------------------------------------
  # Convert list of matrices to N x T x P array
  # ---------------------------------------------------------------------------

  X_batch <-
    states_to_array(
      states
    )


  # ---------------------------------------------------------------------------
  # Q-values
  # ---------------------------------------------------------------------------

  q_values <-
    predict_q_values(
      model,
      X_batch
    )


  # ---------------------------------------------------------------------------
  # Stable softmax
  # ---------------------------------------------------------------------------

  q_shift <-
    q_values -
    apply(
      q_values,
      1,
      max
    )

  exp_q <-
    exp(q_shift)

  action_prob <-
    exp_q /
    rowSums(
      exp_q
    )


  # ---------------------------------------------------------------------------
  # Entropy
  # ---------------------------------------------------------------------------

  entropy <-
    -rowSums(
      action_prob *
      log(
        pmax(
          action_prob,
          1e-12
        )
      )
    )


  # ---------------------------------------------------------------------------
  # Q-value variance
  # ---------------------------------------------------------------------------

  q_variance <-
    apply(
      q_values,
      1,
      var
    )

  q_variance[
    !is.finite(q_variance)
  ] <- 0


  # ---------------------------------------------------------------------------
  # Separate normalization
  # ---------------------------------------------------------------------------

  entropy_norm <-
    safe_minmax(
      entropy
    )

  qvar_norm <-
    safe_minmax(
      q_variance
    )


  # ---------------------------------------------------------------------------
  # Fixed uncertainty score
  # ---------------------------------------------------------------------------

  uncertainty <-
    UNCERTAINTY_ENTROPY_WEIGHT *
    entropy_norm +
    UNCERTAINTY_QVAR_WEIGHT *
    qvar_norm


  list(
    entropy = entropy,
    q_variance = q_variance,
    entropy_norm = entropy_norm,
    qvar_norm = qvar_norm,
    uncertainty = uncertainty
  )
}


# ==============================================================================
# 13. REPLAY PRIORITY SCORES
# ==============================================================================

get_replay_scores <- function(
    method,
    model,
    states,
    actions,
    rewards,
    alpha = 0.5) {

  n <-
    length(rewards)


  # ---------------------------------------------------------------------------
  # Uniform replay
  # ---------------------------------------------------------------------------

  if (
    method == "Uniform"
  ) {

    return(
      rep(
        1,
        n
      )
    )
  }


  # ---------------------------------------------------------------------------
  # alpha = 0 must be exactly uniform
  # ---------------------------------------------------------------------------

  if (
    isTRUE(
      all.equal(
        alpha,
        0
      )
    )
  ) {

    return(
      rep(
        1,
        n
      )
    )
  }


  # ---------------------------------------------------------------------------
  # Convert replay states to batch
  # ---------------------------------------------------------------------------

  X_batch <-
    states_to_array(
      states
    )


  q_values <-
    predict_q_values(
      model,
      X_batch
    )


  # ===========================================================================
  # Entropy replay
  # ===========================================================================

  if (
    method == "Entropy"
  ) {

    q_shift <-
      q_values -
      apply(
        q_values,
        1,
        max
      )

    exp_q <-
      exp(q_shift)

    probs <-
      exp_q /
      rowSums(
        exp_q
      )

    entropy <-
      -rowSums(
        probs *
        log(
          pmax(
            probs,
            1e-12
          )
        )
      )

    entropy_norm <-
      safe_minmax(
        entropy
      )

    scores <-
      1 +
      alpha *
      entropy_norm

    return(
      scores
    )
  }


  # ===========================================================================
  # Residual-PER
  #
  # One-step setting:
  #
  #       residual_i =
  #       | reward_i - Q(s_i, a_i) |
  #
  # This is NOT called a TD error because there is no next state.
  # ===========================================================================

  if (
    method == "Residual-PER"
  ) {

    action_index <-
      actions + 1

    predicted_reward <-
      q_values[
        cbind(
          seq_len(n),
          action_index
        )
      ]

    residual <-
      abs(
        rewards -
        predicted_reward
      )

    residual_norm <-
      safe_minmax(
        residual
      )

    scores <-
      1 +
      alpha *
      residual_norm

    return(
      scores
    )
  }


  # ===========================================================================
  # Quantum-inspired uncertainty replay
  # ===========================================================================

  if (
    method == "Quantum-Uncertainty"
  ) {

    uncertainty <-
      calculate_uncertainty(
        model = model,
        states = states
      )


    scores <-
      1 +
      alpha *
      uncertainty$uncertainty

    return(
      scores
    )
  }


  stop(
    paste(
      "Unknown replay method:",
      method
    )
  )
}


# ==============================================================================
# 14. SAMPLE REPLAY BATCH
# ==============================================================================

sample_replay_batch <- function(
    buffer,
    model,
    method,
    batch_size = BATCH_SIZE,
    alpha = 0.5,
    beta = BETA) {

  filled <-
    buffer$get_all()


  if (
    is.null(filled)
  ) {

    return(NULL)
  }


  n_buffer <-
    length(
      filled$rewards
    )


  if (
    n_buffer == 0
  ) {

    return(NULL)
  }


  # ---------------------------------------------------------------------------
  # Priority scores
  # ---------------------------------------------------------------------------

  scores <-
    get_replay_scores(
      method = method,
      model = model,
      states = filled$states,
      actions = filled$actions,
      rewards = filled$rewards,
      alpha = alpha
    )


  # ---------------------------------------------------------------------------
  # Sampling probabilities
  # ---------------------------------------------------------------------------

  probabilities <-
    normalize_probabilities(
      scores
    )


  # ---------------------------------------------------------------------------
  # Sample experiences
  # ---------------------------------------------------------------------------

  selected <-
    sample(
      seq_len(n_buffer),
      size = min(
        batch_size,
        n_buffer
      ),
      replace = TRUE,
      prob = probabilities
    )


  # ---------------------------------------------------------------------------
  # Importance-sampling correction
  #
  # w_i = (N_B p_i)^(-beta)
  # ---------------------------------------------------------------------------

  selected_probabilities <-
    probabilities[
      selected
    ]

  is_weights <-
    (
      n_buffer *
      selected_probabilities
    )^(-beta)

  is_weights <-
    is_weights /
    max(
      is_weights
    )

  is_weights[
    !is.finite(is_weights)
  ] <- 1


  # ---------------------------------------------------------------------------
  # Convert replay states
  # ---------------------------------------------------------------------------

  batch_states <-
