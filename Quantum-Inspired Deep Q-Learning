# ==============================================================================
# 28. BOOTSTRAP CONFIDENCE INTERVAL
#
# Bootstrap inference is performed on replication-level paired differences.
# This preserves the Monte Carlo replication as the inferential unit.
# ==============================================================================

bootstrap_paired_difference <- function(
    differences,
    R = 2000,
    seed = 1
) {

  set.seed(seed)

  # ---------------------------------------------------------------------------
  # Retain only finite differences
  # ---------------------------------------------------------------------------

  differences <-
    differences[
      is.finite(differences)
    ]

  # ---------------------------------------------------------------------------
  # Insufficient observations
  # ---------------------------------------------------------------------------

  if (length(differences) < 2) {

    return(
      c(
        estimate = NA_real_,
        lower = NA_real_,
        upper = NA_real_
      )
    )
  }

  # ---------------------------------------------------------------------------
  # Bootstrap statistic: mean paired difference
  # ---------------------------------------------------------------------------

  boot_stat <- function(
      data,
      indices
  ) {

    mean(
      data[indices],
      na.rm = TRUE
    )
  }

  # ---------------------------------------------------------------------------
  # Bootstrap resampling
  # ---------------------------------------------------------------------------

  boot_object <-
    boot::boot(
      data = differences,
      statistic = boot_stat,
      R = R
    )

  # ---------------------------------------------------------------------------
  # Percentile confidence interval
  # ---------------------------------------------------------------------------

  ci <-
    tryCatch(

      {

        ci_object <-
          boot::boot.ci(
            boot_object,
            type = "perc"
          )

        if (
          is.null(ci_object$percent) ||
          length(ci_object$percent) < 5
        ) {

          c(
            NA_real_,
            NA_real_
          )

        } else {

          ci_object$percent[4:5]
        }
      },

      error = function(e) {

        c(
          NA_real_,
          NA_real_
        )
      }
    )

  # ---------------------------------------------------------------------------
  # Return estimate and confidence limits
  # ---------------------------------------------------------------------------

  c(
    estimate =
      mean(
        differences,
        na.rm = TRUE
      ),

    lower =
      ci[1],

    upper =
      ci[2]
  )
}


