  # ===========================================================================

  selected_alpha <-
    0.5

  validation_table <-
    NULL


  if (
    tune_alpha
  ) {

    cat(
      "\n  [3] Tuning alpha on validation data\n"
    )


    alpha_selection <-
      select_alpha_validation(
        train_data = train_data,
        valid_data = valid_data,
        model_type = "MLP",
        replay_method = "Quantum-Uncertainty",
        alpha_grid = ALPHA_GRID,
