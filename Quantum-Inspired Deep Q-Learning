  )
}


# ==============================================================================
# 15. TRAIN ONE-STEP CONTEXTUAL-BANDIT MODEL
# ==============================================================================

train_contextual_bandit <- function(
    X,
    Y0,
    Y1,
    Y2,
    model_type = c(
      "MLP",
      "CNN-LSTM"
    ),
    replay_method = c(
      "Uniform",
      "Entropy",
      "Residual-PER",
      "Quantum-Uncertainty"
    ),
    alpha = 0.5,
    seed = 1,
    n_episodes = N_EPISODES,
    batch_size = BATCH_SIZE,
    buffer_size = BUFFER_SIZE) {

  model_type <-
    match.arg(
      model_type
    )

  replay_method <-
    match.arg(
      replay_method
    )


  set.seed(
    seed
  )


  # ---------------------------------------------------------------------------
  # Input dimensions
  # ---------------------------------------------------------------------------

  input_shape <-
    dim(X)[2:3]


  cat(
    "Model:",
    model_type,
    "| Replay:",
    replay_method,
    "| Input:",
    paste(
      input_shape,
      collapse = " x "
    ),
    "\n"
  )


  # ---------------------------------------------------------------------------
  # Build model
  # ---------------------------------------------------------------------------

  if (
    model_type == "MLP"
  ) {

    model <-
      build_mlp(
        input_shape = input_shape,
        n_actions = N_ACTIONS
      )

  } else {

    model <-
      build_cnn_lstm(
        input_shape = input_shape,
        n_actions = N_ACTIONS
      )
  }


  # ---------------------------------------------------------------------------
  # Replay buffer
  # ---------------------------------------------------------------------------

  buffer <-
    ReplayBuffer$new(
      capacity = buffer_size
    )


  # ---------------------------------------------------------------------------
  # Logs
  # ---------------------------------------------------------------------------

  episode_reward_log <-
    numeric(
      n_episodes
    )

  greedy_policy_reward_log <-
    numeric(
      n_episodes
    )

  epsilon_log <-
    numeric(
      n_episodes
    )


  epsilon <-
    EPSILON_START


  # ===========================================================================
  # TRAINING LOOP
  # ===========================================================================

  for (
    ep in seq_len(n_episodes)
  ) {


    # -------------------------------------------------------------------------
    # Current Q-values
    # -------------------------------------------------------------------------

    q_values <-
      predict_q_values(
        model,
        X
      )


    # -------------------------------------------------------------------------
    # Epsilon-greedy actions
    # -------------------------------------------------------------------------

    actions <-
      sample_actions_epsilon_greedy(
        q_values = q_values,
        epsilon = epsilon,
        n_actions = N_ACTIONS
      )


    # -------------------------------------------------------------------------
    # Observed rewards
    # -------------------------------------------------------------------------

    rewards <-
      get_action_rewards(
        Y0 = Y0,
        Y1 = Y1,
        Y2 = Y2,
        actions = actions
      )


    # -------------------------------------------------------------------------
    # Add observations to replay buffer
    #
    # X[i, , ] is a T x P matrix.
    # -------------------------------------------------------------------------

    for (
      i in seq_len(
        dim(X)[1]
      )
    ) {

      buffer$add(
        state = X[i, , ],
        action = actions[i],
        reward = rewards[i]
      )
    }


    # -------------------------------------------------------------------------
    # Log observed reward
    # -------------------------------------------------------------------------

    episode_reward_log[ep] <-
      mean(
        rewards
      )


    # -------------------------------------------------------------------------
    # Replay update
    # -------------------------------------------------------------------------

    batch <-
      sample_replay_batch(
        buffer = buffer,
        model = model,
        method = replay_method,
        batch_size = batch_size,
        alpha = alpha,
        beta = BETA
      )


    if (
      !is.null(batch)
    ) {


      # -----------------------------------------------------------------------
      # Current Q-values
      # -----------------------------------------------------------------------

      q_current <-
        predict_q_values(
          model,
          batch$states
        )


      # -----------------------------------------------------------------------
      # One-step regression target
      #
      # No next state.
      # No gamma.
      # No conventional TD target.
      # -----------------------------------------------------------------------

      q_target <-
        q_current

      row_index <-
        seq_len(
          nrow(q_target)
        )

      action_index <-
        batch$actions + 1

      q_target[
        cbind(
          row_index,
          action_index
        )
      ] <-
        batch$rewards


      # -----------------------------------------------------------------------
      # Weighted regression
      # -----------------------------------------------------------------------

      model %>%
        fit(
          x = batch$states,
          y = q_target,
          sample_weight = batch$is_weights,
          epochs = EPOCHS_PER_UPDATE,
          batch_size = batch_size,
          verbose = 0
        )
    }


    # -------------------------------------------------------------------------
    # Evaluate current greedy policy on training data
    # -------------------------------------------------------------------------

    q_after <-
      predict_q_values(
        model,
        X
      )

    greedy_actions <-
      max.col(
        q_after,
        ties.method = "first"
      ) - 1


    greedy_rewards <-
      get_action_rewards(
        Y0 = Y0,
        Y1 = Y1,
        Y2 = Y2,
        actions = greedy_actions
      )


    greedy_policy_reward_log[ep] <-
      mean(
        greedy_rewards
      )


    # -------------------------------------------------------------------------
    # Epsilon decay
    # -------------------------------------------------------------------------

    epsilon_log[ep] <-
      epsilon

    epsilon <-
      max(
        EPSILON_MIN,
        epsilon *
        EPSILON_DECAY
      )


    # -------------------------------------------------------------------------
    # Progress
    # -------------------------------------------------------------------------

    if (
      ep == 1 ||
      ep %% 5 == 0 ||
      ep == n_episodes
    ) {

      cat(
        sprintf(
          paste0(
            "  Episode %02d/%02d",
            " | epsilon = %.3f",
            " | observed reward = %.4f",
            " | greedy reward = %.4f\n"
          ),
          ep,
          n_episodes,
          epsilon_log[ep],
          episode_reward_log[ep],
          greedy_policy_reward_log[ep]
        )
      )
    }
  }


  # ---------------------------------------------------------------------------
  # Return
  # ---------------------------------------------------------------------------

  list(
    model = model,
    episode_reward = episode_reward_log,
    greedy_policy_reward =
      greedy_policy_reward_log,
    epsilon = epsilon_log,
    replay_method = replay_method,
    model_type = model_type,
    alpha = alpha
  )
}


# ==============================================================================
# 16. POLICY EVALUATION
# ==============================================================================

evaluate_policy <- function(
    model,
    X,
    Y0,
    Y1,
    Y2) {

  q_values <-
    predict_q_values(
      model,
      X
    )


  # ---------------------------------------------------------------------------
  # Greedy policy
  # ---------------------------------------------------------------------------

  actions <-
    max.col(
      q_values,
      ties.method = "first"
    ) - 1


  # ---------------------------------------------------------------------------
  # Policy reward
  # ---------------------------------------------------------------------------

  policy_reward <-
    get_action_rewards(
      Y0 = Y0,
      Y1 = Y1,
      Y2 = Y2,
      actions = actions
    )


  # ---------------------------------------------------------------------------
  # Oracle policy
  # ---------------------------------------------------------------------------

  potential_outcomes <-
    cbind(
      Y0,
      Y1,
      Y2
    )

  optimal_actions <-
    max.col(
      potential_outcomes,
      ties.method = "first"
    ) - 1

  optimal_reward <-
    apply(
      potential_outcomes,
      1,
      max
    )


  # ---------------------------------------------------------------------------
  # Metrics
  # ---------------------------------------------------------------------------

  policy_value <-
    mean(
      policy_reward
    )

  optimal_value <-
    mean(
      optimal_reward
    )

  regret <-
    optimal_value -
    policy_value


  # ---------------------------------------------------------------------------
  # Action distribution
  # ---------------------------------------------------------------------------

  action_distribution <-
    table(
      factor(
        actions,
        levels = 0:2
      )
    )

  action_rate <-
    as.numeric(
      action_distribution
    ) /
    length(actions)


  list(
    actions = actions,
    q_values = q_values,
    reward = policy_reward,
    optimal_actions = optimal_actions,
    optimal_reward = optimal_reward,
    mean_reward = mean(policy_reward),
    sd_reward = sd(policy_reward),
    total_reward = sum(policy_reward),
    policy_value = policy_value,
    optimal_value = optimal_value,
    regret = regret,
    action_rate_0 = action_rate[1],
    action_rate_1 = action_rate[2],
    action_rate_2 = action_rate[3]
  )
}


