      )


    selected_alpha <-
      alpha_selection$selected_alpha

    validation_table <-
      alpha_selection$validation_table


    cat(
      sprintf(
        "  Selected alpha = %.2f\n",
        selected_alpha
      )
    )
  }


  # ===========================================================================
  # 20.4 Quantum-Uncertainty MLP
  # ===========================================================================

  cat(
