    )
}

# =============================================================================
# 30. MAIN EXPERIMENT
# =============================================================================

all_results <- list()

result_counter <- 1

for (dataset_name in names(dataset_objects)) {

    dataset <- dataset_objects[[dataset_name]]

    # -------------------------------------------------------------------------
    # Each dataset is evaluated under rho = +0.5 and rho = -0.5.
    # -------------------------------------------------------------------------

    for (rho in CORRELATIONS) {

        # =====================================================================
        # Uniform replay
        # =====================================================================

        seed_uniform <-
            SEED_BASE +
            result_counter * 100

        result_uniform <- run_experiment(
            dataset_name = dataset_name,
            X = dataset,
            rho = rho,
            replay_method = "uniform",
            seed = seed_uniform
        )

        all_results[[result_counter]] <-
            result_uniform$summary

        result_counter <-
            result_counter + 1


        # =====================================================================
        # Uncertainty-weighted replay
        # =====================================================================

        seed_uncertainty <-
            SEED_BASE +
            result_counter * 100

        result_uncertainty <- run_experiment(
            dataset_name = dataset_name,
            X = dataset,
            rho = rho,
            replay_method = "uncertainty",
            seed = seed_uncertainty
        )

        all_results[[result_counter]] <-
            result_uncertainty$summary

        result_counter <-
            result_counter + 1
    }
}

