# =============================================================================
# 29. RUN ONE EXPERIMENT
# =============================================================================

run_experiment <- function(
    dataset_name,
    X,
    rho,
    replay_method,
    seed
) {

    cat(
        "\n",
        "============================================================\n",
        sep = ""
    )

    cat(
        "Dataset:",
        dataset_name,
        "\n"
    )

    cat(
        "Correlation:",
        rho,
        "\n"
    )

    cat(
        "Replay:",
        replay_method,
        "\n"
    )

    cat(
        "============================================================\n"
    )

    # -------------------------------------------------------------------------
    # Limit sample size if necessary.
    # -------------------------------------------------------------------------

    set.seed(
        seed
    )

    if (
        nrow(X) > N
    ) {

        selected <- sample(
            seq_len(
                nrow(X)
            ),
            N
        )

        X <- X[
            selected,
            ,
            drop = FALSE
        ]
    }

    # -------------------------------------------------------------------------
    # Train / validation / test split.
    # -------------------------------------------------------------------------

    n <- nrow(
        X
    )

    train_n <- floor(
        TRAIN_PROP * n
    )

    valid_n <- floor(
        VALID_PROP * n
    )

    test_n <- n -
        train_n -
        valid_n

    indices <- sample(
        seq_len(n)
    )

    train_idx <- indices[
        seq_len(
            train_n
        )
    ]

    valid_start <-
        train_n + 1

    valid_end <-
        train_n + valid_n

    valid_idx <- indices[
        valid_start:
        valid_end
    ]

    test_idx <- indices[
        (valid_end + 1):
        n
    ]

    X_train_raw <- X[
        train_idx,
        ,
        drop = FALSE
    ]

    X_valid_raw <- X[
        valid_idx,
        ,
        drop = FALSE
    ]

    X_test_raw <- X[
        test_idx,
        ,
        drop = FALSE
    ]

    # -------------------------------------------------------------------------
    # Standardization based ONLY on training data.
    # -------------------------------------------------------------------------

    standardizer <- fit_standardizer(
        X_train_raw
    )

    X_train <- create_initial_states(
        X_train_raw,
        standardizer
    )

    X_valid <- create_initial_states(
        X_valid_raw,
        standardizer
    )

    X_test <- create_initial_states(
        X_test_raw,
        standardizer
    )

    # -------------------------------------------------------------------------
    # Empirical copula fitted ONLY on training states.
    # -------------------------------------------------------------------------

    copula_fit <- fit_copula(
        X_train
    )

    # -------------------------------------------------------------------------
    # Reward scaling fitted ONLY from training data.
    # -------------------------------------------------------------------------

    reward_scaling <-
        fit_reward_scaling(
            X_train
        )

    # -------------------------------------------------------------------------
    # Train sequential DQN.
    # -------------------------------------------------------------------------

    trained <- train_sequential_dqn(
        X_train = X_train,
        X_valid = X_valid,
        copula_fit = copula_fit,
        reward_scaling = reward_scaling,
        rho = rho,
        replay_method = replay_method,
        seed = seed
    )

    model <- trained$model

    # -------------------------------------------------------------------------
    # Independent test rollout.
    # -------------------------------------------------------------------------

    test_rollout <- rollout_policy(
        model = model,
        X_initial = X_test,
        copula_fit = copula_fit,
        reward_scaling = reward_scaling,
        rho = rho,
        seed = seed + 20000
    )

    # -------------------------------------------------------------------------
    # Dynamic CATE.
    # -------------------------------------------------------------------------

    cate_df <- calculate_dynamic_cate(
        test_rollout
    )

    # -------------------------------------------------------------------------
    # Policy matrix.
    # -------------------------------------------------------------------------

    policy_matrix <- create_policy_matrix(
        test_rollout$actions
    )

    # -------------------------------------------------------------------------
    # Policy value.
    # -------------------------------------------------------------------------

    policy_value <- calculate_policy_value(
        test_rollout
    )

    # -------------------------------------------------------------------------
    # Treatment rates.
    # -------------------------------------------------------------------------

    treatment_rates <- policy_matrix |>
        filter(
            action != 1
        ) |>
        group_by(
            action
        ) |>
        summarise(
            treatment_rate =
                mean(rate),
            .groups = "drop"
        )

    treatment_rate_action2 <-
        treatment_rates |>
        filter(
            action == 2
        ) |>
        pull(
            treatment_rate
        )

    treatment_rate_action3 <-
        treatment_rates |>
        filter(
            action == 3
        ) |>
        pull(
            treatment_rate
        )

    if (
        length(
            treatment_rate_action2
        ) == 0
    ) {

        treatment_rate_action2 <- NA_real_
    }

    if (
        length(
            treatment_rate_action3
        ) == 0
    ) {

        treatment_rate_action3 <- NA_real_
    }

    # -------------------------------------------------------------------------
    # CATE summary.
    # -------------------------------------------------------------------------

    cate_summary <- cate_df |>
        group_by(
            contrast,
            reward_dimension
        ) |>
        summarise(
            mean_CATE =
                mean(
                    mean_CATE
                ),
            sd_CATE =
                mean(
                    sd_CATE
                ),
            .groups = "drop"
        )

    # -------------------------------------------------------------------------
    # Final summary.
    # -------------------------------------------------------------------------

    summary_row <- tibble(
        dataset = dataset_name,
        rho = rho,
        replay_method = replay_method,
        n_train = nrow(
            X_train
        ),
        n_valid = nrow(
            X_valid
        ),
        n_test = nrow(
            X_test
        ),
        T_steps = T_STEPS,
        n_actions = N_ACTIONS,
        n_reward_dim = N_REWARD_DIM,
        gamma = GAMMA,
        best_validation_value =
            trained$best_validation,
        test_discounted_policy_value =
            policy_value$discounted_policy_value,
        test_discounted_policy_sd =
            policy_value$discounted_policy_sd,
        test_undiscounted_policy_value =
            policy_value$undiscounted_policy_value,
        test_undiscounted_policy_sd =
            policy_value$undiscounted_policy_sd,
        action2_rate =
            treatment_rate_action2,
        action3_rate =
            treatment_rate_action3
    )

    # -------------------------------------------------------------------------
    # Save experiment-specific files.
    # -------------------------------------------------------------------------

    experiment_tag <- paste(
        dataset_name,
        paste0(
            "rho",
            ifelse(
                rho > 0,
                "pos",
                "neg"
            ),
            abs(rho)
        ),
        replay_method,
        sep = "_"
    )

    experiment_tag <- gsub(
