create_pseudo_temporal_covariates <- function(
    X0,
    T_steps = T_STEPS
) {

    X0 <- as.matrix(
        X0
    )

    n <- nrow(X0)

    p <- ncol(X0)

    X_temporal <- array(
        0,
        dim = c(
            n,
            T_steps,
            p
        )
    )

    for (t in seq_len(T_steps)) {

        temporal_factor <- 1 +
            0.05 * (t - 1)

        temporal_shift <- 0.05 *
            sin(
                2 * pi * t / T_steps
            )

        X_temporal[, t, ] <-
            sweep(
                X0,
                2,
                temporal_factor,
                FUN = "*"
            ) +
            temporal_shift
    }

    X_temporal
}


# =============================================================================
# 8. EQUICORRELATED ERRORS
# =============================================================================

make_correlation_matrix <- function(
    K,
    rho
) {

    Sigma <- matrix(
        rho,
        nrow = K,
        ncol = K
    )

    diag(
        Sigma
    ) <- 1

    Sigma
}


generate_correlated_errors <- function(
    n,
    rho,
    sd = 0.50
) {

    Sigma <- make_correlation_matrix(
        N_REWARD_DIM,
        rho
    )

    Sigma <- Sigma * sd^2

    # Numerical stabilization.
    Sigma <- Sigma +
        diag(
            1e-8,
            N_REWARD_DIM
        )

    L <- chol(
        Sigma
    )

    Z <- matrix(
        rnorm(
            n * N_REWARD_DIM
        ),
        nrow = n,
        ncol = N_REWARD_DIM
    )

    Z %*% L
}


# =============================================================================
# 9. ACTION-DEPENDENT REWARD MEANS
# =============================================================================
#
# Action coding:
#
#   1 = baseline
#   2 = treatment 1
#   3 = treatment 2
#
# The reward is a 3-dimensional correlated outcome.
#
# =============================================================================

calculate_reward_means <- function(
    X_state,
    action
) {

    X_state <- as.matrix(
        X_state
    )

    n <- nrow(
        X_state
    )

    p <- ncol(
        X_state
    )

    # Ensure at least five coordinates.
    x1 <- X_state[, 1]

    x2 <- if (p >= 2) {
        X_state[, 2]
    } else {
        0
    }

    x3 <- if (p >= 3) {
        X_state[, 3]
    } else {
        0
    }

    x4 <- if (p >= 4) {
        X_state[, 4]
    } else {
        0
    }

    x5 <- if (p >= 5) {
        X_state[, 5]
    } else {
        0
    }

    baseline <-
        1.00 +
        0.20 * x1 -
        0.15 * x2 +
        0.10 * x3^2 +
        0.10 * sin(x4)

    tau1 <-
        0.40 +
        0.20 * sin(x1) +
        0.10 * x2 * x3

    tau2 <-
        0.25 +
        0.15 * x2 -
        0.10 * x4

    effect <- rep(
        0,
        n
    )

    if (action == 2) {

        effect <- tau1

    } else if (action == 3) {

        effect <- tau2
    }

    mu <- matrix(
        0,
        nrow = n,
        ncol = N_REWARD_DIM
    )

    mu[, 1] <- baseline + effect

    mu[, 2] <- baseline + 0.80 * effect

    mu[, 3] <- baseline + 1.20 * effect

    mu
}


generate_reward <- function(
    X_state,
    action,
    rho,
    reward_sd = 0.50
) {

    mu <- calculate_reward_means(
        X_state,
        action
    )

    errors <- generate_correlated_errors(
        nrow(X_state),
        rho,
        sd = reward_sd
    )

    mu + errors
}


# =============================================================================
# 10. ACTION-DEPENDENT STATE TRANSITION
# =============================================================================
#
# S_{t+1} = phi S_t + B(A_t) + time drift + eta_t
#
# Thus the selected action changes the future state.
#
# =============================================================================

get_action_shift <- function(
    p,
    action
) {

    shift <- rep(
        0,
        p
    )

    if (action == 2) {

        shift[1] <- 0.08

        if (p >= 2) {
            shift[2] <- -0.05
        }

        if (p >= 3) {
            shift[3] <- 0.03
        }

    } else if (action == 3) {

        shift[1] <- -0.06

        if (p >= 2) {
            shift[2] <- 0.04
        }

        if (p >= 3) {
            shift[3] <- 0.08
        }
    }

    shift
}


transition_state <- function(
    X_state,
    action,
    t,
    phi = 0.92,
    transition_sd = 0.08
) {

    X_state <- as.matrix(
        X_state
    )

    n <- nrow(
        X_state
    )

    p <- ncol(
        X_state
    )

    shift <- get_action_shift(
        p,
        action
    )

    time_drift <- 0.03 *
        sin(
            2 * pi * t / T_STEPS
        )

    noise <- matrix(
        rnorm(
            n * p,
            sd = transition_sd
        ),
        nrow = n,
        ncol = p
    )

    X_next <- phi * X_state

    X_next <- sweep(
        X_next,
        2,
        shift,
        FUN = "+"
    )

    X_next <- X_next +
        time_drift +
        noise

    # Stability constraint.
    X_next <- pmin(
        pmax(
            X_next,
            -4
        ),
        4
    )

    X_next
}


# =============================================================================
# 11. REWARD SCALING FOR STATE HISTORY
# =============================================================================

fit_reward_scaling <- function(
    X_train
) {

    reward_list <- vector(
        "list",
        N_ACTIONS
    )

    for (a in seq_len(N_ACTIONS)) {

        reward_list[[a]] <-
            calculate_reward_means(
                X_train,
                a
            )
    }

    all_rewards <- do.call(
        rbind,
        reward_list
    )

    center <- colMeans(
        all_rewards
    )

    scale_value <- apply(
        all_rewards,
        2,
        sd
    )

    scale_value[
        !is.finite(scale_value) |
        scale_value < 1e-8
    ] <- 1

    list(
        center = center,
        scale = scale_value
    )
}


scale_reward_history <- function(
    R,
    reward_scaling
) {

    R_scaled <- sweep(
        R,
        2,
        reward_scaling$center,
        FUN = "-"
    )

    R_scaled <- sweep(
        R_scaled,
        2,
        reward_scaling$scale,
        FUN = "/"
    )

    R_scaled
}


# =============================================================================
# 12. STATE REPRESENTATION
# =============================================================================
#
# Channels:
#
#   1. standardized state covariates
#   2. empirical-copula state covariates
#   3. previous action
#   4. action × copula interaction
#   5. previous reward dimension 1
#   6. previous reward dimension 2
#   7. previous reward dimension 3
#
# =============================================================================

build_history_state <- function(
    X_history,
    C_history,
    A_history,
    R_history,
    current_t,
    T_steps,
    reward_scaling
) {

    X_history <- as.matrix(
        X_history
    )

    C_history <- as.matrix(
        C_history
    )

    p <- ncol(
        X_history
    )

    channels <- 7

    state_full <- array(
        0,
        dim = c(
            T_steps,
            p,
            channels
        )
    )

    history_length <- current_t

    for (h in seq_len(history_length)) {

        state_full[h, , 1] <-
            X_history[h, ]

        state_full[h, , 2] <-
            C_history[h, ]

        # Previous action.
        if (h > 1) {

            previous_action <-
                A_history[h - 1]

            action_value <-
                (previous_action - 1) /
                max(
                    N_ACTIONS - 1,
                    1
                )

            state_full[h, , 3] <-
                action_value

            state_full[h, , 4] <-
                C_history[h, ] *
                action_value

            previous_reward <-
                R_history[h - 1, ]

            previous_reward <-
                scale_reward_history(
                    matrix(
                        previous_reward,
                        nrow = 1
                    ),
                    reward_scaling
                )[1, ]

            state_full[h, , 5] <-
                previous_reward[1]

            state_full[h, , 6] <-
                previous_reward[2]

            state_full[h, , 7] <-
                previous_reward[3]
        }
    }

    state_full
}


state_to_batch <- function(
    state
) {

    array(
        state,
        dim = c(
            1,
            dim(state)
        )
    )
}


# =============================================================================
# 13. CNN-LSTM DQN
# =============================================================================

build_dqn <- function(
    T_steps,
    p,
    channels,
    n_actions = N_ACTIONS
) {

    inputs <- layer_input(
        shape = c(
            T_steps,
            p,
            channels
        )
    )

    x <- inputs |>
        layer_conv_2d(
            filters = 32,
            kernel_size = c(
                1,
                3
            ),
            padding = "same",
            activation = "relu"
        ) |>
        layer_batch_normalization() |>
        layer_conv_2d(
            filters = 32,
            kernel_size = c(
                1,
                3
            ),
            padding = "same",
            activation = "relu"
        ) |>
        layer_average_pooling_2d(
            pool_size = c(
                1,
                p
            )
        ) |>
        layer_reshape(
            target_shape = c(
                T_steps,
                32
            )
        ) |>
        layer_lstm(
            units = 64,
            return_sequences = FALSE
        ) |>
        layer_dense(
            64,
            activation = "relu"
        ) |>
        layer_dropout(
            0.10
        ) |>
        layer_dense(
            32,
            activation = "relu"
        ) |>
        layer_dense(
            n_actions,
            activation = "linear"
        )

    model <- keras_model(
        inputs = inputs,
        outputs = x
    )

    model |> compile(
        optimizer = optimizer_adam(
            learning_rate = LEARNING_RATE
        ),
        loss = "mse"
    )

    model
}


# =============================================================================
# 14. REPLAY BUFFER
# =============================================================================

ReplayBuffer <- R6Class(
    "ReplayBuffer",

    public = list(

        capacity = NULL,

        buffer = NULL,

        position = NULL,

        size = NULL,

        initialize = function(
            capacity
        ) {

            self$capacity <-
                capacity

            self$buffer <-
                vector(
                    "list",
                    capacity
                )

            self$position <- 1

            self$size <- 0
        },

        add = function(
            transition
        ) {

            self$buffer[[self$position]] <-
                transition

            self$position <-
                self$position + 1

            if (
                self$position >
                self$capacity
            ) {

                self$position <- 1
            }

            self$size <-
                min(
                    self$size + 1,
                    self$capacity
                )
        },

        get_all = function() {

            if (
                self$size == 0
            ) {

                return(
                    list()
                )
            }

            self$buffer[
                seq_len(
                    self$size
                )
            ]
        }
    )
)


# =============================================================================
# 15. Q-DISPERSION UNCERTAINTY
# =============================================================================

calculate_q_uncertainty <- function(
    model,
    states
) {

    q_values <- predict(
        model,
        states,
        verbose = 0
    )

    q_values <- as.matrix(
        q_values
    )

    apply(
        q_values,
        1,
        sd
    )
}


# =============================================================================
# 16. EPSILON-GREEDY ACTION
# =============================================================================

select_action <- function(
    model,
    state,
    epsilon
) {

    if (
        runif(1) <
        epsilon
    ) {

        return(
            sample(
                seq_len(
                    N_ACTIONS
                ),
                1
            )
        )
    }

    q_values <- predict(
        model,
        state,
        verbose = 0
    )

    q_values <- as.numeric(
        q_values[1, ]
    )

    which(
        q_values ==
            max(
                q_values
            )
    )[1]
}


# =============================================================================
# 17. TRANSITION COLLECTION
# =============================================================================
#
# This is the central change from the previous implementation.
#
# The current DQN selects A_t.
#
# That action determines:
#
#   R_t = R(S_t,A_t)
#
# and:
#
#   S_{t+1} = f(S_t,A_t,eta_t)
#
# =============================================================================

collect_dqn_transitions <- function(
    model,
    X_initial,
    copula_fit,
    reward_scaling,
    rho,
    epsilon,
    n_episodes,
    seed
) {

    set.seed(
        seed
    )

    n_available <- nrow(
        X_initial
    )

    episode_ids <- sample(
        seq_len(
            n_available
        ),
        size = n_episodes,
        replace = n_episodes > n_available
    )

    transitions <- vector(
        "list",
        n_episodes * T_STEPS
    )

    counter <- 1

    for (episode in seq_len(n_episodes)) {

        id <- episode_ids[episode]

        current_X <- matrix(
            X_initial[id, ],
            nrow = 1
        )

        p <- ncol(
            current_X
        )

        X_history <- matrix(
            0,
            nrow = T_STEPS,
            ncol = p
        )

        C_history <- matrix(
            0,
            nrow = T_STEPS,
            ncol = p
        )

        A_history <- integer(
            T_STEPS
        )

        R_history <- matrix(
            0,
            nrow = T_STEPS,
            ncol = N_REWARD_DIM
        )

        for (t in seq_len(T_STEPS)) {

            X_history[t, ] <-
                current_X[1, ]

            current_C <-
                apply_copula(
                    current_X,
                    copula_fit
                )

            C_history[t, ] <-
                current_C[1, ]

            current_state <- build_history_state(
                X_history = X_history,
                C_history = C_history,
                A_history = A_history,
                R_history = R_history,
                current_t = t,
                T_steps = T_STEPS,
                reward_scaling = reward_scaling
            )

            state_batch <- state_to_batch(
                current_state
            )

            action <- select_action(
                model = model,
                state = state_batch,
                epsilon = epsilon
            )

            reward_vector <- generate_reward(
                X_state = current_X,
                action = action,
                rho = rho
            )[1, ]

            A_history[t] <- action

            R_history[t, ] <-
                reward_vector

            done <- as.integer(
                t == T_STEPS
            )

            if (!done) {

                next_X <- transition_state(
                    X_state = current_X,
                    action = action,
                    t = t
                )

                next_C <- apply_copula(
                    next_X,
                    copula_fit
                )

                X_history[t + 1, ] <-
                    next_X[1, ]

                C_history[t + 1, ] <-
                    next_C[1, ]

                next_state <- build_history_state(
                    X_history = X_history,
                    C_history = C_history,
                    A_history = A_history,
                    R_history = R_history,
                    current_t = t + 1,
                    T_steps = T_STEPS,
                    reward_scaling = reward_scaling
                )

            } else {

                next_state <- array(
                    0,
                    dim = dim(
                        current_state
                    )
                )
            }

            transitions[[counter]] <- list(
                state = state_batch,
                action = action,
                reward_vector = reward_vector,
                reward = scalarize_reward(
                    reward_vector
                ),
                next_state = state_to_batch(
                    next_state
                ),
                done = done,
                time = t,
                subject = id,
                uncertainty = 0
            )

            counter <- counter + 1

            if (!done) {

                current_X <- next_X
            }
        }
    }

    transitions
}


# =============================================================================
# 18. SCALARIZE MULTIVARIATE REWARD
# =============================================================================

scalarize_reward <- function(
    reward_vector
) {

    sum(
        reward_vector *
            REWARD_WEIGHTS
    )
}


# =============================================================================
# 19. REPLAY SAMPLING
# =============================================================================

sample_replay <- function(
    replay,
    batch_size,
    model,
    method = c(
        "uniform",
        "uncertainty"
    )
) {

    method <- match.arg(
        method
    )

    n <- replay$size

    batch_size <- min(
        batch_size,
        n
    )

    transitions <- replay$get_all()

    if (
        method == "uniform"
    ) {

        probabilities <- rep(
            1 / n,
            n
        )

    } else {

        states <- array(
            0,
            dim = c(
                n,
                dim(
                    transitions[[1]]$state
                )[2:4]
            )
        )

        for (i in seq_len(n)) {

            states[i, , , ] <-
                transitions[[i]]$state[1, , , ]
        }

        uncertainty <- calculate_q_uncertainty(
            model,
            states
        )

        priorities <-
            1 +
            ALPHA_UNCERTAINTY *
            uncertainty

        probabilities <-
            priorities /
            sum(priorities)

        # Update stored uncertainty.
        for (i in seq_len(n)) {

            transitions[[i]]$uncertainty <-
                uncertainty[i]

            replay$buffer[[i]] <-
                transitions[[i]]
        }
    }

    indices <- sample(
        seq_len(n),
        size = batch_size,
        replace = n < batch_size,
        prob = probabilities
    )

    sampled <- transitions[
        indices
    ]

    sampling_probabilities <-
        probabilities[
            indices
        ]

    importance_weights <-
        (
            n *
            sampling_probabilities
        )^(-BETA_IS)

    importance_weights <-
        importance_weights /
        max(
            importance_weights
        )

    list(
        transitions = sampled,
        indices = indices,
        probabilities = sampling_probabilities,
        importance_weights = importance_weights
    )
}


# =============================================================================
# 20. TRAIN ONE DQN BATCH
# =============================================================================

train_dqn_batch <- function(
    online_model,
    target_model,
    batch
) {

    transitions <-
        batch$transitions

    B <- length(
        transitions
    )

    state_shape <- dim(
        transitions[[1]]$state
    )

    state_array <- array(
        0,
        dim = c(
            B,
            state_shape[2],
            state_shape[3],
            state_shape[4]
        )
    )

    next_state_array <- array(
        0,
        dim = c(
            B,
            state_shape[2],
            state_shape[3],
            state_shape[4]
        )
    )

    actions <- integer(
        B
    )

    rewards <- numeric(
        B
    )

    dones <- numeric(
        B
    )

    for (i in seq_len(B)) {

        state_array[i, , , ] <-
            transitions[[i]]$state[1, , , ]

        next_state_array[i, , , ] <-
            transitions[[i]]$next_state[1, , , ]

        actions[i] <-
            transitions[[i]]$action

        rewards[i] <-
            transitions[[i]]$reward

        dones[i] <-
            transitions[[i]]$done
    }

    current_q <- predict(
        online_model,
        state_array,
        verbose = 0
    )

    next_q <- predict(
        target_model,
        next_state_array,
        verbose = 0
    )

    max_next_q <- apply(
        next_q,
        1,
        max
    )

    targets <- current_q

    bellman_target <-
        rewards +
        GAMMA *
        (1 - dones) *
        max_next_q

    for (i in seq_len(B)) {

        targets[i, actions[i]] <-
            bellman_target[i]
    }

    sample_weights <-
        batch$importance_weights

    fit_result <- online_model |> fit(
        x = state_array,
        y = targets,
        sample_weight = sample_weights,
        epochs = 1,
        batch_size = B,
        verbose = 0
    )

    loss_value <- NA_real_

    if (
        !is.null(
            fit_result$metrics
        )
    ) {

        if (
            "loss" %in%
            names(
                fit_result$metrics
            )
        ) {

            loss_value <-
                as.numeric(
                    tail(
                        fit_result$metrics$loss,
                        1
                    )
                )
        }
    }

    list(
        loss = loss_value,
        targets = targets,
        q_values = current_q
    )
}


