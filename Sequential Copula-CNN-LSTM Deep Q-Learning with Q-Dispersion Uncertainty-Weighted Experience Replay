# =============================================================================
# 22. POLICY ROLLOUT
# =============================================================================
#
# Unlike the previous implementation, evaluation does NOT use a pre-generated
# observed reward trajectory.
#
# At each time:
#
#   current state
#       |
#       v
#   DQN action
#       |
#       +------> reward
#       |
#       +------> next state
#
# =============================================================================

rollout_policy <- function(
    model,
    X_initial,
    copula_fit,
    reward_scaling,
    rho,
    seed = NULL
) {

    if (!is.null(seed)) {

        set.seed(
            seed
        )
    }

    n <- nrow(
        X_initial
    )

    p <- ncol(
        X_initial
    )

    actions <- matrix(
        0,
        nrow = n,
        ncol = T_STEPS
    )

    rewards <- array(
        0,
        dim = c(
            n,
            T_STEPS,
            N_REWARD_DIM
        )
    )

    states_X <- array(
        0,
        dim = c(
            n,
            T_STEPS,
            p
        )
    )

    discounted_returns <- numeric(
        n
    )

    undiscounted_returns <- numeric(
        n
    )

    for (i in seq_len(n)) {

        current_X <- matrix(
            X_initial[i, ],
            nrow = 1
        )

        X_history <- matrix(
            0,
            nrow = T_STEPS,
            ncol = p
        )

        C_history <- matrix(
            0,
            nrow = T_STEPS,
            ncol = p
        )

        A_history <- integer(
            T_STEPS
        )

        R_history <- matrix(
            0,
            nrow = T_STEPS,
            ncol = N_REWARD_DIM
        )

        for (t in seq_len(T_STEPS)) {

            X_history[t, ] <-
                current_X[1, ]

            states_X[i, t, ] <-
                current_X[1, ]

            current_C <-
                apply_copula(
                    current_X,
                    copula_fit
                )

            C_history[t, ] <-
                current_C[1, ]

            current_state <- build_history_state(
                X_history = X_history,
                C_history = C_history,
                A_history = A_history,
                R_history = R_history,
                current_t = t,
                T_steps = T_STEPS,
                reward_scaling = reward_scaling
            )

            state_batch <- state_to_batch(
                current_state
            )

            action <- select_action(
                model = model,
                state = state_batch,
                epsilon = 0
            )

            reward_vector <- generate_reward(
                X_state = current_X,
                action = action,
                rho = rho
            )[1, ]

            scalar_reward <-
                scalarize_reward(
                    reward_vector
                )

            actions[i, t] <-
                action

            rewards[i, t, ] <-
                reward_vector

            A_history[t] <-
                action

            R_history[t, ] <-
                reward_vector

            discounted_returns[i] <-
                discounted_returns[i] +
                GAMMA^(t - 1) *
                scalar_reward

            undiscounted_returns[i] <-
                undiscounted_returns[i] +
                scalar_reward

            if (
                t < T_STEPS
            ) {

                current_X <-
                    transition_state(
                        X_state = current_X,
                        action = action,
                        t = t
                    )
            }
        }
    }

    list(
        actions = actions,
        rewards = rewards,
        states_X = states_X,
        discounted_returns =
            discounted_returns,
        undiscounted_returns =
            undiscounted_returns
    )
}


# =============================================================================
# 23. DYNAMIC CATE
# =============================================================================
#
# Immediate dynamic CATE:
#
#   CATE_2vs1(t) =
#       E[R_t(2)-R_t(1) | S_t]
#
#   CATE_3vs1(t) =
#       E[R_t(3)-R_t(1) | S_t]
#
# These are calculated from the conditional reward means, not noisy realized
# rewards.
#
# =============================================================================

calculate_dynamic_cate <- function(
    rollout_result
) {

    states_X <- rollout_result$states_X

    n <- dim(
        states_X
    )[1]

    p <- dim(
        states_X
    )[3]

    results <- vector(
        "list",
        T_STEPS
    )

    counter <- 1

    for (t in seq_len(T_STEPS)) {

        X_t <- matrix(
            states_X[, t, ],
            nrow = n,
            ncol = p
        )

        mu1 <- calculate_reward_means(
            X_t,
            action = 1
        )

        mu2 <- calculate_reward_means(
            X_t,
            action = 2
        )

        mu3 <- calculate_reward_means(
            X_t,
            action = 3
        )

        cate21 <-
            mu2 - mu1

        cate31 <-
            mu3 - mu1

        for (k in seq_len(N_REWARD_DIM)) {

            results[[counter]] <-
                tibble(
                    time = t,
                    contrast = "Action 2 vs Action 1",
                    reward_dimension = k,
                    mean_CATE = mean(
                        cate21[, k]
                    ),
                    sd_CATE = sd(
                        cate21[, k]
                    ),
                    q025 = quantile(
                        cate21[, k],
                        0.025
                    ),
                    q975 = quantile(
                        cate21[, k],
                        0.975
                    )
                )

            counter <- counter + 1

            results[[counter]] <-
                tibble(
                    time = t,
                    contrast = "Action 3 vs Action 1",
                    reward_dimension = k,
                    mean_CATE = mean(
                        cate31[, k]
                    ),
                    sd_CATE = sd(
                        cate31[, k]
                    ),
                    q025 = quantile(
                        cate31[, k],
                        0.025
                    ),
                    q975 = quantile(
                        cate31[, k],
                        0.975
                    )
                )

            counter <- counter + 1
        }
    }

    bind_rows(
        results
    )
}


# =============================================================================
# 24. POLICY MATRIX
# =============================================================================

create_policy_matrix <- function(
    actions
) {

    n <- nrow(
        actions
    )

    result <- vector(
        "list",
        T_STEPS
    )

    for (t in seq_len(T_STEPS)) {

        counts <- table(
            factor(
                actions[, t],
                levels = seq_len(
                    N_ACTIONS
                )
            )
        )

        result[[t]] <- tibble(
            time = t,
            action = seq_len(
                N_ACTIONS
            ),
            count = as.numeric(
                counts
            ),
            rate = as.numeric(
                counts
            ) / n
        )
    }

    bind_rows(
        result
    )
}


# =============================================================================
# 25. POLICY VALUE
# =============================================================================

calculate_policy_value <- function(
    rollout_result
) {

    tibble(
        discounted_policy_value =
            mean(
                rollout_result$discounted_returns
            ),

        discounted_policy_sd =
            sd(
                rollout_result$discounted_returns
            ),

        undiscounted_policy_value =
            mean(
                rollout_result$undiscounted_returns
            ),

        undiscounted_policy_sd =
            sd(
                rollout_result$undiscounted_returns
            )
    )
}


# =============================================================================
# 26. TRAINING FUNCTION
# =============================================================================

train_sequential_dqn <- function(
    X_train,
    X_valid,
    copula_fit,
    reward_scaling,
    rho,
    replay_method,
    seed
) {

    set.seed(
        seed
    )

    p <- ncol(
        X_train
    )

    channels <- 7

    # -------------------------------------------------------------------------
    # Initialize online and target networks.
    # -------------------------------------------------------------------------

    online_model <- build_dqn(
        T_steps = T_STEPS,
        p = p,
        channels = channels,
        n_actions = N_ACTIONS
    )

    target_model <- build_dqn(
        T_steps = T_STEPS,
        p = p,
        channels = channels,
        n_actions = N_ACTIONS
    )

    update_target_network(
        online_model,
        target_model
    )

    # -------------------------------------------------------------------------
    # Replay buffer.
    # -------------------------------------------------------------------------

    replay <- ReplayBuffer$new(
        REPLAY_CAPACITY
    )

    # -------------------------------------------------------------------------
    # Training history.
    # -------------------------------------------------------------------------

    history_df <- tibble(
        epoch = integer(),
        epsilon = numeric(),
        replay_size = integer(),
        loss = numeric(),
        validation_value = numeric(),
        validation_undiscounted = numeric()
    )

    best_validation <- -Inf

    best_weights <- NULL

    epsilon <- EPSILON_START

    # -------------------------------------------------------------------------
    # Epoch loop.
    # -------------------------------------------------------------------------

    for (epoch in seq_len(EPOCHS)) {

        epoch_seed <-
            seed +
            epoch

        # ---------------------------------------------------------------------
        # Collect new trajectories using the CURRENT policy.
        # ---------------------------------------------------------------------

        new_transitions <-
            collect_dqn_transitions(
                model = online_model,
                X_initial = X_train,
                copula_fit = copula_fit,
                reward_scaling = reward_scaling,
                rho = rho,
                epsilon = epsilon,
                n_episodes =
                    EPISODES_PER_EPOCH,
                seed = epoch_seed
            )

        # ---------------------------------------------------------------------
        # Add transitions to replay.
        # ---------------------------------------------------------------------

        for (tr in new_transitions) {

            replay$add(
                tr
            )
        }

        # ---------------------------------------------------------------------
        # Train from replay.
        # ---------------------------------------------------------------------

        losses <- numeric(
            0
        )

        if (
            replay$size >=
            MIN_REPLAY_SIZE
        ) {

            n_batches <- max(
                1,
                floor(
                    replay$size /
                    BATCH_SIZE
                )
            )

            for (b in seq_len(n_batches)) {

                batch <-
                    sample_replay(
                        replay = replay,
                        batch_size = BATCH_SIZE,
                        model = online_model,
                        method = replay_method
                    )

                fit_result <-
                    train_dqn_batch(
                        online_model =
                            online_model,
                        target_model =
                            target_model,
                        batch = batch
                    )

                if (
                    is.finite(
                        fit_result$loss
                    )
                ) {

                    losses <- c(
                        losses,
                        fit_result$loss
                    )
                }
            }
        }

        # ---------------------------------------------------------------------
        # Target network update.
        # ---------------------------------------------------------------------

        if (
            epoch %% TARGET_UPDATE_FREQ == 0
        ) {

            update_target_network(
                online_model,
                target_model
            )
        }

        # ---------------------------------------------------------------------
        # Validation rollout.
        # ---------------------------------------------------------------------

        validation_rollout <-
            rollout_policy(
                model = online_model,
                X_initial = X_valid,
                copula_fit = copula_fit,
                reward_scaling = reward_scaling,
                rho = rho,
                seed = seed + 10000
            )

        validation_value <-
            mean(
                validation_rollout$discounted_returns
            )

        validation_undiscounted <-
            mean(
                validation_rollout$undiscounted_returns
            )

        # ---------------------------------------------------------------------
        # Save best validation model.
        # ---------------------------------------------------------------------

        if (
            is.finite(validation_value) &&
            validation_value > best_validation
        ) {

            best_validation <-
                validation_value

            best_weights <-
                online_model$get_weights()
        }

        # ---------------------------------------------------------------------
        # Record training history.
        # ---------------------------------------------------------------------

        history_df <- bind_rows(
            history_df,
            tibble(
                epoch = epoch,
                epsilon = epsilon,
                replay_size =
                    replay$size,
                loss =
                    if (
                        length(losses) > 0
                    ) {
                        mean(losses)
                    } else {
                        NA_real_
                    },
                validation_value =
                    validation_value,
                validation_undiscounted =
                    validation_undiscounted
            )
        )

        # ---------------------------------------------------------------------
        # Epsilon decay.
        # ---------------------------------------------------------------------

        epsilon <- max(
            EPSILON_END,
            epsilon *
                EPSILON_DECAY
        )

        cat(
            sprintf(
                "Epoch %3d | epsilon = %.4f | replay = %4d | loss = %.6f | validation = %.6f\n",
                epoch,
                epsilon,
                replay$size,
                if (
                    length(losses) > 0
                ) {
                    mean(losses)
                } else {
                    NA_real_
                },
                validation_value
            )
        )
    }

    # -------------------------------------------------------------------------
    # Restore best validation model.
    # -------------------------------------------------------------------------

    if (
        !is.null(
            best_weights
        )
    ) {

        online_model$set_weights(
            best_weights
        )
    }

    list(
        model = online_model,
        target_model = target_model,
        replay = replay,
        history = history_df,
        best_validation =
            best_validation
    )
}


