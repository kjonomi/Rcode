# =============================================================================
# 5. STANDARDIZATION
# =============================================================================

fit_standardizer <- function(X) {

    X <- as.matrix(X)

    center <- colMeans(
        X,
        na.rm = TRUE
    )

    scale_value <- apply(
        X,
        2,
        sd,
        na.rm = TRUE
    )

    scale_value[
        !is.finite(scale_value) |
        scale_value < 1e-8
    ] <- 1

    list(
        center = center,
        scale = scale_value
    )
}


apply_standardizer <- function(
    X,
    standardizer
) {

    X <- as.matrix(X)

    sweep(
        sweep(
            X,
            2,
            standardizer$center,
            FUN = "-"
        ),
        2,
        standardizer$scale,
        FUN = "/"
    )
}


# =============================================================================
# 6. EMPIRICAL COPULA TRANSFORMATION
# =============================================================================

fit_copula <- function(X) {

    X <- as.matrix(X)

    sorted_columns <- vector(
        "list",
        ncol(X)
    )

    for (j in seq_len(ncol(X))) {

        sorted_columns[[j]] <- sort(
            X[, j]
        )
    }

    list(
        sorted_columns = sorted_columns,
        n = nrow(X)
    )
}


apply_copula <- function(
    X,
    copula_fit
) {

    X <- as.matrix(X)

    n <- nrow(X)

    p <- ncol(X)

    U <- matrix(
        0,
        nrow = n,
        ncol = p
    )

    for (j in seq_len(p)) {

        ref <- copula_fit$sorted_columns[[j]]

        ranks <- findInterval(
            X[, j],
            ref
        )

        ranks <- pmin(
            pmax(
                ranks,
                0
            ),
            length(ref)
        )

        U[, j] <- (
            ranks + 0.5
        ) / (
            length(ref) + 1
        )
    }

    Z <- qnorm(
        pmin(
            pmax(
                U,
                1e-6
            ),
            1 - 1e-6
        )
    )

    Z[
        !is.finite(Z)
    ] <- 0

    Z
}


