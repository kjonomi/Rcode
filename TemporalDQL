1. Helper Functions & Covariate Structuring
------------------------------------------------------------
Reorder covariates to ensure contiguous variables have semantic local relationships (R1.3, R2.5)
arrange_covariates_semantically <- function(df) {
Example logic: group numeric variables by correlation similarity
cor_mat <- abs(cor(df, use = "pairwise.complete.obs")) hc <- hclust(as.dist(1 - cor_mat)) ordered_cols <- colnames(df)[hc$order] return(df[, ordered_cols, drop = FALSE]) }
Generate Initial Longitudinal States
generate_initial_long <- function(df, n, T_steps) { p <- ncol(df) idxs <- sample(1:nrow(df), n, replace = TRUE) base_mat <- as.matrix(df[idxs, ]) X_long <- array(0, dim = c(n, T_steps, p)) for (t in 1:T_steps) { X_long[, t, ] <- base_mat + matrix(rnorm(n * p, 0, 0.01), n, p) } return(X_long) }
Treatment Assignment Mechanism
assign_treatment_multistage <- function(X_long, cov_idx = 1, strength = 6) { n <- dim(X_long)[1]; T_steps <- dim(X_long)[2] A <- matrix(0, nrow = n, ncol = T_steps) for (t in 1:T_steps) { logits <- apply(X_long[, t, cov_idx, drop = FALSE], 1, mean) - 0.5 A[, t] <- rbinom(n, 1, plogis(strength * logits)) } return(A) }
Generate Outcomes with Valid Covariance Matrix Boundary (R1.6, R2.3)
generate_multistage_outcomes <- function(X_long, A_matrix, n_outcomes = 6, rho = 0.5, phi = 0.6, base_noise_sd = 0.05) { n <- dim(X_long)[1]; T_steps <- dim(X_long)[2]; p <- dim(X_long)[3]
Ensure valid correlation boundary for d outcomes: rho > -1/(d-1)
min_rho_bound <- -1 / (n_outcomes - 1) + 0.01 if (rho < min_rho_bound) { warning(sprintf("Requested rho=%.3f violates positive-definiteness for d=%d. Adjusting to %.3f", rho, n_outcomes, min_rho_bound)) rho <- min_rho_bound }
Sigma <- matrix(rho, n_outcomes, n_outcomes) diag(Sigma) <- 1.0 if (any(eigen(Sigma)$values <= 0)) {
Sigma <- as.matrix(nearPD(Sigma)$mat) } L <- t(chol(Sigma)) # Lower triangular Cholesky
Y <- array(0, dim = c(n, T_steps, n_outcomes)) for (k in 1:n_outcomes) { feat_idx <- ((k - 1) %% p) + 1 Y[, 1, k] <- as.numeric(X_long[, 1, feat_idx]) + rnorm(n, 0, base_noise_sd) }
tau_fun <- function(x_row, k) { coef_vec <- sin(seq_len(length(x_row)) + k) * (0.2 + 0.05 * k) 0.2 * tanh(sum(coef_vec * x_row)) }
for (t in 2:T_steps) { # Noise vector generation z <- matrix(rnorm(n * n_outcomes, 0, base_noise_sd), nrow = n_outcomes, ncol = n) noise_raw <- t(L %*% z)
for (k in 1:n_outcomes) {
  feat_idx <- ((k - 1) %% p) + 1
  f_xt <- as.numeric(X_long[, t, feat_idx])
  tau_vec <- apply(X_long[, t, , drop = FALSE], 1, function(r) tau_fun(as.numeric(r), k))
  Y[, t, k] <- phi * Y[, t - 1, k] + f_xt + tau_vec * A_matrix[, t] + noise_raw[, k]
}
} return(Y) }
Empirical Copula Transformation
empirical_copula_multistage <- function(Y_array) { n <- dim(Y_array)[1]; T_steps <- dim(Y_array)[2]; n_outcomes <- dim(Y_array)[3] Y_cop <- array(0, dim = c(n, T_steps, n_outcomes)) for (t in 1:T_steps) { for (k in 1:n_outcomes) { col <- Y_array[, t, k] Y_cop[, t, k] <- rank(col, ties.method = "average") / length(col) } } return(Y_cop) }
