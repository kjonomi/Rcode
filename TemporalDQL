3. Main Training Execution Function (Single Run)
------------------------------------------------------------
run_single_dqn_experiment <- function(df, T_steps = 8, n_outcomes = 6, rho = 0.5, replay_mode = "Q-DWR", n = 200, episodes = 30, gamma = 0.95, alpha = 0.001, beta = 0.40) {
df_sem <- arrange_covariates_semantically(df) p <- ncol(df_sem) X_long <- generate_initial_long(df_sem, n, T_steps)
Standardize
for (j in 1:p) for (t in 1:T_steps) { mu <- mean(X_long[, t, j]); s <- sd(X_long[, t, j]); if (s == 0) s <- 1 X_long[, t, j] <- (X_long[, t, j] - mu) / s }
A_true <- assign_treatment_multistage(X_long, cov_idx = 1, strength = 6) Y_array <- generate_multistage_outcomes(X_long, A_true, n_outcomes = n_outcomes, rho = rho) Y_cop <- empirical_copula_multistage(Y_array)
model <- build_dqn(c(T_steps, p), lr = alpha) buffer <- PrioritizedBuffer$new(capacity = 3000, alpha = 0.6)
policy_matrix_learned <- matrix(0, nrow = n, ncol = T_steps) episode_rewards <- numeric(episodes) epsilon <- 1.0; epsilon_decay <- 0.95; epsilon_min <- 0.05
for (ep in 1:episodes) { total_reward_ep <- rep(0, n) S <- X_long
for (t in 1:T_steps) {
  # Action selection & Q-dispersion calculation
  q_all <- model %>% predict(S, verbose = 0) # n x 2
  
  # Cross-action Q-value dispersion (R1.1, R2.2)
  q_dispersion <- abs(q_all[, 2] - q_all[, 1])
  
  greedy_actions <- apply(q_all, 1, which.max) - 1
  rnd <- runif(n)
  actions <- ifelse(rnd < epsilon, rbinom(n, 1, 0.5), greedy_actions)
  
  rewards_mean_outcome <- rowMeans(Y_cop[, t, , drop = FALSE])
  r_vec <- rewards_mean_outcome * actions
  
  S_next <- S
  if (T_steps > 1) S_next[, 1:(T_steps - 1), ] <- S_next[, 2:T_steps, ]
  S_next[, T_steps, ] <- S[, T_steps, ]
  
  # Push transitions into priority buffer
  for (i in 1:n) {
    s_i <- array_reshape(S[i, , ], dim = c(1, T_steps, p))
    s_next_i <- array_reshape(S_next[i, , ], dim = c(1, T_steps, p))
    
    init_p <- if (replay_mode == "Q-DWR") q_dispersion[i] else 1.0
    buffer$push(s_i, actions[i], r_vec[i], s_next_i, (t == T_steps), initial_priority = init_p)
  }
  
  total_reward_ep <- total_reward_ep + (gamma^(t - 1)) * r_vec
  policy_matrix_learned[, t] <- actions
  
  # Batch Update
  sampled <- buffer$sample(batch_size = 64, beta = beta, mode = replay_mode)
  if (!is.null(sampled)) {
    bsize <- length(sampled$batch)
    s_batch <- array(0, dim = c(bsize, T_steps, p))
    s_next_batch <- array(0, dim = c(bsize, T_steps, p))
    target_qs <- array(0, dim = c(bsize, 2))
    
    for (ii in seq_len(bsize)) {
      s_batch[ii, , ] <- sampled$batch[[ii]]$s
      s_next_batch[ii, , ] <- sampled$batch[[ii]]$s_next
    }
    
    q_curr <- model %>% predict(s_batch, verbose = 0)
    q_next <- model %>% predict(s_next_batch, verbose = 0)
    
    td_errors <- numeric(bsize)
    new_priorities <- numeric(bsize)
    
    for (ii in seq_len(bsize)) {
      a_i <- sampled$batch[[ii]]$a
      r_i <- sampled$batch[[ii]]$r
      done_i <- sampled$batch[[ii]]$done
      
      target <- if (!done_i) r_i + gamma * max(q_next[ii, ]) else r_i
      td_errors[ii] <- abs(target - q_curr[ii, a_i + 1])
      
      q_curr[ii, a_i + 1] <- target
      target_qs[ii, ] <- q_curr[ii, ]
      
      # Assign updated priorities based on strategy (R1.2)
      if (replay_mode == "PER") {
        new_priorities[ii] <- td_errors[ii]
      } else if (replay_mode == "Q-DWR") {
        new_priorities[ii] <- abs(q_curr[ii, 2] - q_curr[ii, 1])
      } else {
        new_priorities[ii] <- 1.0
      }
    }
    
    buffer$update_priorities(sampled$indices, new_priorities)
    keras::train_on_batch(model, x = s_batch, y = target_qs, sample_weight = sampled$weights)
  }
  
  S <- S_next
}

episode_rewards[ep] <- mean(total_reward_ep)
epsilon <- max(epsilon * epsilon_decay, epsilon_min)
}
list( final_reward = tail(episode_rewards, 1), mean_reward = mean(episode_rewards), policy_corr = mean(cor(policy_matrix_learned)[upper.tri(cor(policy_matrix_learned))]) ) }
