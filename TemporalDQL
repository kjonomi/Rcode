4. Multi-Seed Robustness Evaluation Framework (R1.5, R2.4)
------------------------------------------------------------
evaluate_multi_seed <- function(df, seeds = c(123, 456, 789), rho = 0.5, replay_mode = "Q-DWR") { results <- list() for (s in seeds) { set.seed(s) tensorflow::set_random_seed(s) res <- run_single_dqn_experiment(df, rho = rho, replay_mode = replay_mode, episodes = 20) results[[length(results) + 1]] <- res }
final_rewards <- sapply(results, function(x) xfinalreward)meanrewards<-sapply(results,function(x)xmean_reward)
data.frame( ReplayMode = replay_mode, Rho = rho, FinalReward_Mean = mean(final_rewards), FinalReward_SE = sd(final_rewards) / sqrt(length(seeds)), AvgReward_Mean = mean(mean_rewards), AvgReward_SE = sd(mean_rewards) / sqrt(length(seeds)) ) }
