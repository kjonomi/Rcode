2. DQN Architecture & Prioritized Buffer Framework
------------------------------------------------------------
build_dqn <- function(input_shape, lr = 1e-3) { inputs <- layer_input(shape = input_shape) outputs <- inputs %>% layer_conv_1d(filters = 32, kernel_size = 3, activation = "relu", padding = "same") %>% layer_max_pooling_1d(pool_size = 2) %>% layer_lstm(units = 32, return_sequences = FALSE) %>% layer_dense(units = 32, activation = "relu") %>% layer_dense(units = 2, activation = "linear")
model <- keras_model(inputs = inputs, outputs = outputs) model %>% compile( optimizer = optimizer_adam(learning_rate = lr), loss = "mse" ) return(model) }
Prioritized Experience Replay Class (Supports UWR, PER, Q-DWR) (R1.2, R1.4, R2.1)
PrioritizedBuffer <- R6::R6Class("PrioritizedBuffer", public = list( capacity = NULL, memory = NULL, priorities = NULL, pos = 1, alpha = 0.6,
initialize = function(capacity, alpha = 0.6) {
  self$capacity <- capacity
  self$alpha <- alpha
  self$memory <- list()
  self$priorities <- numeric(0)
},

push = function(s, a, r, s_next, done, initial_priority = 1.0) {
  entry <- list(s = s, a = a, r = r, s_next = s_next, done = done)
  max_p <- if (length(self$priorities) > 0) max(self$priorities, na.rm = TRUE) else 1.0
  p <- ifelse(is.null(initial_priority) || is.na(initial_priority), max_p, initial_priority)
  
  if (length(self$memory) < self$capacity) {
    self$memory[[length(self$memory) + 1]] <- entry
    self$priorities <- c(self$priorities, p)
  } else {
    self$memory[[self$pos]] <- entry
    self$priorities[self$pos] <- p
    self$pos <- ifelse(self$pos == self$capacity, 1, self$pos + 1)
  }
},

sample = function(batch_size, beta = 0.40, mode = "Q-DWR") {
  n_mem <- length(self$memory)
  if (n_mem == 0) return(NULL)
  
  if (mode == "UWR") {
    probs <- rep(1 / n_mem, n_mem)
  } else {
    scaled_p <- self$priorities^self$alpha
    probs <- scaled_p / sum(scaled_p)
  }
  
  indices <- sample(seq_len(n_mem), min(n_mem, batch_size), replace = FALSE, prob = probs)
  
  # Importance Sampling Weights (R1.4)
  weights <- (n_mem * probs[indices])^(-beta)
  weights <- weights / max(weights)
  
  list(indices = indices, batch = self$memory[indices], weights = weights)
},

update_priorities = function(indices, new_priorities) {
  self$priorities[indices] <- new_priorities + 1e-5
}
) )
