    )

    ##########################################################################
    # NO COPULA
    ##########################################################################

    fit_raw <- tryCatch(

        fit_method(
            sim_data,
            method = "No-Copula",
            tau = TAU,
            weights = WEIGHTS,
            verbose = FALSE
        ),

        error = function(e) {

            cat(
                "No-Copula failed:",
                conditionMessage(e),
                "\n"
            )

            NULL

        }

    )

    ##########################################################################
    # EVALUATION
    ##########################################################################

    eval_cop <- evaluate_method(
        fit_cop,
        sim_data
    )

    eval_raw <- evaluate_method(
        fit_raw,
        sim_data
    )

    ##########################################################################
    # FAILURE LOG
    ##########################################################################

    cop_failed <- is.null(
        eval_cop
    )

    raw_failed <- is.null(
        eval_raw
    )

    cop_valid_n <- if (
        !is.null(eval_cop)
    ) {

        eval_cop$Valid_N

    } else {

        0L

    }

    raw_valid_n <- if (
        !is.null(eval_raw)
    ) {

        eval_raw$Valid_N

    } else {

        0L

    }

    failure_log <- rbind(

        failure_log,

        data.frame(

            Replication = r,

            Copula_Failed = cop_failed,

            NoCopula_Failed = raw_failed,

            Max_Observed_Time = max_time,

            Censoring_Proportion = censor_prop,

            True_Treatment1_Rate =
