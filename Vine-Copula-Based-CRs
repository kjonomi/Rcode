################################################################################
# REAL-DATA APPLICATION
#
# VINE-COPULA vs NO-COPULA INDIVIDUALIZED TREATMENT DECISION-MAKING
# WITH COMPETING RISKS
#
# DATA:
#     survival::pbc
#
# REAL-DATA DESIGN:
#
#     Treatment:
#         trt = 1 : D-penicillamine
#         trt = 2 : placebo
#
#     Cause 1:
#         transplantation
#
#     Cause 2:
#         death
#
#     Censoring:
#         status = 0
#
# IMPORTANT:
#
#     Only subjects with randomized treatment assignment are used.
#     The observational subjects in survival::pbc have trt = NA and
#     are therefore excluded.
#
# METHODS:
#
#     1. Vine-Copula + CSC
#     2. No-Copula + CSC
#
# OUTCOME:
#
#     Cause-specific cumulative incidence functions at TAU.
#
# POLICY:
#
#     Estimated treatment contrast:
#
#         CATE(X) =
#             V_1(X) - V_0(X)
#
#     where
#
#         V_a(X)
#           = - w1 * CIF_1,a(TAU | X)
#             - w2 * CIF_2,a(TAU | X)
#
#     Higher value = better individualized treatment choice.
#
# REAL-DATA POLICY EVALUATION:
#
#     Because counterfactual outcomes are unavailable in real data,
#     policy values are estimated using inverse-probability weighting.
#
################################################################################


################################################################################
# 0. PACKAGES
################################################################################

required_packages <- c(
    
    "survival",
    "riskRegression",
    "prodlim",
    "VineCopula",
    "ggplot2",
    "dplyr",
    "tidyr"
    
)

for (pkg in required_packages) {
    
    if (!requireNamespace(pkg, quietly = TRUE)) {
        
        install.packages(pkg)
        
    }
    
}


library(survival)
library(riskRegression)
library(prodlim)
library(VineCopula)
library(ggplot2)
library(dplyr)
library(tidyr)


