################################################################################
# 29. SUMMARY FUNCTION
################################################################################

summarize_metric <- function(
        data,
        metric_name
) {

    if (
        !metric_name %in%
        names(data)
    ) {

        return(
            data.frame(
                Metric = metric_name,
                Method = character(0),
                N_Replications = integer(0),
                Mean = numeric(0),
                SD = numeric(0),
                MCSE = numeric(0),
                Lower95 = numeric(0),
                Upper95 = numeric(0)
            )
        )

    }

    method_values <- split(
        data[[metric_name]],
        data$Method
    )

    result_list <- lapply(

        names(method_values),

        function(m) {

            x <- method_values[[m]]

            x <- x[
                is.finite(x)
            ]

            n <- length(x)

            mn <- if (
                n > 0
            ) {

                mean(x)

            } else {

                NA_real_

            }

            s <- if (
                n >= 2
            ) {

                sd(x)

            } else {

                NA_real_

            }

            mcse <- if (
                is.finite(s) &&
                n > 0
            ) {

                s / sqrt(n)

            } else {

                NA_real_

            }

            lower <- if (
                is.finite(mcse)
            ) {

                mn - 1.96 * mcse

            } else {

                NA_real_

            }

            upper <- if (
                is.finite(mcse)
            ) {

                mn + 1.96 * mcse

            } else {

                NA_real_

            }

            data.frame(

                Metric = metric_name,

                Method = m,

                N_Replications = n,

                Mean = mn,

                SD = s,

                MCSE = mcse,

                Lower95 = lower,

                Upper95 = upper,

                stringsAsFactors = FALSE

            )

        }

    )

    bind_rows(
        result_list
    )

}


