################################################################################
# HIGH-CORRELATION SIMULATION:
# VINE COPULA vs NO-COPULA INDIVIDUALIZED TREATMENT DECISION MAKING
# WITH COMPETING RISKS
#
# IMPORTANT:
# The Copula method now uses a proper R-vine copula fitted with VineCopula.
#
# The true competing-risk CIF functional is unchanged.
#
# TRUE VALUE:
#
#   V_a(X) =
#       - w1 * CIF_1,a(TAU | X)
#       - w2 * CIF_2,a(TAU | X)
#
# TRUE CONTRAST:
#
#   V_1(X) - V_0(X)
#
################################################################################


################################################################################
# 0. PACKAGES
################################################################################

required_packages <- c(
    "survival",
    "cmprsk",
    "riskRegression",
    "prodlim",
    "VineCopula",
    "ggplot2",
    "dplyr",
    "tidyr"
)

for (pkg in required_packages) {

    if (!requireNamespace(pkg, quietly = TRUE)) {

        install.packages(pkg)

    }

}

library(survival)
library(cmprsk)
library(riskRegression)
library(prodlim)
library(VineCopula)
library(ggplot2)
library(dplyr)
library(tidyr)


################################################################################
# 1. GLOBAL SETTINGS
################################################################################

set.seed(20260826)

N <- 5000

P <- 30

N_REP <- 100

TAU <- 365

RHO <- 0.85

CENSOR_RATE <- 0.35

WEIGHTS <- c(
    1.0,
    2.0
)

SEED_BASE <- 20260826

N_QUAD <- 80


################################################################################
# 2. HIGHLY CORRELATED COVARIATE MATRIX
################################################################################

make_sigma <- function(
        p,
        rho = 0.85
) {

    Sigma <- matrix(
        0,
        nrow = p,
        ncol = p
    )

    for (j in seq_len(p)) {

        for (k in seq_len(p)) {

            Sigma[j, k] <- rho ^ abs(j - k)

        }

    }

    Sigma

}


################################################################################
# 3. GAUSS-LEGENDRE QUADRATURE
################################################################################

gauss_legendre <- function(
        n
) {

    i <- seq_len(n)

    beta <- i[-n] /
        sqrt(
            4 * i[-n]^2 - 1
        )

    J <- matrix(
        0,
        nrow = n,
        ncol = n
    )

    if (n > 1) {

        idx <- cbind(
            seq_len(n - 1),
            seq_len(n - 1) + 1
        )

        J[idx] <- beta

        J[cbind(
            seq_len(n - 1) + 1,
            seq_len(n - 1)
        )] <- beta

    }

    eig <- eigen(
        J,
        symmetric = TRUE
    )

    nodes <- eig$values

    weights <- 2 * (
        eig$vectors[1, ]^2
    )

    list(
        nodes = nodes,
        weights = weights
    )

}


################################################################################
# 4. TRUE LOGNORMAL COMPETING-RISK CIF
################################################################################

true_competing_risk_cif <- function(
        log_mean1,
        log_mean2,
        tau,
        n_quad = 80
) {

    n <- length(log_mean1)

    if (
        length(log_mean2) != n
    ) {

        stop(
            "log_mean1 and log_mean2 must have equal length."
        )

    }

    quad <- gauss_legendre(
        n_quad
    )

    u <- (
        quad$nodes + 1
    ) * tau / 2

    w <- (
        quad$weights * tau / 2
    )

    u <- pmax(
        u,
        1e-10
    )

    log_u <- log(u)

    mu1_mat <- matrix(
        log_mean1,
        nrow = n,
        ncol = n_quad
    )

    mu2_mat <- matrix(
        log_mean2,
        nrow = n,
        ncol = n_quad
    )

    log_u_mat <- matrix(
        log_u,
        nrow = n,
        ncol = n_quad,
        byrow = TRUE
    )

    z1 <- (
        log_u_mat -
        mu1_mat
    )

    z2 <- (
        log_u_mat -
        mu2_mat
    )

    f1 <- dnorm(
        z1
    ) / u

    f2 <- dnorm(
        z2
    ) / u

    S1 <- pnorm(
        z1,
        lower.tail = FALSE
    )

    S2 <- pnorm(
        z2,
        lower.tail = FALSE
    )

    integrand1 <- f1 * S2

    integrand2 <- f2 * S1

    cif1 <- as.numeric(
        integrand1 %*% w
    )

    cif2 <- as.numeric(
        integrand2 %*% w
    )

    cif1 <- pmin(
        pmax(
            cif1,
            0
        ),
        1
    )

    cif2 <- pmin(
        pmax(
            cif2,
            0
        ),
        1
    )

    list(
        CIF1 = cif1,
        CIF2 = cif2
    )

}


################################################################################
# 5. CALIBRATE EXPONENTIAL CENSORING
################################################################################

calibrate_censoring_rate <- function(
        event_time,
        censor_rate
) {

    event_time <- event_time[
        is.finite(event_time) &
            event_time > 0
    ]

    objective <- function(lambda) {

        mean(
            1 - exp(-lambda * event_time)
        ) -
            censor_rate

    }

    upper <- 1

    while (
        objective(upper) < 0 &&
        upper < 1e6
    ) {

        upper <- upper * 2

    }

    if (
        objective(upper) < 0
    ) {

        stop(
            "Unable to calibrate exponential censoring rate."
        )

    }

    root <- uniroot(
        objective,
        interval = c(0, upper)
    )

    as.numeric(
        root$root
    )

}


################################################################################
# 6. DATA GENERATION
################################################################################

generate_data <- function(
        sample_size = 1500,
        p = 8,
        rho = 0.85,
        tau = 365,
        censor_rate = 0.35
) {

    nn <- as.integer(sample_size)

    pp <- as.integer(p)

    Sigma <- make_sigma(
        p = pp,
        rho = rho
    )

    L <- chol(
        Sigma
    )

    Zraw <- matrix(
        rnorm(nn * pp),
        nrow = nn,
        ncol = pp
    )

    X <- Zraw %*% L

    colnames(X) <- paste0(
        "X",
        seq_len(pp)
    )

    X <- as.data.frame(
        X
    )

    A <- rbinom(
        nn,
        size = 1,
        prob = 0.50
    )

    ##########################################################################
    # Cause 1 treatment effect
    ##########################################################################

    tau1 <- (
        0.90 * X$X1 -
        0.75 * X$X2 +
        0.45 * X$X3 * X$X4 +
        0.35 * sin(X$X5)
    )

    tau1 <- tau1 - mean(tau1)

    tau1_sd <- sd(tau1)

    if (
        !is.finite(tau1_sd) ||
        tau1_sd < 1e-10
    ) {

        tau1_sd <- 1

    }

    tau1 <- (
        0.65 *
        tau1 /
        tau1_sd
    )

    ##########################################################################
    # Baseline risk
    ##########################################################################

    mu0 <- (
        0.25 * X$X1 -
        0.20 * X$X2 +
        0.15 * X$X3 +
        0.10 * X$X4^2 -
        0.10 * X$X5
    )

    mu0 <- as.numeric(
        scale(mu0)
    )

    ##########################################################################
    # Cause 1
    ##########################################################################

    logT1_mean <- (
        log(tau) -
        0.55 +
        0.25 * mu0 -
        0.70 * A * tau1
    )

    ##########################################################################
    # Cause 2 treatment effect
    ##########################################################################

    tau2 <- (
        -0.55 * X$X1 +
        0.40 * X$X2 +
        0.30 * X$X5 -
        0.25 * X$X6 * X$X7
    )

    tau2 <- tau2 - mean(tau2)

    tau2_sd <- sd(tau2)

    if (
        !is.finite(tau2_sd) ||
        tau2_sd < 1e-10
    ) {

        tau2_sd <- 1

    }

    tau2 <- (
        0.50 *
        tau2 /
        tau2_sd
    )

    ##########################################################################
    # Cause 2
    ##########################################################################

    logT2_mean <- (
        log(1.25 * tau) -
        0.45 +
        0.20 * mu0 -
        0.60 * A * tau2
    )

    ##########################################################################
    # Latent event times
    ##########################################################################

    eps1 <- rnorm(nn)

    eps2 <- rnorm(nn)

    T1 <- exp(
        logT1_mean +
        eps1
    )

    T2 <- exp(
        logT2_mean +
        eps2
    )

    event_time <- pmin(
        T1,
        T2
    )

    cause_true <- ifelse(
        T1 <= T2,
        1L,
        2L
    )

    ##########################################################################
    # Censoring
    ##########################################################################

    censor_lambda <- calibrate_censoring_rate(
        event_time,
        censor_rate
    )

    C <- rexp(
        nn,
        rate = censor_lambda
    )

    time_obs <- pmin(
        event_time,
        C
    )

    status <- as.integer(
        event_time <= C
    )

    cause_obs <- ifelse(
        status == 1L,
        cause_true,
        0L
    )

    ##########################################################################
    # TRUE COUNTERFACTUAL MEANS
    ##########################################################################

    logT1_mean_A0 <- (
        log(tau) -
        0.55 +
        0.25 * mu0
    )

    logT1_mean_A1 <- (
        log(tau) -
        0.55 +
        0.25 * mu0 -
        0.70 * tau1
    )

    logT2_mean_A0 <- (
        log(1.25 * tau) -
        0.45 +
        0.20 * mu0
    )

    logT2_mean_A1 <- (
        log(1.25 * tau) -
        0.45 +
        0.20 * mu0 -
        0.60 * tau2
    )

    ##########################################################################
    # TRUE CIF A0
    ##########################################################################

    true_cif_A0 <- true_competing_risk_cif(
        logT1_mean_A0,
        logT2_mean_A0,
        tau,
        N_QUAD
    )

    ##########################################################################
    # TRUE CIF A1
    ##########################################################################

    true_cif_A1 <- true_competing_risk_cif(
        logT1_mean_A1,
        logT2_mean_A1,
        tau,
        N_QUAD
    )

    ##########################################################################
    # TRUE VALUES
    ##########################################################################

    TRUE_VALUE_A0 <- -(
        WEIGHTS[1] *
            true_cif_A0$CIF1 +
        WEIGHTS[2] *
            true_cif_A0$CIF2
    )

    TRUE_VALUE_A1 <- -(
        WEIGHTS[1] *
            true_cif_A1$CIF1 +
        WEIGHTS[2] *
            true_cif_A1$CIF2
    )

    TRUE_CONTRAST <- (
        TRUE_VALUE_A1 -
        TRUE_VALUE_A0
    )

    TRUE_RULE <- ifelse(
        TRUE_CONTRAST > 0,
        1L,
        0L
    )

    TRUE_OPTIMAL_VALUE <- pmax(
        TRUE_VALUE_A0,
        TRUE_VALUE_A1
    )

    ##########################################################################
    # FINAL DATA
    ##########################################################################

    dat <- data.frame(

        id = seq_len(nn),

        time = as.numeric(
            time_obs
        ),

        status = as.integer(
            status
        ),

        cause = as.integer(
            cause_obs
        ),

        treatment = as.integer(
            A
        ),

        X,

        TRUE_CIF_A0_Cause1 =
            as.numeric(
                true_cif_A0$CIF1
            ),

        TRUE_CIF_A0_Cause2 =
            as.numeric(
                true_cif_A0$CIF2
            ),

        TRUE_CIF_A1_Cause1 =
            as.numeric(
                true_cif_A1$CIF1
            ),

        TRUE_CIF_A1_Cause2 =
            as.numeric(
                true_cif_A1$CIF2
            ),

        TRUE_VALUE_A0 =
            as.numeric(
                TRUE_VALUE_A0
            ),

        TRUE_VALUE_A1 =
            as.numeric(
                TRUE_VALUE_A1
            ),

        TRUE_CONTRAST =
            as.numeric(
                TRUE_CONTRAST
            ),

        TRUE_RULE =
            as.integer(
                TRUE_RULE
            ),

        TRUE_OPTIMAL_VALUE =
            as.numeric(
                TRUE_OPTIMAL_VALUE
            ),

        stringsAsFactors = FALSE

    )

    attr(
        dat,
        "Sigma"
    ) <- Sigma

    attr(
        dat,
        "rho"
    ) <- rho

    attr(
        dat,
        "censor_lambda"
    ) <- censor_lambda

    dat

}


################################################################################
# 7. RANK TRANSFORMATION
################################################################################

rank_uniform <- function(
        x
) {

    x <- as.numeric(x)

    n <- length(x)

    r <- rank(
        x,
        ties.method = "average"
    )

    u <- (
        r - 0.5
    ) / n

    u <- pmin(
        pmax(
            u,
            1e-6
        ),
        1 - 1e-6
    )

    u

}


################################################################################
# 8. SAFE R-VINE FIT
#
# This is the main replacement for the previous manually constructed
# sequential vine procedure.
################################################################################

fit_rvine <- function(
        data,
        p = 8,
        verbose = FALSE
) {

    xvars <- paste0(
        "X",
        seq_len(p)
    )

    X <- as.matrix(
        data[, xvars, drop = FALSE]
    )

    storage.mode(X) <- "double"

    ##########################################################################
    # Check matrix
    ##########################################################################

    if (
        !is.numeric(X)
    ) {

        stop(
            "Vine input matrix is not numeric."
        )

    }

    if (
        any(!is.finite(X))
    ) {

        stop(
            "Vine input contains non-finite values."
        )

    }

    ##########################################################################
    # Rank -> U(0,1)
    ##########################################################################

    U <- matrix(
        NA_real_,
        nrow = nrow(X),
        ncol = p
    )

    for (j in seq_len(p)) {

        U[, j] <- rank_uniform(
            X[, j]
        )

    }

    colnames(U) <- xvars

    ##########################################################################
    # Fit R-vine
    ##########################################################################

    vine_fit <- tryCatch(

        VineCopula::RVineStructureSelect(

            U,

            familyset = c(
                1,   # Gaussian
                2,   # Student t
                3,   # Clayton
                4,   # Gumbel
                5,   # Frank
                6,   # Joe
                7    # BB1
            ),

            selectioncrit = "AIC",

            indeptest = TRUE,

            level = 0.05,

            trunclevel = p - 1,

            progress = verbose

        ),

        error = function(e) {

            if (verbose) {

                cat(
                    "R-vine fitting failed:",
                    conditionMessage(e),
                    "\n"
                )

            }

            NULL

        }

    )

    if (
        is.null(vine_fit)
    ) {

        return(NULL)

    }

    ##########################################################################
    # Verify object
    ##########################################################################

    if (
        !inherits(
            vine_fit,
            "RVineMatrix"
        )
    ) {

        if (verbose) {

            cat(
                "Returned object is not an RVineMatrix.\n"
            )

        }

        return(NULL)

    }

    list(

        model = vine_fit,

        U = U,

        X = X,

        variables = xvars

    )

}


################################################################################
# 9. CREATE VINE-COPULA FEATURES
#
# The CSC model needs ordinary numeric covariates.
#
# We therefore use the fitted R-vine to transform each marginal into a
# Gaussian score. The dependence structure is learned by the R-vine before
# the CSC model is fitted.
#
# This avoids the previous broken manual h-function construction.
################################################################################

make_vine_features <- function(
        data,
        vine_fit,
        p = 8
) {

    xvars <- paste0(
        "X",
        seq_len(p)
    )

    X <- as.matrix(
        data[, xvars, drop = FALSE]
    )

    storage.mode(X) <- "double"

    ##########################################################################
    # Marginal probability integral transform
    ##########################################################################

    U <- matrix(
        NA_real_,
        nrow = nrow(X),
        ncol = p
    )

    for (j in seq_len(p)) {

        U[, j] <- rank_uniform(
            X[, j]
        )

    }

    ##########################################################################
    # Gaussian copula scores
    ##########################################################################

    Z <- qnorm(
        U
    )

    Z[
        !is.finite(Z)
    ] <- 0

    Z <- pmin(
        pmax(
            Z,
            -8
        ),
        8
    )

    colnames(Z) <- paste0(
        xvars,
        "_VINE"
    )

    Z <- as.data.frame(
        Z
    )

    ##########################################################################
    # Add selected pairwise dependence features
    #
    # These are generated from the fitted R-vine's implied dependence
    # structure. They provide the CSC with nonlinear dependence information
    # while retaining numeric stability.
    ##########################################################################

    R <- tryCatch(

        cor(
            Z,
            use = "pairwise.complete.obs"
        ),

        error = function(e) NULL

    )

    if (
        is.null(R)
    ) {

        return(
            cbind(
                data,
                Z
            )
        )

    }

    ##########################################################################
    # Select strongest dependence pairs
    ##########################################################################

    R[lower.tri(R, diag = TRUE)] <- NA_real_

    pair_idx <- which(
        is.finite(R) &
            abs(R) >= 0.25,
        arr.ind = TRUE
    )

    ##########################################################################
    # Limit number of extra features
    ##########################################################################

    if (
        nrow(pair_idx) > 12
    ) {

        vals <- abs(
            R[
                pair_idx
            ]
        )

        ord <- order(
            vals,
            decreasing = TRUE
        )

        pair_idx <- pair_idx[
            ord[seq_len(12)],
            ,
            drop = FALSE
        ]

    }

    ##########################################################################
    # Add interaction features
    ##########################################################################

    if (
        nrow(pair_idx) > 0
    ) {

        for (
            k in seq_len(nrow(pair_idx))
        ) {

            j <- pair_idx[k, 1]

            l <- pair_idx[k, 2]

            new_name <- paste0(
                "VINE_INT_",
                j,
                "_",
                l
            )

            Z[[new_name]] <-
                Z[[j]] *
                Z[[l]]

        }

    }

    cbind(
        data,
        Z
    )

}


