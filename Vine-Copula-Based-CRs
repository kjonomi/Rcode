################################################################################
# 16. GAUSS-LEGENDRE QUADRATURE
################################################################################
#
# Retained for compatibility with the simulation framework.
# It is not required to calculate a true CIF in the real-data analysis,
# because the real-data CIF is estimated directly by CSC.
#
################################################################################

gauss_legendre <- function(n) {

    i <- seq_len(n)

    beta <- i[-n] /
        sqrt(
            4 * i[-n]^2 - 1
        )

    J <- matrix(
        0,
        nrow = n,
        ncol = n
    )

    if (n > 1) {

        idx <- cbind(
            seq_len(n - 1),
            seq_len(n - 1) + 1
        )

        J[idx] <- beta

        J[cbind(
            seq_len(n - 1) + 1,
            seq_len(n - 1)
        )] <- beta

    }

    eig <- eigen(
        J,
        symmetric = TRUE
    )

    nodes <- eig$values

    weights <- 2 *
        eig$vectors[1, ]^2

    list(
        nodes = nodes,
        weights = weights
    )

}


################################################################################
# 17. RANK TRANSFORMATION
################################################################################

rank_uniform <- function(x) {

    x <- as.numeric(
        x
    )

    n <- length(x)

    r <- rank(
        x,
        ties.method = "average"
    )

    u <- (
        r - 0.5
    ) / n

    u <- pmin(
        pmax(
            u,
            1e-6
        ),
        1 - 1e-6
    )

    u

}


################################################################################
# 18. FIT R-VINE COPULA
################################################################################

fit_rvine <- function(
        data,
        covariate_names,
        verbose = FALSE
) {

    X <- as.matrix(
        data[
            ,
            covariate_names,
            drop = FALSE
        ]
    )

    storage.mode(X) <- "double"


    ##########################################################################
    # Check matrix
    ##########################################################################

    if (
        any(
            !is.finite(X)
        )
    ) {

        stop(
            "Vine input contains non-finite values."
        )

    }


    ##########################################################################
    # Remove zero-variance columns
    ##########################################################################

    variances <- apply(
        X,
        2,
        var,
        na.rm = TRUE
    )

    keep <- is.finite(
        variances
    ) &
        variances > 1e-10

    if (
        sum(keep) < 2
    ) {

        stop(
            "Too few nonconstant covariates for vine fitting."
        )

    }

    X <- X[
        ,
        keep,
        drop = FALSE
    ]

    used_names <- colnames(
        X
    )


    ##########################################################################
    # Rank transformation
    ##########################################################################

    U <- matrix(
        NA_real_,
        nrow = nrow(X),
        ncol = ncol(X)
    )

    for (j in seq_len(ncol(X))) {

        U[, j] <- rank_uniform(
            X[, j]
        )

    }

    colnames(U) <- used_names


    ##########################################################################
    # R-vine structure selection
    ##########################################################################

    vine_fit <- tryCatch(

        VineCopula::RVineStructureSelect(

            U,

            familyset = c(
                1,   # Gaussian
                2,   # Student t
                3,   # Clayton
                4,   # Gumbel
                5,   # Frank
                6,   # Joe
                7    # BB1
            ),

            selectioncrit = "AIC",

            indeptest = TRUE,

            level = 0.05,

            trunclevel =
                max(
                    1,
                    ncol(U) - 1
                ),

            progress = verbose

        ),

        error = function(e) {

            if (verbose) {

                cat(
                    "R-vine fitting failed:",
                    conditionMessage(e),
                    "\n"
                )

            }

            NULL

        }

    )


    if (
        is.null(vine_fit)
    ) {

        return(NULL)

    }


    if (
        !inherits(
            vine_fit,
            "RVineMatrix"
        )
    ) {

        return(NULL)

    }


    list(

        model = vine_fit,

        U = U,

        X = X,

        variables = used_names

    )

}


################################################################################
# 19. CREATE VINE FEATURES
################################################################################
#
# The fitted R-vine is used to learn the dependence structure.
#
# Gaussian marginal scores are then supplied to CSC together with selected
# dependence interaction features.
#
################################################################################

make_vine_features <- function(
        data,
        vine_fit,
        covariate_names
) {

    X <- as.matrix(
        data[
            ,
            covariate_names,
            drop = FALSE
        ]
    )

    storage.mode(X) <- "double"


    ##########################################################################
    # Marginal Gaussian scores
    ##########################################################################

    U <- matrix(
        NA_real_,
        nrow = nrow(X),
        ncol = ncol(X)
    )

    for (j in seq_len(ncol(X))) {

        U[, j] <- rank_uniform(
            X[, j]
        )

    }

    Z <- qnorm(
        U
    )

    Z[
        !is.finite(Z)
    ] <- 0

    Z <- pmin(
        pmax(
            Z,
            -8
        ),
        8
    )

    colnames(Z) <- paste0(
        colnames(X),
        "_VINE"
    )

    Z <- as.data.frame(
        Z
    )


    ##########################################################################
    # Dependence matrix
    ##########################################################################

    R <- tryCatch(

        cor(
            Z,
            use = "pairwise.complete.obs"
        ),

        error = function(e) NULL

    )


    if (
        is.null(R)
    ) {

        return(
            cbind(
                data,
                Z
            )
        )

    }


    ##########################################################################
    # Select strongest pairwise dependence features
    ##########################################################################

    R[
        lower.tri(R, diag = TRUE)
    ] <- NA_real_

    pair_idx <- which(

        is.finite(R) &
            abs(R) >= 0.20,

        arr.ind = TRUE

    )


    ##########################################################################
    # Limit number of interactions
    ##########################################################################

    if (
        nrow(pair_idx) > 10
    ) {

        vals <- abs(
            R[
                pair_idx
            ]
        )

        ord <- order(
            vals,
            decreasing = TRUE
        )

        pair_idx <- pair_idx[
            ord[
                seq_len(10)
            ],
            ,
            drop = FALSE
        ]

    }


    ##########################################################################
    # Create vine interaction features
    ##########################################################################

    if (
        nrow(pair_idx) > 0
    ) {

        for (
            k in seq_len(
                nrow(pair_idx)
            )
        ) {

            j <- pair_idx[k, 1]

            l <- pair_idx[k, 2]

            new_name <- paste0(

                "VINE_INT_",

                j,

                "_",

                l

            )

            Z[[new_name]] <-

                Z[[j]] *
                Z[[l]]

        }

    }


    cbind(
        data,
        Z
    )

}


################################################################################
# 20. ADD VINE COPULA VARIABLES
################################################################################

add_vine_copula_variables <- function(
        data,
        covariate_names,
        verbose = FALSE
) {

    vine <- fit_rvine(

        data,

        covariate_names,

        verbose = verbose

    )

    if (
        is.null(vine)
    ) {

        return(NULL)

    }

    d <- make_vine_features(

        data,

        vine$model,

        vine$variables

    )

    attr(
        d,
        "vine_model"
    ) <- vine$model

    attr(
        d,
        "vine_U"
    ) <- vine$U

    attr(
        d,
        "vine_variables"
    ) <- vine$variables

    d

}


################################################################################
# 21. PREPARE CSC DATA
################################################################################

prepare_csc_data <- function(
        data,
        covariate_names
) {

    needed <- c(

        "time",
        "cause",
        "treatment",
        covariate_names

    )

    missing_vars <- setdiff(

        needed,

        names(data)

    )

    if (
        length(missing_vars) > 0
    ) {

        stop(

            paste(

                "Missing variables:",

                paste(
                    missing_vars,
                    collapse = ", "
                )

            )

        )

    }


    d <- data[

        ,
        needed,
        drop = FALSE

    ]


    d$time <- as.numeric(
        d$time
    )

    d$cause <- as.integer(
        d$cause
    )

    d$treatment <- as.integer(
        d$treatment
    )


    for (v in covariate_names) {

        d[[v]] <- as.numeric(
            d[[v]]
        )

    }


    d <- d[
        complete.cases(d),
        ,
        drop = FALSE
    ]


    d <- d[
        d$cause %in% c(
            0L,
            1L,
            2L
        ),
        ,
        drop = FALSE
    ]


    if (
        length(
            unique(
                d$cause
            )
        ) < 3
    ) {

        stop(
            "CSC data do not contain all three cause states."
        )

    }


    if (
        length(
            unique(
                d$treatment
            )
        ) < 2
    ) {

        stop(
            "CSC data do not contain both treatment groups."
        )

    }


    if (
        any(
            !is.finite(
                d$time
            )
        )
    ) {

        stop(
            "CSC data contain non-finite times."
        )

    }


    if (
        any(
            d$time <= 0
        )
    ) {

        stop(
            "CSC data contain non-positive times."
        )

    }


    d

}


################################################################################
# 22. FIT COMPETING-RISK CSC MODEL
################################################################################

fit_competing_risk_model <- function(
        data,
        covariate_names,
        verbose = FALSE
) {

    d <- tryCatch(

        prepare_csc_data(

            data,

            covariate_names

        ),

        error = function(e) {

            if (verbose) {

                cat(

                    "CSC preparation failed:",

                    conditionMessage(e),

                    "\n"

                )

            }

            NULL

        }

    )


    if (
        is.null(d)
    ) {

        return(NULL)

    }


    ##########################################################################
    # Check events
    ##########################################################################

    event_counts <- table(
        d$cause
    )

    if (
        any(
            event_counts[
                c("1", "2")
            ] < MIN_EVENTS
        )
    ) {

        if (verbose) {

            cat(
                "Too few competing events.\n"
            )

            print(
                event_counts
            )

        }

        return(NULL)

    }


    ##########################################################################
    # CSC formula
    ##########################################################################

    formula_string <- paste(

        "Hist(time, cause) ~ treatment +",

        paste(
            covariate_names,
            collapse = " + "
        )

    )

    f <- as.formula(
        formula_string
    )


    ##########################################################################
    # Fit CSC
    ##########################################################################

    fit <- tryCatch(

        suppressWarnings(

            riskRegression::CSC(

                formula = f,

                data = d

            )

        ),

        error = function(e) {

            if (verbose) {

                cat(
                    "CSC fitting failed:",
                    conditionMessage(e),
                    "\n"
                )

            }

            NULL

        }

    )


    fit

}


################################################################################
# 23. SAFE CIF PREDICTION
################################################################################

safe_predict_cif <- function(
        model,
        newdata,
        cause,
        tau,
        verbose = FALSE
) {

    n <- nrow(
        newdata
    )


    if (
        is.null(model)
    ) {

        return(
            rep(
                NA_real_,
                n
            )
        )

    }


    out <- tryCatch(

        suppressWarnings(

            riskRegression::predictRisk(

                object =
                    model,

                newdata =
                    newdata,

                times =
                    tau,

                cause =
                    cause

            )

        ),

        error = function(e) {

            if (verbose) {

                cat(
                    "CIF prediction failed:",
                    conditionMessage(e),
                    "\n"
                )

            }

            NULL

        }

    )


    if (
        is.null(out)
    ) {

        return(
            rep(
                NA_real_,
                n
            )
        )

    }


    if (
        is.matrix(out) ||
        is.data.frame(out)
    ) {

        out <- out[, 1]

    }


    out <- as.numeric(
        out
    )


    if (
        length(out) != n
    ) {

        return(
            rep(
                NA_real_,
                n
            )
        )

    }


    out[
        !is.finite(out)
    ] <- NA_real_


    out <- pmin(
        pmax(
            out,
            0
        ),
        1
    )


    out

}


################################################################################
# 24. FIT ONE METHOD
################################################################################

fit_method <- function(
        data,
        method,
        tau = TAU,
        weights = WEIGHTS,
        covariate_names = covariates,
        verbose = FALSE
) {

    if (
        !method %in%
        c(
            "Vine-Copula",
            "No-Copula"
        )
    ) {

        stop(
            "Unknown method."
        )

    }


    ##########################################################################
    # VINE-COPULA
    ##########################################################################

    if (
        method == "Vine-Copula"
    ) {

        d <- tryCatch(

            add_vine_copula_variables(

                data,

                covariate_names,

                verbose

            ),

            error = function(e) {

                if (verbose) {

                    cat(
                        "Vine transformation failed:",
                        conditionMessage(e),
                        "\n"
                    )

                }

                NULL

            }

        )


        if (
            is.null(d)
        ) {

            return(NULL)

        }


        covars <- grep(

            "_VINE$|^VINE_INT_",

            names(d),

            value = TRUE

        )

    }


    ##########################################################################
    # NO-COPULA
    ##########################################################################

    if (
        method == "No-Copula"
    ) {

        d <- data

        covars <- covariate_names

    }


    ##########################################################################
    # Check covariates
    ##########################################################################

    if (
        length(covars) == 0
    ) {

        return(NULL)

    }


    ##########################################################################
    # CSC
    ##########################################################################

    model <- fit_competing_risk_model(

        d,

        covars,

        verbose

    )


    if (
        is.null(model)
    ) {

        return(NULL)

    }


    ##########################################################################
    # Counterfactual treatment datasets
    ##########################################################################

    d0 <- d

    d0$treatment <- 0L


    d1 <- d

    d1$treatment <- 1L


    ##########################################################################
    # CIF predictions
    ##########################################################################

    cif01 <- safe_predict_cif(

        model,

        d0,

        cause = 1,

        tau = tau,

        verbose = verbose

    )


    cif02 <- safe_predict_cif(

        model,

        d0,

        cause = 2,

        tau = tau,

        verbose = verbose

    )


    cif11 <- safe_predict_cif(

        model,

        d1,

        cause = 1,

        tau = tau,

        verbose = verbose

    )


    cif12 <- safe_predict_cif(

        model,

        d1,

        cause = 2,

        tau = tau,

        verbose = verbose

    )


    ##########################################################################
    # Valid predictions
    ##########################################################################

    valid <-

        is.finite(cif01) &
        is.finite(cif02) &
        is.finite(cif11) &
        is.finite(cif12)


    n_valid <- sum(
        valid
    )


    if (
        n_valid <
        MIN_VALID_PROP * nrow(d)
    ) {

        if (verbose) {

            cat(

                method,

                ": only",

                n_valid,

                "of",

                nrow(d),

                "valid predictions.\n"

            )

        }

        return(NULL)

    }


    ##########################################################################
    # Weighted competing-risk values
    ##########################################################################

    V0 <- -(

        weights[1] * cif01 +

        weights[2] * cif02

    )


    V1 <- -(

        weights[1] * cif11 +

        weights[2] * cif12

    )


    ##########################################################################
    # Individualized treatment contrast
    ##########################################################################

    cate <- V1 - V0


    ##########################################################################
    # Treatment rule
    ##########################################################################

    rule <- ifelse(

        cate > 0,

        1L,

        0L

    )


    ##########################################################################
    # Return
    ##########################################################################

    list(

        success = TRUE,

        method = method,

        model = model,

        data = d,

        covariates = covars,

        CIF_A0_Cause1 = cif01,

        CIF_A0_Cause2 = cif02,

        CIF_A1_Cause1 = cif11,

        CIF_A1_Cause2 = cif12,

        Value_A0 = V0,

        Value_A1 = V1,

        Estimated_CATE = cate,

        Estimated_Rule = rule,

        Valid = valid,

        Valid_N = n_valid

    )

}


################################################################################
# 25. EXTRACT POLICY SUMMARY
################################################################################

summarize_policy <- function(
        fit,
        original_data
) {

    if (
        is.null(fit)
    ) {

        return(NULL)

    }


    valid <- fit$Valid


    ##########################################################################
    # Policy proportions
    ##########################################################################

    treatment1_rate <- mean(

        fit$Estimated_Rule[valid] == 1,

        na.rm = TRUE

    )


    treatment0_rate <- mean(

        fit$Estimated_Rule[valid] == 0,

        na.rm = TRUE

    )


    ##########################################################################
    # Mean predicted values
    ##########################################################################

    mean_V0 <- mean(

        fit$Value_A0[valid],

        na.rm = TRUE

    )


    mean_V1 <- mean(

        fit$Value_A1[valid],

        na.rm = TRUE

    )


    ##########################################################################
    # Mean estimated individualized contrast
    ##########################################################################

    mean_CATE <- mean(

        fit$Estimated_CATE[valid],

        na.rm = TRUE

    )


    sd_CATE <- sd(

        fit$Estimated_CATE[valid],

        na.rm = TRUE

    )


    ##########################################################################
    # Policy value
    ##########################################################################

    policy_value <- mean(

        ifelse(

            fit$Estimated_Rule[valid] == 1,

            fit$Value_A1[valid],

            fit$Value_A0[valid]

        ),

        na.rm = TRUE

    )


    ##########################################################################
    # Always-treat policies
    ##########################################################################

    always_0 <- mean(

        fit$Value_A0[valid],

        na.rm = TRUE

    )


    always_1 <- mean(

        fit$Value_A1[valid],

        na.rm = TRUE

    )


    ##########################################################################
    # Oracle using fitted conditional values
    ##########################################################################

    fitted_optimal <- pmax(

        fit$Value_A0[valid],

        fit$Value_A1[valid]

    )


    optimal_value <- mean(

        fitted_optimal,

        na.rm = TRUE

    )


    ##########################################################################
    # Regret relative to fitted optimal policy
    ##########################################################################

    regret <-

        optimal_value -

        policy_value


    ##########################################################################
    # Relative loss
    ##########################################################################

    relative_loss <-

        regret /

        max(
            abs(optimal_value),
            1e-8
        )


    ##########################################################################
    # Return
    ##########################################################################

    data.frame(

        Method =
            fit$method,

        N =
            nrow(fit$data),

        Valid_N =
            fit$Valid_N,

        Treatment1_Rate =
            treatment1_rate,

        Treatment0_Rate =
            treatment0_rate,

        Mean_CATE =
            mean_CATE,

        SD_CATE =
            sd_CATE,

        Mean_Value_A0 =
            mean_V0,

        Mean_Value_A1 =
            mean_V1,

        Always_Treatment0_Value =
            always_0,

        Always_Treatment1_Value =
            always_1,

        Policy_Value =
            policy_value,

        Fitted_Optimal_Value =
            optimal_value,

        Fitted_Regret =
            regret,

        Relative_Value_Loss =
            relative_loss,

        stringsAsFactors = FALSE

    )

}


