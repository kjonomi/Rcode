            True_Contrast_Mean =
                true_contrast_mean,

            True_Contrast_SD =
                true_contrast_sd,

            Copula_Valid_N =
                cop_valid_n,

            NoCopula_Valid_N =
                raw_valid_n

        )

    )

    ##########################################################################
    # STORE
    ##########################################################################

    temp <- list()

    if (
        !is.null(eval_cop)
    ) {

        temp[[length(temp) + 1]] <-

            cbind(
                Method = "Vine-Copula",
                Replication = r,
                eval_cop
            )

    }

    if (
        !is.null(eval_raw)
    ) {

        temp[[length(temp) + 1]] <-

            cbind(
                Method = "No-Copula",
                Replication = r,
                eval_raw
            )

    }

    if (
        length(temp) > 0
    ) {

        simulation_results_list[[r]] <-

            bind_rows(
                temp
            )

    }

}


