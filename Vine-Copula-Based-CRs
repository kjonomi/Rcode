################################################################################
# 2. HIGHLY CORRELATED COVARIATE MATRIX
################################################################################

make_sigma <- function(
        p,
        rho = 0.85
) {

    Sigma <- matrix(
        0,
        nrow = p,
        ncol = p
    )

    for (j in seq_len(p)) {

        for (k in seq_len(p)) {

            Sigma[j, k] <- rho ^ abs(j - k)

        }

    }

    Sigma

}


################################################################################
# 3. GAUSS-LEGENDRE QUADRATURE
################################################################################

gauss_legendre <- function(
        n
) {

    i <- seq_len(n)

    beta <- i[-n] /
        sqrt(
            4 * i[-n]^2 - 1
        )

    J <- matrix(
        0,
        nrow = n,
        ncol = n
    )

    if (n > 1) {

        idx <- cbind(
            seq_len(n - 1),
            seq_len(n - 1) + 1
        )

        J[idx] <- beta

        J[cbind(
            seq_len(n - 1) + 1,
            seq_len(n - 1)
        )] <- beta

    }

    eig <- eigen(
        J,
        symmetric = TRUE
    )

    nodes <- eig$values

    weights <- 2 * (
        eig$vectors[1, ]^2
    )

    list(
        nodes = nodes,
        weights = weights
    )

}


################################################################################
# 4. TRUE LOGNORMAL COMPETING-RISK CIF
################################################################################

true_competing_risk_cif <- function(
        log_mean1,
        log_mean2,
        tau,
        n_quad = 80
) {

    n <- length(log_mean1)

    if (
        length(log_mean2) != n
    ) {

        stop(
            "log_mean1 and log_mean2 must have equal length."
        )

    }

    quad <- gauss_legendre(
        n_quad
    )

    u <- (
        quad$nodes + 1
    ) * tau / 2

    w <- (
        quad$weights * tau / 2
    )

    u <- pmax(
        u,
        1e-10
    )

    log_u <- log(u)

    mu1_mat <- matrix(
        log_mean1,
        nrow = n,
        ncol = n_quad
    )

    mu2_mat <- matrix(
        log_mean2,
        nrow = n,
        ncol = n_quad
    )

    log_u_mat <- matrix(
        log_u,
        nrow = n,
        ncol = n_quad,
        byrow = TRUE
    )

    z1 <- (
        log_u_mat -
        mu1_mat
    )

    z2 <- (
        log_u_mat -
        mu2_mat
    )

    f1 <- dnorm(
        z1
    ) / u

    f2 <- dnorm(
        z2
    ) / u

    S1 <- pnorm(
        z1,
        lower.tail = FALSE
    )

    S2 <- pnorm(
        z2,
        lower.tail = FALSE
    )

    integrand1 <- f1 * S2

    integrand2 <- f2 * S1

    cif1 <- as.numeric(
        integrand1 %*% w
    )

    cif2 <- as.numeric(
        integrand2 %*% w
    )

    cif1 <- pmin(
        pmax(
            cif1,
            0
        ),
        1
    )

    cif2 <- pmin(
        pmax(
            cif2,
            0
        ),
        1
    )

    list(
        CIF1 = cif1,
        CIF2 = cif2
    )

}


################################################################################
# 5. CALIBRATE EXPONENTIAL CENSORING
################################################################################

calibrate_censoring_rate <- function(
        event_time,
        censor_rate
) {

    event_time <- event_time[
        is.finite(event_time) &
            event_time > 0
    ]

    objective <- function(lambda) {

        mean(
            1 - exp(-lambda * event_time)
        ) -
            censor_rate

    }

    upper <- 1

    while (
        objective(upper) < 0 &&
        upper < 1e6
    ) {

        upper <- upper * 2

    }

    if (
        objective(upper) < 0
    ) {

        stop(
            "Unable to calibrate exponential censoring rate."
        )

    }

    root <- uniroot(
        objective,
        interval = c(0, upper)
    )

    as.numeric(
        root$root
    )

}


################################################################################
# 6. DATA GENERATION
################################################################################

generate_data <- function(
        sample_size = 1500,
        p = 8,
        rho = 0.85,
        tau = 365,
        censor_rate = 0.35
) {

    nn <- as.integer(sample_size)

    pp <- as.integer(p)

    Sigma <- make_sigma(
        p = pp,
        rho = rho
    )

    L <- chol(
        Sigma
    )

    Zraw <- matrix(
        rnorm(nn * pp),
        nrow = nn,
        ncol = pp
    )

    X <- Zraw %*% L

    colnames(X) <- paste0(
        "X",
        seq_len(pp)
    )

    X <- as.data.frame(
        X
    )

    A <- rbinom(
        nn,
        size = 1,
        prob = 0.50
    )

    ##########################################################################
    # Cause 1 treatment effect
    ##########################################################################

    tau1 <- (
        0.90 * X$X1 -
        0.75 * X$X2 +
        0.45 * X$X3 * X$X4 +
        0.35 * sin(X$X5)
    )

    tau1 <- tau1 - mean(tau1)

    tau1_sd <- sd(tau1)

    if (
        !is.finite(tau1_sd) ||
        tau1_sd < 1e-10
    ) {

        tau1_sd <- 1

    }

    tau1 <- (
        0.65 *
        tau1 /
        tau1_sd
    )

    ##########################################################################
    # Baseline risk
    ##########################################################################

    mu0 <- (
        0.25 * X$X1 -
        0.20 * X$X2 +
        0.15 * X$X3 +
        0.10 * X$X4^2 -
        0.10 * X$X5
    )

    mu0 <- as.numeric(
        scale(mu0)
    )

    ##########################################################################
    # Cause 1
    ##########################################################################

    logT1_mean <- (
        log(tau) -
        0.55 +
        0.25 * mu0 -
        0.70 * A * tau1
    )

    ##########################################################################
    # Cause 2 treatment effect
    ##########################################################################

    tau2 <- (
        -0.55 * X$X1 +
        0.40 * X$X2 +
        0.30 * X$X5 -
        0.25 * X$X6 * X$X7
    )

    tau2 <- tau2 - mean(tau2)

    tau2_sd <- sd(tau2)

    if (
        !is.finite(tau2_sd) ||
        tau2_sd < 1e-10
    ) {

        tau2_sd <- 1

    }

    tau2 <- (
        0.50 *
        tau2 /
        tau2_sd
    )

    ##########################################################################
    # Cause 2
    ##########################################################################

    logT2_mean <- (
        log(1.25 * tau) -
        0.45 +
        0.20 * mu0 -
        0.60 * A * tau2
    )

    ##########################################################################
    # Latent event times
    ##########################################################################

    eps1 <- rnorm(nn)

    eps2 <- rnorm(nn)

    T1 <- exp(
        logT1_mean +
        eps1
    )

    T2 <- exp(
        logT2_mean +
        eps2
    )

    event_time <- pmin(
        T1,
        T2
    )

    cause_true <- ifelse(
        T1 <= T2,
        1L,
        2L
    )

    ##########################################################################
    # Censoring
    ##########################################################################

    censor_lambda <- calibrate_censoring_rate(
        event_time,
        censor_rate
    )

    C <- rexp(
        nn,
        rate = censor_lambda
    )

    time_obs <- pmin(
        event_time,
        C
    )

    status <- as.integer(
        event_time <= C
    )

    cause_obs <- ifelse(
        status == 1L,
        cause_true,
        0L
    )

    ##########################################################################
    # TRUE COUNTERFACTUAL MEANS
    ##########################################################################

    logT1_mean_A0 <- (
        log(tau) -
        0.55 +
        0.25 * mu0
    )

    logT1_mean_A1 <- (
        log(tau) -
        0.55 +
        0.25 * mu0 -
        0.70 * tau1
    )

    logT2_mean_A0 <- (
        log(1.25 * tau) -
        0.45 +
        0.20 * mu0
    )

    logT2_mean_A1 <- (
        log(1.25 * tau) -
        0.45 +
        0.20 * mu0 -
        0.60 * tau2
    )

    ##########################################################################
    # TRUE CIF A0
    ##########################################################################

    true_cif_A0 <- true_competing_risk_cif(
        logT1_mean_A0,
        logT2_mean_A0,
        tau,
        N_QUAD
    )

    ##########################################################################
    # TRUE CIF A1
    ##########################################################################

    true_cif_A1 <- true_competing_risk_cif(
        logT1_mean_A1,
        logT2_mean_A1,
        tau,
        N_QUAD
    )

    ##########################################################################
    # TRUE VALUES
    ##########################################################################

    TRUE_VALUE_A0 <- -(
        WEIGHTS[1] *
            true_cif_A0$CIF1 +
        WEIGHTS[2] *
            true_cif_A0$CIF2
    )

    TRUE_VALUE_A1 <- -(
        WEIGHTS[1] *
            true_cif_A1$CIF1 +
        WEIGHTS[2] *
            true_cif_A1$CIF2
    )

    TRUE_CONTRAST <- (
        TRUE_VALUE_A1 -
        TRUE_VALUE_A0
    )

    TRUE_RULE <- ifelse(
        TRUE_CONTRAST > 0,
        1L,
        0L
    )

    TRUE_OPTIMAL_VALUE <- pmax(
        TRUE_VALUE_A0,
        TRUE_VALUE_A1
    )

    ##########################################################################
    # FINAL DATA
    ##########################################################################

    dat <- data.frame(

