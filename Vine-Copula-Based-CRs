    1,   # Gaussian
    2,   # Student t
    3,   # Clayton
    4,   # Gumbel
    5,   # Frank
    6,   # Joe
    7    # BB1
)

VINE_TRUNCLEVEL <- P - 1

VINE_INDEPTEST_LEVEL <- 0.05

VINE_INTERACTION_THRESHOLD <- 0.25

MAX_VINE_INTERACTIONS <- 12


