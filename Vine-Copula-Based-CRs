################################################################################
# 13. RANK TRANSFORMATION
################################################################################

rank_uniform <- function(
        x
) {
    
    x <- as.numeric(
        x
    )
    
    n <- length(
        x
    )
    
    r <- rank(
        x,
        ties.method = "average"
    )
    
    u <- (
        r - 0.5
    ) / n
    
    u <- pmin(
        pmax(
            u,
            1e-6
        ),
        1 - 1e-6
    )
    
    u
    
}


################################################################################
# 14. SAFE R-VINE FIT
################################################################################

fit_rvine <- function(
        data,
        covariate_names,
        verbose = FALSE
) {
    
    X <- as.matrix(
        data[
            ,
            covariate_names,
            drop = FALSE
        ]
    )
    
    storage.mode(X) <- "double"
    
    
    if (
        any(
            !is.finite(X)
        )
    ) {
        
        stop(
            "Vine input contains non-finite values."
        )
        
    }
    
    
    p <- ncol(
        X
    )
    
    
    ##########################################################################
    # Rank transform
    ##########################################################################
    
    U <- matrix(
        NA_real_,
        nrow = nrow(X),
        ncol = p
    )
    
    for (
        j in seq_len(p)
    ) {
        
        U[, j] <- rank_uniform(
            X[, j]
        )
        
    }
    
    colnames(U) <- covariate_names
    
    
    ##########################################################################
    # Fit R-vine
    ##########################################################################
    
    vine_fit <- tryCatch(
        
        VineCopula::RVineStructureSelect(
            
            U,
            
            familyset =
                VINE_FAMILYSET,
            
            selectioncrit =
                "AIC",
            
            indeptest =
                TRUE,
            
            level =
                VINE_INDEPTEST_LEVEL,
            
            trunclevel =
                min(
                    VINE_TRUNCLEVEL,
                    p - 1
                ),
            
            progress =
                verbose
            
        ),
        
        error = function(e) {
            
            if (
                verbose
            ) {
                
                cat(
                    "R-vine fitting failed:",
                    conditionMessage(e),
                    "\n"
                )
                
            }
            
            NULL
            
        }
        
    )
    
    
    if (
        is.null(vine_fit)
    ) {
        
        return(
            NULL
        )
        
    }
    
    
    if (
        !inherits(
            vine_fit,
            "RVineMatrix"
        )
    ) {
        
        return(
            NULL
        )
        
    }
    
    
    list(
        
        model =
            vine_fit,
        
        U =
            U,
        
        X =
            X,
        
        variables =
            covariate_names
        
    )
    
}


################################################################################
# 15. CREATE VINE-COPULA FEATURES
################################################################################
#
# The fitted R-vine is used to determine the dependence structure.
#
# Gaussianized marginal scores and selected pairwise dependence
# interactions are then supplied to the CSC model.
#
################################################################################

make_vine_features <- function(
        data,
        vine_fit,
        covariate_names
) {
    
    X <- as.matrix(
        data[
            ,
            covariate_names,
            drop = FALSE
        ]
    )
    
    storage.mode(X) <- "double"
    
    n <- nrow(X)
    
    p <- ncol(X)
    
    
    ##########################################################################
    # Rank -> U
    ##########################################################################
    
    U <- matrix(
        NA_real_,
        nrow = n,
        ncol = p
    )
    
    for (
        j in seq_len(p)
    ) {
        
        U[, j] <- rank_uniform(
            X[, j]
        )
        
    }
    
    
    ##########################################################################
    # Gaussian copula scores
    ##########################################################################
    
    Z <- qnorm(
        U
    )
    
    Z[
        !is.finite(Z)
    ] <- 0
    
    Z <- pmin(
        pmax(
            Z,
            -8
        ),
        8
    )
    
    
    colnames(Z) <- paste0(
        covariate_names,
        "_VINE"
    )
    
    
    Z <- as.data.frame(
        Z
    )
    
    
    ##########################################################################
    # Dependence matrix
    ##########################################################################
    
    R <- tryCatch(
        
        cor(
            Z,
            use = "pairwise.complete.obs"
        ),
        
        error = function(e) {
            
            NULL
            
        }
        
    )
    
    
    if (
        is.null(R)
    ) {
        
        return(
            cbind(
                data,
                Z
            )
        )
        
    }
    
    
    ##########################################################################
    # Keep upper triangle only
    ##########################################################################
    
    R[
        lower.tri(
            R,
            diag = TRUE
        )
    ] <- NA_real_
    
    
    pair_idx <- which(
        
        is.finite(R) &
            abs(R) >=
                VINE_INTERACTION_THRESHOLD,
        
        arr.ind = TRUE
        
    )
    
    
    ##########################################################################
    # Limit number of interactions
    ##########################################################################
    
    if (
        nrow(pair_idx) >
        MAX_VINE_INTERACTIONS
    ) {
        
        vals <- abs(
            R[
                pair_idx
            ]
        )
        
        ord <- order(
            vals,
            decreasing = TRUE
        )
        
        pair_idx <- pair_idx[
            
            ord[
                seq_len(
                    MAX_VINE_INTERACTIONS
                )
            ],
            
            ,
            
            drop = FALSE
            
        ]
        
    }
    
    
    ##########################################################################
    # Create Vine interaction features
    ##########################################################################
    
    if (
        nrow(pair_idx) > 0
    ) {
        
        for (
            k in seq_len(
                nrow(pair_idx)
            )
        ) {
            
            j <- pair_idx[k, 1]
            
            l <- pair_idx[k, 2]
            
            new_name <- paste0(
                "VINE_INT_",
                covariate_names[j],
                "_",
                covariate_names[l]
            )
            
            Z[[new_name]] <-
                Z[[j]] *
                Z[[l]]
            
        }
        
    }
    
    
    ##########################################################################
    # Return
    ##########################################################################
    
    out <- cbind(
        data,
        Z
    )
    
    
    attr(
        out,
        "vine_model"
    ) <- vine_fit
    
    out
    
}


################################################################################
# 16. ADD VINE-COPULA VARIABLES
################################################################################

add_vine_copula_variables <- function(
        data,
        verbose = FALSE
) {
    
    vine <- fit_rvine(
        data,
        covariate_names =
            covariates,
        verbose =
            verbose
    )
    
    
    if (
        is.null(vine)
    ) {
        
        return(
            NULL
        )
        
    }
    
    
    d <- make_vine_features(
        data,
        vine$model,
        covariate_names =
            covariates
    )
    
    
    attr(
        d,
        "vine_model"
    ) <- vine$model
    
    attr(
        d,
        "vine_U"
    ) <- vine$U
    
    
    d
    
}


################################################################################
# 17. PREPARE CSC DATA
################################################################################

prepare_csc_data <- function(
        data,
        covariate_names
) {
    
    needed <- c(
        
        "time",
        "cause",
        "treatment",
        covariate_names
        
    )
    
    
    missing_vars <- setdiff(
        needed,
        names(data)
    )
    
    
    if (
        length(missing_vars) > 0
    ) {
        
        stop(
            paste(
                "Missing variables:",
                paste(
                    missing_vars,
                    collapse = ", "
                )
            )
        )
        
    }
    
    
    d <- data[
        ,
        needed,
        drop = FALSE
    ]
    
    
    d$time <- as.numeric(
        d$time
    )
    
    d$cause <- as.integer(
        d$cause
    )
    
    d$treatment <- as.integer(
        d$treatment
    )
    
    
    for (
        v in covariate_names
    ) {
        
        d[[v]] <- as.numeric(
            d[[v]]
        )
        
    }
    
    
    keep <- complete.cases(
        d
    )
    
    d <- d[
        keep,
        ,
        drop = FALSE
    ]
    
    
    d <- d[
        d$cause %in% c(
            0L,
            1L,
            2L
        ),
        ,
        drop = FALSE
    ]
    
    
    if (
        length(
            unique(
                d$cause
            )
        ) < 3
    ) {
        
        stop(
            "CSC data do not contain all three cause states."
        )
        
    }
    
    
    if (
        length(
            unique(
                d$treatment
            )
        ) < 2
    ) {
        
        stop(
            "CSC data do not contain both treatment groups."
        )
        
    }
    
    
    if (
        any(
            !is.finite(
                d$time
            )
        )
    ) {
        
        stop(
            "CSC data contain non-finite times."
        )
        
    }
    
    
    if (
        any(
            d$time <= 0
        )
    ) {
        
        stop(
            "CSC data contain non-positive times."
        )
        
    }
    
    
    d
    
}


################################################################################
# 18. FIT COMPETING-RISK MODEL
################################################################################

fit_competing_risk_model <- function(
        data,
        covariate_names,
        verbose = FALSE
) {
    
    d <- tryCatch(
        
        prepare_csc_data(
            data,
            covariate_names
        ),
        
        error = function(e) {
            
            if (
                verbose
            ) {
                
                cat(
                    "CSC preparation failed:",
                    conditionMessage(e),
                    "\n"
                )
                
            }
            
            NULL
            
        }
        
    )
    
    
    if (
        is.null(d)
    ) {
        
        return(
            NULL
        )
        
    }
    
    
    ##########################################################################
    # Formula
    ##########################################################################
    
    formula_string <- paste(
        
        "Hist(time, cause) ~ treatment +",
        
        paste(
            covariate_names,
            collapse = " + "
        )
        
    )
    
    
    f <- as.formula(
        formula_string
    )
    
    
    ##########################################################################
    # CSC
    ##########################################################################
    
    fit <- tryCatch(
        
        suppressWarnings(
            
            riskRegression::CSC(
                
                formula =
                    f,
                
                data =
                    d
                
            )
            
        ),
        
        error = function(e) {
            
            if (
                verbose
            ) {
                
                cat(
                    "CSC fitting failed:",
                    conditionMessage(e),
                    "\n"
                )
                
            }
            
            NULL
            
        }
        
    )
    
    
    fit
    
}


################################################################################
# 19. SAFE CIF PREDICTION
################################################################################

safe_predict_cif <- function(
        model,
        newdata,
        cause,
        tau,
        verbose = FALSE
) {
    
    n <- nrow(
        newdata
    )
    
    
    if (
        is.null(model)
    ) {
        
        return(
            rep(
                NA_real_,
                n
            )
        )
        
    }
    
    
    out <- tryCatch(
        
        suppressWarnings(
            
            riskRegression::predictRisk(
                
                object =
                    model,
                
                newdata =
                    newdata,
                
                times =
                    tau,
                
                cause =
                    cause
                
            )
            
        ),
        
        error = function(e) {
            
            if (
                verbose
            ) {
                
                cat(
                    "CIF prediction failed for cause",
                    cause,
                    ":",
                    conditionMessage(e),
                    "\n"
                )
                
            }
            
            NULL
            
        }
        
    )
    
    
    if (
        is.null(out)
    ) {
        
        return(
            rep(
                NA_real_,
                n
            )
        )
        
    }
    
    
    if (
        is.matrix(out) ||
        is.data.frame(out)
    ) {
        
        out <- out[
            ,
            1
        ]
        
    }
    
    
    out <- as.numeric(
        out
    )
    
    
    if (
        length(out) != n
    ) {
        
        return(
            rep(
                NA_real_,
                n
            )
        )
        
    }
    
    
    out[
        !is.finite(out)
    ] <- NA_real_
    
    
    out <- pmin(
        pmax(
            out,
            0
        ),
        1
    )
    
    
    out
    
}


################################################################################
# 20. FIT ONE METHOD
################################################################################

fit_method <- function(
        data,
        method,
        tau = TAU,
        weights = WEIGHTS,
        verbose = FALSE
) {
    
    if (
        !method %in%
        c(
            "Vine-Copula",
            "No-Copula"
        )
    ) {
        
        stop(
            "method must be 'Vine-Copula' or 'No-Copula'."
        )
        
    }
    
    
    ##########################################################################
    # Check TAU
    ##########################################################################
    
    max_time <- max(
        data$time,
        na.rm = TRUE
    )
    
    
    if (
        !is.finite(max_time) ||
        max_time < tau
    ) {
        
        if (
            verbose
        ) {
            
            cat(
                method,
                ": TAU unavailable.\n"
            )
            
        }
        
        return(
            NULL
        )
        
    }
    
    
    ##########################################################################
    # VINE COPULA
    ##########################################################################
    
    if (
        method == "Vine-Copula"
    ) {
        
        d <- tryCatch(
            
            add_vine_copula_variables(
                data,
                verbose =
                    verbose
            ),
            
            error = function(e) {
                
                if (
                    verbose
                ) {
                    
                    cat(
                        "Vine transformation failed:",
                        conditionMessage(e),
                        "\n"
                    )
                    
                }
                
                NULL
                
            }
            
        )
        
        
        if (
            is.null(d)
        ) {
            
            return(
                NULL
            )
            
        }
        
        
        covars <- grep(
            
            "^age_VINE$|^sex_VINE$|^edema_VINE$|^bili_VINE$|^albumin_VINE$|^protime_VINE$|^stage_VINE$|^ascites_VINE$|^VINE_INT_",
            
            names(d),
            
            value = TRUE
            
        )
        
        
    } else {
        
        ######################################################################
        # NO COPULA
        ######################################################################
        
        d <- data
        
        covars <- covariates
        
    }
    
    
    if (
        length(covars) == 0
    ) {
        
        if (
            verbose
        ) {
            
            cat(
                method,
                ": no usable covariates.\n"
            )
            
        }
        
        return(
            NULL
        )
        
    }
    
    
    ##########################################################################
    # CSC
    ##########################################################################
    
    model <- fit_competing_risk_model(
        
        d,
        
        covars,
        
        verbose =
            verbose
        
    )
    
    
    if (
        is.null(model)
    ) {
        
        return(
            NULL
        )
        
    }
    
    
    ##########################################################################
    # Counterfactual treatment datasets
    ##########################################################################
    
    d0 <- d
    
    d0$treatment <- 0L
    
    
    d1 <- d
    
    d1$treatment <- 1L
    
    
    ##########################################################################
    # CIFs
    ##########################################################################
    
    cif01 <- safe_predict_cif(
        
        model,
        
        d0,
        
        cause = 1,
        
        tau =
            tau,
        
        verbose =
            verbose
        
    )
    
    
    cif02 <- safe_predict_cif(
        
        model,
        
        d0,
        
        cause = 2,
        
        tau =
            tau,
        
        verbose =
            verbose
        
    )
    
    
    cif11 <- safe_predict_cif(
        
        model,
        
        d1,
        
        cause = 1,
        
        tau =
            tau,
        
        verbose =
            verbose
        
    )
    
    
    cif12 <- safe_predict_cif(
        
        model,
        
        d1,
        
        cause = 2,
        
        tau =
            tau,
        
        verbose =
            verbose
        
    )
    
    
    ##########################################################################
    # Valid predictions
    ##########################################################################
    
    valid <- (
        
        is.finite(cif01) &
            is.finite(cif02) &
            is.finite(cif11) &
            is.finite(cif12)
        
    )
    
    
    n_valid <- sum(
        valid
    )
    
    
    if (
        n_valid <
        0.50 * nrow(d)
    ) {
        
        if (
            verbose
        ) {
            
            cat(
                method,
                ": only",
                n_valid,
                "valid predictions out of",
                nrow(d),
                "\n"
            )
            
        }
        
        return(
            NULL
        )
        
    }
    
    
    ##########################################################################
    # Treatment-specific value
    ##########################################################################
    
    V0 <- -(
        
        weights[1] * cif01 +
            weights[2] * cif02
        
    )
    
    
    V1 <- -(
        
        weights[1] * cif11 +
            weights[2] * cif12
        
    )
    
    
    ##########################################################################
    # Estimated CATE
    ##########################################################################
    
    estimated_cate <- V1 - V0
    
    
    ##########################################################################
    # Individualized rule
    ##########################################################################
    
    estimated_rule <- ifelse(
        
        estimated_cate > 0,
        
        1L,
        
        0L
        
    )
    
    
    ##########################################################################
    # Return
    ##########################################################################
    
    list(
        
        success =
            TRUE,
        
        method =
            method,
        
        model =
            model,
        
        data =
            d,
        
        covariates =
            covars,
        
        CIF_A0_Cause1 =
            cif01,
        
        CIF_A0_Cause2 =
            cif02,
        
        CIF_A1_Cause1 =
            cif11,
        
        CIF_A1_Cause2 =
            cif12,
        
        Value_A0 =
            V0,
        
        Value_A1 =
            V1,
        
        Estimated_CATE =
            estimated_cate,
        
        Estimated_Rule =
            estimated_rule,
        
        Valid =
            valid,
        
        Valid_N =
            n_valid
        
    )
    
}


################################################################################
# 21. FIT PROPENSITY SCORE MODEL
################################################################################
#
# Because the PBC trial treatment is randomized, the empirical treatment
# probability is appropriate for the primary IPW policy-value calculation.
#
################################################################################

fit_propensity <- function(
        data
) {
    
    p_treat <- mean(
        data$treatment == 1
    )
    
    
    if (
        p_treat <= 0 ||
        p_treat >= 1
    ) {
        
        stop(
            "Invalid empirical treatment probability."
        )
        
    }
    
    
    rep(
        p_treat,
        nrow(data)
    )
    
}


################################################################################
# 22. KAPLAN-MEIER ESTIMATOR FOR POLICY VALUE
################################################################################
#
# For a policy d(X), we need an observed outcome contribution.
#
# We define the utility at TAU using:
#
#     U_i(TAU) =
#
#         -w1 * I(transplant by TAU)
#         -w2 * I(death by TAU)
#
# Subjects who are censored before TAU are weighted using
# inverse probability of censoring weighting.
#
################################################################################

estimate_censoring_survival <- function(
        data,
        tau
) {
    
    censor_event <- as.integer(
        data$cause == 0 &
            data$time < tau
    )
    
    
    fit <- survival::survfit(
        
        survival::Surv(
            time,
            censor_event
        ) ~ 1,
        
        data =
            data
        
    )
    
    
    G <- summary(
        
        fit,
        
        times =
            pmin(
                data$time,
                tau
            ),
        
        extend =
            TRUE
        
    )$surv
    
    
    if (
        length(G) != nrow(data)
    ) {
        
        ######################################################################
        # Safe fallback: KM evaluated subject by subject
        ######################################################################
        
        G <- sapply(
            
            seq_len(
                nrow(data)
            ),
            
            function(i) {
                
                ss <- summary(
                    
                    fit,
                    
                    times =
                        min(
                            data$time[i],
                            tau
                        ),
                    
                    extend =
                        TRUE
                    
                )
                
                
                if (
                    length(ss$surv) == 0
                ) {
                    
                    return(
                        1
                    )
                    
                }
                
                
                ss$surv[1]
                
            }
            
        )
        
    }
    
    
    G <- pmax(
        G,
        0.05
    )
    
    
    G
    
}


################################################################################
# 23. OBSERVED POLICY UTILITY
################################################################################

calculate_observed_policy_utility <- function(
        data,
        estimated_rule,
        tau,
        weights
) {
    
    n <- nrow(
        data
    )
    
    
    ##########################################################################
    # Treatment probability
    ##########################################################################
    
    p1 <- mean(
        data$treatment == 1
    )
    
    p0 <- 1 - p1
    
    
    ##########################################################################
    # Censoring survival
    ##########################################################################
    
    G <- estimate_censoring_survival(
        
        data,
        
        tau =
            tau
        
    )
    
    
    ##########################################################################
    # Whether observed treatment agrees with policy
    ##########################################################################
    
    policy_match <- (
        
        data$treatment ==
            estimated_rule
        
    )
    
    
    ##########################################################################
    # Event utility
    ##########################################################################
    
    utility <- rep(
        0,
        n
    )
    
    
    utility[
        data$time <= tau &
            data$cause == 1
    ] <- -weights[1]
    
    
    utility[
        data$time <= tau &
            data$cause == 2
    ] <- -weights[2]
    
    
    ##########################################################################
    # IPCW treatment-policy weight
    ##########################################################################
    
    treatment_weight <- ifelse(
        
        data$treatment == 1,
        
        1 / p1,
        
        1 / p0
        
    )
    
    
    policy_weight <- (
        
        policy_match *
            treatment_weight /
            G
        
    )
    
    
    ##########################################################################
    # Administrative TAU contribution
    ##########################################################################
    
    # Subjects who survive beyond TAU contribute zero utility.
    #
    # Subjects censored before TAU have no observed event by TAU and are
    # handled conservatively through the IPCW contribution.
    
    
    contribution <- (
        
        policy_weight *
            utility
        
    )
    
    
    mean(
        contribution,
        na.rm = TRUE
    )
    
}


################################################################################
# 24. ALWAYS-TREATMENT POLICY VALUE
################################################################################

calculate_fixed_policy_value <- function(
        data,
        fixed_treatment,
        tau,
        weights
) {
    
    policy <- rep(
        fixed_treatment,
        nrow(data)
    )
    
    
    calculate_observed_policy_utility(
        
        data =
            data,
        
        estimated_rule =
            policy,
        
        tau =
            tau,
        
        weights =
            weights
        
    )
    
}


