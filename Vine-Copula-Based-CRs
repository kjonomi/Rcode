################################################################################
# 12. PREPARE CSC DATA
################################################################################

prepare_csc_data <- function(
        data,
        covariate_names
) {

    needed <- c(
        "time",
        "cause",
        "treatment",
        covariate_names
    )

    missing_vars <- setdiff(
        needed,
        names(data)
    )

    if (
        length(missing_vars) > 0
    ) {

        stop(
            paste(
                "Missing variables:",
                paste(
                    missing_vars,
                    collapse = ", "
                )
            )
        )

    }

    d <- data[
        ,
        needed,
        drop = FALSE
    ]

    d$time <- as.numeric(
        d$time
    )

    d$cause <- as.integer(
        d$cause
    )

    d$treatment <- as.integer(
        d$treatment
    )

    for (
        v in covariate_names
    ) {

        d[[v]] <- as.numeric(
            d[[v]]
        )

    }

    keep <- complete.cases(
        d
    )

    d <- d[
        keep,
        ,
        drop = FALSE
    ]

    d <- d[
        d$cause %in% c(
            0L,
            1L,
            2L
        ),
        ,
        drop = FALSE
    ]

    if (
        length(
            unique(d$cause)
        ) < 3
    ) {

        stop(
            "CSC data do not contain all three cause states."
        )

    }

    if (
        length(
            unique(d$treatment)
        ) < 2
    ) {

        stop(
            "CSC data do not contain both treatment groups."
        )

    }

    if (
        any(
            !is.finite(d$time)
        ) ||
        any(
            d$time <= 0
        )
    ) {

        stop(
            "CSC data contain invalid observed times."
        )

    }

    d

}


################################################################################
# 13. FIT COMPETING-RISK MODEL
################################################################################

fit_competing_risk_model <- function(
        data,
        covariate_names,
        verbose = FALSE
) {

    d <- tryCatch(

        prepare_csc_data(
            data,
            covariate_names
        ),

        error = function(e) {

            if (verbose) {

                cat(
                    "CSC data preparation failed:",
                    conditionMessage(e),
                    "\n"
                )

            }

            NULL

        }

    )

    if (
        is.null(d)
    ) {

        return(NULL)

    }

    formula_string <- paste(
        "Hist(time, cause) ~ treatment +",
        paste(
            covariate_names,
            collapse = " + "
        )
    )

    f <- as.formula(
        formula_string
    )

    fit <- tryCatch(

        suppressWarnings(

            riskRegression::CSC(
                formula = f,
                data = d
            )

        ),

        error = function(e) {

            if (verbose) {

                cat(
                    "CSC fitting failed:",
                    conditionMessage(e),
                    "\n"
                )

            }

            NULL

        }

    )

    fit

}


################################################################################
# 14. SAFE CIF PREDICTION
################################################################################

safe_predict_cif <- function(
        model,
        newdata,
        cause,
        tau,
        verbose = FALSE
) {

    n <- nrow(newdata)

    if (
        is.null(model)
    ) {

        return(
            rep(
                NA_real_,
                n
            )
        )

    }

    out <- tryCatch(

        suppressWarnings(

            riskRegression::predictRisk(
                object = model,
                newdata = newdata,
                times = tau,
                cause = cause
            )

        ),

        error = function(e) {

            if (verbose) {

                cat(
                    "\nCIF prediction failed.\n"
                )

                cat(
                    "Cause:",
                    cause,
                    "\n"
                )

                cat(
                    "Error:",
                    conditionMessage(e),
                    "\n"
                )

            }

            NULL

        }

    )

    if (
        is.null(out)
    ) {

        return(
            rep(
                NA_real_,
                n
            )
        )

    }

    if (
        is.matrix(out) ||
        is.data.frame(out)
    ) {

        out <- out[, 1]

    }

    out <- as.numeric(
        out
    )

    if (
        length(out) != n
    ) {

        return(
            rep(
                NA_real_,
                n
            )
        )

    }

    out[
        !is.finite(out)
    ] <- NA_real_

    out <- pmin(
        pmax(
            out,
            0
        ),
        1
    )

    out

}


################################################################################
# 15. FIT ONE METHOD
################################################################################

fit_method <- function(
        data,
        method,
        tau = 365,
        weights = c(1, 2),
        verbose = FALSE
) {

    if (
        !method %in%
        c(
            "Copula",
            "No-Copula"
        )
    ) {

        stop(
            "method must be 'Copula' or 'No-Copula'."
        )

    }

    ##########################################################################
    # TAU
    ##########################################################################

    max_time <- max(
        data$time,
        na.rm = TRUE
    )

    if (
        !is.finite(max_time) ||
        max_time < tau
    ) {

        if (verbose) {

            cat(
                method,
                ": TAU unavailable.\n"
            )

        }

        return(NULL)

    }

    ##########################################################################
    # COPULA METHOD
    ##########################################################################

    if (
        method == "Copula"
    ) {

        d <- tryCatch(

            add_vine_copula_variables(
                data,
                verbose = verbose
            ),

            error = function(e) {

                if (verbose) {

                    cat(
                        "Vine transformation failed:",
                        conditionMessage(e),
                        "\n"
                    )

                }

                NULL

            }

        )

        if (
            is.null(d)
        ) {

            return(NULL)

        }

        covars <- grep(
            "^X[0-9]+_VINE$|^VINE_INT_",
            names(d),
            value = TRUE
        )

    } else {

        d <- add_raw_variables(
            data
        )

        covars <- paste0(
            "X",
            seq_len(P)
        )

    }

    ##########################################################################
    # Check covariates
    ##########################################################################

    if (
        length(covars) == 0
    ) {

        if (verbose) {

            cat(
                method,
                ": no usable covariates.\n"
            )

        }

        return(NULL)

    }

    ##########################################################################
    # CSC
    ##########################################################################

    model <- fit_competing_risk_model(
        d,
        covars,
        verbose = verbose
    )

    if (
        is.null(model)
    ) {

        return(NULL)

    }

    ##########################################################################
    # Counterfactual data
    ##########################################################################

    d0 <- d

    d0$treatment <- 0L

    d1 <- d

    d1$treatment <- 1L

    ##########################################################################
    # CIF predictions
    ##########################################################################

    p01 <- safe_predict_cif(
        model,
        d0,
        cause = 1,
        tau = tau,
        verbose = verbose
    )

    p02 <- safe_predict_cif(
        model,
        d0,
        cause = 2,
        tau = tau,
        verbose = verbose
    )

    p11 <- safe_predict_cif(
        model,
        d1,
        cause = 1,
        tau = tau,
        verbose = verbose
    )

    p12 <- safe_predict_cif(
        model,
        d1,
        cause = 2,
        tau = tau,
        verbose = verbose
    )

    ##########################################################################
    # Validity
    ##########################################################################

    valid <- (
        is.finite(p01) &
        is.finite(p02) &
        is.finite(p11) &
        is.finite(p12)
    )

    n_valid <- sum(valid)

    if (
        n_valid < 0.50 * nrow(d)
    ) {

        if (verbose) {

            cat(
                method,
                ": only",
                n_valid,
                "of",
                nrow(d),
                "valid predictions.\n"
            )

        }

        return(NULL)

    }

    ##########################################################################
    # Values
    ##########################################################################

    V0 <- -(
        weights[1] * p01 +
        weights[2] * p02
    )

    V1 <- -(
        weights[1] * p11 +
        weights[2] * p12
    )

    estimated_cate <- V1 - V0

    estimated_rule <- ifelse(
        estimated_cate > 0,
        1L,
        0L
    )

    ##########################################################################
    # Return
    ##########################################################################

    list(

        success = TRUE,

        method = method,

        model = model,

        data = d,

        covariates = covars,

        CIF_A0_Cause1 = p01,

        CIF_A0_Cause2 = p02,

        CIF_A1_Cause1 = p11,

        CIF_A1_Cause2 = p12,

        Value_A0 = V0,

        Value_A1 = V1,

        Estimated_CATE =
            estimated_cate,

        Estimated_Rule =
            estimated_rule,

        Valid =
            valid,

        Valid_N =
            n_valid

    )

}


################################################################################
# 16. EVALUATE ONE FIT
################################################################################

evaluate_method <- function(
        fit,
        data
) {

    if (
        is.null(fit) ||
        !isTRUE(fit$success)
    ) {

        return(NULL)

    }

    valid <- (
        fit$Valid &
        is.finite(fit$Estimated_CATE) &
        is.finite(data$TRUE_CONTRAST) &
        is.finite(data$TRUE_VALUE_A0) &
        is.finite(data$TRUE_VALUE_A1)
    )

    n_valid <- sum(valid)

    if (
        n_valid < 0.50 * nrow(data)
    ) {

        return(NULL)

    }

    est_cate <- fit$Estimated_CATE

    true_cate <- data$TRUE_CONTRAST

    estimated_ate <- mean(
        est_cate[valid],
        na.rm = TRUE
    )

    true_ate <- mean(
        true_cate[valid],
        na.rm = TRUE
    )

    ate_bias <- (
        estimated_ate -
        true_ate
    )

    ate_squared_error <- (
        estimated_ate -
        true_ate
    )^2

    individual_bias <- mean(
        est_cate[valid] -
            true_cate[valid],
        na.rm = TRUE
    )

    pehe <- sqrt(
        mean(
            (
                est_cate[valid] -
                true_cate[valid]
            )^2,
            na.rm = TRUE
        )
    )

    estimated_rule <- fit$Estimated_Rule

    true_rule <- data$TRUE_RULE

    rule_accuracy <- mean(
        estimated_rule[valid] ==
            true_rule[valid],
        na.rm = TRUE
    )

    TP <- sum(
        estimated_rule[valid] == 1 &
        true_rule[valid] == 1
    )

    TN <- sum(
        estimated_rule[valid] == 0 &
        true_rule[valid] == 0
    )

    FP <- sum(
        estimated_rule[valid] == 1 &
        true_rule[valid] == 0
    )

    FN <- sum(
        estimated_rule[valid] == 0 &
        true_rule[valid] == 1
    )

    sensitivity <- if (
        TP + FN > 0
    ) {

        TP / (TP + FN)

    } else {

        NA_real_

    }

    specificity <- if (
        TN + FP > 0
    ) {

        TN / (TN + FP)

    } else {

        NA_real_

    }

    false_positive_rate <- if (
        TN + FP > 0
    ) {

        FP / (TN + FP)

    } else {

        NA_real_

    }

    false_negative_rate <- if (
        TP + FN > 0
    ) {

        FN / (TP + FN)

    } else {

        NA_real_

    }

    treatment1_rate <- mean(
        estimated_rule[valid] == 1
    )

    estimated_policy_value <- mean(

        ifelse(
            estimated_rule[valid] == 1,
            data$TRUE_VALUE_A1[valid],
            data$TRUE_VALUE_A0[valid]
        ),

        na.rm = TRUE

    )

    optimal_policy_value <- mean(
        data$TRUE_OPTIMAL_VALUE[valid],
        na.rm = TRUE
    )

    regret <- (
        optimal_policy_value -
        estimated_policy_value
    )

    denominator <- abs(
        optimal_policy_value
    )

    relative_value_loss <- if (
        is.finite(denominator) &&
        denominator > 1e-8
    ) {

        regret / denominator

    } else {

        NA_real_

    }

    true_treatment1_rate <- mean(
        true_rule[valid] == 1
    )

    true_cate_sd <- sd(
        true_cate[valid]
    )

    estimated_cate_sd <- sd(
        est_cate[valid]
    )

    cate_sign_agreement <- mean(
        sign(est_cate[valid]) ==
            sign(true_cate[valid])
    )

    data.frame(

        ATE = estimated_ate,

        True_ATE = true_ate,

        ATE_Bias = ate_bias,

        ATE_Squared_Error =
            ate_squared_error,

        Individual_Bias =
            individual_bias,

        PEHE_RMSE =
            pehe,

        True_CATE_SD =
            true_cate_sd,

        Estimated_CATE_SD =
            estimated_cate_sd,

        CATE_Sign_Agreement =
            cate_sign_agreement,

        Policy_Value =
            estimated_policy_value,

        Optimal_Policy_Value =
            optimal_policy_value,

        Regret =
            regret,

        Relative_Value_Loss =
            relative_value_loss,

        Rule_Accuracy =
            rule_accuracy,

        Sensitivity =
            sensitivity,

        Specificity =
            specificity,

        False_Positive_Rate =
            false_positive_rate,

        False_Negative_Rate =
            false_negative_rate,

        Treatment1_Rate =
            treatment1_rate,

        True_Treatment1_Rate =
            true_treatment1_rate,

        Valid_N =
            n_valid,

        stringsAsFactors = FALSE

    )

}


