    NoCopula_Valid_N = integer(0),

    stringsAsFactors = FALSE

)


################################################################################
# 24. MONTE CARLO LOOP
################################################################################

for (
    r in seq_len(N_REP)
) {

    cat(
        "\nReplication",
        r,
        "of",
        N_REP,
        "\n"
    )

    set.seed(
        SEED_BASE + r
    )

    ##########################################################################
    # Generate
    ##########################################################################

    sim_data <- tryCatch(

        generate_data(
            sample_size = N,
            p = P,
            rho = RHO,
            tau = TAU,
            censor_rate = CENSOR_RATE
        ),

        error = function(e) {

            cat(
                "Data generation failed:",
                conditionMessage(e),
                "\n"
            )

            NULL

        }

    )

    if (
        is.null(sim_data)
    ) {

        failure_log <- rbind(

            failure_log,

            data.frame(

                Replication = r,

                Copula_Failed = TRUE,

                NoCopula_Failed = TRUE,

                Max_Observed_Time = NA_real_,

                Censoring_Proportion = NA_real_,

                True_Treatment1_Rate = NA_real_,

                True_Contrast_Mean = NA_real_,

                True_Contrast_SD = NA_real_,

                Copula_Valid_N = 0L,

                NoCopula_Valid_N = 0L

            )

        )

        next

    }

    ##########################################################################
    # Diagnostics
    ##########################################################################

    max_time <- max(
        sim_data$time,
        na.rm = TRUE
    )

    censor_prop <- mean(
        sim_data$status == 0,
        na.rm = TRUE
    )

    true_treat1_rate <- mean(
        sim_data$TRUE_RULE == 1,
        na.rm = TRUE
    )

    true_contrast_mean <- mean(
        sim_data$TRUE_CONTRAST,
        na.rm = TRUE
    )

    true_contrast_sd <- sd(
        sim_data$TRUE_CONTRAST,
        na.rm = TRUE
    )

    cat(
        "Max time:",
        round(max_time, 2),
        "\n"
    )

    cat(
        "Censoring:",
        round(censor_prop, 3),
        "\n"
    )

    cat(
        "True treatment-1 rate:",
        round(true_treat1_rate, 3),
        "\n"
    )

    ##########################################################################
    # TAU
    ##########################################################################

    if (
        max_time < TAU
    ) {

        failure_log <- rbind(

            failure_log,

            data.frame(

                Replication = r,

                Copula_Failed = TRUE,

                NoCopula_Failed = TRUE,

                Max_Observed_Time = max_time,

                Censoring_Proportion = censor_prop,

                True_Treatment1_Rate =
                    true_treat1_rate,

                True_Contrast_Mean =
                    true_contrast_mean,

                True_Contrast_SD =
                    true_contrast_sd,

                Copula_Valid_N = 0L,

                NoCopula_Valid_N = 0L

            )

        )

        next

    }

    ##########################################################################
    # VINE COPULA
    ##########################################################################

    fit_cop <- tryCatch(

        fit_method(
            sim_data,
            method = "Copula",
            tau = TAU,
            weights = WEIGHTS,
            verbose = FALSE
        ),

        error = function(e) {

            cat(
                "Vine-Copula failed:",
                conditionMessage(e),
                "\n"
            )

            NULL

        }

    )

    ##########################################################################
    # NO COPULA
    ##########################################################################

    fit_raw <- tryCatch(

        fit_method(
            sim_data,
            method = "No-Copula",
            tau = TAU,
            weights = WEIGHTS,
            verbose = FALSE
        ),

        error = function(e) {

            cat(
                "No-Copula failed:",
                conditionMessage(e),
                "\n"
            )

            NULL

        }

    )

    ##########################################################################
    # EVALUATION
    ##########################################################################

    eval_cop <- evaluate_method(
        fit_cop,
        sim_data
    )

    eval_raw <- evaluate_method(
        fit_raw,
        sim_data
    )

    ##########################################################################
    # FAILURE LOG
    ##########################################################################

    cop_failed <- is.null(
        eval_cop
    )

    raw_failed <- is.null(
        eval_raw
    )

    cop_valid_n <- if (
        !is.null(eval_cop)
    ) {

        eval_cop$Valid_N

    } else {

        0L

    }

    raw_valid_n <- if (
        !is.null(eval_raw)
    ) {

        eval_raw$Valid_N

    } else {

        0L

    }

    failure_log <- rbind(

        failure_log,

        data.frame(

            Replication = r,

            Copula_Failed = cop_failed,

            NoCopula_Failed = raw_failed,

            Max_Observed_Time = max_time,

            Censoring_Proportion = censor_prop,

            True_Treatment1_Rate =
                true_treat1_rate,

            True_Contrast_Mean =
                true_contrast_mean,

            True_Contrast_SD =
                true_contrast_sd,

            Copula_Valid_N =
                cop_valid_n,

            NoCopula_Valid_N =
                raw_valid_n

        )

    )

    ##########################################################################
    # STORE
    ##########################################################################

    temp <- list()

    if (
        !is.null(eval_cop)
    ) {

        temp[[length(temp) + 1]] <-

            cbind(
                Method = "Vine-Copula",
                Replication = r,
                eval_cop
            )

    }

    if (
        !is.null(eval_raw)
    ) {

        temp[[length(temp) + 1]] <-

            cbind(
                Method = "No-Copula",
                Replication = r,
                eval_raw
            )

    }

    if (
        length(temp) > 0
    ) {

        simulation_results_list[[r]] <-

            bind_rows(
                temp
            )

    }

}


