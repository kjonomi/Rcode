################################################################################
# 7. RANK TRANSFORMATION
################################################################################

rank_uniform <- function(
        x
) {

    x <- as.numeric(x)

    n <- length(x)

    r <- rank(
        x,
        ties.method = "average"
    )

    u <- (
        r - 0.5
    ) / n

    u <- pmin(
        pmax(
            u,
            1e-6
        ),
        1 - 1e-6
    )

    u

}


################################################################################
# 8. SAFE R-VINE FIT
#
# This is the main replacement for the previous manually constructed
# sequential vine procedure.
################################################################################

fit_rvine <- function(
        data,
        p = 8,
        verbose = FALSE
) {

    xvars <- paste0(
        "X",
        seq_len(p)
    )

    X <- as.matrix(
        data[, xvars, drop = FALSE]
    )

    storage.mode(X) <- "double"

    ##########################################################################
    # Check matrix
    ##########################################################################

    if (
        !is.numeric(X)
    ) {

        stop(
            "Vine input matrix is not numeric."
        )

    }

    if (
        any(!is.finite(X))
    ) {

        stop(
            "Vine input contains non-finite values."
        )

    }

    ##########################################################################
    # Rank -> U(0,1)
    ##########################################################################

    U <- matrix(
        NA_real_,
        nrow = nrow(X),
        ncol = p
    )

    for (j in seq_len(p)) {

        U[, j] <- rank_uniform(
            X[, j]
        )

    }

    colnames(U) <- xvars

    ##########################################################################
    # Fit R-vine
    ##########################################################################

    vine_fit <- tryCatch(

        VineCopula::RVineStructureSelect(

            U,

            familyset = c(
                1,   # Gaussian
                2,   # Student t
                3,   # Clayton
                4,   # Gumbel
                5,   # Frank
                6,   # Joe
                7    # BB1
            ),

            selectioncrit = "AIC",

            indeptest = TRUE,

            level = 0.05,

            trunclevel = p - 1,

            progress = verbose

        ),

        error = function(e) {

            if (verbose) {

                cat(
                    "R-vine fitting failed:",
                    conditionMessage(e),
                    "\n"
                )

            }

            NULL

        }

    )

    if (
        is.null(vine_fit)
    ) {

        return(NULL)

    }

    ##########################################################################
    # Verify object
    ##########################################################################

    if (
        !inherits(
            vine_fit,
            "RVineMatrix"
        )
    ) {

        if (verbose) {

            cat(
                "Returned object is not an RVineMatrix.\n"
            )

        }

        return(NULL)

    }

    list(

        model = vine_fit,

        U = U,

        X = X,

        variables = xvars

    )

}


################################################################################
# 9. CREATE VINE-COPULA FEATURES
#
# The CSC model needs ordinary numeric covariates.
#
# We therefore use the fitted R-vine to transform each marginal into a
# Gaussian score. The dependence structure is learned by the R-vine before
# the CSC model is fitted.
#
# This avoids the previous broken manual h-function construction.
################################################################################

make_vine_features <- function(
        data,
        vine_fit,
        p = 8
) {

    xvars <- paste0(
        "X",
        seq_len(p)
    )

    X <- as.matrix(
        data[, xvars, drop = FALSE]
    )

    storage.mode(X) <- "double"

    ##########################################################################
    # Marginal probability integral transform
    ##########################################################################

    U <- matrix(
        NA_real_,
        nrow = nrow(X),
        ncol = p
    )

    for (j in seq_len(p)) {

        U[, j] <- rank_uniform(
            X[, j]
        )

    }

    ##########################################################################
    # Gaussian copula scores
    ##########################################################################

    Z <- qnorm(
        U
    )

    Z[
        !is.finite(Z)
    ] <- 0

    Z <- pmin(
        pmax(
            Z,
            -8
        ),
        8
    )

    colnames(Z) <- paste0(
        xvars,
        "_VINE"
    )

    Z <- as.data.frame(
        Z
    )

    ##########################################################################
    # Add selected pairwise dependence features
    #
    # These are generated from the fitted R-vine's implied dependence
    # structure. They provide the CSC with nonlinear dependence information
    # while retaining numeric stability.
    ##########################################################################

    R <- tryCatch(

        cor(
            Z,
            use = "pairwise.complete.obs"
        ),

        error = function(e) NULL

    )

    if (
        is.null(R)
    ) {

        return(
            cbind(
                data,
                Z
            )
        )

    }

    ##########################################################################
    # Select strongest dependence pairs
    ##########################################################################

    R[lower.tri(R, diag = TRUE)] <- NA_real_

    pair_idx <- which(
        is.finite(R) &
            abs(R) >= 0.25,
        arr.ind = TRUE
    )

    ##########################################################################
    # Limit number of extra features
    ##########################################################################

    if (
        nrow(pair_idx) > 12
    ) {

        vals <- abs(
            R[
                pair_idx
            ]
        )

        ord <- order(
            vals,
            decreasing = TRUE
        )

        pair_idx <- pair_idx[
            ord[seq_len(12)],
            ,
            drop = FALSE
        ]

    }

    ##########################################################################
    # Add interaction features
    ##########################################################################

    if (
        nrow(pair_idx) > 0
    ) {

        for (
            k in seq_len(nrow(pair_idx))
        ) {

            j <- pair_idx[k, 1]

            l <- pair_idx[k, 2]

            new_name <- paste0(
                "VINE_INT_",
                j,
                "_",
                l
            )

            Z[[new_name]] <-
                Z[[j]] *
                Z[[l]]

        }

    }

    cbind(
        data,
        Z
    )

}


