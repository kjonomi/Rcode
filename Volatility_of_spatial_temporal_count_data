        logical(1),
        inherits = TRUE
    )
]

if (length(missing_objects_25) > 0) {
    
    stop(
        paste(
            "Section 25 is missing required objects:",
            paste(missing_objects_25, collapse = ", ")
        )
    )
}


################################################################################
# 25.0.1 INITIALIZE DIAGNOSTIC OBJECTS
################################################################################

silhouette_df <- data.frame(
    State = character(),
    Cluster = integer(),
    Silhouette_Width = numeric(),
    stringsAsFactors = FALSE
)


cluster_diagnostic_by_cluster <- data.frame(
    Cluster = integer(),
    Number_of_States = integer(),
    Mean_Silhouette_Width = numeric(),
    Minimum_Silhouette_Width = numeric(),
    Maximum_Silhouette_Width = numeric(),
    Negative_Silhouette_Count = integer(),
    Weak_Silhouette_Count = integer(),
    stringsAsFactors = FALSE
)


silhouette_width <- NA_real_


################################################################################
# 25.1 FINAL SILHOUETTE DIAGNOSTIC
################################################################################
#
# Calculate the silhouette statistic for the FINAL selected K-means
# partition.
#
################################################################################

if (
    nrow(cluster_assignment) > 0 &&
    is.finite(selected_k) &&
    selected_k >= 2 &&
    nrow(volatility_matrix_scaled) >= selected_k
) {
    
    # ------------------------------------------------------------
    # Validate cluster labels
    # ------------------------------------------------------------
    
    cluster_labels <- as.integer(
        cluster_assignment$Cluster
    )
    
    
    if (
        length(cluster_labels) !=
        nrow(volatility_matrix_scaled)
    ) {
        
        stop(
            "Number of cluster assignments does not match the number of states."
        )
    }
    
    
    if (
        any(
            !is.finite(cluster_labels)
        )
    ) {
        
        stop(
            "Nonfinite cluster labels detected."
        )
    }
    
    
    if (
        length(unique(cluster_labels)) != selected_k
    ) {
        
        stop(
            "Final cluster assignment does not contain the selected number of clusters."
        )
    }
    
    
    # ------------------------------------------------------------
    # Confirm state ordering
    # ------------------------------------------------------------
    
    trajectory_states <- rownames(
        volatility_matrix_scaled
    )
    
    
    assignment_states <- cluster_assignment$State[
        match(
            trajectory_states,
            cluster_assignment$State
        )
    ]
    
    
    if (
        any(
            is.na(assignment_states)
        )
    ) {
        
        stop(
            "Some trajectory states do not have a cluster assignment."
        )
    }
    
    
    cluster_labels_ordered <-
        cluster_assignment$Cluster[
            match(
                trajectory_states,
                cluster_assignment$State
            )
        ]
    
    
    # ------------------------------------------------------------
    # Euclidean trajectory distance
    # ------------------------------------------------------------
    
    distance_matrix <- dist(
        volatility_matrix_scaled,
        method = "euclidean"
    )
    
    
    # ------------------------------------------------------------
    # Final silhouette calculation
    # ------------------------------------------------------------
    
    silhouette_result <- cluster::silhouette(
        cluster_labels_ordered,
        distance_matrix
    )
    
    
    silhouette_width <- mean(
        silhouette_result[, "sil_width"],
        na.rm = TRUE
    )
    
    
    cat(
        "\n============================================================\n"
    )
    
    cat(
        "FINAL VOLATILITY TRAJECTORY CLUSTERING DIAGNOSTIC\n"
    )
    
    cat(
        "============================================================\n"
    )
    
    cat(
        "Selected K:                 ",
        selected_k,
        "\n"
    )
    
    cat(
        "Average silhouette width:   ",
        round(
            silhouette_width,
            4
        ),
        "\n"
    )
    
    
    ################################################################################
    # 25.1.1 QUALITATIVE SILHOUETTE INTERPRETATION
    ################################################################################
    
    if (
        silhouette_width >= 0.50
    ) {
        
        silhouette_interpretation <-
            "Strong cluster separation"
        
    } else if (
        silhouette_width >= 0.25
    ) {
        
        silhouette_interpretation <-
            "Moderate/reasonable cluster separation"
        
    } else if (
        silhouette_width > 0
    ) {
        
        silhouette_interpretation <-
            "Weak cluster separation; substantial overlap among clusters"
        
    } else {
        
        silhouette_interpretation <-
            "No meaningful cluster separation; cluster assignments should be interpreted cautiously"
    }
    
    
    cat(
        "Interpretation:              ",
        silhouette_interpretation,
        "\n"
    )
    
    
    ################################################################################
    # 25.1.2 INDIVIDUAL SILHOUETTE WIDTHS
    ################################################################################
    
    silhouette_df <- data.frame(
        
        State =
            trajectory_states,
        
        Cluster =
            as.integer(
                cluster_labels_ordered
            ),
        
        Silhouette_Width =
            as.numeric(
                silhouette_result[, "sil_width"]
            ),
        
        stringsAsFactors = FALSE
    )
    
    
    silhouette_df <- silhouette_df[
        order(
            silhouette_df$Cluster,
            silhouette_df$Silhouette_Width
        ),
        ,
        drop = FALSE
    ]
    
    
    # ------------------------------------------------------------
    # Flag potentially poorly assigned states
    # ------------------------------------------------------------
    
    silhouette_df$Silhouette_Category <-
        ifelse(
            silhouette_df$Silhouette_Width >= 0.50,
            "Strong",
            ifelse(
                silhouette_df$Silhouette_Width >= 0.25,
                "Moderate",
                ifelse(
                    silhouette_df$Silhouette_Width > 0,
                    "Weak",
                    "Nonpositive"
                )
            )
        )
    
    
    write.csv(
        silhouette_df,
        file.path(
            OUTPUT_DIR,
            "volatility_cluster_silhouette_widths.csv"
        ),
        row.names = FALSE
    )
    
    
    ################################################################################
    # 25.1.3 OVERALL DIAGNOSTIC TABLE
    ################################################################################
    
    cluster_diagnostic <- data.frame(
        
        Selected_K =
            selected_k,
        
        Average_Silhouette =
            silhouette_width,
        
        Interpretation =
            silhouette_interpretation,
        
        Number_of_States =
            nrow(
                volatility_matrix_scaled
            ),
        
        Number_of_Training_Timepoints =
            ncol(
                volatility_matrix_scaled
            ),
        
        Negative_Silhouette_Count =
            sum(
                silhouette_df$Silhouette_Width < 0
            ),
        
        Weak_or_Negative_Count =
            sum(
                silhouette_df$Silhouette_Width < 0.25
            ),
        
        stringsAsFactors = FALSE
    )
    
    
    write.csv(
        cluster_diagnostic,
        file.path(
            OUTPUT_DIR,
            "volatility_cluster_diagnostic.csv"
        ),
        row.names = FALSE
    )
    
    
    ################################################################################
    # 25.1.4 CLUSTER-LEVEL SILHOUETTE SUMMARY
    ################################################################################
    
    cluster_levels <- sort(
        unique(
            silhouette_df$Cluster
        )
    )
    
    
    cluster_diagnostic_by_cluster <- do.call(
        rbind,
        lapply(
            cluster_levels,
            function(cl) {
                
                x <- silhouette_df$Silhouette_Width[
                    silhouette_df$Cluster == cl
                ]
                
                
                data.frame(
                    
                    Cluster =
                        cl,
                    
                    Number_of_States =
                        length(x),
                    
                    Mean_Silhouette_Width =
                        mean(
                            x,
                            na.rm = TRUE
                        ),
                    
                    Minimum_Silhouette_Width =
                        min(
                            x,
                            na.rm = TRUE
                        ),
                    
                    Maximum_Silhouette_Width =
                        max(
                            x,
                            na.rm = TRUE
                        ),
                    
                    Negative_Silhouette_Count =
                        sum(
                            x < 0
                        ),
                    
                    Weak_Silhouette_Count =
                        sum(
                            x < 0.25
                        ),
                    
                    stringsAsFactors = FALSE
                )
            }
        )
    )
    
    
    write.csv(
        cluster_diagnostic_by_cluster,
        file.path(
            OUTPUT_DIR,
            "volatility_cluster_silhouette_by_cluster.csv"
        ),
        row.names = FALSE
    )
    
    
    print(
        cluster_diagnostic_by_cluster
    )
}


