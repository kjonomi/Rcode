################################################################################
#
# REVIEWER 2-4:
#
# The original analysis imposed K = 3 without demonstrating that three
# volatility regimes were supported by the data.
#
# Section 24 evaluates candidate K values using the average silhouette width
# and selects the K with the largest average silhouette.
#
# Section 25 provides the FINAL diagnostic for the selected clustering
# solution, including:
#
#   (i)   overall average silhouette width,
#   (ii)  individual state-level silhouette widths,
#   (iii) cluster-level silhouette summaries,
#   (iv)  qualitative separation assessment, and
#   (v)   final cluster membership combined with volatility magnitude.
#
# IMPORTANT INTERPRETATION:
#
# The following are descriptive heuristic benchmarks:
#
#   silhouette >= 0.50:
#       strong separation
#
#   0.25 <= silhouette < 0.50:
#       moderate/reasonable separation
#
#   0 < silhouette < 0.25:
#       weak separation
#
#   silhouette <= 0:
#       substantial overlap / potentially inappropriate assignment
#
# These thresholds are NOT formal hypothesis tests and should not be
# interpreted as statistical significance levels.
#
# The clustering remains based exclusively on standardized TRAINING-PERIOD
# volatility trajectories. The TEST period is not used.
#
################################################################################


################################################################################
# 25.0 VALIDATE REQUIRED OBJECTS
################################################################################

required_objects_25 <- c(
    "volatility_matrix_scaled",
    "cluster_assignment",
    "selected_k",
    "OUTPUT_DIR"
)

missing_objects_25 <- required_objects_25[
