    "\n",
    sep = ""
)

cat(
    "NA volatility values: ",
    na_vol_count,
    "\n",
    sep = ""
)


################################################################################
# 18.3 VERIFY GARCH DIAGNOSTIC INFORMATION
################################################################################

cat("\n============================================================\n")
cat("18.3 VERIFY GARCH DIAGNOSTICS\n")
cat("============================================================\n")


required_garch_columns <- c(
    "State",
    "GARCH_Persistence",
    "GARCH_Method",
    "GARCH_Status",
    "Innovation_SD_Train"
)

missing_garch_columns <- setdiff(
