        garch_stats$GARCH_Persistence[garch_match]
    )
)

garch_method <- as.character(
    garch_stats$GARCH_Method[garch_match]
)

garch_status <- as.character(
    garch_stats$GARCH_Status[garch_match]
)

innovation_sd_train <- suppressWarnings(
