################################################################################
# 13. CROSS-LOCATION COPULA MODEL
################################################################################
#
# AE-2 / R1-2:
#
# The copula models CROSS-LOCATION DEPENDENCE in standardized count
# innovations.
#
# It does NOT modify the marginal conditional mean.
#
# For each day t:
#
#       U_t =
#       (U_t1, ..., U_tN)
#
# represents the cross-sectional dependence among states.
#
# The copula is therefore separated from:
#
#   1. marginal conditional mean
#   2. marginal count variance
#   3. temporal GARCH volatility
#
# No copula quantity is multiplied by mean_mat.
#
################################################################################


# -------------------------------------------------------------------------
# 13.1 TRAINING INNOVATIONS
# -------------------------------------------------------------------------

innovation_train <- innovation_mat[
    train_idx,
    ,
    drop = FALSE
]


# -------------------------------------------------------------------------
# 13.2 REMOVE NON-FINITE VALUES
# -------------------------------------------------------------------------
#
# For copula estimation, replacing an invalid value by zero can create an
# artificial dependence observation. Therefore, invalid observations are
# treated as missing rather than replaced by zero.
#
# Complete temporal rows are retained for the high-dimensional copula.
#
# -------------------------------------------------------------------------

innovation_train[
    !is.finite(innovation_train)
] <- NA_real_


# -------------------------------------------------------------------------
# 13.3 RANK-BASED PSEUDO-OBSERVATIONS
# -------------------------------------------------------------------------

u_spatial <- pobs(
    innovation_train,
    ties.method = "average"
)

u_spatial <- as.matrix(
    u_spatial
)


# -------------------------------------------------------------------------
# 13.4 COMPLETE COPULA OBSERVATIONS
# -------------------------------------------------------------------------

complete_u <- complete.cases(
    u_spatial
)

u_spatial_complete <- u_spatial[
    complete_u,
    ,
    drop = FALSE
]


cat("\n============================================================\n")
cat("COPULA DATA DIMENSIONS\n")
cat("============================================================\n")

cat(
    "Training observations:",
    nrow(u_spatial_complete),
    "\n"
)

cat(
    "Locations:",
    ncol(u_spatial_complete),
    "\n"
)


################################################################################
# 14. FAST GAUSSIAN COPULA AND CLAYTON COPULA DEPENDENCE ESTIMATION
################################################################################
#
# AE-1 / R2-3:
#
# PURPOSE:
#
# Estimate cross-state dependence using the TRAINING period only.
#
# IMPORTANT METHODOLOGICAL POINT:
#
# The marginal count models and the Gaussian copula dependence structure
# are estimated separately.
#
# The Gaussian copula is estimated from Gaussianized pseudo-observations:
#
#       U_it = empirical pseudo-observation
#
#       Z_it = Phi^{-1}(U_it)
#
# followed by:
#
#       R_hat = Cor(Z)
#
# This is the standard rank/pseudo-observation-based Gaussian copula
# correlation estimator and avoids high-dimensional iterative MPL
# optimization over 1,275 correlation parameters.
#
# For 51 states:
#
#       51 * 50 / 2 = 1,275
#
# pairwise dependence parameters are represented by the correlation matrix.
#
# IMPORTANT:
#
#   * Copula estimation uses TRAINING observations only.
#   * The held-out TEST period is not used to estimate dependence.
#   * Gaussian copula dependence is estimated separately from the marginal
#     count-model/GARCH volatility analysis.
#   * The Gaussian copula is NOT treated as a fitted 'fitCopula' object.
#   * Its log-likelihood is calculated explicitly below.
#
################################################################################


################################################################################
# 14.0 REQUIRED OBJECT CHECKS
################################################################################

required_objects_14 <- c(
    "u_spatial_complete",
    "n_loc",
    "locations",
    "train_idx",
    "test_idx",
    "EPS",
    "OUTPUT_DIR"
)

missing_objects_14 <- required_objects_14[
    !vapply(
        required_objects_14,
        exists,
        logical(1),
        inherits = TRUE
    )
]

if (length(missing_objects_14) > 0) {

    stop(
        paste(
            "Section 14 cannot proceed. Missing object(s):",
            paste(
                missing_objects_14,
                collapse = ", "
            )
        )
    )
}


################################################################################
# 14.0.1 VALIDATE PSEUDO-OBSERVATIONS
################################################################################

u_spatial_complete <- as.matrix(
    u_spatial_complete
)

if (ncol(u_spatial_complete) != n_loc) {

    stop(
        paste(
            "u_spatial_complete has",
            ncol(u_spatial_complete),
            "columns but n_loc =",
            n_loc
        )
    )
}


if (ncol(u_spatial_complete) != length(locations)) {

    stop(
        "Number of copula dimensions does not match number of locations."
    )
}


################################################################################
# 14.0.2 DEFINE SAFE PSEUDO-OBSERVATIONS
################################################################################
#
# qnorm(0) = -Inf and qnorm(1) = Inf.
#
# To avoid infinite Gaussian scores, pseudo-observations are constrained
# to the open interval (0,1).
#
################################################################################

u_spatial_complete[
    !is.finite(
        u_spatial_complete
    )
] <- NA_real_


u_spatial_complete <- pmin(
    pmax(
        u_spatial_complete,
        EPS
    ),
    1 - EPS
)


################################################################################
# 14.1 FAST GAUSSIAN COPULA DEPENDENCE ESTIMATION
################################################################################

cat("\n")
cat("============================================================\n")
cat("FAST GAUSSIAN COPULA DEPENDENCE ESTIMATION\n")
cat("============================================================\n\n")


################################################################################
# 14.1.1 GAUSSIANIZE PSEUDO-OBSERVATIONS
################################################################################

z_spatial <- qnorm(
    u_spatial_complete
)


################################################################################
# 14.1.2 RETAIN COMPLETE TRAINING ROWS ONLY
################################################################################
#
# u_spatial_complete is expected to represent the training-period
# pseudo-observations.
#
# No test observations are introduced here.
#
################################################################################

valid_z_rows <- apply(
    z_spatial,
    1,
    function(x) all(
        is.finite(x)
    )
)


z_spatial <- z_spatial[
    valid_z_rows,
    ,
    drop = FALSE
]


if (nrow(z_spatial) < 2) {

    stop(
        "Insufficient complete observations for Gaussian copula estimation."
    )
}


cat(
    "Gaussian copula observations:",
    nrow(z_spatial),
    "\n"
)

cat(
    "Gaussian copula dimensions:",
    ncol(z_spatial),
    "\n"
)

cat(
    "Gaussian copula correlation parameters:",
    ncol(z_spatial) *
        (ncol(z_spatial) - 1) / 2,
    "\n"
)


################################################################################
# 14.1.3 ESTIMATE GAUSSIAN COPULA CORRELATION MATRIX
################################################################################

gaussian_correlation <- cor(
    z_spatial,
    method = "pearson",
    use = "pairwise.complete.obs"
)


################################################################################
# 14.1.4 BASIC CORRELATION VALIDATION
################################################################################

if (!all(
    is.finite(
        gaussian_correlation
    )
)) {

    stop(
        "Gaussian copula correlation matrix contains non-finite values."
    )
}


gaussian_correlation <- (
    gaussian_correlation +
        t(gaussian_correlation)
) / 2


diag(
    gaussian_correlation
) <- 1


rownames(
    gaussian_correlation
) <- locations

colnames(
    gaussian_correlation
) <- locations


################################################################################
# 14.1.5 POSITIVE-DEFINITENESS CHECK
################################################################################

eigen_values_before <- eigen(
    gaussian_correlation,
    symmetric = TRUE,
    only.values = TRUE
)$values


nearPD_used <- FALSE


if (
    min(eigen_values_before) <= EPS
) {

    if (!requireNamespace("Matrix", quietly = TRUE)) {

        stop(
            paste(
                "The Gaussian correlation matrix is not positive definite",
                "and package 'Matrix' is required for nearPD correction."
            )
        )
    }


    gaussian_correlation <- as.matrix(
        Matrix::nearPD(
            gaussian_correlation,
            corr = TRUE
        )$mat
    )


    gaussian_correlation <- (
        gaussian_correlation +
            t(gaussian_correlation)
    ) / 2


    diag(
        gaussian_correlation
    ) <- 1


    rownames(
        gaussian_correlation
    ) <- locations

    colnames(
        gaussian_correlation
    ) <- locations


    nearPD_used <- TRUE


    cat(
        "\nGaussian copula correlation matrix required ",
        "near-positive-definite adjustment.\n",
        sep = ""
    )
}


################################################################################
# 14.1.6 FINAL POSITIVE-DEFINITENESS CHECK
################################################################################

eigen_values_after <- eigen(
    gaussian_correlation,
    symmetric = TRUE,
    only.values = TRUE
)$values


if (
    min(eigen_values_after) <= 0
) {

    stop(
        "Gaussian correlation matrix remains non-positive-definite."
    )
}


################################################################################
# 14.1.7 STORE GAUSSIAN COPULA OBJECT
################################################################################
#
# This is deliberately a simple custom object.
#
# It is NOT a 'fitCopula' object.
#
################################################################################

gaussian_fit <- list(

    correlation =
        gaussian_correlation,

    dimension =
        ncol(
            gaussian_correlation
        ),

    n_obs =
        nrow(
            z_spatial
        ),

    method =
        "Gaussianized pseudo-observation correlation",

    nearPD_adjustment =
        nearPD_used,

    training_only =
        TRUE
)


class(
    gaussian_fit
) <- "fastGaussianCopula"


################################################################################
# 14.1.8 GAUSSIAN COPULA LOG-LIKELIHOOD
################################################################################
#
# Purpose:
#   Calculate the Gaussian copula log-likelihood from the estimated
#   correlation matrix and Gaussianized pseudo-observations.
#
# Gaussian copula density:
#
#       c_R(u)
#
#       = |R|^{-1/2}
#         exp{
#             -1/2 z' (R^{-1} - I) z
#         }
#
# Therefore:
#
#       log c_R(u)
#
#       = -1/2 [
#             log|R|
#             + z'(R^{-1}-I)z
#         ]
#
# summed over observations.
#
# IMPORTANT:
#   This is the Gaussian copula log-likelihood only. It is NOT the
#   likelihood of the marginal negative-binomial count models.
#
# IMPORTANT:
#   The Gaussian copula is estimated using TRAINING-PERIOD observations only.
#
################################################################################


cat(
    "\n============================================================\n"
)
cat(
    "14.1.8 GAUSSIAN COPULA LOG-LIKELIHOOD\n"
)
cat(
    "============================================================\n"
)


################################################################################
# 1. REQUIRED OBJECT CHECK
################################################################################

required_objects_148 <- c(
    "gaussian_correlation",
    "z_spatial",
    "n_loc",
    "n_days"
)

missing_objects_148 <- required_objects_148[
    !vapply(
        required_objects_148,
        exists,
        logical(1),
        inherits = TRUE
    )
]

if (length(missing_objects_148) > 0) {

    stop(
        paste(
            "Section 14.1.8 cannot proceed. Missing object(s):",
            paste(missing_objects_148, collapse = ", ")
        )
    )

}


################################################################################
# 2. BASIC DIMENSION CHECKS
################################################################################

if (!is.matrix(z_spatial)) {

    stop(
        "`z_spatial` must be a matrix."
    )

}


if (nrow(z_spatial) < 1) {

    stop(
        "`z_spatial` contains no observations."
    )

}


if (ncol(z_spatial) != n_loc) {

    stop(
        paste(
            "Dimension mismatch:",
            "ncol(z_spatial) =",
            ncol(z_spatial),
            "but n_loc =",
            n_loc
        )
    )

}


if (!is.matrix(gaussian_correlation)) {

    stop(
        "`gaussian_correlation` must be a matrix."
    )

}


if (
    nrow(gaussian_correlation) != n_loc ||
    ncol(gaussian_correlation) != n_loc
) {

    stop(
        paste(
            "Gaussian correlation matrix dimension mismatch:",
            nrow(gaussian_correlation),
            "x",
            ncol(gaussian_correlation),
            "versus expected",
            n_loc,
            "x",
            n_loc
        )
    )

}


################################################################################
# 3. CHECK GAUSSIANIZED OBSERVATIONS
################################################################################

if (any(!is.finite(z_spatial))) {

    stop(
        "z_spatial contains non-finite values."
    )

}


################################################################################
# 4. CHECK CORRELATION MATRIX
################################################################################

R <- gaussian_correlation


if (any(!is.finite(R))) {

    stop(
        "Gaussian correlation matrix contains non-finite values."
    )

}


# Numerical symmetrization
R <- (
    R +
        t(R)
) / 2


# Force diagonal to exactly one
diag(R) <- 1


################################################################################
# 5. POSITIVE-DEFINITENESS CHECK
################################################################################

eigen_R <- eigen(
    R,
    symmetric = TRUE,
    only.values = TRUE
)$values


if (any(!is.finite(eigen_R))) {

    stop(
        "Gaussian correlation matrix has non-finite eigenvalues."
    )

}


if (any(eigen_R <= 0)) {

    stop(
        paste(
            "Gaussian correlation matrix is not positive definite.",
            "Minimum eigenvalue =",
            signif(min(eigen_R), 8)
        )
    )

}


################################################################################
# 6. LOG DETERMINANT
################################################################################

log_det_R <- determinant(
    R,
    logarithm = TRUE
)$modulus

log_det_R <- as.numeric(
    log_det_R
)


if (!is.finite(log_det_R)) {

    stop(
        "Gaussian correlation matrix has a non-finite log determinant."
    )

}


################################################################################
# 7. INVERSE CORRELATION MATRIX
################################################################################

R_inv <- tryCatch(

    solve(R),

    error = function(e) {

        stop(
            paste(
                "Unable to invert Gaussian correlation matrix:",
                e$message
            )
        )

    }

)


if (any(!is.finite(R_inv))) {

    stop(
        "Inverse Gaussian correlation matrix contains non-finite values."
    )

}


################################################################################
# 8. IDENTITY MATRIX
################################################################################

I_d <- diag(
    ncol(z_spatial)
)


################################################################################
# 9. OBSERVATION-SPECIFIC QUADRATIC FORMS
################################################################################
#
# For observation t:
#
#       q_t = z_t' (R^{-1} - I) z_t
#
################################################################################

quad_form <- rowSums(
    (
        z_spatial %*%
            (
                R_inv -
                    I_d
            )
    ) *
        z_spatial
)


if (any(!is.finite(quad_form))) {

    stop(
        "Gaussian copula quadratic forms contain non-finite values."
    )

}


################################################################################
# 10. GAUSSIAN COPULA LOG-LIKELIHOOD
################################################################################
#
#       log L =
#
#       -1/2 [
#             n log|R|
#             +
#             sum_t z_t'(R^{-1}-I)z_t
#         ]
#
################################################################################

gaussian_loglik <- -0.5 * (

    nrow(z_spatial) *
        log_det_R +

        sum(
            quad_form
        )

)


################################################################################
# 11. FINAL LOG-LIKELIHOOD VALIDATION
################################################################################

if (!is.finite(gaussian_loglik)) {

    stop(
        "Gaussian copula log-likelihood is non-finite."
    )

}


gaussian_loglik <- as.numeric(
    gaussian_loglik
)


################################################################################
# 12. DISPLAY RESULTS
################################################################################

cat(
    "\nGaussian copula log-likelihood:",
    format(
        gaussian_loglik,
        digits = 12
    ),
    "\n"
)

cat(
    "Number of observations:",
    nrow(z_spatial),
    "\n"
)

cat(
    "Spatial dimension:",
    ncol(z_spatial),
    "\n"
)

cat(
    "Minimum eigenvalue:",
    format(
        min(eigen_R),
        digits = 8
    ),
    "\n"
)

cat(
    "Maximum eigenvalue:",
    format(
        max(eigen_R),
        digits = 8
    ),
    "\n"
)

cat(
    "Log determinant:",
    format(
        log_det_R,
        digits = 12
    ),
    "\n"
)


################################################################################
# 13. GAUSSIAN COPULA NUMBER OF PARAMETERS
################################################################################
#
# A d-dimensional unrestricted correlation matrix contains:
#
#       d(d-1)/2
#
# free correlation parameters.
#
################################################################################

gaussian_k <- (
    n_loc *
        (n_loc - 1)
) / 2

gaussian_k <- as.integer(
    gaussian_k
)


cat(
    "Number of Gaussian copula parameters:",
    gaussian_k,
    "\n"
)


################################################################################
# 14. AIC
################################################################################
#
#       AIC = -2 log L + 2k
#
################################################################################

gaussian_AIC <- (
    -2 *
        gaussian_loglik
) +
    2 *
    gaussian_k


################################################################################
# 15. BIC
################################################################################
#
#       BIC = -2 log L + log(n) k
#
################################################################################

gaussian_BIC <- (
    -2 *
        gaussian_loglik
) +
    log(
        nrow(z_spatial)
    ) *
    gaussian_k

# =============================================================================
# 16_GARCH_VOLATILITY.R
# =============================================================================
# State-Specific GARCH(1,1) Modeling of Standardized Count Innovations
#
# Innovation:
#     e_t = (Y_t - mu_hat_t) / s_hat_t
#
# GARCH is fitted to standardized count innovations, NOT fitted conditional
# means.
#
# Estimation uses TRAINING data only.
#
# Estimation hierarchy:
#   1. fGarch::garchFit(), nlminb
#   2. fGarch::garchFit(), lbfgsb
#   3. Existing fit_garch_constrained_qml(), if available
#   4. Direct reparameterized Gaussian QML
#
# Constraint:
#     omega > 0
#     alpha >= 0
#     beta >= 0
#     alpha + beta < 0.998
#
# =============================================================================


# =============================================================================
# 16.1 REQUIRED OBJECTS
# =============================================================================

if (!exists("innovation_mat")) {
