################################################################################
# 16. ROBUST GARCH(1,1) ESTIMATION OF STANDARDIZED COUNT INNOVATIONS
################################################################################
#
# Reviewer response:
#
# GARCH is applied to standardized count innovations rather than fitted
# conditional means.
#
# For each location/state:
#
#       e_t = (Y_t - mu_hat_t) / s_hat_t
#
# where:
#
#       mu_hat_t = fitted conditional mean
#       s_hat_t  = fitted conditional standard deviation
#
# Numerical stabilization:
#
#   1. Training innovations are internally scaled by their training SD.
#   2. Multiple fGarch algorithms are attempted.
#   3. Candidate parameters are explicitly validated.
#   4. Persistence is required to satisfy:
#
#          alpha + beta < GARCH_MAX_PERSISTENCE
#
#   5. A constrained Gaussian QML estimator is used as fallback.
#   6. Conditional volatility is transformed back to the original innovation
#      scale.
#
# IMPORTANT:
#
# Non-finite innovations are removed only for numerical fitting.
# Their ORIGINAL training positions are retained when volatility is inserted
# into vol_mat.
#
# TEST observations are never used for parameter estimation.
#
################################################################################


cat("\n")
cat("============================================================\n")
cat("SECTION 16: ROBUST GARCH(1,1) ESTIMATION\n")
cat("============================================================\n")


# =============================================================================
# 16.0 INPUT VALIDATION
# =============================================================================

if (!exists("innovation_mat")) {
    stop("Object 'innovation_mat' does not exist.")
}

if (!exists("train_idx")) {
    stop("Object 'train_idx' does not exist.")
}

if (!exists("locations")) {
    stop("Object 'locations' does not exist.")
}

if (!is.matrix(innovation_mat)) {
    innovation_mat <- as.matrix(innovation_mat)
}

n_days <- nrow(innovation_mat)
n_loc  <- ncol(innovation_mat)

if (length(locations) != n_loc) {
    stop(
        "Length of locations does not equal ncol(innovation_mat)."
    )
}

train_idx <- as.integer(train_idx)

if (
    length(train_idx) == 0L ||
    anyNA(train_idx) ||
    any(train_idx < 1L | train_idx > n_days) ||
    anyDuplicated(train_idx) > 0L
) {
    stop("train_idx is invalid.")
}


# =============================================================================
# 16.1 GARCH CONSTANTS
# =============================================================================

GARCH_MIN_OBS <- 50L

# Strict admissibility requirement:
# alpha + beta < 0.998
GARCH_MAX_PERSISTENCE <- 0.998

# Diagnostic threshold only.
GARCH_HIGH_PERSISTENCE <- 0.995

GARCH_MAXIT <- 10000L

GARCH_N_STARTS <- 12L


# =============================================================================
# 16.2 DIRECT CONSTRAINED GAUSSIAN QML
# =============================================================================
#
# Reparameterization guarantees:
#
#       omega > 0
#       alpha >= 0
#       beta >= 0
#       alpha + beta < GARCH_MAX_PERSISTENCE
#
# Optimization is performed on internally standardized innovations.
#
# =============================================================================

fit_garch_direct_qml <- function(
    e,
    max_persistence = GARCH_MAX_PERSISTENCE,
    n_starts = GARCH_N_STARTS,
    maxit = GARCH_MAXIT
) {

    e <- as.numeric(e)

    e <- e[
        is.finite(e)
    ]

    if (length(e) < GARCH_MIN_OBS) {

        return(
            list(
                success = FALSE,
                message = "Too few finite innovations."
            )
        )
    }

    e_sd <- sd(e)

    if (
        !is.finite(e_sd) ||
        e_sd <= 1e-10
    ) {

        return(
            list(
                success = FALSE,
                message = "Innovation SD is too small or non-finite."
            )
        )
    }

    # -------------------------------------------------------------------------
    # Internal standardization
    # -------------------------------------------------------------------------

    x <- e / e_sd

    n <- length(x)

    x_var <- var(x)

    if (
        !is.finite(x_var) ||
        x_var <= 0
    ) {
        x_var <- 1
    }


    # -------------------------------------------------------------------------
    # Parameter unpacking
    # -------------------------------------------------------------------------

    unpack <- function(theta) {

        omega <- exp(theta[1])

        persistence <-
            max_persistence *
            plogis(theta[2])

        alpha_share <-
            plogis(theta[3])

        alpha <-
            persistence *
            alpha_share

        beta <-
            persistence *
            (1 - alpha_share)

        list(
            omega = omega,
            alpha = alpha,
            beta = beta,
            persistence = persistence
        )
    }


    # -------------------------------------------------------------------------
    # Gaussian QML negative log-likelihood
    # -------------------------------------------------------------------------

    nll <- function(theta) {

        par <- unpack(theta)

        sigma2 <- numeric(n)

        unconditional_var <-
            par$omega /
            (1 - par$persistence)

        if (
            !is.finite(unconditional_var) ||
            unconditional_var <= 0
        ) {
            unconditional_var <- x_var
        }

        sigma2[1] <-
            max(
                unconditional_var,
                1e-8
            )

        for (tt in 2:n) {

            sigma2[tt] <-
                par$omega +
                par$alpha * x[tt - 1]^2 +
                par$beta * sigma2[tt - 1]

            if (
                !is.finite(sigma2[tt]) ||
                sigma2[tt] <= 0
            ) {
                return(1e100)
            }
        }

        value <-
            0.5 *
            sum(
                log(sigma2) +
                x^2 / sigma2
            )

        if (
            !is.finite(value)
        ) {
            return(1e100)
        }

        value
    }


    # -------------------------------------------------------------------------
    # Starting-value generator
    # -------------------------------------------------------------------------

    make_start <- function(
        omega,
        persistence,
        alpha_share
    ) {

        persistence_scaled <-
            min(
                max(
                    persistence / max_persistence,
                    1e-6
                ),
                1 - 1e-6
            )

        alpha_share <-
            min(
                max(
                    alpha_share,
                    1e-6
                ),
                1 - 1e-6
            )

        c(
            log(omega),
            qlogis(persistence_scaled),
            qlogis(alpha_share)
        )
    }


    # -------------------------------------------------------------------------
    # Multiple starting values
    # -------------------------------------------------------------------------

    starts <- list(

        make_start(0.05, 0.95, 0.05),

        make_start(0.05, 0.90, 0.10),

        make_start(0.02, 0.94, 0.05),

        make_start(0.01, 0.97, 0.01),

        make_start(0.10, 0.80, 0.05),

        make_start(0.01, 0.85, 0.10),

        make_start(0.02, 0.80, 0.15),

        make_start(0.10, 0.70, 0.10),

        make_start(0.05, 0.50, 0.20),

        make_start(0.10, 0.95, 0.50),

        make_start(0.01, 0.60, 0.50),

        make_start(0.05, 0.98, 0.01)
    )


    starts <-
        starts[
            seq_len(
                min(
                    n_starts,
                    length(starts)
                )
            )
        ]


    # -------------------------------------------------------------------------
    # Run multiple optimizations
    # -------------------------------------------------------------------------

    fits <- lapply(
        starts,
        function(st) {

            tryCatch(
                optim(
                    par = st,
                    fn = nll,
                    method = "BFGS",
                    control = list(
                        maxit = maxit,
                        reltol = 1e-10
                    )
                ),
                error = function(err) {
                    NULL
                }
            )
        }
    )


    # -------------------------------------------------------------------------
    # Keep only finite optimization results
    # -------------------------------------------------------------------------

    valid <- vapply(
        fits,
        function(fit) {

            !is.null(fit) &&
                is.finite(fit$value) &&
                length(fit$par) == 3L &&
                all(
                    is.finite(fit$par)
                )
        },
        logical(1)
    )

    valid_fits <-
        fits[
            valid
        ]


    if (
        length(valid_fits) == 0L
    ) {

        return(
            list(
                success = FALSE,
                message = "No finite direct-QML optimization result."
            )
        )
    }


    # -------------------------------------------------------------------------
    # Select best optimization result
    # IMPORTANT: [[best_id]] extracts the actual list element.
    # -------------------------------------------------------------------------

    objective_values <- vapply(
        valid_fits,
        function(fit) {
            fit$value
        },
        numeric(1)
    )

    best_id <-
        which.min(
            objective_values
        )

    best <- valid_fits[[best_id]]


    # -------------------------------------------------------------------------
    # Recover GARCH parameters
    # -------------------------------------------------------------------------

    par <- unpack(
        best$par
    )

    omega_scaled <-
        par$omega

    alpha <-
        par$alpha

    beta <-
        par$beta

    persistence <-
        alpha + beta


    # -------------------------------------------------------------------------
    # Explicit admissibility check
    # -------------------------------------------------------------------------

    admissible <-
        is.finite(omega_scaled) &&
        is.finite(alpha) &&
        is.finite(beta) &&
        is.finite(persistence) &&
        omega_scaled > 0 &&
        alpha >= 0 &&
        beta >= 0 &&
        persistence < max_persistence


    if (
        !admissible
    ) {

        return(
            list(
                success = FALSE,
                message =
                    "Direct QML produced invalid GARCH parameters."
            )
        )
    }


    # -------------------------------------------------------------------------
    # Reconstruct conditional variance
    # -------------------------------------------------------------------------

    sigma2 <- numeric(n)

    unconditional_var <-
        omega_scaled /
        (1 - persistence)

    if (
        !is.finite(unconditional_var) ||
        unconditional_var <= 0
    ) {
        unconditional_var <- x_var
    }

    sigma2[1] <-
        max(
            unconditional_var,
            1e-8
        )


    for (tt in 2:n) {

        sigma2[tt] <-
            omega_scaled +
            alpha * x[tt - 1]^2 +
            beta * sigma2[tt - 1]

        if (
            !is.finite(sigma2[tt]) ||
            sigma2[tt] <= 0
        ) {

            return(
                list(
                    success = FALSE,
                    message =
                        "Invalid conditional variance recursion."
                )
            )
        }
    }


    # -------------------------------------------------------------------------
    # Return volatility to ORIGINAL innovation scale
    # -------------------------------------------------------------------------

    sigma_original <-
        sqrt(sigma2) *
        e_sd

    omega_original <-
        omega_scaled *
        e_sd^2


    if (
        any(
            !is.finite(sigma_original)
        ) ||
        any(
            sigma_original <= 0
        )
    ) {

        return(
            list(
                success = FALSE,
                message =
                    "Original-scale volatility is invalid."
            )
        )
    }


    list(
        success = TRUE,

        omega =
            omega_original,

        alpha =
            alpha,

        beta =
            beta,

        persistence =
            persistence,

        sigma =
            sigma_original,

        objective =
            best$value,

        convergence =
            best$convergence,

        iterations =
            if (
                !is.null(
                    best$counts[["function"]]
                )
            ) {
                best$counts[["function"]]
            } else {
                NA_integer_
            },

        innovation_sd =
            e_sd,

        method =
            "Direct constrained Gaussian QML - reparameterized",

        constraint_parameterization =
            TRUE,

        message =
            "Successful"
    )
}


# =============================================================================
# 16.3 INITIALIZE OUTPUT OBJECTS
# =============================================================================

OUTPUT_DIR <- "garch_results"

if (
    !dir.exists(OUTPUT_DIR)
) {
    dir.create(
        OUTPUT_DIR,
        recursive = TRUE,
        showWarnings = FALSE
    )
}


vol_mat <-
    matrix(
        NA_real_,
        nrow = length(train_idx),
        ncol = n_loc
    )

colnames(vol_mat) <-
    locations


garch_models <-
    vector(
        mode = "list",
        length = n_loc
    )


garch_stats <-
    data.frame(
        State = locations,

        N_Train_Usable =
            integer(n_loc),

        Innovation_SD_Train =
            rep(NA_real_, n_loc),

        Omega =
            rep(NA_real_, n_loc),

        Alpha =
            rep(NA_real_, n_loc),

        Beta =
            rep(NA_real_, n_loc),

        GARCH_Persistence =
            rep(NA_real_, n_loc),

        Mean_Volatility_Train =
            rep(NA_real_, n_loc),

        SD_Volatility_Train =
            rep(NA_real_, n_loc),

        GARCH_Method =
            rep(NA_character_, n_loc),

        GARCH_Status =
            rep(NA_character_, n_loc),

        stringsAsFactors = FALSE
    )


failed_diagnostics <-
    list()


# =============================================================================
# 16.4 CHECK fGarch AVAILABILITY
# =============================================================================

HAS_FGARCH <-
    requireNamespace(
        "fGarch",
        quietly = TRUE
    )


if (
    HAS_FGARCH
) {

    message(
        "fGarch detected: nlminb and lbfgsb methods will be attempted."
    )

} else {

    message(
        "fGarch not available: direct constrained Gaussian QML will be used."
    )
}


# =============================================================================
# 16.5 STATE-SPECIFIC GARCH ESTIMATION
# =============================================================================

for (
    i in seq_len(n_loc)
) {

    state_name <-
        locations[i]


    message(
        sprintf(
            "\n[%d/%d] Estimating GARCH for %s",
            i,
            n_loc,
            state_name
        )
    )


    # =========================================================================
    # Extract TRAINING innovations
    # =========================================================================

    e_train_raw <-
        as.numeric(
            innovation_mat[
                train_idx,
                i
            ]
        )


    # Keep ORIGINAL training positions.
    valid_idx <-
        which(
            is.finite(
                e_train_raw
            )
        )


    e_train <-
        e_train_raw[
            valid_idx
        ]


    n_usable <-
        length(
            e_train
        )


    garch_stats$N_Train_Usable[i] <-
        n_usable


    innovation_sd <-
        if (
            n_usable > 1L
        ) {

            sd(
                e_train
            )

        } else {

            NA_real_
        }


    garch_stats$Innovation_SD_Train[i] <-
        innovation_sd


    # =========================================================================
    # Minimum-data check
    # =========================================================================

    if (
        n_usable < GARCH_MIN_OBS ||
        !is.finite(innovation_sd) ||
        innovation_sd <= 1e-8
    ) {

        garch_stats$GARCH_Method[i] <-
            "None"

        garch_stats$GARCH_Status[i] <-
            "Insufficient/near-zero innovation variation"

        failed_diagnostics[[state_name]] <-
            "Insufficient usable innovations or near-zero innovation SD."

        message(
            sprintf(
                "%s: insufficient usable innovations (%d).",
                state_name,
                n_usable
            )
        )

        next
    }


    # =========================================================================
    # Internal scaling
    # =========================================================================

    e_sd <-
        innovation_sd

    e_scaled <-
        e_train /
        e_sd


    if (
        any(
            !is.finite(
                e_scaled
            )
        )
    ) {

        garch_stats$GARCH_Method[i] <-
            "None"

        garch_stats$GARCH_Status[i] <-
            "Non-finite internally standardized innovations"

        failed_diagnostics[[state_name]] <-
            "Internal scaling generated non-finite values."

        message(
            sprintf(
                "%s: internal scaling failed.",
                state_name
            )
        )

        next
    }


    # =========================================================================
    # 16.5.1 fGarch estimation
    # =========================================================================

    fgarch_fit <-
        NULL

    fgarch_algorithm <-
        NA_character_


    if (
        HAS_FGARCH
    ) {

        for (
            alg in c(
                "nlminb",
                "lbfgsb"
            )
        ) {

            candidate <-
                tryCatch(

                    suppressWarnings(
                        fGarch::garchFit(
                            formula =
                                ~ garch(
                                    1,
                                    1
                                ),

                            data =
                                e_scaled,

                            include.mean =
                                FALSE,

                            cond.dist =
                                "norm",

                            trace =
                                FALSE,

                            algorithm =
                                alg
                        )
                    ),

                    error = function(err) {
                        NULL
                    }
                )


            if (
                is.null(candidate)
            ) {
                next
            }


            coef_candidate <-
                tryCatch(
                    coef(candidate),
                    error = function(err) {
                        NULL
                    }
                )


            if (
                is.null(coef_candidate)
            ) {
                next
            }


            omega_candidate <-
                unname(
                    coef_candidate["omega"]
                )

            alpha_candidate <-
                unname(
                    coef_candidate["alpha1"]
                )

            beta_candidate <-
                unname(
                    coef_candidate["beta1"]
                )


            persistence_candidate <-
                alpha_candidate +
                beta_candidate


            valid_candidate <-
                is.finite(omega_candidate) &&
                is.finite(alpha_candidate) &&
                is.finite(beta_candidate) &&
                is.finite(persistence_candidate) &&
                omega_candidate > 0 &&
                alpha_candidate >= 0 &&
                beta_candidate >= 0 &&
                persistence_candidate <
                    GARCH_MAX_PERSISTENCE


            if (
                !valid_candidate
            ) {
                next
            }


            sigma_candidate <-
                tryCatch(
                    as.numeric(
                        volatility(
                            candidate
                        )
                    ),
                    error = function(err) {
                        NULL
                    }
                )


            if (
                is.null(sigma_candidate) ||
                length(sigma_candidate) != n_usable ||
                any(
                    !is.finite(
                        sigma_candidate
                    )
                ) ||
                any(
                    sigma_candidate <= 0
                )
            ) {
                next
            }


            fgarch_fit <-
                candidate

            fgarch_algorithm <-
                alg

            break
        }
    }


    # =========================================================================
    # 16.5.2 ACCEPT fGarch
    # =========================================================================

    if (
        !is.null(fgarch_fit)
    ) {

        coef_fit <-
            tryCatch(
                coef(fgarch_fit),
                error = function(err) {
                    NULL
                }
            )


        if (
            !is.null(coef_fit)
        ) {

            omega_fit <-
                unname(
                    coef_fit["omega"]
                )

            alpha_fit <-
                unname(
                    coef_fit["alpha1"]
                )

            beta_fit <-
                unname(
                    coef_fit["beta1"]
                )

            persistence_fit <-
                alpha_fit +
                beta_fit


            sigma_scaled <-
                tryCatch(
                    as.numeric(
                        volatility(
                            fgarch_fit
                        )
                    ),
                    error = function(err) {
                        NULL
                    }
                )


            valid_final_fit <-
                is.finite(omega_fit) &&
                is.finite(alpha_fit) &&
                is.finite(beta_fit) &&
                is.finite(persistence_fit) &&
                omega_fit > 0 &&
                alpha_fit >= 0 &&
                beta_fit >= 0 &&
                persistence_fit <
                    GARCH_MAX_PERSISTENCE &&
                !is.null(sigma_scaled) &&
                length(sigma_scaled) == n_usable &&
                all(
                    is.finite(
                        sigma_scaled
                    )
                ) &&
                all(
                    sigma_scaled > 0
                )


            if (
                valid_final_fit
            ) {

                sigma_original <-
                    sigma_scaled *
                    e_sd


                if (
                    all(
                        is.finite(
                            sigma_original
                        )
                    ) &&
                    all(
                        sigma_original > 0
                    )
                ) {

                    # ---------------------------------------------------------
                    # IMPORTANT:
                    # Preserve ORIGINAL training positions.
                    # ---------------------------------------------------------

                    vol_mat[
                        valid_idx,
                        i
                    ] <-
                        sigma_original


                    garch_models[[i]] <-
                        list(
                            fit =
                                fgarch_fit,

                            method =
                                paste0(
                                    "fGarch-",
                                    fgarch_algorithm
                                ),

                            omega =
                                omega_fit *
                                e_sd^2,

                            alpha =
                                alpha_fit,

                            beta =
                                beta_fit,

                            persistence =
                                persistence_fit,

                            innovation_sd =
                                e_sd,

                            n_obs =
                                n_usable
                        )


                    garch_stats$Omega[i] <-
                        omega_fit *
                        e_sd^2

                    garch_stats$Alpha[i] <-
                        alpha_fit

                    garch_stats$Beta[i] <-
                        beta_fit

                    garch_stats$GARCH_Persistence[i] <-
                        persistence_fit

                    garch_stats$Mean_Volatility_Train[i] <-
                        mean(
                            sigma_original,
                            na.rm = TRUE
                        )

                    garch_stats$SD_Volatility_Train[i] <-
                        sd(
                            sigma_original,
                            na.rm = TRUE
                        )

                    garch_stats$GARCH_Method[i] <-
                        paste0(
                            "fGarch-",
                            fgarch_algorithm
                        )

                    garch_stats$GARCH_Status[i] <-
                        "SUCCESS"


                    message(
                        sprintf(
                            "%s: SUCCESS [%s], persistence = %.6f",
                            state_name,
                            paste0(
                                "fGarch-",
                                fgarch_algorithm
                            ),
                            persistence_fit
                        )
                    )

                    next
                }
            }
        }
    }


    # =========================================================================
    # 16.5.3 DIRECT CONSTRAINED QML FALLBACK
    # =========================================================================

    direct_fit <-
        fit_garch_direct_qml(
            e = e_train,
            max_persistence =
                GARCH_MAX_PERSISTENCE,
            n_starts =
                GARCH_N_STARTS,
            maxit =
                GARCH_MAXIT
        )


    if (
        isTRUE(
            direct_fit$success
        )
    ) {

        sigma_original <-
            direct_fit$sigma


        if (
            length(sigma_original) == n_usable &&
            all(
                is.finite(
                    sigma_original
                )
            ) &&
            all(
                sigma_original > 0
            )
        ) {

            # -------------------------------------------------------------
            # Preserve ORIGINAL training positions.
            # -------------------------------------------------------------

            vol_mat[
                valid_idx,
                i
            ] <-
                sigma_original


            garch_models[[i]] <-
                direct_fit


            garch_stats$Omega[i] <-
                direct_fit$omega

            garch_stats$Alpha[i] <-
                direct_fit$alpha

            garch_stats$Beta[i] <-
                direct_fit$beta

            garch_stats$GARCH_Persistence[i] <-
                direct_fit$persistence

            garch_stats$Mean_Volatility_Train[i] <-
                mean(
                    sigma_original,
                    na.rm = TRUE
                )

            garch_stats$SD_Volatility_Train[i] <-
                sd(
                    sigma_original,
                    na.rm = TRUE
                )

            garch_stats$GARCH_Method[i] <-
                direct_fit$method

            garch_stats$GARCH_Status[i] <-
                "SUCCESS"


            message(
                sprintf(
                    "%s: SUCCESS [%s], persistence = %.6f",
                    state_name,
                    direct_fit$method,
                    direct_fit$persistence
                )
            )

            next
        }
    }


    # =========================================================================
    # 16.5.4 FINAL FAILURE
    # =========================================================================

    failure_message <-
        if (
            is.null(
                direct_fit$message
            )
        ) {
            "GARCH estimation failed."
        } else {
            as.character(
                direct_fit$message
            )
        }


    garch_stats$GARCH_Method[i] <-
        "None"

    garch_stats$GARCH_Status[i] <-
        "FAILED"


    failed_diagnostics[[state_name]] <-
        failure_message


    message(
        sprintf(
            "%s: FAILED - %s",
            state_name,
            failure_message
        )
    )
}


