################################################################################
# 4. REVIEWER 2: EXPLORATORY COUNT-DATA ANALYSIS
################################################################################
#
# R2-2:
# Reviewer requested:
#   - number/proportion of zeros
#   - temporal distribution
#   - spatial distribution
#   - mean-variance relationship
#
################################################################################

zero_count <- colSums(ts_data == 0, na.rm = TRUE)
zero_prop  <- zero_count / n_days

