            ),

            error = function(err) {

                method_messages <<-
                    c(
                        method_messages,
                        paste0(
                            "Existing constrained QML: ",
                            conditionMessage(err)
                        )
                    )

                NULL
            }
        )


        if (
            !is.null(fit_existing) &&
            isTRUE(fit_existing$success)
        ) {

            selected_fit <- fit_existing
        }
    }


    # =========================================================================
    # METHOD 4: DIRECT REPARAMETERIZED QML
    # =========================================================================

    if (is.null(selected_fit)) {

        fit_direct <- tryCatch(

            fit_garch_direct_qml(
                e = e_train,
                max_persistence = GARCH_MAX_PERSISTENCE,
                n_starts = GARCH_N_STARTS,
                maxit = GARCH_MAXIT
            ),

            error = function(err) {

                method_messages <<-
                    c(
                        method_messages,
                        paste0(
                            "Direct constrained QML: ",
                            conditionMessage(err)
                        )
                    )

                NULL
            }
        )


        if (
            !is.null(fit_direct) &&
            isTRUE(fit_direct$success)
        ) {

            selected_fit <- fit_direct

        } else {

            if (
                !is.null(fit_direct) &&
                !is.null(fit_direct$message)
            ) {

                method_messages <-
                    c(
                        method_messages,
                        paste0(
                            "Direct constrained QML: ",
                            fit_direct$message
                        )
                    )
            }
        }
    }


    # =========================================================================
    # SUCCESS / FAILURE
    # =========================================================================

    if (
        !is.null(selected_fit) &&
        isTRUE(selected_fit$success)
    ) {

        sigma_i <- selected_fit$sigma


        # ---------------------------------------------------------------------
        # Check volatility length
        # ---------------------------------------------------------------------

        if (
            length(sigma_i) != n_train_valid
        ) {

            failure_message <- paste0(
                "Volatility length mismatch: expected ",
                n_train_valid,
                ", got ",
                length(sigma_i),
                "."
            )


            garch_results[[i]] <- data.frame(
                State = state_i,
                Success = FALSE,
                GARCH_Method = selected_fit$method,
                N_Train = n_train_total,
                N_Valid = n_train_valid,
                N_Missing = n_train_missing,
                Innovation_Mean = innovation_mean,
                Innovation_SD_Train = innovation_sd,
                Omega = NA_real_,
                Alpha = NA_real_,
                Beta = NA_real_,
                Persistence = NA_real_,
                High_Persistence = NA,
                Objective = NA_real_,
                Convergence = NA_integer_,
                Iterations = NA_integer_,
                Failure_Message = failure_message,
                stringsAsFactors = FALSE
            )


            failed_diagnostics[[i]] <-
                garch_results[[i]]


            cat("FAILED\n")


        # ---------------------------------------------------------------------
        # Check volatility values
        # ---------------------------------------------------------------------

        } else if (
            any(!is.finite(sigma_i)) ||
            any(sigma_i <= 0)
        ) {

            failure_message <-
                "Selected GARCH model produced invalid volatility values."


            garch_results[[i]] <- data.frame(
                State = state_i,
                Success = FALSE,
                GARCH_Method = selected_fit$method,
                N_Train = n_train_total,
                N_Valid = n_train_valid,
                N_Missing = n_train_missing,
                Innovation_Mean = innovation_mean,
                Innovation_SD_Train = innovation_sd,
                Omega = NA_real_,
                Alpha = NA_real_,
                Beta = NA_real_,
                Persistence = NA_real_,
                High_Persistence = NA,
                Objective = NA_real_,
                Convergence = NA_integer_,
                Iterations = NA_integer_,
                Failure_Message = failure_message,
                stringsAsFactors = FALSE
            )


            failed_diagnostics[[i]] <-
                garch_results[[i]]


            cat("FAILED\n")


        # ---------------------------------------------------------------------
        # Valid successful model
        # ---------------------------------------------------------------------

        } else {

            # IMPORTANT:
            # Preserve the original training positions.
            vol_mat[
                valid_idx,
                i
            ] <- sigma_i


            garch_models[[i]] <-
                selected_fit


            persistence_i <-
                selected_fit$persistence


            high_persistence_i <-
                is.finite(persistence_i) &&
                persistence_i >= GARCH_HIGH_PERSISTENCE


            garch_results[[i]] <- data.frame(
                State = state_i,
                Success = TRUE,
                GARCH_Method = selected_fit$method,
                N_Train = n_train_total,
                N_Valid = n_train_valid,
                N_Missing = n_train_missing,
                Innovation_Mean = innovation_mean,
                Innovation_SD_Train = innovation_sd,
                Omega = selected_fit$omega,
