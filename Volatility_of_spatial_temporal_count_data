################################################################################
# 22. VOLATILITY TRAJECTORY MATRIX
################################################################################
#
# REVIEWER 2-4:
#
# Clustering should not be based only on scalar mean volatility.
#
# Instead, each state is represented by its complete TRAINING-PERIOD
# volatility trajectory:
#
#       sigma_i =
#       (sigma_1i, sigma_2i, ..., sigma_Ttrain,i)
#
# This preserves temporal information and allows states with similar
# volatility dynamics to be grouped even when they are geographically
# distant.
#
# IMPORTANT:
#
# 1. Clustering uses TRAINING-PERIOD conditional volatility only.
# 2. The held-out TEST period is completely excluded.
# 3. vol_mat already contains TRAINING-PERIOD rows only.
#    Therefore, train_idx must NOT be applied again to vol_mat.
# 4. States with fewer than 80% finite trajectory values are excluded.
# 5. Occasional missing values among retained states are linearly
#    interpolated using neighboring training-period observations.
#
################################################################################


################################################################################
# 22.0 VALIDATE REQUIRED OBJECTS
################################################################################

required_objects_22 <- c(
    "vol_mat",
    "dates",
    "locations",
    "train_idx",
    "test_idx",
    "OUTPUT_DIR"
)

missing_objects_22 <- required_objects_22[
    !vapply(
        required_objects_22,
        exists,
        logical(1),
        inherits = TRUE
    )
]

if (length(missing_objects_22) > 0) {
    
    stop(
        paste(
            "Section 22 is missing required objects:",
            paste(missing_objects_22, collapse = ", ")
        )
    )
}


################################################################################
# 22.0.1 VALIDATE TRAINING / TEST INDEX STRUCTURE
################################################################################

if (
    length(train_idx) == 0 ||
    length(test_idx) == 0
) {
    
    stop(
        "train_idx and test_idx must both contain observations."
    )
}


if (
    length(intersect(train_idx, test_idx)) > 0
) {
    
    stop(
        "train_idx and test_idx overlap."
    )
}


if (
    length(union(train_idx, test_idx)) != length(dates)
) {
    
    stop(
        "train_idx and test_idx do not partition the full time series."
    )
}


################################################################################
# 22.0.2 VALIDATE VOLATILITY MATRIX DIMENSIONS
################################################################################

vol_mat <- as.matrix(vol_mat)

if (
    nrow(vol_mat) != length(train_idx)
) {
    
    stop(
        paste0(
            "Dimension mismatch: vol_mat has ",
            nrow(vol_mat),
            " rows, but length(train_idx) = ",
            length(train_idx),
            ". ",
            "vol_mat should contain training-period rows only."
        )
    )
}


if (
    ncol(vol_mat) != length(locations)
) {
    
    stop(
        paste0(
            "Dimension mismatch: vol_mat has ",
            ncol(vol_mat),
            " columns, but there are ",
            length(locations),
            " locations."
        )
    )
}


################################################################################
# 22.0.3 CONSTRUCT TRAINING DATES
################################################################################
#
# train_dates correspond exactly to the rows of vol_mat.
#
################################################################################

train_dates <- as.Date(
    dates[train_idx]
)


if (
    length(train_dates) != nrow(vol_mat)
) {
    
    stop(
        "Length of train_dates does not match the number of rows in vol_mat."
    )
}


################################################################################
# 22.1 CONSTRUCT COMPLETE TRAINING-PERIOD VOLATILITY TRAJECTORY MATRIX
################################################################################
#
# Each row represents one state.
#
# Each column represents one TRAINING-PERIOD date.
#
# Dimensions:
#
#       number of retained states × number of training observations
#
# No test-period observations are included.
#
################################################################################

volatility_matrix <- t(
    vol_mat
)


rownames(
    volatility_matrix
) <- locations


colnames(
    volatility_matrix
) <- as.character(
    train_dates
)


################################################################################
# 22.1.1 BASIC DIMENSION CHECK
################################################################################

cat(
    "\n============================================================\n"
)

cat(
    "VOLATILITY TRAJECTORY CLUSTERING DATA\n"
)

cat(
    "============================================================\n"
)

cat(
    "Total dates:              ",
    length(dates),
    "\n"
)

cat(
    "Training observations:    ",
    length(train_idx),
    "\n"
)

cat(
    "Test observations:        ",
    length(test_idx),
    "\n"
)

cat(
    "Total states:             ",
    length(locations),
    "\n"
)

cat(
    "Trajectory matrix rows:   ",
    nrow(volatility_matrix),
    "\n"
)

cat(
    "Trajectory matrix columns:",
    ncol(volatility_matrix),
    "\n"
)


if (
    nrow(volatility_matrix) != length(locations)
) {
    
    stop(
        "Trajectory matrix row count does not match number of states."
    )
}


