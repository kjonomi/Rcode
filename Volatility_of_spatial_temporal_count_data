################################################################################
# 32.9 OOS AGGREGATE-RISK VALIDATION
################################################################################
#
# The Gaussian copula is evaluated separately as a model of cross-state
# dependence.
#
# It does NOT modify the marginal conditional mean or marginal GARCH
# conditional variance.
#
# For state i:
#
#     q_it = sqrt(V_it) * sigma_it
#
# where:
#
#     V_it = conditional count variance
#
# and:
#
#     sigma_it^2 = GARCH conditional variance of the standardized innovation.
#
# Under conditional independence:
#
#     Var(sum_i r_it | F)
#       = sum_i q_it^2
#
# Under a Gaussian copula correlation matrix R:
#
#     Var(sum_i r_it | F)
#       = q' R q
#
################################################################################


spatial_aggregate_available <- FALSE


gaussian_correlation <- NULL


if (
    exists("gaussian_fit") &&
    !is.null(gaussian_fit)
) {
    
    gaussian_correlation <- tryCatch(
        
        {
            getSigma(
                gaussian_fit@copula
            )
        },
        
        error = function(e) NULL
    )
    
    
    if (
        !is.null(gaussian_correlation) &&
        all(
            dim(
                gaussian_correlation
            ) ==
                c(
                    n_loc,
                    n_loc
                )
        ) &&
        all(
            is.finite(
                gaussian_correlation
            )
        )
    ) {
        
        spatial_aggregate_available <- TRUE
    }
}


if (
    spatial_aggregate_available
) {
    
    
    ################################################################################
    # 32.10 PREPARE COPULA CORRELATION MATRIX
    ################################################################################
    
    gaussian_correlation <-
        (
            gaussian_correlation +
                t(
                    gaussian_correlation
                )
        ) / 2
    
    
    diag(
        gaussian_correlation
    ) <- 1
    
    
    ################################################################################
    # 32.11 TEST-PERIOD CONDITIONAL COUNT VARIANCE
    ################################################################################
    
    if (
        !exists("variance_mat")
    ) {
        
        warning(
            "variance_mat is unavailable; aggregate-risk OOS validation skipped."
        )
        
    } else {
        
        test_count_variance <- variance_mat[
            test_idx,
            ,
            drop = FALSE
        ]
        
        
        if (
            ncol(test_count_variance) != n_loc
        ) {
            
            stop(
                "variance_mat does not match the number of states."
            )
        }
        
        
        ################################################################################
        # 32.12 RAW CONDITIONAL STANDARD DEVIATION FORECAST
        ################################################################################
        
        raw_sd_forecast <- sqrt(
            pmax(
                test_count_variance,
                0
            )
        ) *
            sqrt(
                pmax(
                    benchmark_sigma2,
                    0
                )
            )
        
        
        aggregate_variance_independence <-
            rep(
                NA_real_,
                n_test
            )
        
        
        aggregate_variance_spatial <-
            rep(
                NA_real_,
                n_test
            )
        
        
        ################################################################################
        # 32.13 AGGREGATE CONDITIONAL VARIANCE
        ################################################################################
        
        for (
            h in seq_len(n_test)
        ) {
            
            q <- raw_sd_forecast[
                h,
                ]
            
            
            valid <- is.finite(
                q
            )
            
            
            if (
                sum(valid) >= 2
            ) {
                
                q_valid <- q[
                    valid
                ]
                
                
                R_valid <- gaussian_correlation[
                    valid,
                    valid,
                    drop = FALSE
                ]
                
                
                aggregate_variance_independence[h] <-
                    sum(
                        q_valid^2
                    )
                
                
                aggregate_variance_spatial[h] <-
                    as.numeric(
                        t(
                            q_valid
                        ) %*%
                            R_valid %*%
                            q_valid
                    )
                
                
                aggregate_variance_spatial[h] <-
                    max(
                        aggregate_variance_spatial[h],
                        0
                    )
            }
        }
        
        
        ################################################################################
        # 32.14 OBSERVED AGGREGATE COUNT RESIDUAL
        ################################################################################
        
        if (
            exists("y") &&
            exists("mean_mat")
        ) {
            
            observed_residual <- y[
                test_idx,
                ,
                drop = FALSE
            ] -
                mean_mat[
                    test_idx,
                    ,
                    drop = FALSE
                ]
            
            
            observed_aggregate_residual <-
                rowSums(
                    observed_residual,
                    na.rm = FALSE
                )
            
            
            observed_aggregate_squared_residual <-
                observed_aggregate_residual^2
            
            
            aggregate_oos <- data.frame(
                
                Date =
                    test_dates,
                
                Observed_Aggregate_Squared_Residual =
                    observed_aggregate_squared_residual,
                
                Independence_Forecast_Variance =
                    aggregate_variance_independence,
                
                Gaussian_Copula_Forecast_Variance =
                    aggregate_variance_spatial
            )
            
            
            ################################################################################
            # 32.15 AGGREGATE FORECAST EVALUATION
            ################################################################################
            
            valid_aggregate <- is.finite(
                aggregate_oos$
                Observed_Aggregate_Squared_Residual
            ) &
                is.finite(
                    aggregate_oos$
                    Independence_Forecast_Variance
                ) &
                is.finite(
                    aggregate_oos$
                    Gaussian_Copula_Forecast_Variance
                )
            
            
            n_valid_aggregate <-
                sum(
                    valid_aggregate
                )
            
            
            if (
                n_valid_aggregate > 5
            ) {
                
                actual_agg <-
                    aggregate_oos$
                    Observed_Aggregate_Squared_Residual[
                        valid_aggregate
                    ]
                
                
                ind_agg <-
                    aggregate_oos$
                    Independence_Forecast_Variance[
                        valid_aggregate
                    ]
                
                
                spatial_agg <-
                    aggregate_oos$
                    Gaussian_Copula_Forecast_Variance[
                        valid_aggregate
                    ]
                
                
                aggregate_performance <- data.frame(
                    
                    Model = c(
                        "Independence benchmark",
                        "Gaussian copula spatial model"
                    ),
                    
                    MSE = c(
                        
                        mean(
                            (
                                actual_agg -
                                    ind_agg
                            )^2
                        ),
                        
                        mean(
                            (
                                actual_agg -
                                    spatial_agg
                            )^2
                        )
                    ),
                    
                    MAE = c(
                        
                        mean(
                            abs(
                                actual_agg -
                                    ind_agg
                            )
                        ),
                        
                        mean(
                            abs(
                                actual_agg -
                                    spatial_agg
                            )
                        )
                    ),
                    
                    Correlation = c(
                        
                        suppressWarnings(
                            cor(
                                actual_agg,
                                ind_agg
                            )
                        ),
                        
                        suppressWarnings(
                            cor(
                                actual_agg,
                                spatial_agg
                            )
                        )
                    ),
                    
                    N_Test =
                        n_valid_aggregate,
                    
                    stringsAsFactors = FALSE
                )
                
                
                write.csv(
                    aggregate_performance,
                    
                    file.path(
                        OUTPUT_DIR,
                        "oos_aggregate_spatial_risk_comparison.csv"
                    ),
                    
                    row.names = FALSE
                )
                
                
                write.csv(
                    aggregate_oos,
                    
                    file.path(
                        OUTPUT_DIR,
                        "oos_aggregate_risk_forecasts.csv"
                    ),
                    
                    row.names = FALSE
                )
                
                
                print(
                    aggregate_performance
                )
            }
        }
    }
    
    
    ################################################################################
    # 32.16 SAVE GAUSSIAN COPULA CORRELATION MATRIX
    ################################################################################
    
    write.csv(
        gaussian_correlation,
        
        file.path(
            OUTPUT_DIR,
            "gaussian_copula_spatial_correlation_matrix.csv"
        ),
        
        row.names = TRUE
    )
    
} else {
    
    warning(
        paste(
            "Gaussian copula correlation matrix is unavailable.",
            "Aggregate spatial-risk OOS validation was not performed."
        )
    )
}


