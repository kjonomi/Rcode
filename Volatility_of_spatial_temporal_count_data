################################################################################
# 18.11 STATE-LEVEL VOLATILITY SUMMARY
################################################################################

cat("\n============================================================\n")
cat("18.11 CREATE VOLATILITY TRAJECTORY SUMMARY\n")
cat("============================================================\n")


volatility_trajectory_summary <- data.frame(
    State = locations,

    Training_Observations = length(train_idx),

    Finite_Training_Volatility = vapply(
        seq_len(n_loc),
        function(j) {
            sum(
                is.finite(
                    full_vol_mat[
                        train_idx,
                        j
                    ]
                )
            )
        },
        integer(1)
    ),

    Missing_Training_Volatility = vapply(
        seq_len(n_loc),
        function(j) {
            sum(
                is.na(
                    full_vol_mat[
                        train_idx,
                        j
                    ]
                )
            )
        },
        integer(1)
    ),

    Mean_Training_Volatility = vapply(
        seq_len(n_loc),
        function(j) {

            x <- full_vol_mat[
                train_idx,
                j
            ]

            if (all(is.na(x))) {
                return(NA_real_)
            }

            mean(
                x,
                na.rm = TRUE
            )
        },
        numeric(1)
    ),

    SD_Training_Volatility = vapply(
        seq_len(n_loc),
        function(j) {

            x <- full_vol_mat[
                train_idx,
                j
            ]

            if (sum(is.finite(x)) <= 1L) {
                return(NA_real_)
            }

            sd(
                x,
                na.rm = TRUE
            )
        },
        numeric(1)
    ),

    Min_Training_Volatility = vapply(
        seq_len(n_loc),
        function(j) {

            x <- full_vol_mat[
                train_idx,
                j
            ]

            if (all(is.na(x))) {
