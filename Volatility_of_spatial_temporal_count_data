# Do NOT use:
#
#     full_vol_mat[train_idx, , drop = FALSE] <- vol_mat
#
# Instead, use explicit linear matrix indexing.
#
# For each location j:
#
#     row index = train_idx
#     column j  = j
#
# R's column-major matrix indexing gives:
#
#     train_idx + (j - 1) * n_days
#
# -------------------------------------------------------------------------

training_linear_indices <- rep(
    train_idx,
    times = n_loc
) +
    rep(
        seq_len(n_loc) - 1L,
        each = length(train_idx)
    ) * n_days


# -------------------------------------------------------------------------
# Verify linear index count
# -------------------------------------------------------------------------

expected_index_count <- length(train_idx) * n_loc

if (length(training_linear_indices) != expected_index_count) {
