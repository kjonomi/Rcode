################################################################################
# 23. STANDARDIZED VOLATILITY TRAJECTORIES
################################################################################
#
# PURPOSE:
#
# The primary clustering analysis is based on the TEMPORAL SHAPE of each
# state's training-period volatility trajectory rather than its absolute
# volatility level.
#
# For state i and training time t:
#
#       z_it =
#       (sigma_it - mean(sigma_i)) / sd(sigma_i)
#
# where sigma_it is the training-period conditional volatility.
#
# This state-wise temporal standardization removes differences in volatility
# level and scale and therefore emphasizes the relative temporal dynamics
# within each state.
#
# Consequently:
#
#   - states with different average volatility but similar temporal dynamics
#     may be assigned to the same cluster;
#
#   - absolute volatility magnitude is intentionally removed from the
#     PRIMARY trajectory clustering analysis;
#
#   - magnitude-sensitive features are retained separately for interpretation
#     and post-clustering analysis.
#
# IMPORTANT:
#
# 1. Standardization is performed STATE-WISE across TRAINING TIME.
# 2. The completed trajectory matrix from Section 22 is used.
# 3. The TEST period is not used.
# 4. Magnitude-sensitive features are NOT used for primary trajectory
#    clustering.
#
################################################################################


################################################################################
# 23.0 VALIDATE REQUIRED OBJECTS
################################################################################

required_objects_23 <- c(
    "volatility_matrix_imputed",
    "volatility_matrix_valid",
    "OUTPUT_DIR"
)

