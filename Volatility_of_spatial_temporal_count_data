################################################################################
# 31. DTW SENSITIVITY ANALYSIS
################################################################################
#
# REVIEWER 2-5:
#
# Dynamic Time Warping (DTW) is used as a sensitivity analysis because
# volatility episodes may occur at somewhat different times across states.
#
# PRIMARY ANALYSIS:
#
#   Euclidean distance between standardized training-period volatility
#   trajectories.
#
# SENSITIVITY ANALYSIS:
#
#   DTW distance between the SAME standardized training-period trajectories.
#
# IMPORTANT:
#
#   1. The same valid states used in the primary trajectory analysis are used.
#   2. The selected K from Section 24 is retained.
#   3. DTW does not replace the primary Euclidean/K-means analysis.
#   4. The test period is excluded.
#
################################################################################


if (
    exists("USE_DTW") &&
    isTRUE(USE_DTW) &&
    exists("volatility_matrix_scaled") &&
    !is.null(volatility_matrix_scaled) &&
    nrow(volatility_matrix_scaled) >= 3
) {
    
    
    ################################################################################
    # 31.1 VALIDATE DTW INPUT
    ################################################################################
    
    dtw_states <- rownames(
        volatility_matrix_scaled
    )
    
    
    if (
        is.null(dtw_states) ||
        any(
            !nzchar(dtw_states)
        )
    ) {
        
        stop(
            "volatility_matrix_scaled must have valid state names."
        )
    }
    
    
    n_dtw <- nrow(
        volatility_matrix_scaled
    )
    
    
    if (
        any(
            !is.finite(
                volatility_matrix_scaled
            )
        )
    ) {
        
        stop(
            "Nonfinite values detected in volatility_matrix_scaled."
        )
    }
    
    
    ################################################################################
    # 31.2 COMPUTE DTW DISTANCE MATRIX
    ################################################################################
    
    dtw_distance <- matrix(
        0,
        nrow = n_dtw,
        ncol = n_dtw,
        dimnames = list(
            dtw_states,
            dtw_states
        )
    )
    
    
    dtw_failure_count <- 0L
    
    
    for (
        i in seq_len(n_dtw)
    ) {
        
        for (
            j in i:n_dtw
        ) {
            
            if (
                i == j
            ) {
                
                dtw_distance[i, j] <- 0
                
            } else {
                
                dtw_fit <- tryCatch(
                    
                    dtw(
                        volatility_matrix_scaled[i, ],
                        volatility_matrix_scaled[j, ],
                        distance.only = TRUE
                    ),
                    
                    error = function(e) NULL
                )
                
                
                if (
                    !is.null(dtw_fit) &&
                    is.finite(
                        dtw_fit$distance
                    )
                ) {
                    
                    dtw_distance[i, j] <-
                        as.numeric(
                            dtw_fit$distance
                        )
                    
                    dtw_distance[j, i] <-
                        dtw_distance[i, j]
                    
                } else {
                    
                    dtw_distance[i, j] <- NA_real_
                    dtw_distance[j, i] <- NA_real_
                    
                    dtw_failure_count <-
                        dtw_failure_count + 1L
                }
            }
        }
    }
    
    
    ################################################################################
    # 31.3 VALIDATE DISTANCE MATRIX
    ################################################################################
    
    dtw_finite <- all(
        is.finite(
            dtw_distance
        )
    )
    
    
    dtw_symmetric <- isTRUE(
        all.equal(
            dtw_distance,
            t(dtw_distance),
            tolerance = 1e-10
        )
    )
    
    
    dtw_nonnegative <- all(
        dtw_distance >= 0,
        na.rm = TRUE
    )
    
    
    if (
        !dtw_finite
    ) {
        
        warning(
            paste(
                "DTW distance matrix contains nonfinite values.",
                "DTW clustering will not be performed."
            )
        )
    }
    
    
    if (
        !dtw_symmetric
    ) {
        
        stop(
            "DTW distance matrix is not symmetric."
        )
    }
    
    
    if (
        !dtw_nonnegative
    ) {
        
        stop(
            "DTW distance matrix contains negative distances."
        )
    }
    
    
    ################################################################################
    # 31.4 SAVE DTW DISTANCE MATRIX
    ################################################################################
    
    write.csv(
        dtw_distance,
        
        file.path(
            OUTPUT_DIR,
            "DTW_volatility_distance_matrix.csv"
        ),
        
        row.names = TRUE
    )
    
    
    ################################################################################
    # 31.5 DTW CLUSTERING USING PRIMARY SELECTED K
    ################################################################################
    
    dtw_clustering_available <- FALSE
    
    
    if (
        dtw_finite &&
        exists("selected_k") &&
        is.finite(selected_k) &&
        selected_k >= 2 &&
        selected_k < n_dtw
    ) {
        
        dtw_hclust <- hclust(
            as.dist(
                dtw_distance
            ),
            method = "average"
        )
        
        
        dtw_clusters <- cutree(
            dtw_hclust,
            k = selected_k
        )
        
        
        dtw_cluster_df <- data.frame(
            
            State =
                dtw_states,
            
            DTW_Cluster =
                as.integer(
                    dtw_clusters
                ),
            
            stringsAsFactors = FALSE
        )
        
        
        dtw_clustering_available <- TRUE
        
        
        ################################################################################
        # 31.6 SAVE DTW CLUSTER ASSIGNMENTS
        ################################################################################
        
        write.csv(
            dtw_cluster_df,
            
            file.path(
                OUTPUT_DIR,
                "DTW_volatility_clusters.csv"
            ),
            
            row.names = FALSE
        )
        
        
        print(
            dtw_cluster_df
        )
        
        
        ################################################################################
        # 31.7 VALIDATE PRIMARY CLUSTER MEMBERSHIP
        ################################################################################
        
        if (
            !exists("cluster_membership") ||
            is.null(cluster_membership) ||
            nrow(cluster_membership) == 0
        ) {
            
            stop(
                "Primary cluster_membership is unavailable for DTW comparison."
            )
        }
        
        
        primary_cluster <- cluster_membership[
            match(
                dtw_states,
                cluster_membership$State
            ),
            ,
            drop = FALSE
        ]
        
        
        if (
            any(
                is.na(
                    primary_cluster$Cluster
                )
            )
        ) {
            
            stop(
                "Some DTW states could not be matched to primary cluster membership."
            )
        }
        
        
        ################################################################################
        # 31.8 COMPARE PRIMARY AND DTW CLUSTERING
        ################################################################################
        
        dtw_comparison <- data.frame(
            
            State =
                dtw_states,
            
            Primary_Cluster =
                as.integer(
                    primary_cluster$Cluster
                ),
            
            DTW_Cluster =
                as.integer(
                    dtw_clusters
                ),
            
            stringsAsFactors = FALSE
        )
        
        
        write.csv(
            dtw_comparison,
            
            file.path(
                OUTPUT_DIR,
                "primary_vs_DTW_cluster_comparison.csv"
            ),
            
            row.names = FALSE
        )
        
        
        ################################################################################
        # 31.9 CLUSTER AGREEMENT TABLE
        ################################################################################
        
        agreement_table <- table(
            
            Primary =
                dtw_comparison$Primary_Cluster,
            
            DTW =
                dtw_comparison$DTW_Cluster
        )
        
        
        print(
            agreement_table
        )
        
        
        write.csv(
            as.data.frame(
                agreement_table
            ),
            
            file.path(
                OUTPUT_DIR,
                "primary_vs_DTW_cluster_agreement_table.csv"
            ),
            
            row.names = FALSE
        )
        
        
        ################################################################################
        # 31.10 ADJUSTED RAND INDEX
        ################################################################################
        
        ari_value <- NA_real_
        
        
        if (
            requireNamespace(
                "mclust",
                quietly = TRUE
            )
        ) {
            
            ari_value <- mclust::adjustedRandIndex(
                dtw_comparison$Primary_Cluster,
                dtw_comparison$DTW_Cluster
            )
        }
        
        
        ################################################################################
        # 31.11 DTW CLUSTER SIZE
        ################################################################################
        
        dtw_cluster_size <- as.data.frame(
            table(
                DTW_Cluster =
                    dtw_comparison$DTW_Cluster
            )
        )
        
        
        names(
            dtw_cluster_size
        )[2] <-
            "Number_of_States"
        
        
        dtw_cluster_size$Proportion <-
            dtw_cluster_size$Number_of_States /
            sum(
                dtw_cluster_size$Number_of_States
            )
        
        
        write.csv(
            dtw_cluster_size,
            
            file.path(
                OUTPUT_DIR,
                "DTW_cluster_sizes.csv"
            ),
            
            row.names = FALSE
        )
        
        
        ################################################################################
        # 31.12 DTW SENSITIVITY SUMMARY
        ################################################################################
        
        dtw_sensitivity_summary <- data.frame(
            
            Primary_K =
                selected_k,
            
            DTW_K =
                selected_k,
            
            Number_of_States =
                n_dtw,
            
            Primary_Distance =
                "Euclidean",
            
            Sensitivity_Distance =
                "Dynamic Time Warping",
            
            DTW_Linkage =
                "Average linkage hierarchical clustering",
            
            Adjusted_Rand_Index =
                ari_value,
            
            DTW_Distance_Matrix_Finite =
                dtw_finite,
            
            DTW_Distance_Matrix_Symmetric =
                dtw_symmetric,
            
            DTW_Distance_Matrix_Nonnegative =
                dtw_nonnegative,
            
            DTW_Distance_Failures =
                dtw_failure_count,
            
            Training_Period_Only =
                TRUE,
            
            Test_Period_Used =
                FALSE,
            
            stringsAsFactors = FALSE
        )
        
        
        write.csv(
            dtw_sensitivity_summary,
            
            file.path(
                OUTPUT_DIR,
                "DTW_sensitivity_summary.csv"
            ),
            
            row.names = FALSE
        )
        
        
        ################################################################################
        # 31.13 FINAL DTW MESSAGE
        ################################################################################
        
        cat(
            "\n============================================================\n"
        )
        
        cat(
            "SECTION 31: DTW SENSITIVITY ANALYSIS\n"
        )
        
        cat(
            "============================================================\n"
        )
        
        cat(
            "States:                  ",
            n_dtw,
            "\n",
            sep = ""
        )
        
        cat(
            "Primary K:               ",
            selected_k,
            "\n",
            sep = ""
        )
        
        cat(
            "DTW K:                   ",
            selected_k,
            "\n",
            sep = ""
        )
        
        cat(
            "DTW distance failures:   ",
            dtw_failure_count,
            "\n",
            sep = ""
        )
        
        cat(
            "Adjusted Rand Index:     ",
            ifelse(
                is.finite(ari_value),
                round(
                    ari_value,
                    4
                ),
                "not available"
            ),
            "\n",
            sep = ""
        )
        
        cat(
            "Training period only:    YES\n"
        )
        
        cat(
            "Test period used:        NO\n"
        )
        
        cat(
            "============================================================\n"
        )
    }
}


################################################################################
# 32. TEMPORAL OUT-OF-SAMPLE VOLATILITY VALIDATION
################################################################################
#
# REVIEWER / AE CONCERN:
#
# The temporal validation is strictly chronological.
#
# Training period:
#     January 22, 2020 -- February 21, 2022
#
# Test period:
#     February 22, 2022 -- September 1, 2022
#
# GARCH parameters are estimated using TRAINING data only.
#
# The TEST period is used only to evaluate future volatility forecasts.
#
# IMPORTANT:
#
# Section 16 internally scaled each training innovation series for numerical
# stability. Therefore, this section reconstructs ORIGINAL-SCALE GARCH
# parameters using the stored training innovation SD.
#
# If:
#
#     e* = e / s
#
# then:
#
#     omega* = omega / s^2
#
#     alpha* = alpha
#
#     beta*  = beta
#
# Hence:
#
#     omega = omega* s^2
#
# and the original-scale recursion can be used directly.
#
# Forecasting is one-step-ahead and recursive:
#
#     h_{t+1|t} =
#         omega + alpha e_t^2 + beta h_t
#
# After the forecast is generated, the OBSERVED test innovation is used to
# update the recursion for the next forecast.
#
# Missing test innovations are NOT replaced by zero.
#
################################################################################


################################################################################
# 32.0 VALIDATE TIME PARTITION
################################################################################


if (
    !exists("train_idx") ||
    !exists("test_idx") ||
    !exists("innovation_mat") ||
    !exists("n_loc") ||
    !exists("locations")
) {
    
    stop(
        "Required training/test objects are unavailable for Section 32."
    )
}


if (
    length(
        intersect(
            train_idx,
            test_idx
        )
    ) > 0
) {
    
    stop(
        "Training and test indices overlap."
    )
}


if (
    length(
        train_idx
    ) == 0 ||
    length(
        test_idx
    ) == 0
) {
    
    stop(
        "Both training and test periods must contain observations."
    )
}


if (
    nrow(innovation_mat) <
    max(
        c(
            train_idx,
            test_idx
        )
    )
) {
    
    stop(
        "innovation_mat does not contain all required observations."
    )
}


if (
    ncol(innovation_mat) != n_loc
) {
    
    stop(
        "innovation_mat column count does not match n_loc."
    )
}


################################################################################
# 32.1 TEST DATES
################################################################################


if (
    exists("dates")
) {
    
    test_dates <- as.Date(
        dates[test_idx]
    )
    
    train_dates <- as.Date(
        dates[train_idx]
    )
    
} else if (
    exists("test_dates") &&
    exists("train_dates")
) {
    
    test_dates <- as.Date(
        test_dates
    )
    
    train_dates <- as.Date(
        train_dates
    )
    
} else {
    
    stop(
        "dates, train_dates, or test_dates are unavailable."
    )
}


n_test <- length(
    test_idx
)


################################################################################
# 32.2 INITIALIZE FORECAST MATRICES
################################################################################


benchmark_sigma2 <- matrix(
    
    NA_real_,
    
    nrow = n_test,
    
    ncol = n_loc,
    
    dimnames = list(
        as.character(
            test_dates
        ),
        locations
    )
)


actual_test_squared_innovation <- matrix(
    
    NA_real_,
    
    nrow = n_test,
    
    ncol = n_loc,
    
    dimnames = list(
        as.character(
            test_dates
        ),
        locations
    )
)


################################################################################
# 32.3 STORE OBSERVED TEST INNOVATIONS
################################################################################


for (
    i in seq_len(n_loc)
) {
    
    e_test <- innovation_mat[
        test_idx,
        i
    ]
    
    
    e_test[
        !is.finite(e_test)
    ] <- NA_real_
    
    
    actual_test_squared_innovation[
        ,
        i
    ] <-
        e_test^2
}


################################################################################
# 32.4 HELPER: EXTRACT TRAINING INNOVATION SD
################################################################################
#
# Section 16 stored Innovation_SD_Train in garch_stats.
#
# This function searches the revised garch_stats object by state.
#
################################################################################


get_training_innovation_sd <- function(
    state_name,
    garch_stats_object
) {
    
    if (
        is.null(garch_stats_object) ||
        nrow(garch_stats_object) == 0 ||
        !"State" %in%
        names(garch_stats_object)
    ) {
        
        return(
            NA_real_
        )
    }
    
    
    idx <- match(
        state_name,
        garch_stats_object$State
    )
    
    
    if (
        is.na(idx)
    ) {
        
        return(
            NA_real_
        )
    }
    
    
    if (
        !"Innovation_SD_Train" %in%
        names(garch_stats_object)
    ) {
        
        return(
            NA_real_
        )
    }
    
    
    value <- as.numeric(
        garch_stats_object$Innovation_SD_Train[idx]
    )
    
    
    if (
        !is.finite(value) ||
        value <= 0
    ) {
        
        return(
            NA_real_
        )
    }
    
    
    value
}


################################################################################
# 32.5 HELPER: EXTRACT GARCH PARAMETERS
################################################################################
#
# This function supports:
#
#   A. garch_stats containing original-scale parameters, if available.
#
#   B. garch_stats containing scaled parameters plus Innovation_SD_Train.
#
#   C. garch_models as a fallback.
#
################################################################################


get_garch_parameters_original_scale <- function(
    state_name,
    index_i
) {
    
    
    omega <- NA_real_
    alpha <- NA_real_
    beta <- NA_real_
    
    
    ############################################################################
    # First preference: garch_stats
    ############################################################################
    
    if (
        exists("garch_stats") &&
        !is.null(garch_stats) &&
        nrow(garch_stats) > 0 &&
        "State" %in%
        names(garch_stats)
    ) {
        
        idx <- match(
            state_name,
            garch_stats$State
        )
        
        
        if (
            !is.na(idx)
        ) {
            
            possible_omega <- c(
                "Omega_Original",
                "omega_original",
                "Omega",
                "omega"
            )
            
            
            possible_alpha <- c(
                "Alpha1_Original",
                "alpha1_original",
                "Alpha1",
                "alpha1"
            )
            
            
            possible_beta <- c(
                "Beta1_Original",
                "beta1_original",
                "Beta1",
                "beta1"
            )
            
            
            omega_name <- possible_omega[
                possible_omega %in%
                    names(garch_stats)
            ][1]
            
            
            alpha_name <- possible_alpha[
                possible_alpha %in%
                    names(garch_stats)
            ][1]
            
            
            beta_name <- possible_beta[
                possible_beta %in%
                    names(garch_stats)
            ][1]
            
            
            if (
                !is.na(omega_name)
            ) {
                
                omega <- as.numeric(
                    garch_stats[
                        idx,
                        omega_name
                    ]
                )
            }
            
            
            if (
                !is.na(alpha_name)
            ) {
                
                alpha <- as.numeric(
                    garch_stats[
                        idx,
                        alpha_name
                    ]
                )
            }
            
            
            if (
                !is.na(beta_name)
            ) {
                
                beta <- as.numeric(
                    garch_stats[
                        idx,
                        beta_name
                    ]
                )
            }
        }
    }
    
    
    ############################################################################
    # Fallback: fitted GARCH model
    ############################################################################
    
    if (
        (
            !is.finite(omega) ||
            !is.finite(alpha) ||
            !is.finite(beta)
        ) &&
        exists("garch_models") &&
        length(garch_models) >= index_i &&
        !is.null(garch_models[[index_i]])
    ) {
        
        fit <- garch_models[[index_i]]
        
        
        cf <- tryCatch(
            coef(fit),
            error = function(e) NULL
        )
        
        
        if (
            !is.null(cf)
        ) {
            
            if (
                "omega" %in%
                names(cf)
            ) {
                
                omega <- as.numeric(
                    cf["omega"]
                )
            }
            
            
            if (
                "alpha1" %in%
                names(cf)
            ) {
                
                alpha <- as.numeric(
                    cf["alpha1"]
                )
            }
            
            
            if (
                "beta1" %in%
                names(cf)
            ) {
                
                beta <- as.numeric(
                    cf["beta1"]
                )
            }
        }
    }
    
    
    ############################################################################
    # Recover original-scale omega when Section 16 used innovation scaling.
    ############################################################################
    
    innovation_sd <- get_training_innovation_sd(
        state_name,
        if (
            exists("garch_stats")
        ) garch_stats else NULL
    )
    
    
    if (
        is.finite(innovation_sd) &&
        innovation_sd > 0 &&
        is.finite(omega)
    ) {
        
        # If Section 16 stored the scaled omega, recover original scale.
        #
        # The revised garch_stats may explicitly contain Omega_Original.
        # Therefore only apply this transformation when the original-scale
        # value is not already available.
        
        has_original_omega <-
            exists("garch_stats") &&
            "Omega_Original" %in%
            names(garch_stats)
        
        
        if (
            !has_original_omega
        ) {
            
            omega <- omega *
                innovation_sd^2
        }
    }
    
    
    list(
        omega = omega,
        alpha = alpha,
        beta = beta,
        innovation_sd = innovation_sd
    )
}


################################################################################
# 32.6 GENERATE RECURSIVE ONE-STEP-AHEAD GARCH FORECASTS
################################################################################
#
# Training estimates are fixed.
#
# No test-period refitting occurs.
#
################################################################################


garch_oos_status <- data.frame(
    
    State =
        locations,
    
    Forecast_Available =
        FALSE,
    
    N_Test_Forecasts =
        0L,
    
    N_Test_Updates =
        0L,
    
    Forecast_Status =
        "Not attempted",
    
    stringsAsFactors = FALSE
)


for (
    i in seq_len(n_loc)
) {
    
    
    state_i <- locations[i]
    
    
    ############################################################################
    # Extract original-scale GARCH parameters
    ############################################################################
    
    garch_par <- get_garch_parameters_original_scale(
        state_name = state_i,
        index_i = i
    )
    
    
    omega <- garch_par$omega
    alpha <- garch_par$alpha
    beta <- garch_par$beta
    
    
    if (
        !all(
            is.finite(
                c(
                    omega,
                    alpha,
                    beta
                )
            )
        ) ||
        omega <= 0 ||
        alpha < 0 ||
        beta < 0 ||
        (alpha + beta) >= 0.999
    ) {
        
        garch_oos_status$Forecast_Status[i] <-
            "Invalid GARCH parameters"
        
        next
    }
    
    
    ############################################################################
    # Training innovations
    ############################################################################
    
    e_train <- innovation_mat[
        train_idx,
        i
    ]
    
    
    valid_train <- is.finite(
        e_train
    )
    
    
    if (
        sum(valid_train) < 2
    ) {
        
        garch_oos_status$Forecast_Status[i] <-
            "Insufficient training innovations"
        
        next
    }
    
    
    ############################################################################
    # Obtain final training conditional variance
    ############################################################################
    #
    # Prefer the final finite training volatility from vol_mat because Section
    # 16 already transformed the conditional volatility back to original scale.
    #
    ############################################################################
    
    sigma_last <- NA_real_
    
    
    if (
        exists("vol_mat") &&
        nrow(vol_mat) == length(train_idx) &&
        ncol(vol_mat) >= i
    ) {
        
        sigma_training <- vol_mat[
            ,
            i
        ]
        
        
        valid_sigma <- is.finite(
            sigma_training
        )
        
        
        if (
            any(valid_sigma)
        ) {
            
            sigma_last <- tail(
                sigma_training[
                    valid_sigma
                ],
                1
            )
        }
    }
    
    
    ############################################################################
    # Fallback to fitted model volatility
    ############################################################################
    
    if (
        !is.finite(sigma_last) &&
        exists("garch_models") &&
        length(garch_models) >= i &&
        !is.null(garch_models[[i]])
    ) {
        
        sigma_fit <- tryCatch(
            
            volatility(
                garch_models[[i]]
            ),
            
            error = function(e) NULL
        )
        
        
        if (
            !is.null(sigma_fit)
        ) {
            
            sigma_fit <- sigma_fit[
                is.finite(sigma_fit)
            ]
            
            
            if (
                length(sigma_fit) > 0
            ) {
                
                sigma_last <- tail(
                    sigma_fit,
                    1
                )
            }
        }
    }
    
    
    if (
        !is.finite(sigma_last) ||
        sigma_last <= 0
    ) {
        
        garch_oos_status$Forecast_Status[i] <-
            "Final training volatility unavailable"
        
        next
    }
    
    
    ############################################################################
    # Last observed training innovation
    ############################################################################
    
    e_train_valid <- e_train[
        valid_train
    ]
    
    
    e_last <- tail(
        e_train_valid,
        1
    )
    
    
    ############################################################################
    # Recursive OOS forecasting
    ############################################################################
    
    n_forecasts_i <- 0L
    n_updates_i <- 0L
    
    
    for (
        h in seq_len(n_test)
    ) {
        
        ########################################################################
        # Forecast next conditional variance
        ########################################################################
        
        sigma_next_sq <-
            omega +
            alpha * e_last^2 +
            beta * sigma_last^2
        
        
        if (
            !is.finite(sigma_next_sq) ||
            sigma_next_sq <= 0
        ) {
            
            benchmark_sigma2[
                h,
                i
            ] <- NA_real_
            
            break
        }
        
        
        sigma_next_sq <-
            max(
                sigma_next_sq,
                EPS
            )
        
        
        benchmark_sigma2[
            h,
            i
        ] <-
            sigma_next_sq
        
        
        n_forecasts_i <-
            n_forecasts_i + 1L
        
        
        ########################################################################
        # After forecasting, update with the OBSERVED test innovation.
        #
        # This creates a genuine one-step-ahead rolling forecast.
        ########################################################################
        
        e_observed <- innovation_mat[
            test_idx[h],
            i
        ]
        
        
        if (
            is.finite(e_observed)
        ) {
            
            e_last <-
                e_observed
            
            sigma_last <-
                sqrt(
                    sigma_next_sq
                )
            
            n_updates_i <-
                n_updates_i + 1L
            
        } else {
            
            ####################################################################
            # If the next observed innovation is unavailable, do not fabricate
            # a zero shock. Carry forward the conditional expectation:
            #
            # E(e_t^2 | F_{t-1}) = sigma_t^2
            #
            # Therefore the next forecast uses:
            #
            # omega + beta * sigma_t^2
            #
            # because E(e_t^2 | F_{t-1}) = sigma_t^2.
            ####################################################################
            
            e_last <- 0
            
            sigma_last <-
                sqrt(
                    sigma_next_sq
                )
        }
    }
    
    
    garch_oos_status$Forecast_Available[i] <-
        n_forecasts_i > 0
    
    garch_oos_status$N_Test_Forecasts[i] <-
        n_forecasts_i
    
    garch_oos_status$N_Test_Updates[i] <-
        n_updates_i
    
    
    if (
        n_forecasts_i == n_test
    ) {
        
        garch_oos_status$Forecast_Status[i] <-
            "Successful"
        
    } else if (
        n_forecasts_i > 0
    ) {
        
        garch_oos_status$Forecast_Status[i] <-
            "Partial"
    }
}


################################################################################
# 32.7 STATE-LEVEL OOS FORECAST EVALUATION
################################################################################
#
# Forecast:
#
#     h_t = sigma_t^2
#
# Target:
#
#     e_t^2
#
