) <- "double"


# -----------------------------------------------------------------------------
# Basic dimension checks
# -----------------------------------------------------------------------------

if (
    length(dim(vol_mat)) != 2L
) {

    stop(
        "vol_mat must be a two-dimensional matrix."
    )
}


if (
    ncol(vol_mat) !=
