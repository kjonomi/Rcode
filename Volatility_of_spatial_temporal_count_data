    stop(
        "GARCH volatility matrix has incorrect dimensions."
    )
}


# =============================================================================
# 16.11 VALIDATION: SUCCESSFUL STATES HAVE VOLATILITY
# =============================================================================

if (
    successful_state_count > 0L
) {

    missing_volatility <-
        successful_states[
            vapply(
                successful_states,
                function(i) {

                    all(
                        is.finite(
                            vol_mat[
                                ,
                                i
                            ]
                        )
                    ) &&
                    all(
                        vol_mat[
                            ,
                                i
                            ] > 0
                    )

                },
                logical(1)
            ) == FALSE
        ]


    if (
        length(
            missing_volatility
        ) == 0L
    ) {

        cat(
            "PASS: All successful states have finite positive training volatility.\n"
        )

    } else {

        warning(
            "Some states marked successful have missing/invalid volatility."
        )

        print(
            locations[
                missing_volatility
            ]
        )
    }

} else {

    cat(
        "No successful GARCH states available for volatility validation.\n"
    )
}


# =============================================================================
# 16.12 VALIDATION: FAILED STATES REMAIN NA
# =============================================================================

if (
    failed_state_count > 0L
) {

    failed_with_volatility <-
        failed_states[
            vapply(
                failed_states,
                function(i) {

                    any(
                        is.finite(
                            vol_mat[
                                ,
                                i
                            ]
                        )
                    )

                },
                logical(1)
            )
        ]


    if (
        length(
            failed_with_volatility
        ) == 0L
    ) {

        cat(
            "PASS: Failed states contain no fitted volatility values.\n"
        )

    } else {

        warning(
            "Some failed states contain fitted volatility values."
        )

        print(
            locations[
                failed_with_volatility
            ]
        )
    }
}


# =============================================================================
# 16.13 VALIDATION: GARCH PARAMETER RESTRICTIONS
# =============================================================================

successful_parameter_check <-
    garch_stats[
        garch_stats$GARCH_Status == "SUCCESS",
        ,
        drop = FALSE
    ]


if (
    nrow(successful_parameter_check) > 0L
) {

    invalid_parameters <-
        successful_parameter_check[
            !is.finite(
                successful_parameter_check$Omega
            ) |
            !is.finite(
                successful_parameter_check$Alpha
            ) |
            !is.finite(
                successful_parameter_check$Beta
            ) |
            !is.finite(
                successful_parameter_check$GARCH_Persistence
            ) |
            successful_parameter_check$Omega <= 0 |
            successful_parameter_check$Alpha < 0 |
            successful_parameter_check$Beta < 0 |
            successful_parameter_check$GARCH_Persistence >=
                GARCH_MAX_PERSISTENCE,
            ,
            drop = FALSE
        ]


    if (
        nrow(invalid_parameters) == 0L
