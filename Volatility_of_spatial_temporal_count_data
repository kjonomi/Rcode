) {

    stop(
        "Number of columns in vol_mat does not equal ",
        "length(locations)."
    )
}


# -----------------------------------------------------------------------------
# Assign state names
# -----------------------------------------------------------------------------

colnames(
    vol_mat
) <- locations


n_train <-
    nrow(vol_mat)


n_loc <-
    ncol(vol_mat)


if (
    n_train < 1L
) {

    stop(
        "vol_mat contains zero training observations."
    )
}


if (
    n_loc < 1L
) {

