for (i in seq_len(n_loc)) {

    state_i <- state_names[i]

    cat(
        sprintf(
            "[%02d/%02d] %s ... ",
            i,
            n_loc,
            state_i
        )
    )


    # =========================================================================
    # TRAINING INNOVATIONS ONLY
    # =========================================================================

    e_train_raw <- innovation_mat[
        train_idx,
        i
    ]

    # IMPORTANT:
    # valid_idx preserves the original position in the training vector.
    valid_idx <- which(is.finite(e_train_raw))

    e_train <- e_train_raw[valid_idx]

    n_train_total <- length(e_train_raw)
    n_train_valid <- length(e_train)
    n_train_missing <- n_train_total - n_train_valid


    innovation_mean <- if (n_train_valid > 0) {
        mean(e_train)
    } else {
        NA_real_
    }


    innovation_sd <- if (n_train_valid > 1) {
        sd(e_train)
    } else {
        NA_real_
    }


    method_messages <- character(0)

    selected_fit <- NULL


    # =========================================================================
    # BASIC DATA CHECK
    # =========================================================================

    if (n_train_valid < GARCH_MIN_OBS) {

        failure_message <- paste0(
            "Too few finite training innovations: ",
            n_train_valid,
            ". Minimum required = ",
            GARCH_MIN_OBS,
            "."
        )

        garch_results[[i]] <- data.frame(
            State = state_i,
            Success = FALSE,
            GARCH_Method = "None",
            N_Train = n_train_total,
            N_Valid = n_train_valid,
            N_Missing = n_train_missing,
            Innovation_Mean = innovation_mean,
            Innovation_SD_Train = innovation_sd,
            Omega = NA_real_,
            Alpha = NA_real_,
            Beta = NA_real_,
            Persistence = NA_real_,
            High_Persistence = NA,
            Objective = NA_real_,
            Convergence = NA_integer_,
            Iterations = NA_integer_,
            Failure_Message = failure_message,
            stringsAsFactors = FALSE
        )

        failed_diagnostics[[i]] <- garch_results[[i]]

        cat("FAILED\n")

        next
    }


    if (!is.finite(innovation_sd) || innovation_sd <= 1e-10) {

        failure_message <-
            "Training innovation SD is too small or non-finite."

        garch_results[[i]] <- data.frame(
            State = state_i,
            Success = FALSE,
            GARCH_Method = "None",
            N_Train = n_train_total,
            N_Valid = n_train_valid,
            N_Missing = n_train_missing,
            Innovation_Mean = innovation_mean,
            Innovation_SD_Train = innovation_sd,
            Omega = NA_real_,
            Alpha = NA_real_,
            Beta = NA_real_,
            Persistence = NA_real_,
            High_Persistence = NA,
            Objective = NA_real_,
            Convergence = NA_integer_,
            Iterations = NA_integer_,
            Failure_Message = failure_message,
            stringsAsFactors = FALSE
        )

        failed_diagnostics[[i]] <- garch_results[[i]]

        cat("FAILED\n")

        next
    }


    # =========================================================================
    # METHOD 1: fGarch / nlminb
    # =========================================================================
    #
    # IMPORTANT:
    # Do NOT use invokeRestart("muffleWarning") inside tryCatch().
    # suppressWarnings() is used instead.
    #
    # =========================================================================

    if (
        is.null(selected_fit) &&
        HAS_FGARCH
    ) {

        fit_fgarch_nlminb <- tryCatch(

            suppressWarnings(

                fGarch::garchFit(
                    ~ garch(1, 1),
                    data = e_train,
                    cond.dist = "norm",
                    include.mean = FALSE,
                    trace = FALSE,
                    algorithm = "nlminb"
                )
            ),

            error = function(err) {

                method_messages <<-
                    c(
                        method_messages,
                        paste0(
                            "fGarch-nlminb: ",
                            conditionMessage(err)
                        )
                    )

                NULL
            }
        )


        if (!is.null(fit_fgarch_nlminb)) {

            coef_fgarch <- tryCatch(
                coef(fit_fgarch_nlminb),
                error = function(err) NULL
            )


            if (
                !is.null(coef_fgarch) &&
                all(is.finite(coef_fgarch))
            ) {

                omega_i <- unname(
                    coef_fgarch["omega"]
                )

                alpha_i <- unname(
                    coef_fgarch["alpha1"]
                )

                beta_i <- unname(
                    coef_fgarch["beta1"]
                )


                if (
                    is.finite(omega_i) &&
                    is.finite(alpha_i) &&
                    is.finite(beta_i) &&
                    omega_i > 0 &&
                    alpha_i >= 0 &&
                    beta_i >= 0 &&
                    alpha_i + beta_i < GARCH_MAX_PERSISTENCE
                ) {

                    sigma_i <- tryCatch(
                        as.numeric(
                            sigma(
                                fit_fgarch_nlminb
                            )
                        ),
                        error = function(err) NULL
                    )


                    if (
                        !is.null(sigma_i) &&
                        length(sigma_i) == n_train_valid &&
                        all(is.finite(sigma_i)) &&
                        all(sigma_i > 0)
                    ) {

                        objective_i <- tryCatch(
                            as.numeric(
                                -logLik(
                                    fit_fgarch_nlminb
                                )
                            ),
                            error = function(err) NA_real_
                        )


                        selected_fit <- list(
                            success = TRUE,
                            omega = omega_i,
                            alpha = alpha_i,
                            beta = beta_i,
                            persistence = alpha_i + beta_i,
                            sigma = sigma_i,
                            objective = objective_i,
                            convergence = NA_integer_,
                            iterations = NA_integer_,
                            innovation_sd = innovation_sd,
                            method = "fGarch - nlminb",
                            constraint_parameterization = FALSE,
                            message = "Successful"
                        )
                    }
                }
            }
        }
    }


    # =========================================================================
    # METHOD 2: fGarch / lbfgsb
    # =========================================================================

    if (
        is.null(selected_fit) &&
        HAS_FGARCH
    ) {

        fit_fgarch_lbfgsb <- tryCatch(

            suppressWarnings(

                fGarch::garchFit(
                    ~ garch(1, 1),
                    data = e_train,
                    cond.dist = "norm",
                    include.mean = FALSE,
                    trace = FALSE,
                    algorithm = "lbfgsb"
                )
            ),

            error = function(err) {

                method_messages <<-
                    c(
                        method_messages,
                        paste0(
                            "fGarch-lbfgsb: ",
                            conditionMessage(err)
                        )
                    )

                NULL
            }
        )


        if (!is.null(fit_fgarch_lbfgsb)) {

            coef_fgarch <- tryCatch(
                coef(fit_fgarch_lbfgsb),
                error = function(err) NULL
            )


            if (
                !is.null(coef_fgarch) &&
                all(is.finite(coef_fgarch))
            ) {

                omega_i <- unname(
                    coef_fgarch["omega"]
                )

                alpha_i <- unname(
                    coef_fgarch["alpha1"]
                )

                beta_i <- unname(
                    coef_fgarch["beta1"]
                )


                if (
                    is.finite(omega_i) &&
                    is.finite(alpha_i) &&
                    is.finite(beta_i) &&
                    omega_i > 0 &&
                    alpha_i >= 0 &&
                    beta_i >= 0 &&
                    alpha_i + beta_i < GARCH_MAX_PERSISTENCE
                ) {

                    sigma_i <- tryCatch(
                        as.numeric(
                            sigma(
                                fit_fgarch_lbfgsb
                            )
                        ),
                        error = function(err) NULL
                    )


                    if (
                        !is.null(sigma_i) &&
                        length(sigma_i) == n_train_valid &&
                        all(is.finite(sigma_i)) &&
                        all(sigma_i > 0)
                    ) {

                        objective_i <- tryCatch(
                            as.numeric(
                                -logLik(
                                    fit_fgarch_lbfgsb
                                )
                            ),
                            error = function(err) NA_real_
                        )


                        selected_fit <- list(
                            success = TRUE,
                            omega = omega_i,
                            alpha = alpha_i,
                            beta = beta_i,
                            persistence = alpha_i + beta_i,
                            sigma = sigma_i,
                            objective = objective_i,
                            convergence = NA_integer_,
                            iterations = NA_integer_,
                            innovation_sd = innovation_sd,
                            method = "fGarch - lbfgsb",
                            constraint_parameterization = FALSE,
                            message = "Successful"
                        )
                    }
                }
            }
        }
    }


    # =========================================================================
    # METHOD 3: EXISTING CONSTRAINED QML
    # =========================================================================

    if (
        is.null(selected_fit) &&
        HAS_EXISTING_CONSTRAINED_QML
    ) {

        fit_existing <- tryCatch(

            fit_garch_constrained_qml(
