################################################################################
# 24. SELECT NUMBER OF CLUSTERS
################################################################################
#
# REVIEWER 2-4:
#
# The number of clusters should not be imposed without diagnostic support.
#
# We evaluate candidate numbers of clusters using the average silhouette
# width.
#
# The clustering distance is based on the standardized TIME-INDEXED
# TRAINING-PERIOD volatility trajectories.
#
# Because each state trajectory was standardized across time in Section 23,
# the Euclidean distance primarily measures similarity in TEMPORAL SHAPE
# rather than absolute volatility magnitude.
#
# The test period is NOT used for cluster selection or clustering.
#
################################################################################


################################################################################
# 24.0 VALIDATE REQUIRED OBJECTS
################################################################################

required_objects_24 <- c(
    "volatility_matrix_scaled",
    "OUTPUT_DIR"
)

missing_objects_24 <- required_objects_24[
    !vapply(
        required_objects_24,
        exists,
        logical(1),
        inherits = TRUE
    )
]

if (length(missing_objects_24) > 0) {
    
    stop(
        paste(
            "Section 24 is missing required objects:",
            paste(missing_objects_24, collapse = ", ")
        )
    )
}


################################################################################
# 24.0.1 VALIDATE CLUSTERING MATRIX
################################################################################

volatility_matrix_scaled <-
    as.matrix(
        volatility_matrix_scaled
    )


if (
    nrow(volatility_matrix_scaled) < 3
) {
    
    warning(
        "Fewer than three states are available for silhouette-based ",
        "cluster selection."
    )
}


if (
    ncol(volatility_matrix_scaled) < 2
) {
    
    stop(
        "The standardized volatility trajectories contain too few time points."
    )
}


if (
    any(
        !is.finite(
            volatility_matrix_scaled
        )
    )
) {
    
    stop(
        "Nonfinite values are present in volatility_matrix_scaled."
    )
}


################################################################################
# 24.0.2 CHECK FOR ZERO-VARIANCE STATE TRAJECTORIES
################################################################################
#
# A completely flat standardized trajectory is represented by zeros in
# Section 23. Such a trajectory has no temporal variation.
#
# These trajectories can technically be clustered, but they should be
# explicitly identified because they contain little information about
# temporal dynamics.
#
################################################################################

trajectory_row_sd <- apply(
    volatility_matrix_scaled,
    1,
    sd
)


zero_variation_states <- rownames(
    volatility_matrix_scaled
)[
    trajectory_row_sd < EPS
]


cat(
    "\n============================================================\n"
)

cat(
    "VOLATILITY TRAJECTORY CLUSTER SELECTION\n"
)

cat(
    "============================================================\n"
)

cat(
    "States available:       ",
    nrow(volatility_matrix_scaled),
    "\n"
)

cat(
    "Training time points:   ",
    ncol(volatility_matrix_scaled),
    "\n"
)

cat(
    "Zero-variation states:  ",
    length(zero_variation_states),
    "\n"
)

if (
    length(zero_variation_states) > 0
) {
    
    cat(
        "States with no temporal variation:\n"
    )
    
    print(
        zero_variation_states
    )
}


################################################################################
# 24.1 DEFINE CANDIDATE NUMBER OF CLUSTERS
################################################################################
#
# The candidate range is deliberately restricted to avoid fitting an
# excessive number of small clusters.
#
# The upper bound can be modified for sensitivity analysis.
#
################################################################################

MAX_CANDIDATE_K <- 6


if (
    !is.numeric(MAX_CANDIDATE_K) ||
    length(MAX_CANDIDATE_K) != 1 ||
    !is.finite(MAX_CANDIDATE_K) ||
    MAX_CANDIDATE_K < 2
) {
    
    stop(
        "MAX_CANDIDATE_K must be a finite numeric value >= 2."
    )
}


MAX_CANDIDATE_K <- as.integer(
    MAX_CANDIDATE_K
)


max_k <- min(
    MAX_CANDIDATE_K,
    nrow(volatility_matrix_scaled) - 1
)


candidate_k <- if (
    max_k >= 2
) {
    seq.int(
        2,
        max_k
    )
} else {
    integer(0)
}


################################################################################
# 24.2 COMPUTE TRAJECTORY DISTANCE MATRIX
################################################################################
#
# Euclidean distance is calculated between the standardized state
# trajectories.
#
#       d(i,j) =
#       sqrt[
#           sum_t (z_it - z_jt)^2
#       ]
#
# Because z_it is state-wise standardized, this distance emphasizes
# similarity in temporal dynamics.
#
################################################################################

cluster_distance <- NULL


if (
    length(candidate_k) > 0
) {
    
    cluster_distance <- dist(
        volatility_matrix_scaled,
        method = "euclidean"
    )
}


################################################################################
# 24.3 SILHOUETTE-BASED K SELECTION
################################################################################

selected_k <- NA_integer_


silhouette_results <- data.frame(
    K = integer(),
    Average_Silhouette = numeric(),
    Total_WithinSS = numeric(),
    BetweenSS = numeric(),
    TotalSS = numeric(),
    BetweenSS_Ratio = numeric(),
    Minimum_Cluster_Size = integer(),
    Maximum_Cluster_Size = integer(),
    stringsAsFactors = FALSE
)


if (
    length(candidate_k) > 0
) {
    
    for (
        k in candidate_k
    ) {
        
        set.seed(
            12345 + k
        )
        
        
        km_tmp <- kmeans(
            volatility_matrix_scaled,
            centers = k,
            nstart = 100
        )
        
        
        cluster_sizes <- table(
            km_tmp$cluster
        )
        
        
        # ------------------------------------------------------------
        # Guard against degenerate clustering solutions
        # ------------------------------------------------------------
        
        if (
            length(cluster_sizes) != k
        ) {
            
            warning(
                "K = ",
                k,
                " produced fewer than ",
                k,
                " nonempty clusters. ",
                "This solution will not be used for selection."
            )
            
            next
        }
        
        
        # ------------------------------------------------------------
        # Silhouette width
        # ------------------------------------------------------------
        
        sil <- cluster::silhouette(
            km_tmp$cluster,
            cluster_distance
        )
        
        
        avg_silhouette <- mean(
            sil[, "sil_width"],
            na.rm = TRUE
        )
        
        
        # ------------------------------------------------------------
        # K-means diagnostics
        # ------------------------------------------------------------
        
        total_within_ss <- sum(
            km_tmp$withinss
        )
        
        
        total_ss <- sum(
            (
                volatility_matrix_scaled -
                matrix(
                    colMeans(
                        volatility_matrix_scaled
                    ),
                    nrow = nrow(volatility_matrix_scaled),
                    ncol = ncol(volatility_matrix_scaled),
                    byrow = TRUE
                )
            )^2
        )
        
        
        between_ss <- total_ss -
            total_within_ss
        
        
        between_ss_ratio <- if (
            total_ss > EPS
        ) {
            
            between_ss / total_ss
            
        } else {
            
            NA_real_
        }
        
        
        silhouette_results <- rbind(
            silhouette_results,
            data.frame(
                K = k,
                Average_Silhouette = avg_silhouette,
                Total_WithinSS = total_within_ss,
                BetweenSS = between_ss,
                TotalSS = total_ss,
                BetweenSS_Ratio = between_ss_ratio,
                Minimum_Cluster_Size = min(cluster_sizes),
                Maximum_Cluster_Size = max(cluster_sizes),
                stringsAsFactors = FALSE
            )
        )
    }
}


################################################################################
# 24.4 SAVE SILHOUETTE RESULTS
################################################################################

if (
    nrow(silhouette_results) > 0
) {
    
    silhouette_results <- silhouette_results[
