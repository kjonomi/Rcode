            }

            min(
                x,
                na.rm = TRUE
            )
        },
        numeric(1)
    ),

    Max_Training_Volatility = vapply(
        seq_len(n_loc),
        function(j) {

            x <- full_vol_mat[
                train_idx,
                j
            ]

            if (all(is.na(x))) {
                return(NA_real_)
            }

            max(
                x,
                na.rm = TRUE
            )
        },
        numeric(1)
    ),

    GARCH_Persistence = garch_persistence,

    High_Persistence = high_persistence_flag,

