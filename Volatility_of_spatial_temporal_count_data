# 17. TRAINING-PERIOD VOLATILITY SUMMARY
################################################################################
#
# PURPOSE:
#
#   Summarize the conditional volatility generated by Section 16.
#
# IMPORTANT:
#
#   Section 16 constructs:
#
#       vol_mat
#
#   with dimensions:
#
#       n_train x n_loc
#
#   Therefore vol_mat ALREADY contains only training-period volatility.
#
#   DO NOT use:
#
#       vol_mat[train_idx, ]
#
#   because train_idx refers to positions in the ORIGINAL full time series,
#   whereas vol_mat has only n_train rows.
#
#   Section 17 therefore operates directly on vol_mat.
#
################################################################################


cat("\n")
cat("============================================================\n")
cat("SECTION 17: TRAINING-PERIOD VOLATILITY SUMMARY\n")
cat("============================================================\n")


# =============================================================================
# 17.0 INPUT VALIDATION
# =============================================================================

if (!exists("vol_mat")) {

    stop(
        "Object 'vol_mat' does not exist. Run Section 16 first."
    )
}


if (!exists("locations")) {

    stop(
        "Object 'locations' does not exist."
    )
}


if (!exists("garch_stats")) {

    stop(
        "Object 'garch_stats' does not exist. Run Section 16 first."
    )
}


if (!exists("model_stats")) {

    stop(
        "Object 'model_stats' does not exist."
    )
}


# -----------------------------------------------------------------------------
# Ensure output directory exists
# -----------------------------------------------------------------------------

if (!exists("OUTPUT_DIR")) {

    OUTPUT_DIR <- "spatial_count_outputs"

}


if (!dir.exists(OUTPUT_DIR)) {

    dir.create(
        OUTPUT_DIR,
        recursive = TRUE,
