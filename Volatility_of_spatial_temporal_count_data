################################################################################
# 11. REVIEWER 1 / AE-1:
#     DIAGNOSTIC SUMMARY OF STANDARDIZED COUNT INNOVATIONS
################################################################################
#
# GARCH is applied to standardized count innovations:
#
#        e_ti =
#
#        (Y_ti - mu_ti)
#        ----------------
#        sqrt(V_ti)
#
# rather than to fitted conditional means.
#
# Diagnostics are calculated separately for:
#
#   (1) training period
#   (2) test period
#   (3) full period
#
# This distinction is important for temporal out-of-sample validation.
#
################################################################################


# -----------------------------------------------------------------------------
# 11.1 Robust helper functions
# -----------------------------------------------------------------------------
#
# These functions are defined here because Section 11 is executed before the
# later GARCH sections.
#

safe_mean <- function(x) {

    x <- as.numeric(x)

    x <- x[
        is.finite(x)
    ]

    if (length(x) == 0) {
        return(NA_real_)
    }

    mean(
        x,
        na.rm = TRUE
    )
}


safe_sd <- function(x) {

    x <- as.numeric(x)

    x <- x[
        is.finite(x)
    ]

    if (length(x) < 2) {
        return(NA_real_)
    }

    sd(
        x,
        na.rm = TRUE
    )
}


safe_mean_abs <- function(x) {

    x <- as.numeric(x)

    x <- x[
        is.finite(x)
    ]

