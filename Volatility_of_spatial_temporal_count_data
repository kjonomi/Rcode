    ncol = n_loc
)

colnames(full_vol_mat) <- locations


# -------------------------------------------------------------------------
# HARD STRUCTURAL CHECK
# -------------------------------------------------------------------------

if (!is.matrix(full_vol_mat)) {
    stop(
        "Section 18.6: full_vol_mat is not a matrix."
