# -----------------------------------------------------------------------------

high_persistence_flag_matched <-
    is.finite(
        garch_persistence_matched
    ) &
        garch_persistence_matched >=
            GARCH_HIGH_PERSISTENCE


# -----------------------------------------------------------------------------
# GARCH success indicator
# -----------------------------------------------------------------------------

garch_success_matched <-
    !is.na(
        garch_status_matched
    ) &
        grepl(
            "^Successful",
            garch_status_matched
        )


# =============================================================================
# 17.6 VOLATILITY COMPLETENESS
# =============================================================================

volatility_completeness <-
    ifelse(
        n_train > 0L,
        n_volatility_estimated /
            n_train,
        NA_real_
    )


# =============================================================================
# 17.7 CONSTRUCT TRAINING VOLATILITY SUMMARY DATA FRAME
# =============================================================================

volatility_df <- data.frame(

    State =
        locations,

    N_Train =
        rep(
            n_train,
            n_loc
        ),

    N_Volatility_Estimated =
        as.integer(
            n_volatility_estimated
        ),

    Volatility_Completeness =
        as.numeric(
            volatility_completeness
        ),

    Mean_Volatility_Train =
        as.numeric(
            mean_volatility_train
        ),

    SD_Volatility_Train =
        as.numeric(
            sd_volatility_train
        ),

    Min_Volatility_Train =
        as.numeric(
            min_volatility_train
        ),

    Max_Volatility_Train =
        as.numeric(
            max_volatility_train
        ),

    GARCH_Persistence =
        garch_persistence_matched,

    High_Persistence_Flag =
        high_persistence_flag_matched,

    GARCH_Method =
        garch_method_matched,

    GARCH_Status =
        garch_status_matched,

    Innovation_SD_Train =
        innovation_sd_matched,

    Selected_Count_Model =
        rep(
            as.character(
                model_stats$Selected_Model[1]
            ),
            n_loc
        ),

    stringsAsFactors = FALSE
)


# =============================================================================
# 17.8 SUCCESSFUL / FAILED GARCH STATES
# =============================================================================

successful_garch_states <-
    volatility_df$State[
        garch_success_matched
    ]


failed_garch_states <-
    volatility_df$State[
        !garch_success_matched
    ]


# =============================================================================
# 17.9 COMPLETE / INCOMPLETE VOLATILITY STATES
# =============================================================================

complete_volatility_states <-
    volatility_df$State[
        is.finite(
            volatility_df$Volatility_Completeness
        ) &
            volatility_df$Volatility_Completeness >=
                1
    ]


incomplete_volatility_states <-
    volatility_df$State[
        !(
            is.finite(
                volatility_df$Volatility_Completeness
            ) &
                volatility_df$Volatility_Completeness >=
                    1
        )
    ]


