################################################################################
# 29. CLUSTER SIZE
################################################################################
#
# Cluster size is reported descriptively.
#
# Small clusters should be interpreted cautiously because a cluster containing
# only a few states provides limited cross-sectional evidence for a distinct
# volatility regime.
#
# Cluster size does NOT determine cluster membership.
#
################################################################################


if (
    exists("cluster_membership") &&
    !is.null(cluster_membership) &&
    nrow(cluster_membership) > 0
) {
    
    
    ################################################################################
    # 29.1 VALIDATE CLUSTER MEMBERSHIP
    ################################################################################
    
    if (
        !"State" %in%
        names(cluster_membership)
    ) {
        
        stop(
            "cluster_membership does not contain a 'State' column."
        )
    }
    
    
    if (
        !"Cluster" %in%
        names(cluster_membership)
    ) {
        
        stop(
            "cluster_membership does not contain a 'Cluster' column."
        )
    }
    
    
    if (
        anyDuplicated(
            cluster_membership$State
        ) > 0
    ) {
        
        stop(
            "Duplicate states detected in cluster_membership."
        )
    }
    
    
    ################################################################################
    # 29.2 CALCULATE CLUSTER SIZE
    ################################################################################
    
    cluster_size <- as.data.frame(
        table(
            cluster_membership$Cluster
        )
    )
    
    
    names(
        cluster_size
    ) <- c(
        "Cluster",
        "Number_of_States"
    )
    
    
    cluster_size$Cluster <-
        as.integer(
            as.character(
                cluster_size$Cluster
            )
        )
    
    
    cluster_size <- cluster_size[
        order(
            cluster_size$Cluster
        ),
        ,
        drop = FALSE
    ]
    
    
    cluster_size$Proportion <-
        cluster_size$Number_of_States /
        sum(
            cluster_size$Number_of_States
        )
    
    
    cluster_size$Percentage <-
        100 *
        cluster_size$Proportion
    
    
    ################################################################################
    # 29.3 FLAG SMALL CLUSTERS
    ################################################################################
    
    cluster_size$Small_Cluster_Flag <-
        cluster_size$Number_of_States < 3
    
    
    cluster_size$Interpretation <-
        ifelse(
            cluster_size$Small_Cluster_Flag,
            "Small cluster; interpret cautiously",
            "Adequate descriptive cluster size"
        )
    
    
    ################################################################################
    # 29.4 SAVE
    ################################################################################
    
