  State = locations,
  Mean = mean_counts,
  Variance = var_counts,
  Zero_Count = zero_count,
  Zero_Proportion = zero_prop,
  Variance_to_Mean = var_counts / pmax(mean_counts, EPS)
)

write.csv(
