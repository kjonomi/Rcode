# -----------------------------------------------------------------------------

if (
    !"Selected_Model" %in% names(model_stats)
) {

    stop(
        "model_stats does not contain 'Selected_Model'."
    )
}


# =============================================================================
# 17.2 SAFE SUMMARY FUNCTIONS
# =============================================================================

safe_mean <- function(x) {

    x <- x[
        is.finite(x)
    ]


    if (
        length(x) == 0L
    ) {

        return(
            NA_real_
        )
    }


    mean(
        x
    )
}


safe_max <- function(x) {

    x <- x[
        is.finite(x)
    ]


    if (
        length(x) == 0L
    ) {

        return(
            NA_real_
        )
    }


    max(
        x
    )
}


safe_min <- function(x) {

    x <- x[
        is.finite(x)
    ]


    if (
        length(x) == 0L
    ) {

        return(
            NA_real_
        )
    }


    min(
        x
    )
}


safe_sd <- function(x) {

    x <- x[
        is.finite(x)
    ]


    if (
        length(x) < 2L
    ) {

        return(
            NA_real_
        )
    }


    sd(
        x
    )
}


