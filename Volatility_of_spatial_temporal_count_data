        "GARCH_Method",
        "GARCH_Status",
        "High_Persistence_Flag"
    ),
    names(garch_stats)
)


garch_parameter_table <- garch_stats[
    ,
    parameter_columns,
    drop = FALSE
]


volatility_diagnostics <- merge(
    volatility_diagnostics,
    garch_parameter_table,
    by = "State",
    all.x = TRUE,
    sort = FALSE
)


