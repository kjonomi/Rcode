# -----------------------------------------------------------------------------
# Expected number of finite training volatility values
# -----------------------------------------------------------------------------
#
# Each successfully estimated state should have one volatility estimate for
# each training observation, except where Section 16 intentionally retained
# missing values because an innovation was non-finite.
#
# Therefore, we compare the actual count with garch_stats rather than assuming
# that every successful state necessarily has exactly length(train_idx) values.
#
# -----------------------------------------------------------------------------

state_volatility_counts <- aggregate(
    is.finite(volatility_train_long$Volatility),
    by = list(
        State = volatility_train_long$State
    ),
    FUN = sum
)


names(state_volatility_counts)[2] <-
    "N_Finite_Volatility"


# =============================================================================
# 19.7 ENSURE STATE ORDERING IS STABLE
# =============================================================================

volatility_train_long$State <- factor(
    as.character(
        volatility_train_long$State
    ),
    levels = successful_states
)


# =============================================================================
# 19.8 STATE-LEVEL VOLATILITY DIAGNOSTICS
# =============================================================================

volatility_diagnostics <- do.call(
    rbind,
    lapply(
        successful_states,
        function(st) {

            z <- volatility_train_long$Volatility[
                as.character(
                    volatility_train_long$State
                ) == st
            ]

            finite_z <- z[
                is.finite(z)
            ]

            data.frame(

                State =
                    st,

                N =
                    length(finite_z),

                Mean_Volatility =
                    if (
                        length(finite_z) > 0L
                    ) {
                        mean(
                            finite_z
                        )
                    } else {
                        NA_real_
                    },

                SD_Volatility =
                    if (
                        length(finite_z) > 1L
                    ) {
                        sd(
                            finite_z
                        )
                    } else {
                        NA_real_
                    },

                Min_Volatility =
                    if (
                        length(finite_z) > 0L
                    ) {
                        min(
                            finite_z
                        )
                    } else {
                        NA_real_
                    },

                Max_Volatility =
                    if (
                        length(finite_z) > 0L
                    ) {
                        max(
                            finite_z
                        )
                    } else {
                        NA_real_
                    },

                stringsAsFactors = FALSE
            )
        }
    )
)


rownames(
    volatility_diagnostics
) <- NULL


# =============================================================================
# 19.9 MERGE GARCH PARAMETERS
# =============================================================================
#
# Match by State rather than relying on row order.
#
# This is important because the GARCH fitting section can contain failed
# states, and row order should never be assumed to coincide with locations.
#
# =============================================================================

parameter_columns <- intersect(
    c(
        "State",
        "N_Train_Total",
        "N_Train_Usable",
        "Innovation_SD_Train",
        "Omega",
        "Alpha",
        "Beta",
