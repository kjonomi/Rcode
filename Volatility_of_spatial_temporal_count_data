# 14.1 VALIDATE GAUSSIAN COPULA OBJECT
# =============================================================================

if (!exists("gaussian_fit")) {

    stop(
        "Object 'gaussian_fit' does not exist. ",
        "The Gaussian copula must be estimated before Section 14."
    )
}


if (!is.list(gaussian_fit)) {

    stop(
        "`gaussian_fit` must be a list-like custom Gaussian copula object."
    )
}


if (!"correlation" %in% names(gaussian_fit)) {

    stop(
        "`gaussian_fit$correlation` does not exist."
    )
}


R_gaussian <- gaussian_fit$correlation


if (!is.matrix(R_gaussian)) {

    R_gaussian <- as.matrix(
        R_gaussian
    )
}


if (
    nrow(R_gaussian) != n_loc ||
    ncol(R_gaussian) != n_loc
) {

    stop(
        paste0(
            "`R_gaussian` has dimensions ",
            paste(dim(R_gaussian), collapse = " x "),
            ", but expected ",
            n_loc,
            " x ",
            n_loc,
            "."
        )
    )
}


if (
    any(
        !is.finite(
            R_gaussian
        )
    )
) {

    stop(
        "`R_gaussian` contains non-finite values."
    )
}


# =============================================================================
# 14.1.1 SYMMETRIZE NUMERICALLY
# =============================================================================

R_gaussian <- (
    R_gaussian +
        t(R_gaussian)
) / 2


# =============================================================================
# 14.1.2 CHECK UNIT DIAGONAL
# =============================================================================

if (
    any(
        abs(
            diag(R_gaussian) - 1
        ) > 1e-8
    )
) {

    stop(
        "`R_gaussian` does not have a unit diagonal."
    )
}


# =============================================================================
# 14.1.3 POSITIVE-DEFINITE CHECK
# =============================================================================

gaussian_eigenvalues <- eigen(
    R_gaussian,
    symmetric = TRUE,
    only.values = TRUE
)$values


if (
    any(
        !is.finite(
            gaussian_eigenvalues
        )
    )
) {

    stop(
        "Gaussian correlation matrix has non-finite eigenvalues."
    )
}


if (
    min(gaussian_eigenvalues) <= 0
) {

    stop(
        "Gaussian correlation matrix is not positive definite."
    )
}


# =============================================================================
# 14.1.4 EXTRACT GAUSSIAN LOG-LIKELIHOOD
# =============================================================================

gaussian_loglik <- NA_real_


if (
    "logLik" %in%
        names(gaussian_fit)
) {

    gaussian_loglik <- tryCatch(

        as.numeric(
            gaussian_fit$logLik
        ),

        error = function(e) {
            NA_real_
        }
    )
}


# =============================================================================
# 14.1.5 EXPLICIT GAUSSIAN COPULA LOG-LIKELIHOOD FALLBACK
# =============================================================================
#
# For z_spatial ~ N(0, R), the Gaussian copula log-likelihood is
#
#   -1/2 { n log|R| +
#          sum_i z_i' (R^{-1} - I) z_i }.
#
# Constant terms cancel from the copula density and are therefore omitted.
#
################################################################################

if (
    !is.finite(gaussian_loglik)
) {

    if (!exists("z_spatial")) {

        stop(
            "Neither gaussian_fit$logLik nor z_spatial is available ",
            "for Gaussian copula likelihood calculation."
        )
    }


    if (
        !is.matrix(z_spatial) ||
        ncol(z_spatial) != n_loc
    ) {

        stop(
            "`z_spatial` has incorrect dimensions."
        )
    }


    gaussian_loglik <- tryCatch({

        log_det_R <- as.numeric(
            determinant(
                R_gaussian,
                logarithm = TRUE
            )$modulus
        )


        R_inv <- solve(
            R_gaussian
        )


        I_d <- diag(
            ncol(R_gaussian)
        )


        quad_form <- rowSums(
            (
                z_spatial %*%
                    (
                        R_inv -
                            I_d
                    )
            ) *
                z_spatial
        )


        value <- -0.5 * (
            nrow(z_spatial) *
                log_det_R +
                sum(quad_form)
        )


        if (
            is.finite(value)
        ) {

            value

        } else {

            NA_real_
        }

    }, error = function(e) {

        NA_real_

    })
}


# =============================================================================
# 14.1.6 GAUSSIAN PARAMETER COUNT
# =============================================================================

gaussian_dimension <- ncol(
    R_gaussian
)


gaussian_k <-
    gaussian_dimension *
    (
        gaussian_dimension - 1
    ) / 2


# =============================================================================
# 14.1.7 GAUSSIAN AIC
# =============================================================================

gaussian_aic <- if (
    is.finite(
        gaussian_loglik
    )
) {

    -2 *
        gaussian_loglik +
        2 *
        gaussian_k

} else {

    NA_real_
}


# =============================================================================
# 14.1.8 GAUSSIAN BIC
# =============================================================================

gaussian_bic <- if (
    is.finite(
