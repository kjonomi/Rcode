    drop = FALSE
]

test_block <- full_vol_mat[
    test_idx,
    ,
    drop = FALSE
]


training_finite_count <- sum(
    is.finite(training_block)
)

training_expected_count <- (
    length(train_idx) * n_loc
)

test_finite_count <- sum(
    is.finite(test_block)
)


cat(
    "Finite training values: ",
