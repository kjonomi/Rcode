    !is.finite(SIGMA_LEVEL) ||
    SIGMA_LEVEL <= 0
) {

    stop(
        "SIGMA_LEVEL must be a positive finite numeric scalar."
    )
}


cl_upper <- vol_mean +
    SIGMA_LEVEL *
    vol_sd


cl_lower <- max(
    0,
    vol_mean -
        SIGMA_LEVEL *
        vol_sd
)


cat(
