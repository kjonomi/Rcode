# =============================================================================
# 16.7 DIRECT REPARAMETERIZED GAUSSIAN QML
# =============================================================================

fit_garch_direct_qml <- function(
    e,
    max_persistence = 0.998,
    n_starts = 12,
    maxit = 10000
) {

    # -------------------------------------------------------------------------
    # Clean innovations
    # -------------------------------------------------------------------------

    e <- as.numeric(e)
    e <- e[is.finite(e)]

    if (length(e) < GARCH_MIN_OBS) {

        return(
            list(
                success = FALSE,
                message = paste0(
                    "Too few finite innovations: ",
                    length(e),
                    "."
                )
            )
        )
    }


    # -------------------------------------------------------------------------
    # Scale innovations
    # -------------------------------------------------------------------------

    e_sd <- sd(e)

    if (!is.finite(e_sd) || e_sd <= 1e-10) {

        return(
            list(
                success = FALSE,
                message = "Innovation SD is too small or non-finite."
            )
        )
    }

    x <- e / e_sd

    n <- length(x)

    x_var <- var(x)

    if (!is.finite(x_var) || x_var <= 0) {
        x_var <- 1
    }


    # -------------------------------------------------------------------------
    # Parameter transformation
    #
    # omega = exp(theta1)
    #
    # persistence = max_persistence * plogis(theta2)
    #
    # alpha_share = plogis(theta3)
    #
    # alpha = persistence * alpha_share
    #
    # beta = persistence * (1-alpha_share)
    # -------------------------------------------------------------------------

    unpack <- function(theta) {

        omega <- exp(theta[1])

        persistence <- max_persistence * plogis(theta[2])

        alpha_share <- plogis(theta[3])

        alpha <- persistence * alpha_share

        beta <- persistence * (1 - alpha_share)

        list(
            omega = omega,
            alpha = alpha,
            beta = beta,
            persistence = persistence
        )
    }


    # -------------------------------------------------------------------------
    # Gaussian QML objective
    # -------------------------------------------------------------------------

    nll <- function(theta) {

        par <- unpack(theta)

        sigma2 <- numeric(n)

        unconditional_var <-
            par$omega / (1 - par$persistence)

        if (!is.finite(unconditional_var) || unconditional_var <= 0) {
            unconditional_var <- x_var
        }

        sigma2[1] <- max(unconditional_var, 1e-8)

        for (tt in 2:n) {

            sigma2[tt] <-
                par$omega +
                par$alpha * x[tt - 1]^2 +
                par$beta * sigma2[tt - 1]

            if (!is.finite(sigma2[tt]) || sigma2[tt] <= 0) {
                return(1e100)
            }
        }

        value <-
            0.5 * sum(
                log(sigma2) +
                x^2 / sigma2
            )

        if (!is.finite(value)) {
            return(1e100)
        }

        value
    }


    # -------------------------------------------------------------------------
    # Starting-value function
    # -------------------------------------------------------------------------

    make_start <- function(
        omega,
        persistence,
        alpha_share
    ) {

        persistence_scaled <-
            min(
                max(
                    persistence / max_persistence,
                    1e-6
                ),
                1 - 1e-6
            )

        alpha_share <-
            min(
                max(alpha_share, 1e-6),
                1 - 1e-6
            )

        c(
            log(omega),
            qlogis(persistence_scaled),
            qlogis(alpha_share)
        )
    }


    # -------------------------------------------------------------------------
    # Multiple starting values
    # -------------------------------------------------------------------------

    starts <- list(

        make_start(0.05, 0.95, 0.05),
        make_start(0.05, 0.90, 0.10),
        make_start(0.02, 0.94, 0.05),
        make_start(0.01, 0.97, 0.01),
        make_start(0.10, 0.80, 0.05),
        make_start(0.01, 0.85, 0.10),
        make_start(0.02, 0.80, 0.15),
        make_start(0.10, 0.70, 0.10),
        make_start(0.05, 0.50, 0.20),
        make_start(0.10, 0.95, 0.50),
        make_start(0.01, 0.60, 0.50),
        make_start(0.05, 0.98, 0.01)
    )

    starts <- starts[
        seq_len(
            min(n_starts, length(starts))
        )
    ]


    # -------------------------------------------------------------------------
    # Optimize
    # -------------------------------------------------------------------------

    fits <- lapply(
        starts,
        function(st) {

            tryCatch(

                optim(
                    par = st,
                    fn = nll,
                    method = "BFGS",
                    control = list(
                        maxit = maxit,
                        reltol = 1e-10
                    )
                ),

                error = function(err) {
                    NULL
                }
            )
        }
    )


    # -------------------------------------------------------------------------
    # Keep finite fits
    # -------------------------------------------------------------------------

    valid <- vapply(
        fits,
        function(fit) {

            !is.null(fit) &&
                is.finite(fit$value) &&
                length(fit$par) == 3 &&
                all(is.finite(fit$par))
        },
        logical(1)
    )

    valid_fits <- fits[valid]


    if (length(valid_fits) == 0) {

        return(
            list(
                success = FALSE,
                message =
                    "No finite direct-QML optimization result."
            )
        )
    }


    # -------------------------------------------------------------------------
    # Select best fit
    # -------------------------------------------------------------------------

    objective_values <- vapply(
        valid_fits,
        function(fit) fit$value,
        numeric(1)
    )

    best_id <- which.min(objective_values)

    # IMPORTANT:
    # Use [[best_id]], not [ [best_id] ].
    best <- valid_fits[[best_id]]


    # -------------------------------------------------------------------------
    # Recover parameters
    # -------------------------------------------------------------------------

    par <- unpack(best$par)

    omega_scaled <- par$omega
    alpha <- par$alpha
    beta <- par$beta
    persistence <- par$persistence


    # -------------------------------------------------------------------------
    # Strict admissibility
    # -------------------------------------------------------------------------

    admissible <-
        is.finite(omega_scaled) &&
        is.finite(alpha) &&
        is.finite(beta) &&
        is.finite(persistence) &&
        omega_scaled > 0 &&
        alpha >= 0 &&
        beta >= 0 &&
        persistence < max_persistence

    if (!admissible) {

        return(
            list(
                success = FALSE,
                message =
                    "Direct QML produced invalid GARCH parameters."
            )
        )
    }


    # -------------------------------------------------------------------------
    # Reconstruct conditional variance
    # -------------------------------------------------------------------------

    sigma2 <- numeric(n)

    unconditional_var <-
        omega_scaled / (1 - persistence)

    if (!is.finite(unconditional_var) || unconditional_var <= 0) {
        unconditional_var <- x_var
    }

    sigma2[1] <- max(unconditional_var, 1e-8)

    for (tt in 2:n) {

        sigma2[tt] <-
            omega_scaled +
            alpha * x[tt - 1]^2 +
            beta * sigma2[tt - 1]

        if (!is.finite(sigma2[tt]) || sigma2[tt] <= 0) {

            return(
                list(
                    success = FALSE,
                    message =
                        "Invalid conditional variance recursion."
                )
            )
        }
    }


    # -------------------------------------------------------------------------
    # Transform back to original innovation scale
    # -------------------------------------------------------------------------

    sigma_original <- sqrt(sigma2) * e_sd

    omega_original <- omega_scaled * e_sd^2


    # -------------------------------------------------------------------------
    # Final validation
    # -------------------------------------------------------------------------

    if (
        length(sigma_original) != length(e) ||
        any(!is.finite(sigma_original)) ||
        any(sigma_original <= 0)
    ) {

        return(
            list(
                success = FALSE,
                message =
                    "Final conditional volatility contains invalid values."
            )
        )
    }


    # -------------------------------------------------------------------------
    # Return result
    # -------------------------------------------------------------------------

    list(
        success = TRUE,
        omega = omega_original,
        alpha = alpha,
        beta = beta,
        persistence = persistence,
        sigma = sigma_original,
        objective = best$value,
        convergence = best$convergence,
        iterations = if (!is.null(best$counts[["function"]])) {
            best$counts[["function"]]
        } else {
            NA_integer_
        },
        innovation_sd = e_sd,
        method =
            "Direct constrained Gaussian QML - reparameterized",
        constraint_parameterization = TRUE,
        message = "Successful"
    )
}


