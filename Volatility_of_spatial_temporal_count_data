################################################################################
# 23.1 STATE-WISE TEMPORAL STANDARDIZATION
################################################################################
#
# Each row corresponds to one state.
#
# Each row is standardized using its own training-period mean and standard
# deviation.
#
################################################################################

row_standardize <- function(x) {
    
    mu <- mean(
        x,
        na.rm = TRUE
    )
    
    s <- sd(
        x,
        na.rm = TRUE
    )
    
    if (
        !is.finite(mu)
    ) {
        
        stop(
            "A nonfinite state-specific volatility mean was detected."
        )
    }
    
    if (
        !is.finite(s) ||
        s < EPS
    ) {
        
        # A state with essentially constant volatility has no temporal shape.
        # Assigning zero to all standardized values gives it a neutral
        # trajectory representation.
        return(
            rep(
                0,
                length(x)
            )
        )
    }
    
    (
        x - mu
    ) / s
}


################################################################################
# 23.2 APPLY STANDARDIZATION TO EACH STATE
################################################################################

