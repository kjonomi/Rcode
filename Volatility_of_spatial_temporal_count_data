cat("Testing observations:", length(test_idx), "\n")
cat("Training end:", as.character(max(train_dates)), "\n")
cat("Testing start:", as.character(min(test_dates)), "\n")

################################################################################
# 9. TRAINING-ONLY MARGINAL COUNT MODEL SELECTION
################################################################################
#
# AE-1 / R2-3 / R1-3:
#
# Candidate marginal count models:
#
#   1. Poisson
#   2. Negative Binomial (NB)
#   3. Zero-Inflated Poisson (ZIP)
#
# -------------------------------------------------------------------------------
# ESTIMATION PRINCIPLE
# -------------------------------------------------------------------------------
#
# ALL marginal count-model parameters are estimated using TRAINING
# observations only.
#
# The held-out TEST period is NEVER used for:
#
#   * model parameter estimation,
#   * BIC calculation,
#   * model selection,
#   * NB dispersion estimation,
#   * ZIP zero-inflation estimation.
#
# After model selection, the FIXED training-estimated model is used to
# generate conditional means and conditional variances for both the
# training and test periods.
#
# Thus, test-period quantities are strictly out-of-sample model-based
# predictions from parameters estimated on the training period.
#
# -------------------------------------------------------------------------------
# MODEL SELECTION
# -------------------------------------------------------------------------------
#
# Models are compared using TRAINING BIC.
#
# The selected model is the numerically valid candidate with the smallest
# training BIC.
#
# ZIP is included because count data may contain excess zeros, particularly
# for smaller states or during periods of unusually low mortality.
#
# IMPORTANT:
#
#   * The presence of zeros alone does NOT justify ZIP.
#   * ZIP is selected only when its TRAINING BIC is lower than the competing
#     valid Poisson and NB models.
#   * A pathological NB dispersion estimate is rejected.
#   * If no candidate model is numerically valid, a constant-mean fallback
#     is used.
#
# -------------------------------------------------------------------------------
# CONDITIONAL MEANS AND VARIANCES
# -------------------------------------------------------------------------------
#
# Poisson:
#
#       E(Y_t | F_{t-1}) = lambda_t
#       Var(Y_t | F_{t-1}) = lambda_t
#
# Negative Binomial:
#
#       E(Y_t | F_{t-1}) = mu_t
#
#       Var(Y_t | F_{t-1})
#           = mu_t + mu_t^2 / theta
#
# ZIP:
#
#       E(Y_t | F_{t-1})
#           = (1-pi_t) lambda_t
#
#       Var(Y_t | F_{t-1})
#           = (1-pi_t) lambda_t
#             [1 + pi_t lambda_t]
#
# Here the ZIP zero-inflation probability is modeled as constant:
#
#       logit(pi_t) = gamma_0
#
# while the Poisson count component is:
#
#       log(lambda_t) = beta_0 + beta_1 t.
#
# -------------------------------------------------------------------------------
# STANDARDIZED COUNT INNOVATIONS
# -------------------------------------------------------------------------------
#
# After selecting the marginal model:
#
#       e_t =
#
#           Y_t - mu_t
#           -----------
#              sqrt(V_t)
#
# where mu_t and V_t are the selected-model conditional mean and variance.
#
# These standardized COUNT innovations are subsequently used as the input
# to the training-only GARCH analysis.
#
# IMPORTANT:
#
# GARCH is NOT fitted to:
#
#   * fitted conditional means,
#   * raw counts,
#   * or test-period observations.
#
################################################################################


################################################################################
# 9.0 REQUIRED PACKAGES
################################################################################

if (!requireNamespace("MASS", quietly = TRUE)) {
    stop(
        "Package 'MASS' is required for the Negative Binomial model."
    )
}

if (!requireNamespace("pscl", quietly = TRUE)) {
    stop(
        paste(
            "Package 'pscl' is required for the Zero-Inflated Poisson model.",
            "Install it using: install.packages('pscl')"
        )
    )
}


################################################################################
# 9.1 OUTPUT DIRECTORY
################################################################################

if (!exists("OUTPUT_DIR") ||
    !is.character(OUTPUT_DIR) ||
    length(OUTPUT_DIR) != 1 ||
    is.na(OUTPUT_DIR) ||
    !nzchar(OUTPUT_DIR)) {

    OUTPUT_DIR <- "spatial_count_volatility_results"
}

if (!dir.exists(OUTPUT_DIR)) {

    dir.create(
        OUTPUT_DIR,
        recursive = TRUE,
        showWarnings = FALSE
    )
}


################################################################################
# 9.2 REQUIRED OBJECT CHECKS
################################################################################

required_objects_9 <- c(
    "ts_data",
    "n_days",
    "n_loc",
    "locations",
    "train_idx",
    "test_idx",
    "train_end",
    "EPS"
)

missing_objects_9 <- required_objects_9[
    !vapply(
        required_objects_9,
        exists,
        logical(1),
        inherits = TRUE
    )
]

if (length(missing_objects_9) > 0) {

    stop(
        paste(
            "Section 9 cannot proceed. Missing object(s):",
            paste(missing_objects_9, collapse = ", ")
        )
    )
}


################################################################################
# 9.3 VALIDATE TRAINING / TEST PARTITION
################################################################################

train_idx <- as.integer(train_idx)
test_idx  <- as.integer(test_idx)

if (length(train_idx) == 0 ||
    length(test_idx) == 0) {

    stop(
        "Training and test index vectors must both contain observations."
    )
}

if (anyDuplicated(train_idx) > 0 ||
    anyDuplicated(test_idx) > 0) {

    stop(
        "Training or test indices contain duplicates."
    )
}

if (any(!is.finite(train_idx)) ||
    any(!is.finite(test_idx))) {

    stop(
        "Training or test indices contain non-finite values."
    )
}

if (any(train_idx < 1 | train_idx > n_days) ||
    any(test_idx < 1 | test_idx > n_days)) {

    stop(
        "Training/test indices are outside the valid observation range."
    )
}

if (length(intersect(train_idx, test_idx)) > 0) {

    stop(
        "Training and test indices overlap."
    )
}

if (length(c(train_idx, test_idx)) != n_days) {

    stop(
        "Training and test indices do not partition the complete time series."
    )
}


################################################################################
# 9.4 INITIALIZE MODEL OBJECTS
################################################################################

mean_mat <- matrix(
    NA_real_,
    nrow = n_days,
    ncol = n_loc
)

colnames(mean_mat) <- locations


variance_mat <- matrix(
    NA_real_,
    nrow = n_days,
    ncol = n_loc
)

colnames(variance_mat) <- locations


innovation_mat <- matrix(
    NA_real_,
    nrow = n_days,
    ncol = n_loc
)

colnames(innovation_mat) <- locations


model_stats <- data.frame(

    State = locations,

    Poisson_AIC = NA_real_,
    Poisson_BIC = NA_real_,

    NB_AIC = NA_real_,
    NB_BIC = NA_real_,
    NB_Theta = NA_real_,

    ZIP_AIC = NA_real_,
    ZIP_BIC = NA_real_,
    ZIP_ZeroProb = NA_real_,

    Selected_Model = NA_character_,
    Dispersion = NA_real_,

    Training_N = NA_integer_,
    Training_Zero_Count = NA_integer_,
    Training_Zero_Proportion = NA_real_,

    stringsAsFactors = FALSE
)


count_models <- vector(
    "list",
    n_loc
)

names(count_models) <- locations


################################################################################
# 9.5 FIT EACH STATE USING TRAINING DATA ONLY
################################################################################

for (i in seq_len(n_loc)) {

    state_name <- locations[i]

    cat(
        "\nFitting training-only marginal models:",
        state_name,
        "(", i, "/", n_loc, ")"
    )

    ########################################################################
    # FULL SERIES
    ########################################################################

    y_all <- as.numeric(
        ts_data[, i]
    )

    if (length(y_all) != n_days) {

        stop(
            paste(
                "State", state_name,
                "does not have", n_days,
                "observations."
            )
        )
    }


    ########################################################################
    # TRAINING DATA ONLY
    ########################################################################

    y_train <- y_all[train_idx]

    t_train <- seq_along(train_idx)

    t_test <- train_end + seq_along(test_idx)


    ########################################################################
    # BASIC COUNT-DATA VALIDATION
    ########################################################################

    finite_train <- is.finite(y_train)

    y_train_valid <- y_train[finite_train]

    model_stats$Training_N[i] <-
        length(y_train_valid)

    model_stats$Training_Zero_Count[i] <-
        sum(
            y_train_valid == 0
        )

    if (length(y_train_valid) > 0) {

        model_stats$Training_Zero_Proportion[i] <-
            mean(
                y_train_valid == 0
            )

    } else {

        model_stats$Training_Zero_Proportion[i] <-
            NA_real_
    }


    ########################################################################
    # CHECK NONNEGATIVE INTEGER COUNTS
    ########################################################################

    if (length(y_train_valid) > 0) {

        invalid_count_values <- any(
            y_train_valid < 0 |
            abs(
                y_train_valid -
                    round(y_train_valid)
            ) > 1e-8
        )

        if (invalid_count_values) {

            warning(
                paste(
                    "State", state_name,
                    "contains nonnegative non-integer training values.",
                    "Count-model fitting may be inappropriate."
                )
            )
        }
    }


    ########################################################################
    # 9.5.1 CONSTANT / EMPTY TRAINING SERIES
    ########################################################################

    training_mean <- if (
        length(y_train_valid) > 0
    ) {

        mean(
            y_train_valid
        )

    } else {

        NA_real_
    }


    training_variance <- if (
        length(y_train_valid) > 1
    ) {

        var(
            y_train_valid
        )

    } else {

        NA_real_
    }


    constant_training <- (
        length(y_train_valid) == 0 ||
        !is.finite(training_variance) ||
        training_variance <= EPS
    )


    if (constant_training) {

        fallback_mean <- if (
            is.finite(training_mean)
        ) {
            max(
                training_mean,
                EPS
            )
        } else {
            EPS
        }


        mu_train <- rep(
            fallback_mean,
            length(train_idx)
        )

        mu_test <- rep(
            fallback_mean,
            length(test_idx)
        )


        mean_mat[train_idx, i] <-
            mu_train

        mean_mat[test_idx, i] <-
            mu_test


        variance_mat[train_idx, i] <-
            pmax(
                mu_train,
                EPS
            )

        variance_mat[test_idx, i] <-
            pmax(
                mu_test,
                EPS
            )


        innovation_mat[, i] <-
            (
                y_all -
                    mean_mat[, i]
            ) /
            sqrt(
                pmax(
                    variance_mat[, i],
                    EPS
                )
            )


        innovation_mat[!is.finite(innovation_mat[, i]), i] <-
            NA_real_


        model_stats$Selected_Model[i] <-
            "Constant"

        count_models[[i]] <-
            NULL

        cat(
            " -> Constant fallback"
        )

        next
    }


    ########################################################################
    # 9.5.2 POISSON MODEL
    ########################################################################

    poisson_fit <- tryCatch(

        suppressWarnings(
            glm(
                y_train ~ t_train,
                family = poisson(link = "log")
            )
        ),

        error = function(e) NULL
    )


    ########################################################################
    # 9.5.3 NEGATIVE BINOMIAL MODEL
    ########################################################################

    nb_fit <- tryCatch(

        suppressWarnings(
            MASS::glm.nb(
                y_train ~ t_train,
                control = glm.control(
                    maxit = 100
                )
            )
        ),

        error = function(e) NULL
    )


    ########################################################################
    # 9.5.4 ZERO-INFLATED POISSON MODEL
    ########################################################################
    #
    # Count component:
    #
    #       log(lambda_t) = beta_0 + beta_1 t
    #
    # Zero-inflation component:
    #
    #       logit(pi_t) = gamma_0
    #
    # The zero-inflation probability is intentionally constant over time.
    #
    ########################################################################

    zip_fit <- tryCatch(

        suppressWarnings(
            pscl::zeroinfl(
                y_train ~ t_train | 1,
                data = data.frame(
                    y_train = y_train,
                    t_train = t_train
                ),
                dist = "poisson"
            )
        ),

        error = function(e) NULL
    )


    ########################################################################
    # 9.6 VALIDATE POISSON MODEL
    ########################################################################

    poisson_valid <- FALSE

    if (!is.null(poisson_fit)) {

        poisson_coef <- tryCatch(
            coef(poisson_fit),
            error = function(e) NULL
        )

        poisson_aic <- tryCatch(
            AIC(poisson_fit),
            error = function(e) NA_real_
        )

        poisson_bic <- tryCatch(
            BIC(poisson_fit),
            error = function(e) NA_real_
        )

        poisson_valid <- (

            !is.null(poisson_coef) &&

            all(
                is.finite(
                    poisson_coef
                )
            ) &&

            is.finite(
                poisson_aic
            ) &&

            is.finite(
                poisson_bic
            )
        )


        if (poisson_valid) {

            model_stats$Poisson_AIC[i] <-
                poisson_aic

            model_stats$Poisson_BIC[i] <-
                poisson_bic
        }
    }


    ########################################################################
    # 9.7 VALIDATE NEGATIVE BINOMIAL MODEL
    ########################################################################

    nb_valid <- FALSE

    nb_theta <- NA_real_


    if (!is.null(nb_fit)) {

        nb_theta <- tryCatch(
            as.numeric(
                nb_fit$theta
            ),
            error = function(e) NA_real_
        )

        nb_coef <- tryCatch(
            coef(nb_fit),
            error = function(e) NULL
        )

        nb_aic <- tryCatch(
            AIC(nb_fit),
            error = function(e) NA_real_
        )

        nb_bic <- tryCatch(
            BIC(nb_fit),
            error = function(e) NA_real_
        )


        ####################################################################
        # Reject pathological NB dispersion estimates.
        #
        # A very large theta makes NB approximately Poisson and may
        # indicate numerical instability in dispersion estimation.
        ####################################################################

        nb_valid <- (

            length(nb_theta) == 1 &&

            is.finite(nb_theta) &&

            nb_theta > 0 &&

            nb_theta < 1e6 &&

            !is.null(nb_coef) &&

            all(
                is.finite(
                    nb_coef
                )
            ) &&

            is.finite(
                nb_aic
            ) &&

            is.finite(
                nb_bic
            )
        )


        if (nb_valid) {

            model_stats$NB_AIC[i] <-
                nb_aic

            model_stats$NB_BIC[i] <-
                nb_bic

            model_stats$NB_Theta[i] <-
                nb_theta
        }
    }


    ########################################################################
    # 9.8 VALIDATE ZERO-INFLATED POISSON MODEL
    ########################################################################

    zip_valid <- FALSE

    zip_zero_prob <- NA_real_


    if (!is.null(zip_fit)) {

        zip_coef <- tryCatch(
            coef(zip_fit),
            error = function(e) NULL
        )

        zip_aic <- tryCatch(
            AIC(zip_fit),
            error = function(e) NA_real_
        )

        zip_bic <- tryCatch(
            BIC(zip_fit),
            error = function(e) NA_real_
        )


        ####################################################################
        # Extract zero-inflation intercept.
        ####################################################################

        zip_zero_coef <- tryCatch(

            as.numeric(
                coef(
                    zip_fit,
                    model = "zero"
                )[1]
            ),

            error = function(e) NA_real_
        )


        if (is.finite(zip_zero_coef)) {

            zip_zero_prob <-
                plogis(
                    zip_zero_coef
                )
        }


        ####################################################################
        # ZIP numerical validity
        ####################################################################

        zip_valid <- (

            !is.null(zip_coef) &&

            all(
                is.finite(
                    zip_coef
                )
            ) &&

            is.finite(
                zip_aic
            ) &&

            is.finite(
                zip_bic
            ) &&

            is.finite(
                zip_zero_prob
            ) &&

            zip_zero_prob >= 0 &&

            zip_zero_prob <= 1
        )


        if (zip_valid) {

            model_stats$ZIP_AIC[i] <-
                zip_aic

            model_stats$ZIP_BIC[i] <-
                zip_bic

            model_stats$ZIP_ZeroProb[i] <-
                zip_zero_prob
        }
    }


    ########################################################################
    # 9.9 TRAINING BIC MODEL SELECTION
    ########################################################################
    #
    # IMPORTANT:
    #
    # Only TRAINING BIC values enter this comparison.
    #
    ########################################################################

    candidate_bic <- c(

        Poisson =
            if (poisson_valid) {
                model_stats$Poisson_BIC[i]
            } else {
                Inf
            },

        NB =
            if (nb_valid) {
                model_stats$NB_BIC[i]
            } else {
                Inf
            },

        ZIP =
            if (zip_valid) {
                model_stats$ZIP_BIC[i]
            } else {
                Inf
            }
    )


    valid_candidate <- is.finite(
        candidate_bic
    )


    if (!any(valid_candidate)) {

        selected_model <- "Constant"

        selected_fit <- NULL

    } else {

        selected_model <-
            names(
                candidate_bic
            )[
                which.min(
                    candidate_bic
                )
            ]


        if (selected_model == "Poisson") {

            selected_fit <-
                poisson_fit

        } else if (selected_model == "NB") {

            selected_fit <-
                nb_fit

        } else if (selected_model == "ZIP") {

            selected_fit <-
                zip_fit

        } else {

            selected_model <- "Constant"

            selected_fit <- NULL
        }
    }


    ########################################################################
    # 9.10 STORE SELECTED MODEL
    ########################################################################

    count_models[[i]] <-
        selected_fit

    model_stats$Selected_Model[i] <-
        selected_model


    ########################################################################
    # 9.11 GENERATE CONDITIONAL MEANS
    ########################################################################
    #
    # Training means are fitted values from the selected training model.
    #
    # Test means are genuine out-of-sample predictions obtained by
    # extrapolating the FIXED training-estimated model to the test time
    # indices.
    #
    ########################################################################

    if (selected_model == "Poisson") {

        mu_train <- tryCatch(

            predict(
                selected_fit,
                newdata = data.frame(
                    t_train = t_train
                ),
                type = "response"
            ),

            error = function(e) rep(
                NA_real_,
                length(train_idx)
            )
        )


        mu_test <- tryCatch(

            predict(
                selected_fit,
                newdata = data.frame(
                    t_train = t_test
                ),
                type = "response"
            ),

            error = function(e) rep(
                NA_real_,
                length(test_idx)
            )
        )


    } else if (selected_model == "NB") {

        mu_train <- tryCatch(

            predict(
                selected_fit,
                newdata = data.frame(
                    t_train = t_train
                ),
                type = "response"
            ),

            error = function(e) rep(
                NA_real_,
                length(train_idx)
            )
        )


        mu_test <- tryCatch(

            predict(
                selected_fit,
                newdata = data.frame(
                    t_train = t_test
                ),
                type = "response"
            ),

            error = function(e) rep(
                NA_real_,
                length(test_idx)
            )
        )


    } else if (selected_model == "ZIP") {

        ####################################################################
        # type = "response" returns:
        #
        #       E(Y_t) = (1-pi_t) lambda_t
        #
        ####################################################################

        mu_train <- tryCatch(

            predict(
                selected_fit,
                newdata = data.frame(
                    t_train = t_train
                ),
                type = "response"
            ),

            error = function(e) rep(
                NA_real_,
                length(train_idx)
            )
        )


        mu_test <- tryCatch(

            predict(
                selected_fit,
                newdata = data.frame(
                    t_train = t_test
                ),
                type = "response"
            ),

            error = function(e) rep(
                NA_real_,
                length(test_idx)
            )
        )


    } else {

        ####################################################################
        # Constant fallback
        ####################################################################

        fallback_mean <- max(
            training_mean,
            EPS
        )

        mu_train <- rep(
            fallback_mean,
            length(train_idx)
        )

        mu_test <- rep(
            fallback_mean,
            length(test_idx)
        )
    }


    ########################################################################
    # 9.12 NUMERICAL VALIDATION OF CONDITIONAL MEANS
    ########################################################################

    mu_train <- as.numeric(
        mu_train
    )

    mu_test <- as.numeric(
        mu_test
    )


    if (length(mu_train) != length(train_idx) ||
        length(mu_test) != length(test_idx)) {

        warning(
            paste(
                "State", state_name,
                "produced invalid conditional-mean lengths.",
                "Using constant fallback."
            )
        )

        fallback_mean <- max(
            training_mean,
            EPS
        )

        mu_train <- rep(
            fallback_mean,
            length(train_idx)
        )

        mu_test <- rep(
            fallback_mean,
            length(test_idx)
        )

        selected_model <- "Constant"

        model_stats$Selected_Model[i] <-
            "Constant"

        count_models[[i]] <-
            NULL
    }


    mu_train[!is.finite(mu_train)] <-
        NA_real_

    mu_test[!is.finite(mu_test)] <-
        NA_real_


    ########################################################################
    # 9.13 STORE CONDITIONAL MEANS
    ########################################################################

    mean_mat[train_idx, i] <-
        pmax(
            mu_train,
            EPS
        )

    mean_mat[test_idx, i] <-
        pmax(
            mu_test,
            EPS
        )


    ########################################################################
    # 9.14 CONDITIONAL COUNT VARIANCE
    ########################################################################

    if (selected_model == "NB" &&
        !is.null(selected_fit) &&
        is.finite(selected_fit$theta) &&
        selected_fit$theta > 0) {

        ####################################################################
        # Negative Binomial:
        #
        # Var(Y) = mu + mu^2 / theta
        ####################################################################

        theta <- as.numeric(
            selected_fit$theta
        )

        variance_train <-
            mu_train +
            mu_train^2 / theta

        variance_test <-
            mu_test +
            mu_test^2 / theta

        model_stats$Dispersion[i] <-
            theta


    } else if (
        selected_model == "ZIP" &&
        !is.null(selected_fit)
    ) {

        ####################################################################
        # ZIP:
        #
        # type = "count" gives lambda_t, the Poisson component mean.
        ####################################################################

        lambda_train <- tryCatch(

            predict(
                selected_fit,
                newdata = data.frame(
                    t_train = t_train
                ),
                type = "count"
            ),

            error = function(e) rep(
                NA_real_,
                length(train_idx)
            )
        )


        lambda_test <- tryCatch(

            predict(
                selected_fit,
                newdata = data.frame(
                    t_train = t_test
                ),
                type = "count"
            ),

            error = function(e) rep(
                NA_real_,
                length(test_idx)
            )
        )


        ####################################################################
        # Constant zero-inflation probability.
        ####################################################################

        zero_coef <- tryCatch(

            as.numeric(
                coef(
                    selected_fit,
                    model = "zero"
                )[1]
            ),

            error = function(e) NA_real_
        )


        if (is.finite(zero_coef)) {

            pi_hat <- plogis(
                zero_coef
            )

        } else {

            pi_hat <- NA_real_
        }


        ####################################################################
        # ZIP conditional variance:
        #
        # Var(Y)
        #   = (1-pi) lambda (1 + pi lambda)
        ####################################################################

        variance_train <-
            (1 - pi_hat) *
            lambda_train *
            (
                1 +
                    pi_hat *
                    lambda_train
            )

        variance_test <-
            (1 - pi_hat) *
            lambda_test *
            (
                1 +
                    pi_hat *
                    lambda_test
            )

        model_stats$Dispersion[i] <-
            pi_hat


    } else {

        ####################################################################
        # Poisson / Constant fallback
        ####################################################################

        variance_train <-
            pmax(
                mu_train,
                EPS
            )

        variance_test <-
            pmax(
                mu_test,
                EPS
            )
    }


    ########################################################################
    # 9.15 STORE CONDITIONAL VARIANCES
    ########################################################################

    variance_train <- as.numeric(
        variance_train
    )

    variance_test <- as.numeric(
        variance_test
    )


    variance_train[
        !is.finite(variance_train) |
        variance_train <= 0
    ] <- EPS


    variance_test[
        !is.finite(variance_test) |
        variance_test <= 0
    ] <- EPS


    variance_mat[train_idx, i] <-
        variance_train

    variance_mat[test_idx, i] <-
        variance_test


    ########################################################################
    # 9.16 STANDARDIZED COUNT INNOVATIONS
    ########################################################################
    #
    #       e_t =
    #
    #          Y_t - mu_t
    #          -----------
    #             sqrt(V_t)
    #
    # IMPORTANT:
    #
    # The TRAINING portion of innovation_mat is used subsequently for
    # training-only GARCH estimation.
    #
    # The TEST portion is retained only for out-of-sample evaluation and
    # is NOT used to estimate marginal-model or GARCH parameters.
    #
    ########################################################################

    innovation_mat[, i] <-
        (
            y_all -
                mean_mat[, i]
        ) /
        sqrt(
            pmax(
                variance_mat[, i],
                EPS
            )
        )


    ########################################################################
    # 9.17 NUMERICAL CLEANUP
    ########################################################################

    innovation_mat[
        !is.finite(
            innovation_mat[, i]
        ),
        i
    ] <- NA_real_


    mean_mat[
        !is.finite(
            mean_mat[, i]
        ),
        i
    ] <- NA_real_


    variance_mat[
        !is.finite(
            variance_mat[, i]
        ) |
        variance_mat[, i] <= 0,
        i
    ] <- EPS


    ########################################################################
    # PROGRESS MESSAGE
    ########################################################################

    cat(
        " -> Selected:",
        selected_model
    )

    if (selected_model == "ZIP") {

        cat(
            paste0(
                " (zero probability = ",
                round(
                    model_stats$ZIP_ZeroProb[i],
                    4
                ),
                ")"
            )
        )

    } else if (selected_model == "NB") {

        cat(
            paste0(
                " (theta = ",
                signif(
                    model_stats$NB_Theta[i],
                    5
                ),
                ")"
            )
        )
    }
}


