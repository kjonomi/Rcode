###############################################################################
# 2. DYNAMIC LONGITUDINAL SIMULATION ENGINE (AR(1) + Dynamic Carryover)
###############################################################################

simulate_dynamic_sports_data <- function(n = N_CUSTOMERS, t_steps = T_TIMESTEPS, p = P_COVARIATES, rho = 0.6) {
    
    total_obs <- n * t_steps
    X_panel <- array(0, dim = c(n, t_steps, p))
    A_panel <- matrix(0, nrow = n, ncol = t_steps)
    Y_panel <- matrix(0, nrow = n, ncol = t_steps)
    TAU_panel <- matrix(0, nrow = n, ncol = t_steps)
    PROP_panel <- matrix(0, nrow = n, ncol = t_steps)
    Y0_panel <- matrix(0, nrow = n, ncol = t_steps)
    Y1_panel <- matrix(0, nrow = n, ncol = t_steps)
    
    for (i in 1:n) {
        # Baseline individual fan heterogeneity
        alpha_i <- rnorm(p, mean = 0, sd = 0.5)
        
        # Initial state
        X_panel[i, 1, ] <- alpha_i + rnorm(p, mean = 0, sd = 1)
        
        for (t in 1:t_steps) {
            # Game calendar & seasonality effect
            calendar_effect <- sin(2 * pi * t / 7) + 0.5 * cos(2 * pi * t / 30)
            
            if (t > 1) {
                # Past intervention carryover & fatigue
                past_A <- A_panel[i, t - 1]
                # AR(1) dynamic covariate evolution
                X_panel[i, t, ] <- rho * X_panel[i, t - 1, ] + 
                                   (1 - rho) * alpha_i + 
                                   0.1 * calendar_effect - 
                                   0.2 * past_A + 
                                   rnorm(p, mean = 0, sd = 0.3)
            }
            
            X_it <- X_panel[i, t, ]
            
            # Dynamic Propensity Score e(H_it)
            logit_e <- -0.2 + 0.3 * X_it[1] - 0.25 * X_it[2] + 0.2 * X_it[3] + 0.1 * calendar_effect
            prop_it <- pmin(pmax(plogis(logit_e), 0.05), 0.95)
            PROP_panel[i, t] <- prop_it
            
            # Historical treatment assignment
            A_it <- rbinom(1, 1, prop_it)
            A_panel[i, t] <- A_it
            
            # Non-linear Dynamic CATE tau(H_it)
            tau_it <- 0.40 + 0.35 * sin(X_it[1]) + 0.25 * X_it[2] * X_it[3] + 0.20 * (X_it[4]^2 - 1)
            TAU_panel[i, t] <- tau_it
            
            # Baseline Revenue Y(0)
            y0_it <- 1.00 + 0.20 * X_it[1] - 0.10 * X_it[2] + 0.15 * calendar_effect
            Y0_panel[i, t] <- y0_it
            Y1_panel[i, t] <- y0_it + tau_it
            
            # Realized Outcome with noise
            eps <- rnorm(1, mean = 0, sd = 0.4)
            Y_panel[i, t] <- ifelse(A_it == 1, Y1_panel[i, t] + eps, Y0_panel[i, t] + eps)
        }
    }
    
    return(list(
        X = X_panel, A = A_panel, Y = Y_panel,
        TAU = TAU_panel, PROP = PROP_panel,
        Y0 = Y0_panel, Y1 = Y1_panel
    ))
}

###############################################################################
# 3. CONSTRUCT TEMPORAL LOOKBACK SEQUENCES (LEAKAGE PREVENTION)
###############################################################################

build_chronological_dataset <- function(sim_data, lookback = LOOKBACK) {
    X_arr <- sim_data$X
    A_mat <- sim_data$A
    Y_mat <- sim_data$Y
    TAU_mat <- sim_data$TAU
    Y0_mat <- sim_data$Y0
    Y1_mat <- sim_data$Y1
    
    n <- dim(X_arr)[1]
    t_steps <- dim(X_arr)[2]
    p <- dim(X_arr)[3]
    
    seq_per_fan <- t_steps - lookback
    total_seq <- n * seq_per_fan
    
    X_seq <- array(0, dim = c(total_seq, lookback, p))
    A_seq <- numeric(total_seq)
    Y_seq <- numeric(total_seq)
    TAU_seq <- numeric(total_seq)
    Y0_seq <- numeric(total_seq)
    Y1_seq <- numeric(total_seq)
    RFM_seq <- matrix(0, nrow = total_seq, ncol = p * 2) # Summary features for static models
    
    idx <- 1
    for (i in 1:n) {
        for (t in (lookback + 1):t_steps) {
            hist_range <- (t - lookback):(t - 1)
            X_seq[idx, , ] <- X_arr[i, hist_range, ]
            
            # Aggregate static RFM-style features across lookback window
            RFM_seq[idx, ] <- c(colMeans(X_arr[i, hist_range, ]), apply(X_arr[i, hist_range, ], 2, sd))
            
            A_seq[idx] <- A_mat[i, t]
            Y_seq[idx] <- Y_mat[i, t]
            TAU_seq[idx] <- TAU_mat[i, t]
            Y0_seq[idx] <- Y0_mat[i, t]
            Y1_seq[idx] <- Y1_mat[i, t]
            
            idx <- idx + 1
        }
    }
    
    return(list(
        X_seq = X_seq, RFM_seq = RFM_seq, A_seq = A_seq,
        Y_seq = Y_seq, TAU_seq = TAU_seq, Y0_seq = Y0_seq, Y1_seq = Y1_seq
    ))
}

###############################################################################
# 4. TEMPORAL CAUSAL DEEP ARCHITECTURE (CNN + BiLSTM + Transformer)
###############################################################################

build_temporal_causal_network <- function(lookback = LOOKBACK, p = P_COVARIATES, branch_type = "full") {
    
    inputs <- layer_input(shape = c(lookback, p), name = "temporal_history")
    
    if (branch_type == "full" || branch_type == "cnn") {
        cnn_branch <- inputs %>%
            layer_conv_1d(filters = 32, kernel_size = 3, padding = "same", activation = "relu") %>%
            layer_batch_normalization() %>%
            layer_global_average_pooling_1d()
    }
    
    if (branch_type == "full" || branch_type == "bilstm") {
        bilstm_branch <- keras_layers$Bidirectional(
            keras_layers$LSTM(units = 32L, return_sequences = FALSE)
        )(inputs)
    }
    
    if (branch_type == "full" || branch_type == "transformer") {
        attn <- layer_multi_head_attention(num_heads = 2, key_dim = 16)(query = inputs, key = inputs, value = inputs)
        attn_add <- layer_add(list(inputs, attn)) %>% layer_layer_normalization()
        transformer_branch <- attn_add %>% layer_global_average_pooling_1d()
    }
    
    # Combined latent representation
    if (branch_type == "full") {
        combined <- layer_concatenate(list(cnn_branch, bilstm_branch, transformer_branch))
    } else if (branch_type == "cnn") {
        combined <- cnn_branch
    } else if (branch_type == "bilstm") {
        combined <- bilstm_branch
    } else if (branch_type == "transformer") {
        combined <- transformer_branch
    }
    
    representation <- combined %>%
        layer_dense(units = 32, activation = "relu") %>%
        layer_batch_normalization() %>%
        layer_dropout(rate = 0.15)
    
    propensity_head <- representation %>% layer_dense(units = 1, activation = "sigmoid", name = "propensity")
    y0_head <- representation %>% layer_dense(units = 1, activation = "linear", name = "Y0")
    y1_head <- representation %>% layer_dense(units = 1, activation = "linear", name = "Y1")
    
    model <- keras_model(inputs = inputs, outputs = list(propensity_head, y0_head, y1_head))
    
    model$compile(
        optimizer = keras_optimizers$Adam(learning_rate = LEARNING_RATE),
        loss = list("binary_crossentropy", "mse", "mse"),
        loss_weights = list(0.5, 1.0, 1.0)
    )
    
    return(model)
}

###############################################################################
# 5. COMPARATIVE BENCHMARK LEARNERS (S/T/X-Learners)
###############################################################################

fit_meta_learners <- function(train_df, test_df) {
    # S-Learner (Single Model)
    s_fit <- randomForest(Y ~ . - TAU - Y0 - Y1, data = train_df)
    test_s_1 <- predict(s_fit, newdata = mutate(test_df, A = 1))
    test_s_0 <- predict(s_fit, newdata = mutate(test_df, A = 0))
    tau_s <- test_s_1 - test_s_0
    
    # T-Learner (Two Separate Models)
    t_fit_0 <- randomForest(Y ~ . - A - TAU - Y0 - Y1, data = filter(train_df, A == 0))
    t_fit_1 <- randomForest(Y ~ . - A - TAU - Y0 - Y1, data = filter(train_df, A == 1))
    tau_t <- predict(t_fit_1, newdata = test_df) - predict(t_fit_0, newdata = test_df)
    
    # X-Learner (Causal Imputation Second-Stage)
    d_train_1 <- filter(train_df, A == 1)$Y - predict(t_fit_0, newdata = filter(train_df, A == 1))
    d_train_0 <- predict(t_fit_1, newdata = filter(train_df, A == 0)) - filter(train_df, A == 0)$Y
    
    x_fit_1 <- randomForest(d_train_1 ~ . - A - Y - TAU - Y0 - Y1, data = filter(train_df, A == 1))
    x_fit_0 <- randomForest(d_train_0 ~ . - A - Y - TAU - Y0 - Y1, data = filter(train_df, A == 0))
    
    e_fit <- glm(A ~ . - Y - TAU - Y0 - Y1, data = train_df, family = binomial)
    e_test <- predict(e_fit, newdata = test_df, type = "response")
    
    tau_x <- e_test * predict(x_fit_0, newdata = test_df) + (1 - e_test) * predict(x_fit_1, newdata = test_df)
    
    return(list(tau_s = tau_s, tau_t = tau_t, tau_x = tau_x))
}

###############################################################################
# 6. CROSS-FITTED POLICY EVALUATION ENGINE (DR & IPW)
###############################################################################

evaluate_policy_cross_fitted <- function(Y, A, propensity, policy, mu0, mu1, cost = MARKETING_COST, margin = CONTRIBUTION_MARGIN) {
    # Trim propensity scores to preserve positivity
    propensity <- pmin(pmax(propensity, 0.02), 0.98)
    
    # Contribution margin revenue
    m_Y <- Y * margin
    m_mu0 <- mu0 * margin
    m_mu1 <- mu1 * margin
    
    # Doubly Robust Policy Estimator
    mu_policy <- ifelse(policy == 1, m_mu1 - cost, m_mu0)
    observed_mu <- ifelse(A == 1, m_mu1, m_mu0)
    observed_p <- ifelse(A == 1, propensity, 1 - propensity)
    
    dr_correction <- (as.numeric(A == policy) / observed_p) * (m_Y - observed_mu)
    dr_value <- mean(mu_policy + dr_correction)
    
    # IPW Policy Estimator (Trimming extreme weights)
    ipw_weights <- pmin(as.numeric(A == policy) / observed_p, 20)
    ipw_value <- mean(ipw_weights * (m_Y - policy * cost))
    
    return(list(dr_value = dr_value, ipw_value = ipw_value))
}

###############################################################################
# 7. MAIN MONTE CARLO EXECUTION PIPELINE
###############################################################################

cat("\n============================================================\n")
cat("STARTING MONTE CARLO EVALUATION (", MC_REPLICATIONS, " REPLICATIONS)\n")
cat("============================================================\n")

mc_results_list <- list()

for (mc in 1:MC_REPLICATIONS) {
    cat("\n--- Executing Replication", mc, "of", MC_REPLICATIONS, "---\n")
    
    # 1. Simulate dynamic data
    sim_data <- simulate_dynamic_sports_data()
    seq_data <- build_chronological_dataset(sim_data)
    
    # 2. Chronological Split
    n_total <- dim(seq_data$X_seq)[1]
    n_train <- floor(TRAIN_PROP * n_total)
    n_valid <- floor(VALID_PROP * n_total)
    n_test  <- n_total - n_train - n_valid
    
    train_idx <- 1:n_train
    valid_idx <- (n_train + 1):(n_train + n_valid)
    test_idx  <- (n_train + n_valid + 1):n_total
    
    # Convert arrays to numpy for Python Keras fit
    X_tr_py <- np$array(seq_data$X_seq[train_idx, , ], dtype = "float32")
    X_va_py <- np$array(seq_data$X_seq[valid_idx, , ], dtype = "float32")
    X_te_py <- np$array(seq_data$X_seq[test_idx, , ], dtype = "float32")
    
    Y_tr <- seq_data$Y_seq[train_idx]
    A_tr <- seq_data$A_seq[train_idx]
    Y_va <- seq_data$Y_seq[valid_idx]
    A_va <- seq_data$A_seq[valid_idx]
    
    # Sample weighting masks for potential outcome heads
    Y_tr_list <- list(
        np$array(matrix(A_tr, ncol = 1), dtype = "float32"),
        np$array(matrix(Y_tr, ncol = 1), dtype = "float32"),
        np$array(matrix(Y_tr, ncol = 1), dtype = "float32")
    )
    
    SW_tr_list <- list(
        np$array(rep(1, length(A_tr)), dtype = "float32"),
        np$array(ifelse(A_tr == 0, 1, 0), dtype = "float32"),
        np$array(ifelse(A_tr == 1, 1, 0), dtype = "float32")
    )
    
    Y_va_list <- list(
        np$array(matrix(A_va, ncol = 1), dtype = "float32"),
        np$array(matrix(Y_va, ncol = 1), dtype = "float32"),
        np$array(matrix(Y_va, ncol = 1), dtype = "float32")
    )
    
    SW_va_list <- list(
        np$array(rep(1, length(A_va)), dtype = "float32"),
        np$array(ifelse(A_va == 0, 1, 0), dtype = "float32"),
        np$array(ifelse(A_va == 1, 1, 0), dtype = "float32")
    )
    
    # 3. Fit Proposed Deep Causal Model
    nn_model <- build_temporal_causal_network(branch_type = "full")
    nn_model$fit(
        x = X_tr_py, y = Y_tr_list, sample_weight = SW_tr_list,
        validation_data = list(X_va_py, Y_va_list, SW_va_list),
        epochs = as.integer(EPOCHS), batch_size = as.integer(BATCH_SIZE), verbose = 0L
    )
    
    # Predict on test set
    pred <- nn_model$predict(X_te_py, verbose = 0L)
    prop_hat <- as.numeric(pred[[1]])
    y0_hat   <- as.numeric(pred[[2]])
    y1_hat   <- as.numeric(pred[[3]])
    tau_hat  <- y1_hat - y0_hat
    
    # Proposed Profit-Maximizing Policy
    incremental_profit_hat <- (tau_hat * CONTRIBUTION_MARGIN) - MARKETING_COST
    proposed_policy <- ifelse(incremental_profit_hat > POLICY_THRESHOLD, 1, 0)
    
    # Predictive Response Policy (Targeting Top-K purchase probability)
    predictive_cutoff <- quantile(y1_hat, probs = 1 - mean(proposed_policy))
    predictive_policy <- ifelse(y1_hat >= predictive_cutoff, 1, 0)
    
    # 4. Fit Static Benchmarks (RFM Features)
    train_rfm_df <- as.data.frame(seq_data$RFM_seq[train_idx, ])
    train_rfm_df$A <- seq_data$A_seq[train_idx]
    train_rfm_df$Y <- seq_data$Y_seq[train_idx]
    train_rfm_df$TAU <- seq_data$TAU_seq[train_idx]
    train_rfm_df$Y0 <- seq_data$Y0_seq[train_idx]
    train_rfm_df$Y1 <- seq_data$Y1_seq[train_idx]
    
    test_rfm_df <- as.data.frame(seq_data$RFM_seq[test_idx, ])
    test_rfm_df$A <- seq_data$A_seq[test_idx]
    test_rfm_df$Y <- seq_data$Y_seq[test_idx]
    test_rfm_df$TAU <- seq_data$TAU_seq[test_idx]
    test_rfm_df$Y0 <- seq_data$Y0_seq[test_idx]
    test_rfm_df$Y1 <- seq_data$Y1_seq[test_idx]
    
    benchmarks <- fit_meta_learners(train_rfm_df, test_rfm_df)
    
    # 5. True Policy Evaluation Values
    true_tau_test <- seq_data$TAU_seq[test_idx]
    true_y0_test  <- seq_data$Y0_seq[test_idx]
    true_y1_test  <- seq_data$Y1_seq[test_idx]
    
    true_profit <- function(pol) {
        mean(ifelse(pol == 1, (true_y1_test * CONTRIBUTION_MARGIN) - MARKETING_COST, true_y0_test * CONTRIBUTION_MARGIN))
    }
    
    # Policy Evaluation Values
    val_proposed   <- true_profit(proposed_policy)
    val_predictive <- true_profit(predictive_policy)
    val_t_learner  <- true_profit(ifelse((benchmarks$tau_t * CONTRIBUTION_MARGIN) - MARKETING_COST > 0, 1, 0))
    val_x_learner  <- true_profit(ifelse((benchmarks$tau_x * CONTRIBUTION_MARGIN) - MARKETING_COST > 0, 1, 0))
    val_all        <- true_profit(rep(1, n_test))
    val_none       <- true_profit(rep(0, n_test))
    
    pehe_proposed  <- sqrt(mean((tau_hat - true_tau_test)^2))
    pehe_t_learner <- sqrt(mean((benchmarks$tau_t - true_tau_test)^2))
    
    mc_results_list[[mc]] <- data.frame(
        Replication = mc,
        PEHE_Proposed = pehe_proposed,
        PEHE_TLearner = pehe_t_learner,
        Profit_Proposed = val_proposed,
        Profit_Predictive = val_predictive,
        Profit_TLearner = val_t_learner,
        Profit_XLearner = val_x_learner,
        Profit_TargetAll = val_all,
        Profit_TargetNone = val_none,
        TargetRate_Proposed = mean(proposed_policy)
    )
}

mc_results_df <- do.call(rbind, mc_results_list)

