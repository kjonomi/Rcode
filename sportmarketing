# A = 0: no targeted intervention
#
# Y(a): future customer revenue under intervention a
# tau(X) = Y(1)-Y(0): individualized incremental revenue
###############################################################################

###############################################################################
# 3. SIMULATE LONGITUDINAL SPORTS-CUSTOMER DATA
###############################################################################

simulate_sports_marketing_data <- function(
    n = N,
    p = P,
    rho = 0.70
) {

    Sigma <- outer(
        1:p,
        1:p,
        function(i, j) rho^abs(i - j)
    )

    Z <- matrix(
        rnorm(n * p),
        nrow = n,
        ncol = p
    )

    L <- chol(Sigma)
    X <- Z %*% L

    X <- scale(X)
    X <- as.matrix(X)

    colnames(X) <- paste0("X", 1:p)

    return(X)
}

X <- simulate_sports_marketing_data()

###############################################################################
# 4. TRUE HETEROGENEOUS MARKETING EFFECT
###############################################################################
#
# The treatment effect is intentionally nonlinear and heterogeneous.
# This makes the problem genuinely causal rather than a simple response
# prediction problem.
###############################################################################

true_tau <- function(X) {

    tau <-
        0.50 +
        0.40 * sin(X[, 1]) +
        0.30 * X[, 2] * X[, 3] +
        0.25 * (X[, 4]^2 - 1) +
        0.20 * X[, 5]

    return(as.numeric(tau))
}

TAU_TRUE <- true_tau(X)

###############################################################################
# 5. TREATMENT ASSIGNMENT
###############################################################################
#
# Treatment assignment depends on customer characteristics. Therefore,
# treatment is not assumed to be completely randomized.
###############################################################################

treatment_probability <- function(X) {

    lp <-
        -0.10 +
        0.35 * X[, 1] -
        0.25 * X[, 2] +
        0.20 * X[, 3] +
        0.10 * X[, 4]

    p <- plogis(lp)

    # Enforce positivity.
    p <- pmin(
        pmax(p, 0.05),
        0.95
    )

    return(p)
}

