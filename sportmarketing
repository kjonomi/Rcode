###############################################################################
# 44. IPW POLICY VALUE
###############################################################################

evaluate_policy_ipw <- function(
    Y,
    A,
    propensity,
    policy
) {

    propensity <- pmin(
        pmax(propensity, 0.05),
        0.95
    )

    policy_prob <- ifelse(
        policy == 1,
        propensity,
        1 - propensity
    )

    matched <- as.numeric(
        A == policy
    )

    value <- mean(
        matched * Y / policy_prob
    )

    return(value)
}

IPW_REVENUE_VALUE <- evaluate_policy_ipw(
    Y = Y_test,
    A = A_test,
    propensity = PROPENSITY_HAT,
    policy = POLICY
)

IPW_PROFIT_VALUE <-
    IPW_REVENUE_VALUE -
    POLICY_MARKETING_COST_TOTAL

###############################################################################
# 45. DOUBLY ROBUST POLICY VALUE
###############################################################################

evaluate_policy_dr <- function(
    Y,
    A,
    propensity,
    policy,
    mu0,
    mu1,
    marketing_cost
) {

    propensity <- pmin(
        pmax(propensity, 0.05),
        0.95
    )

    mu_policy <- ifelse(
        policy == 1,
        mu1,
        mu0
    )

    observed_mu <- ifelse(
        A == 1,
        mu1,
        mu0
    )

    observed_propensity <- ifelse(
        A == 1,
        propensity,
        1 - propensity
    )

    correction <-
        (
            as.numeric(A == policy) /
                observed_propensity
        ) *
        (
            Y -
                observed_mu
        )

    revenue_value <- mean(
        mu_policy +
            correction
    )

    profit_value <-
        revenue_value -
        mean(policy * marketing_cost)

    return(profit_value)
}

DR_PROFIT_VALUE <- evaluate_policy_dr(
    Y = Y_test,
    A = A_test,
    propensity = PROPENSITY_HAT,
    policy = POLICY,
    mu0 = Y0_HAT,
    mu1 = Y1_HAT,
    marketing_cost = MARKETING_COST
)

