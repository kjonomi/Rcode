###############################################################################
# 11. CREATE TEMPORAL SEQUENCES
###############################################################################
#
# Genuine one-step-ahead decision:
#
#   X[t-LOOKBACK], ..., X[t-1]
#                  |
#                  v
#                 A[t]
#                  |
#                  v
#                 Y[t]
#
# The contemporaneous X[t] is excluded from the input sequence to prevent
# temporal leakage.
###############################################################################

create_sequences <- function(
    X,
    A,
    Y,
    tau,
    lookback
) {

    n <- nrow(X)
    p <- ncol(X)
    n_seq <- n - lookback

    X_seq <- array(
        0,
        dim = c(
            n_seq,
            lookback,
            p
        )
    )

    A_seq <- numeric(n_seq)
    Y_seq <- numeric(n_seq)
    tau_seq <- numeric(n_seq)

    for (i in seq_len(n_seq)) {

        target_index <- i + lookback
        start_index <- i
        end_index <- target_index - 1

        idx <- start_index:end_index

        X_seq[i, , ] <- X[idx, ]
        A_seq[i] <- A[target_index]
        Y_seq[i] <- Y[target_index]
        tau_seq[i] <- tau[target_index]
    }

    return(
        list(
            X = X_seq,
            A = A_seq,
            Y = Y_seq,
            tau = tau_seq
        )
    )
}

