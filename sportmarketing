        Profit_Predictive_Mean = mean(Profit_Predictive), Profit_Predictive_SD = sd(Profit_Predictive),
        Profit_TLearner_Mean = mean(Profit_TLearner), Profit_TLearner_SD = sd(Profit_TLearner),
        Profit_XLearner_Mean = mean(Profit_XLearner), Profit_XLearner_SD = sd(Profit_XLearner),
        Profit_TargetAll_Mean = mean(Profit_TargetAll), Profit_TargetNone_Mean = mean(Profit_TargetNone)
    )

